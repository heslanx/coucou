    "konclui.whatsapp.sample.direct.text" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عشاء الليلة؟" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আজ রাতে ডিনার?" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Abendessen heute?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Dinner tonight?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Cenamos hoy?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "On dîne ce soir ?" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आज रात डिनर?" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Makan malam nanti?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "今夜、夕食どう？" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘 저녁 먹을래요?" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Vamos jantar hoje?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ужин сегодня?" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "มื้อเย็นวันนี้ไหม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Akşam yemeğe çıkalım mı?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今晚一起吃饭？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "今晚一起吃飯？" } } } },
