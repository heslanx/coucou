    "flow.ann.no-access" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن Koncluí من اللصق: كلماتك منسوخة. اضغط ⌘V، واسمح بتسهيلات الاستخدام ليلصق بنفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí পেস্ট করতে পারেনি: আপনার কথা কপি হয়েছে। ⌘V চাপুন, আর অ্যাক্সেসিবিলিটির অনুমতি দিন যাতে নিজেই পেস্ট করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí konnte nicht einfügen: Deine Worte wurden kopiert. Drücke ⌘V und erlaube Bedienungshilfen, damit Koncluí sie für dich einfügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí couldn't paste: your words are copied. Press ⌘V, and allow Accessibility so it pastes for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí no pudo pegar: tus palabras están copiadas. Pulsa ⌘V y permite Accesibilidad para que pegue solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí n'a pas pu coller : tes mots sont copiés. Fais ⌘V, et autorise l'Accessibilité pour qu'il colle tout seul."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí चिपका नहीं सका: आपके शब्द कॉपी हो गए हैं। ⌘V दबाएँ, और एक्सेसिबिलिटी की अनुमति दें ताकि वह खुद चिपकाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí tidak bisa menempel: kata-katamu sudah disalin. Tekan ⌘V, dan izinkan Aksesibilitas agar ia menempel sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí はペーストできませんでした。言葉はコピーされています。⌘V を押し、アクセシビリティを許可すると自動でペーストされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣기에 실패해서 대신 복사해 뒀어요. ⌘V를 누르고, 다음엔 알아서 붙여넣도록 손쉬운 사용을 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí não conseguiu colar: suas palavras foram copiadas. Pressione ⌘V e permita a Acessibilidade para ele colar sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí не смог вставить: слова скопированы. Нажмите ⌘V и разрешите Универсальный доступ, чтобы он вставлял сам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí วางข้อความไม่ได้ คัดลอกข้อความแล้ว กด ⌘V และอนุญาตการช่วยการเข้าถึงเพื่อให้วางข้อความได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí yapıştıramadı: sözlerin kopyalandı. ⌘V tuşlarına bas ve Koncluí'nun senin için yapıştırabilmesi için Erişilebilirlik izni ver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 无法粘贴：你的话已拷贝。按 ⌘V，并允许“辅助功能”，让它自动粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 無法貼上：文字已複製。請按 ⌘V，並允許輔助使用，讓 Koncluí 自動貼上。"
          }
        }
      }
    },
