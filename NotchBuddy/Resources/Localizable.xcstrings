    "Stop reminder" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung stoppen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detener recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêter le rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर रोकें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hentikan pengingat" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановить напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หยุดการเตือนความจำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatıcıyı durdur" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停止提醒" } } } },
    "Vertical position from top" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الموضع الرأسي من الأعلى" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "উপর থেকে উল্লম্ব অবস্থান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Vertikale Position von oben" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Vertical position from top" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Posición vertical desde arriba" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Position verticale depuis le haut" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऊपर से ऊर्ध्वाधर स्थिति" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Posisi vertikal dari atas" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Posição vertical a partir do topo" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Положение по вертикали от верха" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตำแหน่งแนวตั้งจากด้านบน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Üstten dikey konum" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "距顶部的垂直位置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從頂端起算的垂直位置" } } } },
    "That image could not be decoded. Choose a valid PNG or JPEG." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّرت قراءة هذه الصورة. اختر ملف PNG أو JPEG صالحًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ছবিটি পড়া যায়নি। একটি বৈধ PNG বা JPEG বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Bild konnte nicht gelesen werden. Wähle ein gültiges PNG oder JPEG." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "That image could not be decoded. Choose a valid PNG or JPEG." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo leer esa imagen. Elige un PNG o JPEG válido." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette image n'a pas pu être lue. Choisis un PNG ou un JPEG valide." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "वह छवि पढ़ी नहीं जा सकी। मान्य PNG या JPEG चुनें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gambar itu tidak dapat dibaca. Pilih PNG atau JPEG yang valid." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível abrir essa imagem. Escolha um PNG ou JPEG válido." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось прочитать это изображение. Выберите корректный PNG или JPEG." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อ่านรูปภาพนี้ไม่ได้ เลือกไฟล์ PNG หรือ JPEG ที่ใช้ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu görsel okunamadı. Geçerli bir PNG veya JPEG seç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取该图片。请选择有效的 PNG 或 JPEG。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法解碼此圖片。請選擇有效的 PNG 或 JPEG。" } } } },
