    "hub.hint %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على %@ في أي تطبيق، تحدّث، ثم اترك: يظهر النص حيث تكتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো অ্যাপে %@ চেপে ধরুন, বলুন, ছেড়ে দিন: যেখানে টাইপ করছেন সেখানেই লেখা আসবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ in einer beliebigen App gedrückt, sprich und lass los: Der Text erscheint dort, wo du tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ in any app, speak, let go: the text appears where you type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén %@ en cualquier app, habla y suelta: el texto aparece donde escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens %@ dans n'importe quelle app, parle, relâche : le texte apparaît là où tu écris."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप में %@ दबाए रखें, बोलें, छोड़ें: टेक्स्ट वहीं आ जाता है जहाँ आप टाइप करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan %@ di app mana pun, bicara, lepas: teks muncul di tempat kamu mengetik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでも %@ を押したまま話して離すと、貼り付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디서든 %@ 키를 꾹 누르고 말한 다음 떼면, 짠! 붙여넣어져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure %@ em qualquer app, fale e solte: o texto aparece onde você digita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %@ в любом приложении, говорите, отпустите: текст появится там, где вы печатаете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ค้างไว้ในแอปใดก็ได้ พูด แล้วปล่อย ข้อความจะปรากฏตรงที่คุณพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir uygulamada %@ tuşunu basılı tut, konuş, bırak: metin yazdığın yerde belirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按住 %@，说话，松开：文字会出现在你输入的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按住 %@ 說話，放開後文字會出現在你輸入的位置。"
          }
        }
      }
    },
