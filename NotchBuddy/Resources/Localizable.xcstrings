    "notes.setup" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب Koncluí مكالماتك على جهاز Mac باستخدام Parakeet، ويميّز الأصوات بنموذج صغير ثانٍ. يُنزَّل الاثنان مرة واحدة (نحو 650 ميغابايت)، ثم يعمل كل شيء بلا إنترنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí Parakeet দিয়ে আপনার Mac-এই কল লিখে ফেলে, আর দ্বিতীয় একটি ছোট মডেল দিয়ে কণ্ঠ আলাদা করে। দুটোই একবার ডাউনলোড হয় (প্রায় ৬৫০ MB), তারপর সব অফলাইনে চলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí transkribiert deine Gespräche auf deinem Mac mit Parakeet und unterscheidet die Stimmen mit einem zweiten kleinen Modell. Beide werden einmal heruntergeladen (etwa 650 MB), danach läuft alles offline."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí writes your calls on your Mac with Parakeet, and tells the voices apart with a second small model. Both are downloaded once (about 650 MB), then everything works offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí transcribe tus llamadas en tu Mac con Parakeet y distingue las voces con un segundo modelo pequeño. Ambos se descargan una vez (unos 650 MB) y luego todo funciona sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí écrit tes calls sur ton Mac avec Parakeet, et reconnaît les voix avec un second petit modèle. Les deux se téléchargent une fois (environ 650 Mo), puis tout marche hors ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí आपकी कॉल Parakeet से आपके Mac पर ही लिखता है, और एक दूसरे छोटे मॉडल से आवाज़ें पहचानता है। दोनों एक बार डाउनलोड होते हैं (लगभग 650 MB), फिर सब ऑफ़लाइन चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí menulis panggilanmu di Mac dengan Parakeet, dan membedakan suara dengan model kecil kedua. Keduanya diunduh sekali (sekitar 650 MB), lalu semuanya bekerja luring."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí は Mac 上で Parakeet を使って通話を書き起こし、2 つ目の小さなモデルで声を聞き分けます。どちらも 1 回だけダウンロード（約 650 MB）すれば、すべてオフラインで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí는 Parakeet으로 Mac에서 통화를 받아 적고, 작은 모델 하나로 목소리를 구분해요. 두 모델을 한 번만 받으면(약 650MB) 그다음부턴 전부 오프라인으로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí transcreve suas chamadas no seu Mac com o Parakeet e distingue as vozes com um segundo modelo pequeno. Os dois são baixados uma vez (cerca de 650 MB) e depois tudo funciona offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí записывает звонки текстом прямо на Mac с помощью Parakeet и различает голоса второй небольшой моделью. Обе скачиваются один раз (около 650 МБ), дальше всё работает без сети."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí บันทึกการโทรบน Mac ด้วย Parakeet และแยกเสียงผู้พูดด้วยโมเดลขนาดเล็กอีกตัว ดาวน์โหลดทั้งสองโมเดลครั้งเดียวประมาณ 650 MB จากนั้นใช้งานออฟไลน์ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí görüşmelerini Mac'inde Parakeet ile yazıya döker ve ikinci küçük bir modelle sesleri ayırt eder. İkisi de bir kez indirilir (yaklaşık 650 MB), sonra her şey çevrimdışı çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 用 Parakeet 在你的 Mac 上转写通话，并用第二个小模型区分说话人。两者只需下载一次（约 650 MB），之后一切离线运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 會使用 Parakeet 在 Mac 上轉錄通話，並透過另一個小型模型區分說話者。兩個模型僅需下載一次（約 650 MB），之後即可完全離線運作。"
          }
        }
      }
    },
