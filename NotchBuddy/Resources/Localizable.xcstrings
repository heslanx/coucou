    "hub.setup %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على %@ في أي تطبيق، تحدّث، ثم اترك: تُلصق كلماتك حيث تكتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো অ্যাপে %@ চেপে ধরুন, বলুন, ছেড়ে দিন: আপনি যেখানে লেখেন সেখানে কথা পেস্ট হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte in einer beliebigen App %@ gedrückt, sprich und lasse los: Deine Worte werden dort eingefügt, wo du schreibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ in any app, speak, let go: your words are pasted where you type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén %@ en cualquier app, habla y suelta: tus palabras se pegan donde escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens %@ dans n'importe quelle app, parle, relâche : tes mots sont collés là où tu écris."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी ऐप में %@ दबाए रखें, बोलें, छोड़ दें: आपके शब्द वहीं चिपकते हैं जहाँ आप टाइप करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan %@ di aplikasi apa pun, bicara, lepas: kata-katamu ditempel di tempat kamu mengetik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリでも %@ を押したまま話して離すと、入力中の場所に言葉が貼り付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 앱에서나 %@ 키를 꾹 누르고 말한 다음 떼면, 입력하던 곳에 짠! 하고 들어가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure %@ em qualquer app, fale e solte: suas palavras são coladas onde você digita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %@ в любом приложении, говорите, отпустите: слова вставятся туда, где вы печатаете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ค้างไว้ในแอปใดก็ได้ พูดแล้วปล่อย ข้อความจะถูกวางตรงที่คุณพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir uygulamada %@ tuşunu basılı tut, konuş, bırak: sözlerin yazdığın yere yapıştırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按住 %@，说话，松开：你的话会粘贴到你正在输入的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何 App 中按住 %@ 說話，放開後文字便會貼到你輸入的位置。"
          }
        }
      }
    },
