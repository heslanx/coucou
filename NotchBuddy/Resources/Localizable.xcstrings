    "konclui.reminders.alert.in %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بعد %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ পরে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "in %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "in %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "en %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "dans %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ में" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "dalam %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@後" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 후" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "em %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "через %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อีก %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ sonra" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@后" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@後" } } } },
    "konclui.reminders.alert.now" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الآن" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "jetzt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "now" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "ahora" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "maintenant" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "sekarang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "今" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "agora" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "сейчас" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตอนนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "şimdi" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "現在" } } } },
    "konclui.reminders.preview.stopped" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوقف: لن يتكرر." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ: আর হবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gestoppt: keine weiteren Termine." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped: no more turns." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detenido: no volverá a sonar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêté : plus de rappels." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रुका: अब नहीं दोहराएगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dihentikan: tidak berulang lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止しました：これ以上通知されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지됨: 더 이상 반복되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parado: não toca mais." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановлено: больше не повторится." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หยุดแล้ว จะไม่เตือนซ้ำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Durduruldu: bir daha çalmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止：不再重复。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已停止：不再重複。" } } } },
    "konclui.reminders.preview.finished" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم: لن يظهر مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সম্পন্ন: আর বাজবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erledigt: Sie meldet sich nicht mehr." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Done: it won’t ring again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Listo: no volverá a sonar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Terminé : il ne sonnera plus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हो गया: अब नहीं बजेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selesai: tidak akan berbunyi lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "完了しました：もう鳴りません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료: 다시 울리지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pronto: não toca de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Готово: больше не сработает." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เสร็จแล้ว จะไม่เตือนอีก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tamam: bir daha çalmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成：不会再响。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "完成：不會再響。" } } } },
    "konclui.reminders.preview.back %lld" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعود بعد %lld د" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%lld মিনিট পরে ফিরবে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurück in %lld Min." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Back in %lld min" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Vuelve en %lld min" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Revient dans %lld min" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%lld मिनट में लौटेगा" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kembali dalam %lld menit" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld分後に再通知" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld분 후 다시 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Volta em %lld min" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вернётся через %lld мин" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กลับมาในอีก %lld นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%lld dk sonra geri gelir" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分钟后再次提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分鐘後再次提醒" } } } },
    "Snooze · %lld min" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأجيل · %lld د" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "স্থগিত · %lld মিনিট" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Später · %lld Min." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snooze · %lld min" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Posponer · %lld min" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reporter · %lld min" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "टालें · %lld मिनट" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tunda · %lld mnt" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スヌーズ · %lld分" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 알림 · %lld분" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adiar · %lld min" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отложить · %lld мин" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลื่อน · %lld นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ertele · %lld dk" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推迟 · %lld 分钟" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "延後 · %lld 分鐘" } } } },
    "konclui.reminders.preview.label" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "معاينة التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডারের প্রিভিউ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorschau der Erinnerung" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminder preview" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Vista previa del recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aperçu du rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर का प्रीव्यू" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pratinjau pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーのプレビュー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림 미리 보기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Prévia do lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Предпросмотр напоминания" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตัวอย่างการเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı önizlemesi" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒预览" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒預覽" } } } },
    "konclui.reminders.preview.then %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بعدها: %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এরপর: %@" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Danach: %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Then: %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Después: %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ensuite : %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फिर: %@" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berikutnya: %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "次回：%@" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음: %@" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Depois: %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Затем: %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ครั้งถัดไป: %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonra: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下次：%@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下次：%@" } } } },
    "konclui.reminders.preview.closed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عندما يكون Koncluí مغلقًا يصل كإشعار من macOS." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí বন্ধ থাকলে এটি macOS নোটিফিকেশন হিসেবে আসে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ist Koncluí geschlossen, kommt sie als macOS-Mitteilung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "With Koncluí closed, it arrives as a macOS notification." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Con Koncluí cerrado, llega como notificación de macOS." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí fermé, il arrive en notification macOS." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí बंद होने पर यह macOS सूचना के रूप में आता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saat Koncluí ditutup, muncul sebagai notifikasi macOS." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí を終了している間は、macOS の通知として届きます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 닫혀 있으면 macOS 알림으로 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Com o Koncluí fechado, chega como notificação do macOS." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Когда Koncluí закрыт, приходит как уведомление macOS." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เมื่อปิด Koncluí จะมาเป็นการแจ้งเตือนของ macOS" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí kapalıyken macOS bildirimi olarak gelir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 关闭时，会以 macOS 通知的形式送达。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 關閉時，會以 macOS 通知的形式送達。" } } } },
    "konclui.reminders.preview.drag" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسحب البطاقة لتغيير مكان ظهورها." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কোথায় দেখাবে বদলাতে কার্ডটি টেনে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ziehe die Karte, um ihren Platz zu ändern." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the card to change where it appears." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Arrastra la tarjeta para cambiar dónde aparece." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Faites glisser la carte pour changer sa place." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जगह बदलने के लिए कार्ड को खींचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Seret kartu untuk mengubah posisinya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カードをドラッグして表示位置を変更します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "카드를 드래그해 표시 위치를 바꾸세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Arraste o cartão para mudar onde ele aparece." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Перетащите карточку, чтобы изменить место." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลากการ์ดเพื่อเปลี่ยนตำแหน่งที่แสดง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nerede görüneceğini değiştirmek için kartı sürükleyin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖动卡片可更改显示位置。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "拖移卡片可更改顯示位置。" } } } },
    "konclui.reminders.issue.image-read" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذر فتح هذه الصورة. اختر PNG أو JPEG." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ছবিটি খোলা গেল না। একটি PNG বা JPEG বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Bild ließ sich nicht öffnen. Wähle ein PNG oder JPEG." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "That image couldn’t be opened. Choose a PNG or JPEG." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo abrir esa imagen. Elige un PNG o JPEG." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible d’ouvrir cette image. Choisissez un PNG ou un JPEG." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह इमेज नहीं खुली। PNG या JPEG चुनें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gambar itu tidak bisa dibuka. Pilih PNG atau JPEG." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像を開けませんでした。PNG または JPEG を選んでください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미지를 열 수 없어요. PNG 또는 JPEG를 선택하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não deu para abrir essa imagem. Escolha um PNG ou JPEG." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось открыть изображение. Выберите PNG или JPEG." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดรูปภาพนี้ไม่ได้ เลือกไฟล์ PNG หรือ JPEG" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu görüntü açılamadı. PNG ya da JPEG seçin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开这张图片。请选择 PNG 或 JPEG。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法打開這張圖片。請選擇 PNG 或 JPEG。" } } } },
    "konclui.reminders.issue.image-size" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر صورة لا يزيد حجمها عن 2 ميغابايت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "২ MB পর্যন্ত একটি ছবি বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle ein Bild bis 2 MB." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose an image of up to 2 MB." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige una imagen de hasta 2 MB." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez une image de 2 Mo maximum." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "2 MB तक की इमेज चुनें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih gambar maksimal 2 MB." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "2 MB 以下の画像を選んでください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "2MB 이하의 이미지를 선택하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha uma imagem de até 2 MB." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите изображение до 2 МБ." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลือกรูปภาพขนาดไม่เกิน 2 MB" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "En fazla 2 MB’lık bir görüntü seçin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择不超过 2 MB 的图片。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請選擇不超過 2 MB 的圖片。" } } } },
    "konclui.reminders.issue.button" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعطِ كل زر اسمًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রতিটি বোতামের নাম দিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib jeder Taste einen Namen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Give every button a name." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ponle nombre a cada botón." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Donnez un nom à chaque bouton." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हर बटन को नाम दें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Beri nama setiap tombol." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべてのボタンに名前を付けてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 버튼에 이름을 지정하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Dê um nome a cada botão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Дайте название каждой кнопке." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตั้งชื่อให้ทุกปุ่ม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her düğmeye bir ad verin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请为每个按钮命名。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請為每個按鈕命名。" } } } },
    "konclui.reminders.issue.link" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يبدأ الرابط بـ https://." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "লিংকটি https:// দিয়ে শুরু হতে হবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Link muss mit https:// beginnen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The link must start with https://." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El enlace debe empezar por https://." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le lien doit commencer par https://." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "लिंक https:// से शुरू होना चाहिए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tautan harus diawali https://." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リンクは https:// で始まる必要があります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "링크는 https://로 시작해야 해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O link precisa começar com https://." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ссылка должна начинаться с https://." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลิงก์ต้องขึ้นต้นด้วย https://" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlantı https:// ile başlamalı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "链接必须以 https:// 开头。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連結必須以 https:// 開頭。" } } } },
    "konclui.reminders.issue.past" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا الوقت مضى. اختر وقتًا آخر." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সময়টি পেরিয়ে গেছে। অন্য সময় বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Zeit ist vorbei. Wähle eine andere." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "That time has passed. Pick another one." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esa hora ya pasó. Elige otra." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette heure est passée. Choisissez-en une autre." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह समय निकल चुका है। कोई और समय चुनें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Waktu itu sudah lewat. Pilih waktu lain." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "その時刻は過ぎています。別の時刻を選んでください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 지난 시간이에요. 다른 시간을 선택하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esse horário já passou. Escolha outro." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это время уже прошло. Выберите другое." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เวลานั้นผ่านไปแล้ว เลือกเวลาอื่น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu saat geçti. Başka bir saat seçin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个时间已经过了，请另选一个。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這個時間已經過了，請另選一個。" } } } },
    "konclui.reminders.issue.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعطِ التذكير اسمًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডারটির একটি নাম দিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib der Erinnerung einen Namen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Give the reminder a name." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ponle un nombre al recordatorio." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Donnez un nom au rappel." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर को एक नाम दें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Beri nama pengingat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーに名前を付けてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림 이름을 지정하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Dê um nome ao lembrete." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Дайте напоминанию название." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตั้งชื่อการเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcıya bir ad verin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "给提醒起个名字。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為提醒取個名稱。" } } } },
    "konclui.reminders.draft.discard" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "البدء من جديد" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আবার শুরু করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Neu beginnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Start over" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Empezar de cero" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Recommencer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फिर से शुरू करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mulai dari awal" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初からやり直す" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음부터 다시 시작" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Começar do zero" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Начать заново" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เริ่มใหม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Baştan başla" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新开始" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新開始" } } } },
    "konclui.reminders.draft.restored" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تمت استعادة المسودة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "খসড়া ফিরিয়ে আনা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Entwurf wiederhergestellt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Draft restored." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Borrador restaurado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Brouillon restauré." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ड्राफ़्ट वापस आ गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Draf dipulihkan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "下書きを復元しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "임시 저장한 내용을 복원했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Rascunho restaurado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Черновик восстановлен." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กู้คืนฉบับร่างแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Taslak geri yüklendi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已恢复草稿。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已還原草稿。" } } } },
    "konclui.reminders.active.help" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عند الإيقاف يبقى التذكير هنا لكنه لا يظهر." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ থাকলে রিমাইন্ডারটি এখানে থাকে কিন্তু বাজে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus: Die Erinnerung bleibt hier, meldet sich aber nicht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Off, the reminder stays here but doesn’t ring." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivado, el recordatorio se queda aquí pero no suena." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé, le rappel reste ici mais ne sonne pas." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद होने पर रिमाइंडर यहीं रहता है, पर बजता नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jika mati, pengingat tetap di sini tetapi tidak berbunyi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにすると、リマインダーはここに残りますが通知されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끄면 미리 알림은 여기에 남지만 울리지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desligado, o lembrete fica aqui mas não toca." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Если выключить, напоминание останется здесь, но не сработает." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เมื่อปิด การเตือนยังอยู่ที่นี่แต่จะไม่เตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalıyken anımsatıcı burada kalır ama çalmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭后，提醒仍保留在这里，但不会响起。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉後，提醒仍保留在這裡，但不會響起。" } } } },
    "konclui.reminders.delete" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "মুছুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Löschen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "삭제" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apagar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sil" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除" } } } },
    "konclui.reminders.save" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حفظ" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সংরক্ষণ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Sichern" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Save" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Guardar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistrer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सहेजें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Simpan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Salvar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaydet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存" } } } },
    "konclui.reminders.create" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إنشاء التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার তৈরি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung anlegen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Create reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crear recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Créer le rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर बनाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buat pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを作成" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림 만들기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Criar lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создать напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สร้างการเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı oluştur" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立提醒" } } } },
    "konclui.reminders.test.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعرضه الآن كما سيظهر. أزراره تغلق التجربة فقط." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখনই দেখায়, যেমন দেখা যাবে। এর বোতামগুলো শুধু পরীক্ষাটি বন্ধ করে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt sie jetzt so, wie sie erscheint. Ihre Tasten schließen nur den Test." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows it now, as it will appear. Its buttons only close the test." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Lo muestra ahora, tal como aparecerá. Sus botones solo cierran la prueba." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’affiche maintenant, tel qu’il apparaîtra. Ses boutons ferment seulement le test." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी वैसा ही दिखाता है जैसा दिखेगा। इसके बटन सिर्फ़ टेस्ट बंद करते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan sekarang seperti nanti muncul. Tombolnya hanya menutup uji coba." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実際の表示と同じ内容を今すぐ表示します。テスト中にボタンを押しても、テストが閉じるだけです。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실제 표시 모습으로 지금 보여 줘요. 테스트에서는 버튼을 눌러도 테스트만 닫혀요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra agora, como vai aparecer. Os botões só fecham o teste." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Покажет сейчас, как оно будет выглядеть. Кнопки просто закроют проверку." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงตอนนี้ตามที่จะปรากฏจริง ปุ่มต่างๆ แค่ปิดการทดสอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şimdi, görüneceği gibi gösterir. Düğmeleri yalnızca denemeyi kapatır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即按实际效果显示。其中的按钮只会关闭测试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "立即按實際效果顯示。其中的按鈕只會關閉測試。" } } } },
    "konclui.reminders.test" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تجربة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরীক্ষা" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Testen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Test" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Probar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tester" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आज़माएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テスト" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "테스트" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Testar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ทดสอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dene" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "测试" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "測試" } } } },
