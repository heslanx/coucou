    "update.ask.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Koru من إصدارات Koncluí على GitHub بضع مرات يوميًا ويخبرك عند صدور إصدار جديد. لا يُرسَل أي شيء عنك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru দিনে কয়েকবার GitHub-এ Koncluí-র রিলিজ দেখে এবং নতুন এলে জানায়। আপনার সম্পর্কে কিছুই পাঠানো হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru schaut ein paar Mal am Tag nach den Releases von Koncluí auf GitHub und sagt dir, wenn eine neue da ist. Über dich wird nichts gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru checks Koncluí’s releases on GitHub a few times a day and tells you when one is out. Nothing about you is sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru revisa las versiones de Koncluí en GitHub unas veces al día y te avisa cuando sale una. No se envía nada sobre ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru regarde les versions de Koncluí sur GitHub quelques fois par jour et te prévient quand il y en a une. Rien sur toi n’est envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru दिन में कुछ बार GitHub पर Koncluí के रिलीज़ देखता है और नया आने पर बताता है। आपके बारे में कुछ नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru memeriksa rilis Koncluí di GitHub beberapa kali sehari dan memberi tahu saat ada yang baru. Tidak ada data tentangmu yang dikirim."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru は GitHub で Koncluí のリリースを 1 日に数回確認し、新しいバージョンが出たらお知らせします。あなたに関する情報は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코루가 하루에 몇 번 GitHub에서 Koncluí 새 버전을 확인하고, 나오면 바로 알려 줘요. 사용자 정보는 하나도 안 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Koru verifica as versões do Koncluí no GitHub algumas vezes por dia e avisa quando sai uma. Nada sobre você é enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru несколько раз в день проверяет релизы Koncluí на GitHub и сообщает о новых. О вас ничего не отправляется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru จะดูรีลีสของ Koncluí บน GitHub วันละไม่กี่ครั้ง และบอกคุณเมื่อมีเวอร์ชันใหม่ ไม่มีการส่งข้อมูลใดเกี่ยวกับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru, Koncluí'nun GitHub'daki sürümlerine günde birkaç kez bakar ve yenisi çıkınca sana söyler. Seninle ilgili hiçbir şey gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru 每天会在 GitHub 上查看几次 Koncluí 的版本，有新版本时告诉你。不会发送任何关于你的信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koru 每天會在 GitHub 上查看幾次 Koncluí 的版本，有新版本時會通知你。不會傳送任何關於你的資訊。"
          }
        }
      }
    },
