    "mail.chat.toggle-help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح للذكاء الاصطناعي رؤية أحدث رسائلك وتحضير إجراءات عليها. لا يحدث شيء قبل نقرك على تشغيل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-কে আপনার সাম্প্রতিক মেল দেখতে ও কাজ প্রস্তুত করতে দেয়। চালান-এ ক্লিক না করা পর্যন্ত কিছুই হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt die KI deine neuesten E-Mails sehen und Aktionen dafür vorbereiten. Nichts passiert, bevor du auf Ausführen klickst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets the AI see your latest messages and prepare actions on them. Nothing happens until you click Run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la IA vea tus últimos correos y prepare acciones. No pasa nada hasta que pulses Ejecutar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse l’IA voir tes derniers mails et préparer des actions dessus. Rien ne se passe avant ton clic sur Lancer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI को आपके नए मेल देखने और उन पर कार्रवाइयाँ तैयार करने देता है। चलाएँ पर क्लिक करने तक कुछ नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI bisa melihat email terbarumu dan menyiapkan tindakan. Tidak ada yang terjadi sebelum kamu klik Jalankan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI が最新のメールを見て、操作を準備できるようにします。「実行」をクリックするまで何も起きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 최근 메일을 보고 작업을 준비할 수 있게 합니다. 실행을 누르기 전에는 아무 일도 일어나지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa a IA ver seus últimos e-mails e preparar ações. Nada acontece até você clicar em Executar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ видит ваши последние письма и готовит действия. Ничего не происходит, пока вы не нажмёте «Запустить»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ AI เห็นอีเมลล่าสุดของคุณและเตรียมการกระทำ จะไม่มีอะไรเกิดขึ้นจนกว่าคุณจะคลิก เรียกใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekânın son e-postalarını görmesini ve işlemler hazırlamasını sağlar. Çalıştır’a tıklayana kadar hiçbir şey olmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 AI 查看你最近的邮件并准备操作。点击“执行”之前不会发生任何事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 AI 查看你最近的郵件並準備動作。按下「執行」之前不會發生任何事。"
          }
