    "hub.settings.dock-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Koncluí كأي تطبيق؛ والنقر على أيقونته يعيد هذه النافذة. عند الإيقاف يبقى Koncluí في شريط القوائم فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো অ্যাপের মতো Koncluí খুলুন; এর আইকনে ক্লিক করলে এই উইন্ডো ফিরে আসে। বন্ধ থাকলে Koncluí শুধু মেনু বারে থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Koncluí wie jede andere App; ein Klick auf das Symbol bringt dieses Fenster zurück. Ist die Option aus, bleibt Koncluí nur in der Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Koncluí like any app; a click on its icon brings this window back. Off, Koncluí lives in the menu bar only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Koncluí como cualquier app; un clic en su icono trae esta ventana. Desactivado, Koncluí solo está en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Koncluí comme n'importe quelle app ; un clic sur son icône ramène cette fenêtre. Désactivé, Koncluí vit seulement dans la barre des menus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí को किसी भी ऐप की तरह खोलें; इसके आइकन पर क्लिक करने से यह विंडो वापस आती है। बंद होने पर Koncluí सिर्फ़ मेनू बार में रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Koncluí seperti aplikasi lain; klik ikonnya untuk memunculkan jendela ini. Jika mati, Koncluí hanya ada di bar menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通のアプリのように Koncluí を開きます。アイコンをクリックするとこのウインドウが戻ります。オフの場合、Koncluí はメニューバーにだけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱처럼 Koncluí를 열고, 아이콘을 누르면 이 창이 다시 나타나요. 끄면 Koncluí는 메뉴 막대에서만 지내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Koncluí como qualquer app; um clique no ícone traz esta janela de volta. Desligado, o Koncluí fica só na barra de menus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте Koncluí как обычное приложение; щелчок по значку возвращает это окно. Если выключено, Koncluí живёт только в строке меню."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด Koncluí เหมือนแอปทั่วไป คลิกไอคอนเพื่อเรียกหน้าต่างนี้กลับมา เมื่อปิด Koncluí จะแสดงเฉพาะในแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí'yu herhangi bir uygulama gibi aç; simgesine tıklamak bu pencereyi geri getirir. Kapalıyken Koncluí yalnızca menü çubuğunda bulunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像其他 App 一样打开 Koncluí；点按其图标即可回到此窗口。关闭后，Koncluí 只在菜单栏中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像其他 App 一樣開啟 Koncluí；按一下圖示即可返回此視窗。關閉時，Koncluí 只會顯示在選單列。"
          }
        }
      }
    },
