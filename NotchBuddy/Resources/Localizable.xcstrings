    "konclui.reminders.position.topLeading" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أعلى اليسار" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "উপরে বাঁয়ে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Oben links" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Top left" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Arriba a la izquierda" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "En haut à gauche" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऊपर बाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kiri atas" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "左上" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "왼쪽 위" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "No alto, à esquerda" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вверху слева" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บนซ้าย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sol üst" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "左上" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "左上" } } } },
