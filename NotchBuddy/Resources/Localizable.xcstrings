    "hub.style.natural-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا «أممم» ولا تكرار، مع الحفاظ على أسلوبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“উম” আর পুনরাবৃত্তি ছাড়া, আপনার সুর বজায় রেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne „äh“ und Wiederholungen, dein Ton bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without the “um” and the repeats, your tone kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin los «eh» ni repeticiones, con tu tono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans les « euh » ni les répétitions, ton ton gardé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना “अं” और दोहराव के, आपका लहजा बना रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa “eh” dan pengulangan, nadamu tetap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「えー」や繰り返しを除き、あなたの口調はそのまま。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“어… 음…”과 반복만 빼고, 말투는 그대로 둬요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem os “é…” e as repetições, com o seu tom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без «э-э» и повторов, ваш тон сохранён."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดคำอ้ำอึ้งและคำซ้ำ โดยคงน้ำเสียงของคุณไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ıı” gibi dolgu sesleri ve tekrarlar çıkarılır, üslubun korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去掉“嗯”和重复，保留你的语气。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除「嗯」與重複內容，保留你的語氣。"
          }
        }
      }
    },
