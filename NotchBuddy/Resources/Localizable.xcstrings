    "hub.words-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا كلمات بعد. أضف الأسماء والعلامات والمصطلحات التي يخطئ Koncluí في كتابتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো শব্দ নেই। যে নাম, ব্র্যান্ড আর পরিভাষা Koncluí ভুল লেখে সেগুলো যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Wörter. Füge Namen, Marken und Fachbegriffe hinzu, die Koncluí falsch schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No word yet. Add the names, brands and jargon Koncluí gets wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay palabras. Añade los nombres, marcas y tecnicismos que Koncluí escribe mal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mot pour l'instant. Ajoute les noms, marques et mots techniques que Koncluí écrit mal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई शब्द नहीं। वे नाम, ब्रांड और तकनीकी शब्द जोड़ें जिन्हें Koncluí गलत लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada kata. Tambahkan nama, merek, dan istilah yang sering salah ditulis Koncluí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単語はまだありません。Koncluí が間違える名前、ブランド、専門用語を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 단어가 없어요. Koncluí가 자꾸 틀리는 이름, 브랜드, 전문 용어를 알려 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma palavra ainda. Adicione nomes, marcas e termos técnicos que o Koncluí escreve errado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слов пока нет. Добавьте имена, бренды и термины, которые Koncluí пишет неправильно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีคำ เพิ่มชื่อ แบรนด์ และศัพท์เฉพาะที่ Koncluí มักฟังผิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz sözcük yok. Koncluí'nun yanlış yazdığı adları, markaları ve terimleri ekle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
