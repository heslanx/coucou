    "hub.mail.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُسمح لـ Koncluí بالتحكم في Mail. اسمح بذلك من الخصوصية والأمن ← الأتمتة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí-কে Mail নিয়ন্ত্রণের অনুমতি দেওয়া নেই। Privacy & Security → Automation-এ অনুমতি দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí darf Mail nicht steuern. Erlaube es unter Datenschutz & Sicherheit → Automation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí is not allowed to control Mail. Allow it in Privacy & Security → Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí no tiene permiso para controlar Mail. Permítelo en Privacidad y seguridad → Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí n’a pas le droit de piloter Mail. Autorise-le dans Confidentialité et sécurité → Automatisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí को Mail नियंत्रित करने की अनुमति नहीं है। Privacy & Security → Automation में अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí tidak diizinkan mengontrol Mail. Izinkan di Privasi & Keamanan → Otomatisasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí に Mail の操作が許可されていません。「プライバシーとセキュリティ」→「オートメーション」で許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí에 Mail 제어 권한이 없습니다. 개인정보 보호 및 보안 → 자동화에서 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí não tem permissão para controlar o Mail. Permita em Privacidade e Segurança → Automação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí не может управлять Mail. Разрешите это в «Конфиденциальность и безопасность» → «Автоматизация»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ไม่ได้รับอนุญาตให้ควบคุม Mail อนุญาตได้ที่ ความเป็นส่วนตัวและความปลอดภัย → การทำงานอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí’nun Mail’i kontrol etme izni yok. Gizlilik ve Güvenlik → Otomasyon’dan izin ver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 无权控制“邮件”。请在“隐私与安全性”→“自动化”中允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 無權控制「郵件」。請在「隱私權與安全性」→「自動化」中允許。"
          }
        }
      }
    },
