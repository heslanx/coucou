    "whatsapp.install.bad-checksum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنزيل لا يطابق الملف المنشور للبوابة: حُذف ولم يُثبَّت شيء. حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডাউনলোড গেটওয়ের প্রকাশিত ফাইলের সঙ্গে মেলে না: মুছে ফেলা হয়েছে, কিছু ইনস্টল হয়নি। আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download stimmt nicht mit der veröffentlichten Gateway-Datei überein: Er wurde gelöscht, nichts wurde installiert. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download doesn't match the file the gateway published: it was deleted and nothing was installed. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga no coincide con el archivo publicado de la pasarela: se eliminó y no se instaló nada. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléchargement ne correspond pas au fichier publié de la passerelle : il a été supprimé, rien n'a été installé. Réessaie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड गेटवे की प्रकाशित फ़ाइल से मेल नहीं खाता: हटा दिया गया, कुछ इंस्टॉल नहीं हुआ। फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan tidak cocok dengan file yang dipublikasikan gateway: sudah dihapus, tidak ada yang dipasang. Coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたファイルが GOWA の公開ファイルと一致しません。削除され、何もインストールされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앗, 다운로드한 파일이 GOWA가 공개한 파일과 달라요. 지워 버렸고, 아무것도 설치하지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O download não corresponde ao arquivo que o gateway publicou: foi apagado e nada foi instalado. Tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка не совпадает с опубликованным файлом шлюза: она удалена, ничего не установлено. Попробуйте ещё раз."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
