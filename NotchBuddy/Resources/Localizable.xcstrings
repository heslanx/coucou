    "hooks.outdated" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطافات قديمة. حدِّثها للإجابة على أسئلة Claude من الشريط العلوي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হুক পুরনো। নচ থেকে Claude-এর প্রশ্নের উত্তর দিতে আপডেট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks veraltet. Aktualisiere sie, um Claudes Fragen aus der Notch zu beantworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks outdated. Update them to answer Claude's questions from the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks desactualizados. Actualízalos para responder las preguntas de Claude desde el notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks obsolètes. Mets-les à jour pour répondre aux questions de Claude depuis l'encoche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हुक पुराने हैं। नॉच से Claude के सवालों का जवाब देने के लिए अपडेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks usang. Perbarui untuk menjawab pertanyaan Claude dari notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フックが古くなっています — ノッチから Claude の質問に答えるにはアップデートしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훅이 낡았어요 — 노치에서 Claude 질문에 답하려면 업데이트해 주세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks desatualizados. Atualize-os para responder às perguntas do Claude pelo notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хуки устарели. Обнови их, чтобы отвечать на вопросы Claude из ноча."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks ล้าสมัย อัปเดตเพื่อให้ตอบคำถาม Claude จากแถบได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hook'lar güncel değil. Claude'un sorularını adadan yanıtlamak için güncelle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks 已过期。请更新以便从刘海处回答 Claude 的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooks 已過期，請更新以在動態島中回答 Claude 的問題"
          }
        }
      }
    },
