    "hub.mail.banned-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسالة التي يحتوي مرسلها أو موضوعها أو نصها على إحدى هذه الكلمات أو العناوين تذهب مباشرة إلى غير المرغوب. الكلمات الكاملة فقط: «sale» لا تلتقط «Salesforce»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে মেলের প্রেরক, বিষয় বা লেখায় এর কোনো শব্দ বা ঠিকানা থাকে, সেটি সরাসরি জাঙ্কে যায়। শুধু পুরো শব্দ: “sale” দিয়ে “Salesforce” ধরা পড়ে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine E-Mail, deren Absender, Betreff oder Text eines dieser Wörter oder Adressen enthält, landet direkt in Werbung. Nur ganze Wörter: „Sale“ trifft nicht „Salesforce“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A message whose sender, subject or text holds one of these words or addresses goes straight to Junk. Whole words only: “sale” does not catch “Salesforce”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un correo cuyo remitente, asunto o texto contenga una de estas palabras o direcciones va directo a no deseado. Solo palabras completas: «oferta» no atrapa «ofertas»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mail dont l’expéditeur, l’objet ou le texte contient un de ces mots ou adresses part direct en indésirables. Mots entiers seulement : « promo » n’attrape pas « promotion »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस मेल के प्रेषक, विषय या टेक्स्ट में इनमें से कोई शब्द या पता हो, वह सीधे जंक में जाता है। सिर्फ़ पूरे शब्द: “sale” से “Salesforce” नहीं पकड़ा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email yang pengirim, subjek, atau isinya memuat salah satu kata atau alamat ini langsung masuk Sampah. Hanya kata utuh: “sale” tidak menangkap “Salesforce”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "差出人・件名・本文にこれらの語句やアドレスを含むメールは、そのまま迷惑メールへ移動します。単語単位で判定するので「sale」は「Salesforce」に一致しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낸 사람, 제목, 본문에 이 단어나 주소가 있는 메일은 바로 정크로 갑니다. 단어 단위로만 찾으므로 ‘sale’은 ‘Salesforce’를 잡지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um e-mail cujo remetente, assunto ou texto tenha uma destas palavras ou endereços vai direto para o lixo. Só palavras inteiras: “promo” não pega “promoção”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письмо, где в отправителе, теме или тексте есть одно из этих слов или адресов, сразу уходит в спам. Только целые слова: «акция» не ловит «акционер»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีเมลที่ผู้ส่ง หัวเรื่อง หรือข้อความมีคำหรือที่อยู่เหล่านี้ จะถูกย้ายไปที่ขยะทันที จับเฉพาะคำเต็ม: “sale” จะไม่จับ “Salesforce”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Göndereni, konusu ya da metni bu kelimelerden veya adreslerden birini içeren e-posta doğrudan gereksize gider. Yalnızca tam kelimeler: “sale”, “Salesforce”u yakalamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发件人、主题或正文包含这些词或地址的邮件会直接移到垃圾邮件。只匹配完整单词：“sale”不会匹配“Salesforce”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寄件者、主旨或內文包含這些字詞或地址的郵件會直接移到垃圾郵件。只比對完整單字：「sale」不會比對到「Salesforce」。"
          }
        }
      }
    },
