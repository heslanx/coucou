    "update.settings.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث Koncluí عن إصدارات جديدة على GitHub بضع مرات يوميًا. لا يُثبَّت شيء دون نقرتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí দিনে কয়েকবার GitHub-এ নতুন সংস্করণ খোঁজে। আপনার ক্লিক ছাড়া কিছু ইনস্টল হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
