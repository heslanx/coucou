    "Change image…" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير الصورة…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ছবি বদলান…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bild ändern…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Change image…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cambiar imagen…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Changer d'image…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "छवि बदलें…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ganti gambar…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Trocar imagem…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Заменить изображение…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปลี่ยนรูปภาพ…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Görseli değiştir…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更换图片…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更換圖片…" } } } },
    "Remove image" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إزالة الصورة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ছবি সরান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bild entfernen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove image" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar imagen" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer l'image" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "छवि हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus gambar" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover imagem" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить изображение" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบรูปภาพ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Görseli kaldır" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除图片" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移除圖片" } } } },
