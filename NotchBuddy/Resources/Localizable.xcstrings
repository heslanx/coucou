    "hub.mail.overview-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفرز Koncluí صناديق Apple Mail لديك: كبار الشخصيات أولًا، ثم الكلمات المحظورة، ثم قواعدك. لا يحذف أي رسالة أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí আপনার Apple Mail ইনবক্স সাজায়: আগে VIP, তারপর নিষিদ্ধ শব্দ, তারপর আপনার নিয়ম। এটি কখনো কোনো মেল মুছে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí sortiert deine Apple-Mail-Postfächer: zuerst VIPs, dann verbotene Wörter, dann deine Regeln. Es löscht nie eine E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí sorts your Apple Mail inboxes: VIPs first, then banned words, then your rules. It never deletes a message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ordena tus buzones de Apple Mail: primero los VIP, luego las palabras prohibidas y después tus reglas. Nunca borra un correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí trie tes boîtes Apple Mail : les VIP d’abord, puis les mots bannis, puis tes règles. Il ne supprime jamais un mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí आपके Apple Mail इनबॉक्स छाँटता है: पहले VIP, फिर प्रतिबंधित शब्द, फिर आपके नियम। यह कभी कोई मेल नहीं हटाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí memilah kotak masuk Apple Mail-mu: VIP dulu, lalu kata terlarang, lalu aturanmu. Koncluí tidak pernah menghapus email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí は Apple Mail の受信箱を整理します。まず VIP、次に禁止ワード、最後にあなたのルール。メールを削除することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 Apple Mail 받은편지함을 정리합니다. VIP가 먼저, 다음은 금지어, 그다음은 내 규칙입니다. 메일을 삭제하지는 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí organiza suas caixas do Apple Mail: primeiro os VIPs, depois as palavras proibidas, depois suas regras. Ele nunca apaga um e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí сортирует ящики Apple Mail: сначала VIP, затем запрещённые слова, затем ваши правила. Он никогда не удаляет письма."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí คัดแยกกล่องจดหมาย Apple Mail ของคุณ: VIP ก่อน ตามด้วยคำต้องห้าม แล้วจึงเป็นกฎของคุณ และจะไม่ลบอีเมลใด ๆ เลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí, Apple Mail gelen kutularını düzenler: önce VIP’ler, sonra yasaklı kelimeler, sonra kuralların. Hiçbir e-postayı silmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 会整理你的 Apple Mail 收件箱：先看 VIP，再看屏蔽词，最后是你的规则。它从不删除邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 會整理你的 Apple Mail 收件匣：先看 VIP，再看封鎖字詞，最後是你的規則。它從不刪除郵件。"
          }
        }
      }
    },
