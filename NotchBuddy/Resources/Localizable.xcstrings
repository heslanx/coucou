    "notes.legal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى كل شيء على جهاز Mac. أخبر من في المكالمة أنك تسجّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবকিছু আপনার Mac-এ থাকে। কলের লোকদের জানান যে আপনি রেকর্ড করছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf deinem Mac. Informiere die Gesprächsteilnehmer über die Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays on your Mac. Tell the people in the call that you are recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se queda en tu Mac. Avisa a las personas de la llamada de que grabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur ton Mac. Préviens les gens du call que tu enregistres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ आपके Mac पर रहता है। कॉल में लोगों को बताएँ कि आप रिकॉर्ड कर रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semuanya tetap di Mac-mu. Beri tahu orang di panggilan bahwa kamu merekam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべて Mac に残ります。通話の参加者に録音していることを伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 내용은 Mac에만 남아요. 녹음 중이라고 통화 상대에게 꼭 알려 주세요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica no seu Mac. Avise as pessoas da chamada que você está gravando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остаётся на Mac. Предупредите участников звонка, что ведёте запись."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างอยู่บน Mac ของคุณ โปรดแจ้งผู้ร่วมสายว่าคุณกำลังบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey Mac'inde kalır. Görüşmedeki kişilere kayıt yaptığını söyle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都留在你的 Mac 上。请告知通话中的人你正在录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有資料都會留在 Mac 上。請告知通話參與者你正在錄音。"
          }
        }
      }
    },
