    "konclui.whatsapp.sample.mention.text" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "@أنت هل يمكنك مراجعة ملف Figma؟" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "@আপনি Figma-টা একবার দেখে দিতে পারবেন?" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "@du kannst du dir das Figma ansehen?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "@you can you review the Figma?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "@tú ¿puedes revisar el Figma?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "@toi tu peux relire le Figma ?" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "@आप क्या Figma देख सकते हैं?" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "@kamu bisa cek Figma-nya?" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "@あなた、Figma を確認してもらえますか？" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "@회원님, Figma 검토해 주실 수 있나요?" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "@você pode revisar o Figma?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "@вы можете посмотреть Figma?" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "@คุณ ช่วยรีวิว Figma ให้หน่อยได้ไหม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "@sen Figma’ya bakabilir misin?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "@你 能帮忙看看 Figma 吗？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "@你 能幫忙看看 Figma 嗎？" } } } },
