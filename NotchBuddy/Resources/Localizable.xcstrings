    "voice.setting-speak-desc" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Koncluí النتائج باللغة المنطوقة باستخدام صوت مُركَّب. كل شيء يتم على الجهاز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí কথ্য ভাষায় ফলাফল পড়ে। সবকিছু ডিভাইসেই হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí liest Ergebnisse in der gesprochenen Sprache mit einer synthetischen Stimme vor. Vollständig auf dem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí reads back results in the spoken language, using a synthesized voice. 100% on-device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí lee los resultados en el idioma hablado con una voz sintetizada. Todo en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí lit les résultats dans la langue parlée. Tout se passe sur l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí बोली जाने वाली भाषा में परिणाम पढ़ता है। सब कुछ डिवाइस पर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí membaca hasil dalam bahasa yang diucapkan. Semuanya di perangkat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí は話された言語で、合成音声を使って結果を読み上げます。100% デバイス上で処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 말한 언어로 결과를 소리 내어 읽어 줘요. 합성 음성을 쓰고, 100% 기기 안에서 처리해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí lê os resultados no idioma falado. Tudo no dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí зачитывает результаты на языке команды. Всё на устройстве."
          }
        },
        "th" : {
