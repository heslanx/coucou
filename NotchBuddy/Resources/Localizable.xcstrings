    "konclui.whatsapp.sample.group.text" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "شواء يوم الأحد" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রবিবারের বার্বিকিউ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Grillen am Sonntag" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Sunday barbecue" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Asado del domingo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Barbecue dimanche" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रविवार को बारबेक्यू" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "BBQ hari Minggu" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "日曜日のバーベキュー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일요일 바비큐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Churrasco domingo" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Барбекю в воскресенье" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บาร์บีคิววันอาทิตย์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pazar barbekü" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "周日烧烤" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "週日烤肉" } } } },
    "konclui.whatsapp.reconnect" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة الاتصال" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আবার সংযোগ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Neu verbinden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnect" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Reconectar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reconnecter" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फिर से कनेक्ट करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hubungkan ulang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再接続" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 연결" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Reconectar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключить снова" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อใหม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden bağlan" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新连接" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新連線" } } } },
    "konclui.whatsapp.install-again" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة التثبيت" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আবার ইনস্টল করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erneut installieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Install again" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Instalar de nuevo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réinstaller" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फिर से इंस्टॉल करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pasang ulang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再インストール" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 설치" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Instalar de novo" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установить снова" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้งอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden yükle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新安装" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重新安裝" } } } },
    "konclui.whatsapp.install-failed.impact" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم إعداد واتساب، لذا لن تصل أي رسالة إلى النوتش." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp সেট আপ হয়নি, তাই নচে কোনো বার্তা পৌঁছাবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp ist nicht eingerichtet, daher kommt keine Nachricht in der Notch an." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp is not set up, so no message reaches the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp no está configurado, así que ningún mensaje llega al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp n’est pas configuré, donc aucun message n’arrive dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp सेट अप नहीं है, इसलिए नॉच में कोई संदेश नहीं पहुँचेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp belum disiapkan, jadi tidak ada pesan yang sampai ke notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp が設定されていないため、メッセージはノッチに届きません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp이 설정되지 않아 메시지가 노치에 도착하지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O WhatsApp não está configurado, então nenhuma mensagem chega ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp не настроен, поэтому сообщения в чёлку не приходят." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่ได้ตั้งค่า WhatsApp จึงไม่มีข้อความไปถึงรอยบาก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp kurulmadı, bu yüzden çentiğe mesaj ulaşmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 尚未设置，因此刘海收不到任何消息。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 尚未設定，因此瀏海收不到任何訊息。" } } } },
    "konclui.whatsapp.update-gateway" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تحديث البوابة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ে আপডেট করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gateway aktualisieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Update gateway" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Actualizar pasarela" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mettre à jour la passerelle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे अपडेट करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Perbarui gateway" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲートウェイを更新" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "게이트웨이 업데이트" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Atualizar gateway" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновить шлюз" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อัปเดตเกตเวย์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidini güncelle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新网关" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更新閘道" } } } },
    "konclui.whatsapp.update-failed.impact" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم تحديث البوابة. تستمر النسخة الحالية في العمل. اضغط «تحديث البوابة» للمحاولة مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ে আপডেট হয়নি। বর্তমান সংস্করণ চলতে থাকবে। আবার চেষ্টা করতে “গেটওয়ে আপডেট করুন” চাপুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Gateway wurde nicht aktualisiert. Die vorhandene Version läuft weiter. Wähle „Gateway aktualisieren“, um es erneut zu versuchen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The gateway was not updated. The version you have keeps running. Press Update gateway to try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La pasarela no se actualizó. La versión actual sigue funcionando. Pulsa «Actualizar pasarela» para reintentarlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La passerelle n’a pas été mise à jour. La version actuelle continue de fonctionner. Appuie sur « Mettre à jour la passerelle » pour réessayer." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे अपडेट नहीं हुआ। मौजूदा वर्शन चलता रहेगा। फिर कोशिश करने के लिए “गेटवे अपडेट करें” दबाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gateway tidak diperbarui. Versi yang ada tetap berjalan. Tekan “Perbarui gateway” untuk mencoba lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲートウェイは更新されませんでした。現在のバージョンは引き続き動作します。「ゲートウェイを更新」を押して、もう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "게이트웨이가 업데이트되지 않았어요. 현재 버전은 계속 실행돼요. ‘게이트웨이 업데이트’를 눌러 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O gateway não foi atualizado. A versão atual continua funcionando. Clique em “Atualizar gateway” para tentar de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Шлюз не обновлён. Текущая версия продолжает работать. Нажмите «Обновить шлюз», чтобы повторить." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อัปเดตเกตเวย์ไม่สำเร็จ เวอร์ชันปัจจุบันยังทำงานต่อไป กด “อัปเดตเกตเวย์” เพื่อลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidi güncellenemedi. Mevcut sürüm çalışmaya devam eder. Yeniden denemek için “Ağ geçidini güncelle” düğmesine basın." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关未更新。当前版本仍会继续运行。点按“更新网关”可重试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閘道未更新。目前的版本仍會繼續執行。按「更新閘道」可重試。" } } } },
    "konclui.whatsapp.install.plain" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ينزّل Koncluí البوابة، وهي برنامج صغير مفتوح المصدر، من GitHub (نحو 15 ميغابايت، مرة واحدة)، ويتحقق منها ويشغّلها. ثم امسح رمز QR بهاتفك. لا حاجة إلى الطرفية." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí GitHub থেকে গেটওয়ে নামে ছোট একটি ওপেন-সোর্স প্রোগ্রাম ডাউনলোড করে (প্রায় ১৫ MB, একবারই), যাচাই করে চালু করে। তারপর ফোন দিয়ে QR কোড স্ক্যান করুন। টার্মিনাল লাগবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí lädt das Gateway, ein kleines Open-Source-Programm, von GitHub herunter (etwa 15 MB, einmalig), prüft es und startet es. Danach scannst du den QR-Code mit deinem Telefon. Kein Terminal nötig." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí downloads the gateway, a small open-source program, from GitHub (about 15 MB, once), checks it and starts it. Then scan the QR code with your phone. No Terminal needed." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí descarga la pasarela, un pequeño programa de código abierto, desde GitHub (unos 15 MB, una sola vez), la comprueba y la inicia. Luego escanea el código QR con tu teléfono. Sin Terminal." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí télécharge la passerelle, un petit programme open source, depuis GitHub (environ 15 Mo, une seule fois), la vérifie et la lance. Ensuite, scanne le QR code avec ton téléphone. Pas besoin du Terminal." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí गेटवे नाम का छोटा ओपन-सोर्स प्रोग्राम GitHub से डाउनलोड करता है (लगभग 15 MB, सिर्फ़ एक बार), जाँचता है और चालू करता है। फिर फ़ोन से QR कोड स्कैन करें। टर्मिनल की ज़रूरत नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí mengunduh gateway, program open source kecil, dari GitHub (sekitar 15 MB, sekali saja), memeriksanya lalu menjalankannya. Lalu pindai kode QR dengan ponselmu. Tanpa Terminal." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí は GitHub から小さなオープンソースプログラムのゲートウェイ（約 15 MB）を一度ダウンロードし、検証して起動します。その後、スマートフォンで QR コードをスキャンしてください。ターミナルは不要です。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 GitHub에서 작고 오픈 소스인 게이트웨이 프로그램(약 15MB)을 한 번 다운로드하고, 확인한 다음 시작해요. 이후 휴대폰으로 QR 코드를 스캔하세요. 터미널은 필요하지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí baixa o gateway, um programa pequeno de código aberto, do GitHub (cerca de 15 MB, uma única vez), verifica e inicia. Depois, escaneie o QR code com o celular. Sem Terminal." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí скачивает шлюз, небольшую программу с открытым кодом, с GitHub (около 15 МБ, один раз), проверяет и запускает. Затем отсканируйте QR-код телефоном. Терминал не нужен." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ดาวน์โหลดเกตเวย์ ซึ่งเป็นโปรแกรมโอเพนซอร์สขนาดเล็ก จาก GitHub (ประมาณ 15 MB ครั้งเดียว) ตรวจสอบและเริ่มทำงาน จากนั้นสแกนคิวอาร์โค้ดด้วยโทรศัพท์ ไม่ต้องใช้เทอร์มินัล" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ağ geçidini, küçük bir açık kaynak programı, GitHub’dan indirir (yaklaşık 15 MB, yalnızca bir kez), doğrular ve başlatır. Sonra QR kodunu telefonunuzla tarayın. Terminal gerekmez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 会从 GitHub 下载网关（一个开源小程序，约 15 MB，仅一次），校验后启动。然后用手机扫描二维码即可。无需终端。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 會從 GitHub 下載閘道（一個開放原始碼的小程式，約 15 MB，僅需一次），驗證後啟動。接著使用手機掃描 QR 碼即可，無須使用終端機。" } } } },
    "konclui.whatsapp.install.checking" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "البحث عن أحدث إصدار…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সর্বশেষ সংস্করণ খোঁজা হচ্ছে…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Suche nach der neuesten Version…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Looking for the latest version…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Buscando la última versión…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Recherche de la dernière version…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "नया वर्शन ढूँढ रहा है…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mencari versi terbaru…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最新バージョンを確認中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "최신 버전 확인 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Procurando a versão mais recente…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Поиск последней версии…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังค้นหาเวอร์ชันล่าสุด…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "En son sürüm aranıyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在查找最新版本…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在尋找最新版本…" } } } },
    "konclui.whatsapp.gateway-ready %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تثبيت البوابة %@ وتشغيلها بواسطة Koncluí." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ে %@ ইনস্টল হয়েছে এবং Koncluí চালু করেছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gateway %@ ist installiert und wird von Koncluí gestartet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Gateway %@ installed and started by Koncluí." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pasarela %@ instalada e iniciada por Koncluí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Passerelle %@ installée et lancée par Koncluí." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे %@ इंस्टॉल है और Koncluí ने उसे चालू किया है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gateway %@ terpasang dan dijalankan oleh Koncluí." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲートウェイ %@ を Koncluí がインストールして起動しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "게이트웨이 %@을(를) Koncluí가 설치하고 시작했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Gateway %@ instalado e iniciado pelo Koncluí." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Шлюз %@ установлен и запущен Koncluí." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้งเกตเวย์ %@ และ Koncluí เป็นผู้เริ่มทำงานแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidi %@ kuruldu ve Koncluí tarafından başlatıldı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关 %@ 已安装，由 Koncluí 启动。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閘道 %@ 已安裝，由 Koncluí 啟動。" } } } },
    "konclui.whatsapp.gateway-own" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بوابتك الخاصة جاهزة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার নিজের গেটওয়ে সেট আপ করা আছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein eigenes Gateway ist eingerichtet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your own gateway is set up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu propia pasarela está configurada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ta propre passerelle est configurée." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपका अपना गेटवे सेट अप है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gateway milikmu sudah disiapkan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "独自のゲートウェイが設定されています。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용자 게이트웨이가 설정됐어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O seu próprio gateway está configurado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваш собственный шлюз настроен." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตั้งค่าเกตเวย์ของคุณเองแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kendi ağ geçidiniz kurulu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你自己的网关已设置好。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你自訂的閘道已設定好。" } } } },
    "konclui.whatsapp.show-in-notch" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض في النوتش" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নচে দেখান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "In der Notch zeigen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Show in the notch" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar en el notch" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher dans le notch" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "नॉच में दिखाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan di notch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノッチに表示" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "노치에 표시" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar no notch" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показывать в чёлке" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงในรอยบาก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çentikte göster" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在刘海中显示" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在瀏海中顯示" } } } },
    "konclui.whatsapp.connected-as" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متصل برقم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সংযুক্ত নম্বর" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbunden als" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected as" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectado como" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecté en tant que" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कनेक्टेड नंबर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Terhubung sebagai" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続中のアカウント" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 계정으로 연결됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conectado como" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключён как" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อเป็น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlı numara" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接为" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已連線為" } } } },
    "konclui.whatsapp.number.open" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح الدردشة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চ্যাট খুলুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Chat öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the chat" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir el chat" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir le chat" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चैट खोलें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka chat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "チャットを開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "채팅 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir a conversa" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть чат" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sohbeti aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开聊天" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟對話" } } } },
    "konclui.whatsapp.number.copy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ الرقم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নম্বর কপি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nummer kopieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy the number" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar el número" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier le numéro" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "नंबर कॉपी करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salin nomor" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "電話番号をコピー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "번호 복사" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiar o número" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать номер" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกหมายเลข" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Numarayı kopyala" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制号码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "拷貝號碼" } } } },
    "konclui.whatsapp.id.copy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ معرّف الدردشة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চ্যাট আইডি কপি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Chat-ID kopieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy the chat id" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar el id del chat" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier l’id du chat" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चैट आईडी कॉपी करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salin id chat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "チャット ID をコピー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "채팅 ID 복사" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiar o id da conversa" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать id чата" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกรหัสแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sohbet kimliğini kopyala" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制聊天 ID" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "拷貝對話 ID" } } } },
    "konclui.whatsapp.number.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعرض ما يمكنك فعله بهذا الرقم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই নম্বর দিয়ে কী করা যায় তা দেখায়" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt, was du mit dieser Nummer tun kannst" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows what you can do with this number" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra lo que puedes hacer con este número" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Montre ce que tu peux faire avec ce numéro" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस नंबर के साथ क्या किया जा सकता है, दिखाता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menampilkan yang bisa kamu lakukan dengan nomor ini" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この番号でできる操作を表示します" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 번호로 할 수 있는 작업을 표시해요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra o que você pode fazer com este número" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показывает, что можно сделать с этим номером" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงสิ่งที่ทำได้กับหมายเลขนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu numarayla neler yapabileceğinizi gösterir" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示可对此号码执行的操作" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "顯示可對此號碼執行的操作" } } } },
    "konclui.whatsapp.number.unavailable" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "واتساب لنظام Mac غير مثبّت، لذا لا يمكن فتح الدردشة. ثبّته لفتح الدردشات من هنا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Mac-এর জন্য WhatsApp ইনস্টল করা নেই, তাই চ্যাট খোলা যাচ্ছে না। এখান থেকে চ্যাট খুলতে সেটি ইনস্টল করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp für Mac ist nicht installiert, daher lässt sich der Chat nicht öffnen. Installiere es, um Chats von hier zu öffnen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp for Mac is not installed, so the chat cannot open. Install it to open chats from here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp para Mac no está instalado, así que no se puede abrir el chat. Instálalo para abrir chats desde aquí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp pour Mac n’est pas installé, donc le chat ne peut pas s’ouvrir. Installe-le pour ouvrir des chats d’ici." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Mac के लिए WhatsApp इंस्टॉल नहीं है, इसलिए चैट नहीं खुल सकती। यहाँ से चैट खोलने के लिए उसे इंस्टॉल करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp untuk Mac belum terpasang, jadi chat tidak bisa dibuka. Pasang dulu untuk membuka chat dari sini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mac 版 WhatsApp がインストールされていないため、チャットを開けません。ここからチャットを開くにはインストールしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Mac용 WhatsApp이 설치되지 않아 채팅을 열 수 없어요. 여기서 채팅을 열려면 설치하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O WhatsApp para Mac não está instalado, então a conversa não pode abrir. Instale-o para abrir conversas daqui." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp для Mac не установлен, поэтому чат не открыть. Установите его, чтобы открывать чаты отсюда." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่ได้ติดตั้ง WhatsApp สำหรับ Mac จึงเปิดแชตไม่ได้ ติดตั้งก่อนเพื่อเปิดแชตจากที่นี่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mac için WhatsApp kurulu değil, bu yüzden sohbet açılamıyor. Buradan sohbet açmak için kurun." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未安装 Mac 版 WhatsApp，无法打开聊天。安装后即可从这里打开聊天。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未安裝 Mac 版 WhatsApp，無法開啟對話。安裝後即可從這裡開啟對話。" } } } },
    "konclui.whatsapp.copied" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم النسخ." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কপি হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Kopiert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copié." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कॉपी हो गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tersalin." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コピーしました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사됨." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировано." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kopyalandı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已拷貝。" } } } },
    "konclui.whatsapp.unignore" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف التجاهل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "উপেক্ষা বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht mehr ignorieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop ignoring" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Dejar de ignorar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ne plus ignorer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अनदेखा करना बंद करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berhenti mengabaikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "無視を解除" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "무시 해제" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar de ignorar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не игнорировать" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลิกละเว้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yok saymayı bırak" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不再忽略" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不再忽略" } } } },
    "konclui.whatsapp.undo" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تراجع" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পূর্বাবস্থায় ফিরুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Rückgängig" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Undo" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Deshacer" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Annuler" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पूर्ववत करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Urungkan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り消す" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 취소" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desfazer" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отменить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลิกทำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geri al" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤销" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "復原" } } } },
    "konclui.whatsapp.undo.ignored %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تجاهل %@. لن تصل رسائلها إلى النوتش بعد الآن." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ উপেক্ষা করা হচ্ছে। এর বার্তা আর নচে পৌঁছাবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ wird ignoriert. Die Nachrichten kommen nicht mehr in der Notch an." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Ignoring %@. Its messages no longer reach the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ignorando %@. Sus mensajes ya no llegan al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ est ignoré. Ses messages n’arrivent plus dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ को अनदेखा किया जा रहा है। उसके संदेश अब नॉच में नहीं पहुँचेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ diabaikan. Pesannya tidak lagi sampai ke notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@を無視しました。メッセージはノッチに届かなくなります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@을(를) 무시해요. 해당 메시지는 더 이상 노치에 도착하지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ignorando %@. As mensagens não chegam mais ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ игнорируется. Его сообщения больше не приходят в чёлку." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ละเว้น %@ แล้ว ข้อความจะไม่ไปถึงรอยบากอีก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ yok sayılıyor. Mesajları artık çentiğe ulaşmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在忽略 %@。它的消息不再到达刘海。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在忽略 %@。它的訊息不再傳到瀏海。" } } } },
    "konclui.whatsapp.undo.unignored %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم إيقاف تجاهل %@. ستصل رسائلها الجديدة إلى النوتش مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ আর উপেক্ষা করা হচ্ছে না। এর নতুন বার্তা আবার নচে পৌঁছাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ wird nicht mehr ignoriert. Neue Nachrichten kommen wieder in der Notch an." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped ignoring %@. Its new messages reach the notch again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se dejó de ignorar %@. Sus mensajes nuevos vuelven a llegar al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ n’est plus ignoré. Ses nouveaux messages arrivent de nouveau dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ को अब अनदेखा नहीं किया जा रहा। उसके नए संदेश फिर नॉच में पहुँचेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ tidak lagi diabaikan. Pesan barunya sampai ke notch lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@の無視を解除しました。新しいメッセージが再びノッチに届きます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@을(를) 더 이상 무시하지 않아요. 새 메시지가 다시 노치에 도착해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parou de ignorar %@. As mensagens novas voltam a chegar ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ больше не игнорируется. Новые сообщения снова приходят в чёлку." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลิกละเว้น %@ แล้ว ข้อความใหม่จะไปถึงรอยบากอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ artık yok sayılmıyor. Yeni mesajları yine çentiğe ulaşır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已不再忽略 %@。它的新消息会再次到达刘海。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已不再忽略 %@。它的新訊息會再次傳到瀏海。" } } } },
    "konclui.whatsapp.undo.off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "واتساب متوقف. نسي Koncluí الرسائل التي كان يحتفظ بها في الذاكرة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp বন্ধ। Koncluí মেমরিতে রাখা বার্তাগুলো ভুলে গেছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp ist aus. Koncluí hat die Nachrichten im Speicher vergessen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp is off. Koncluí forgot the messages it held in memory." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp está desactivado. Koncluí olvidó los mensajes que tenía en memoria." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp est désactivé. Koncluí a oublié les messages gardés en mémoire." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp बंद है। Koncluí ने मेमोरी में रखे संदेश भुला दिए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp dimatikan. Koncluí melupakan pesan yang disimpan di memori." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp をオフにしました。Koncluí はメモリに保持していたメッセージを消去しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp이 꺼졌어요. Koncluí가 메모리에 보관하던 메시지를 지웠어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O WhatsApp está desativado. O Koncluí esqueceu as mensagens que guardava na memória." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp выключен. Koncluí забыл сообщения, которые хранил в памяти." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิด WhatsApp แล้ว Koncluí ลืมข้อความที่เก็บไว้ในหน่วยความจำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp kapatıldı. Koncluí bellekte tuttuğu mesajları unuttu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 已关闭。Koncluí 已忘记内存中的消息。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 已關閉。Koncluí 已忘記記憶體中的訊息。" } } } },
    "konclui.whatsapp.undo.saved" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم حفظ إعدادات البوابة. أعاد Koncluí الاتصال." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ের সেটিংস সংরক্ষিত হয়েছে। Koncluí আবার সংযোগ করেছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gateway-Einstellungen gespeichert. Koncluí hat sich neu verbunden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Gateway settings saved. Koncluí reconnected." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes de la pasarela guardados. Koncluí se reconectó." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages de la passerelle enregistrés. Koncluí s’est reconnecté." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे की सेटिंग्स सेव हो गईं। Koncluí ने फिर से कनेक्ट किया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Setelan gateway disimpan. Koncluí terhubung ulang." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ゲートウェイの設定を保存しました。Koncluí は再接続しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "게이트웨이 설정을 저장했어요. Koncluí가 다시 연결했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes do gateway salvos. O Koncluí reconectou." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки шлюза сохранены. Koncluí подключился заново." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึกการตั้งค่าเกตเวย์แล้ว Koncluí เชื่อมต่อใหม่แล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidi ayarları kaydedildi. Koncluí yeniden bağlandı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关设置已保存。Koncluí 已重新连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閘道設定已儲存。Koncluí 已重新連線。" } } } },
    "konclui.whatsapp.ignore.empty" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب رقم هاتف أو معرّف دردشة أولًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আগে একটি ফোন নম্বর বা চ্যাট আইডি লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib zuerst eine Telefonnummer oder Chat-ID ein." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type a phone number or a chat id first." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe primero un número de teléfono o un id de chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Saisis d’abord un numéro de téléphone ou un id de chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले फ़ोन नंबर या चैट आईडी लिखें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ketik dulu nomor telepon atau id chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "電話番号またはチャット ID を入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "먼저 전화번호나 채팅 ID를 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Digite primeiro um número de telefone ou um id de conversa." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сначала введите номер телефона или id чата." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์หมายเลขโทรศัพท์หรือรหัสแชตก่อน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce bir telefon numarası veya sohbet kimliği yazın." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先输入电话号码或聊天 ID。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先輸入電話號碼或對話 ID。" } } } },
    "konclui.whatsapp.ignore.invalid" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا ليس رقم هاتف ولا معرّف دردشة. اكتب الأرقام مع رمز الدولة، أو معرّفًا ينتهي بـ @g.us." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এটি ফোন নম্বর বা চ্যাট আইডি নয়। দেশের কোডসহ সংখ্যাগুলো লিখুন, অথবা @g.us দিয়ে শেষ হওয়া আইডি দিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das ist keine Telefonnummer und keine Chat-ID. Gib die Ziffern mit Landesvorwahl ein oder eine ID, die auf @g.us endet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "That is not a phone number or a chat id. Use the digits with the country code, or an id that ends in @g.us." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Eso no es un número de teléfono ni un id de chat. Usa los dígitos con el prefijo del país, o un id que termine en @g.us." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce n’est ni un numéro de téléphone ni un id de chat. Utilise les chiffres avec l’indicatif du pays, ou un id qui finit par @g.us." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह फ़ोन नंबर या चैट आईडी नहीं है। देश के कोड के साथ अंक लिखें, या @g.us पर खत्म होने वाली आईडी दें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Itu bukan nomor telepon atau id chat. Gunakan angka dengan kode negara, atau id yang diakhiri @g.us." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "電話番号またはチャット ID ではありません。国番号を含む数字、または @g.us で終わる ID を入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "전화번호나 채팅 ID가 아니에요. 국가 코드를 포함한 숫자 또는 @g.us로 끝나는 ID를 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Isso não é um número de telefone nem um id de conversa. Use os dígitos com o código do país, ou um id que termine em @g.us." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это не номер телефона и не id чата. Введите цифры с кодом страны или id, который заканчивается на @g.us." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "นี่ไม่ใช่หมายเลขโทรศัพท์หรือรหัสแชต ใส่ตัวเลขพร้อมรหัสประเทศ หรือรหัสที่ลงท้ายด้วย @g.us" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu bir telefon numarası ya da sohbet kimliği değil. Ülke koduyla rakamları veya @g.us ile biten bir kimlik girin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这不是电话号码或聊天 ID。请输入带国家区号的数字，或以 @g.us 结尾的 ID。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這不是電話號碼或對話 ID。請輸入含國碼的數字，或以 @g.us 結尾的 ID。" } } } },
    "konclui.whatsapp.port.invalid" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يكون المنفذ رقمًا من 1024 إلى 65535. سيبقى المنفذ السابق عند الحفظ." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পোর্ট ১০২৪ থেকে ৬৫৫৩৫-এর মধ্যে একটি সংখ্যা হতে হবে। সংরক্ষণ করলে আগের পোর্টই থাকবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Port muss eine Zahl von 1024 bis 65535 sein. Beim Sichern bleibt der bisherige Port." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The port must be a number from 1024 to 65535. Saving keeps the previous port." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El puerto debe ser un número de 1024 a 65535. Al guardar se mantiene el puerto anterior." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le port doit être un nombre de 1024 à 65535. L’enregistrement garde l’ancien port." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पोर्ट 1024 से 65535 के बीच की संख्या होनी चाहिए। सेव करने पर पुराना पोर्ट ही रहेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Port harus berupa angka 1024 sampai 65535. Saat disimpan, port sebelumnya tetap dipakai." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ポートには 1024〜65535 の数値を指定してください。保存すると、以前のポートが維持されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "포트는 1024~65535 사이의 숫자여야 해요. 저장하면 이전 포트가 유지돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A porta deve ser um número de 1024 a 65535. Ao salvar, a porta anterior continua." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Порт должен быть числом от 1024 до 65535. При сохранении останется прежний порт." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พอร์ตต้องเป็นตัวเลข 1024 ถึง 65535 เมื่อบันทึกจะใช้พอร์ตเดิมต่อไป" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlantı noktası 1024 ile 65535 arasında bir sayı olmalı. Kaydedince önceki nokta korunur." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "端口必须是 1024 到 65535 之间的数字。保存时会保留原来的端口。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連接埠必須是 1024 到 65535 之間的數字。儲存時會保留原本的連接埠。" } } } },
    "konclui.whatsapp.url.invalid" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجب أن يبدأ العنوان بـ http:// أو https://. لا يمكن حفظه كما كُتب." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ঠিকানা http:// বা https:// দিয়ে শুরু হতে হবে। যেমন লেখা আছে তেমন সংরক্ষণ করা যাবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Adresse muss mit http:// oder https:// beginnen. So lässt sie sich nicht sichern." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The address must start with http:// or https://. It cannot be saved as typed." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La dirección debe empezar por http:// o https://. No se puede guardar así." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’adresse doit commencer par http:// ou https://. Elle ne peut pas être enregistrée telle quelle." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पता http:// या https:// से शुरू होना चाहिए। इसे ऐसे सेव नहीं किया जा सकता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Alamat harus diawali http:// atau https://. Tidak bisa disimpan seperti ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アドレスは http:// または https:// で始まる必要があります。この内容では保存できません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "주소는 http:// 또는 https://로 시작해야 해요. 현재 입력한 주소는 저장할 수 없어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O endereço deve começar com http:// ou https://. Ele não pode ser salvo assim." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Адрес должен начинаться с http:// или https://. В таком виде его нельзя сохранить." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ที่อยู่ต้องขึ้นต้นด้วย http:// หรือ https:// บันทึกตามที่พิมพ์ไม่ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Adres http:// veya https:// ile başlamalı. Yazıldığı gibi kaydedilemez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "地址必须以 http:// 或 https:// 开头。无法按当前内容保存。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "位址必須以 http:// 或 https:// 開頭。無法照目前內容儲存。" } } } },
    "konclui.whatsapp.testing" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ الاختبار…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরীক্ষা চলছে…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Teste…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Testing…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Probando…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Test en cours…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जाँच हो रही है…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menguji…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テスト中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "테스트 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Testando…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверка…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังทดสอบ…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sınanıyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在测试…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在測試…" } } } },
    "konclui.whatsapp.qr.label" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رمز QR لربط واتساب" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp লিঙ্ক করার QR কোড" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "QR-Code zum Verknüpfen von WhatsApp" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "QR code to link WhatsApp" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Código QR para vincular WhatsApp" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "QR code pour lier WhatsApp" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp लिंक करने का QR कोड" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kode QR untuk menautkan WhatsApp" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp をリンクする QR コード" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 연결용 QR 코드" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "QR code para conectar o WhatsApp" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "QR-код для привязки WhatsApp" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คิวอาร์โค้ดสำหรับเชื่อม WhatsApp" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp’ı bağlamak için QR kodu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于关联 WhatsApp 的二维码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於連結 WhatsApp 的 QR 碼" } } } },
    "konclui.whatsapp.step.done" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সম্পন্ন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "erledigt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "done" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "hecho" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "terminé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हो गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "selesai" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "完了" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "concluído" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "готово" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เสร็จแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "bitti" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已完成" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已完成" } } } },
    "konclui.whatsapp.step.now" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "قيد التنفيذ" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চলছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "läuft" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "in progress" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "en curso" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "en cours" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जारी है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "berjalan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "進行中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "진행 중" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "em andamento" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "выполняется" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังทำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sürüyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "进行中" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "進行中" } } } },
