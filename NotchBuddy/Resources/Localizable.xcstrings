    "hub.mail.autosort-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسائل التي تصل من الآن فقط، في كل الحسابات المضافة إلى Mail. يجب أن يكون Mail مفتوحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু এখন থেকে আসা মেল, Mail-এ যোগ করা সব অ্যাকাউন্টে। Mail খোলা থাকতে হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur E-Mails, die ab jetzt ankommen, in allen Accounts in Mail. Mail muss geöffnet sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only messages that arrive from now on, in every account added to Mail. Mail must be open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los correos que lleguen a partir de ahora, en todas las cuentas añadidas a Mail. Mail debe estar abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les mails qui arrivent à partir de maintenant, dans tous les comptes ajoutés à Mail. Mail doit être ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ अब से आने वाले मेल, Mail में जोड़े गए हर खाते में। Mail खुला होना चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya email yang masuk mulai sekarang, di semua akun yang ditambahkan ke Mail. Mail harus terbuka."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今から届くメールのみ、Mail に追加したすべてのアカウントが対象です。Mail を開いておく必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금부터 도착하는 메일만, Mail에 추가한 모든 계정에서 정리합니다. Mail이 열려 있어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os e-mails que chegarem a partir de agora, em todas as contas adicionadas ao Mail. O Mail precisa estar aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только письма, которые придут с этого момента, во всех учётных записях Mail. Mail должна быть открыта."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะอีเมลที่เข้ามาตั้งแต่ตอนนี้ ในทุกบัญชีที่เพิ่มไว้ใน Mail และต้องเปิด Mail ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bundan sonra gelen e-postalar, Mail’e eklenen tüm hesaplarda. Mail açık olmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限从现在起收到的邮件，涵盖添加到“邮件”的所有账户。“邮件”必须保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅限從現在起收到的郵件，涵蓋加入「郵件」的所有帳號。「郵件」必須保持開啟。"
          }
        }
      }
    },
    "hub.mail.autosort-off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفرز التلقائي متوقف: لن تعمل هذه الإعدادات حتى يُشغَّل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্বয়ংক্রিয় সাজানো বন্ধ: চালু না করা পর্যন্ত এই সেটিংস কাজ করবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Sortierung ist aus: Diese Einstellungen wirken erst, wenn sie an ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic sorting is off: these settings do nothing until it is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El orden automático está desactivado: estos ajustes no hacen nada hasta que lo actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tri automatique est désactivé : ces réglages ne font rien tant qu’il n’est pas activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो छँटाई बंद है: चालू होने तक ये सेटिंग कुछ नहीं करेंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemilahan otomatis mati: pengaturan ini tidak berpengaruh sampai dinyalakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動整理はオフです。オンにするまでこれらの設定は働きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 정리가 꺼져 있습니다. 켜기 전까지는 이 설정이 작동하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A organização automática está desligada: estes ajustes não fazem nada até ela ser ligada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автосортировка выключена: эти настройки не работают, пока она не включена."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การคัดแยกอัตโนมัติปิดอยู่: การตั้งค่าเหล่านี้จะไม่ทำงานจนกว่าจะเปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik düzenleme kapalı: açılana kadar bu ayarlar bir şey yapmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动整理已关闭：开启之前这些设置不会生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動整理已關閉：開啟之前這些設定不會生效。"
          }
        }
      }
    },
