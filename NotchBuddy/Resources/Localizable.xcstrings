    "whatsapp.autostart.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّله Koncluí على هذا الـMac فقط (127.0.0.1، منفذ العنوان)، دون تنزيل الوسائط، ويوقفه عند إغلاق Koncluí. تبقى جلسة واتساب في ‎~/Library/Application Support/Konclui/GOWA."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí এটি শুধু এই Mac-এ চালায় (127.0.0.1, URL-এর পোর্ট), মিডিয়া ডাউনলোড ছাড়াই, এবং Koncluí বন্ধ হলে থামিয়ে দেয়। এর WhatsApp সেশন থাকে ~/Library/Application Support/Konclui/GOWA-তে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí führt es nur auf diesem Mac aus (127.0.0.1, der Port der URL), ohne Medien herunterzuladen, und beendet es, wenn Koncluí beendet wird. Seine WhatsApp-Sitzung liegt in ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí runs it on this Mac only (127.0.0.1, the URL’s port), without downloading media, and stops it when Koncluí quits. Its WhatsApp session stays in ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí lo ejecuta solo en este Mac (127.0.0.1, el puerto de la URL), sin descargar archivos, y lo detiene al cerrar Koncluí. Su sesión de WhatsApp queda en ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí le lance sur ce Mac uniquement (127.0.0.1, le port de l’URL), sans télécharger les médias, et l’arrête quand Koncluí quitte. Sa session WhatsApp reste dans ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí इसे सिर्फ़ इस Mac पर चलाता है (127.0.0.1, URL का पोर्ट), मीडिया डाउनलोड किए बिना, और Koncluí बंद होने पर रोक देता है। इसका WhatsApp सेशन ~/Library/Application Support/Konclui/GOWA में रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí menjalankannya hanya di Mac ini (127.0.0.1, port dari URL), tanpa mengunduh media, dan menghentikannya saat Koncluí ditutup. Sesi WhatsApp-nya ada di ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí はこの Mac のみ（127.0.0.1、URL のポート）でメディアをダウンロードせずに実行し、Koncluí の終了時に停止します。WhatsApp のセッションは ~/Library/Application Support/Konclui/GOWA に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 이 Mac에서만(127.0.0.1, URL의 포트) 실행하고, 미디어는 받지 않으며, Koncluí를 끄면 같이 꺼져요. WhatsApp 세션은 ~/Library/Application Support/Konclui/GOWA에 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí o executa só neste Mac (127.0.0.1, a porta da URL), sem baixar mídias, e o encerra quando o Koncluí fecha. A sessão do WhatsApp fica em ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí запускает его только на этом Mac (127.0.0.1, порт из адреса), без загрузки медиа, и останавливает при выходе. Сессия WhatsApp хранится в ~/Library/Application Support/Konclui/GOWA."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí เรียกใช้งานเฉพาะบน Mac เครื่องนี้ (127.0.0.1 พอร์ตตาม URL) โดยไม่ดาวน์โหลดสื่อ และหยุดเมื่อ Koncluí ปิด เซสชัน WhatsApp ของมันอยู่ใน ~/Library/Application Support/Konclui/GOWA"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí onu yalnızca bu Mac'te çalıştırır (127.0.0.1, URL'nin bağlantı noktası), medya indirmez ve Koncluí kapanınca durdurur. WhatsApp oturumu ~/Library/Application Support/Konclui/GOWA içinde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 仅在这台 Mac 上运行它（127.0.0.1，使用地址中的端口），不下载媒体，并在 Koncluí 退出时停止它。其 WhatsApp 会话保存在 ~/Library/Application Support/Konclui/GOWA。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 僅在這台 Mac 上執行閘道（127.0.0.1，使用網址指定的連接埠），不下載媒體，並在結束時停止閘道。WhatsApp 工作階段會保留在 ~/Library/Application Support/Konclui/GOWA。"
          }
        }
      }
    },
