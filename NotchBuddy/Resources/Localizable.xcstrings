    "iphone.sync.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل جلساتك إلى iCloud الخاص بك لتطبيق Koncluí على iPhone. تُشفَّر أسماء المشاريع والأوامر والأسئلة بمفاتيح iCloud الخاصة بك. إيقاف التشغيل يحذفها من iCloud."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí iPhone অ্যাপের জন্য আপনার সেশনগুলো আপনার প্রাইভেট iCloud-এ পাঠায়। প্রজেক্টের নাম, কমান্ড এবং প্রশ্নগুলো আপনার iCloud কী দিয়ে এনক্রিপ্ট করা হয়। বন্ধ করলে iCloud থেকে মুছে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet deine Sitzungen an deine private iCloud für Koncluí auf dem iPhone. Projektnamen, Befehle und Fragen werden mit deinen iCloud-Schlüsseln verschlüsselt. Beim Deaktivieren werden die Daten aus iCloud entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends your sessions to your private iCloud for the Koncluí app on iPhone. Project names, commands, and questions are encrypted with your iCloud keys. Disabling removes data from iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tus sesiones a tu iCloud privado para la app Koncluí de iPhone. Los nombres de proyecto, comandos y preguntas se cifran con tus claves de iCloud. Desactivarlo las elimina de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie tes sessions sur ton iCloud privé pour l'app Koncluí sur iPhone. Les noms de projets, commandes et questions sont chiffrés avec tes clés iCloud. Désactiver supprime les données d'iCloud."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí iPhone ऐप के लिए आपके सेशन आपके प्राइवेट iCloud में भेजता है। प्रोजेक्ट नाम, कमांड और सवाल आपकी iCloud कुंजियों से एन्क्रिप्ट किए जाते हैं। बंद करने पर iCloud से हटा दिए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim sesi Anda ke iCloud pribadi Anda untuk aplikasi Koncluí iPhone. Nama proyek, perintah, dan pertanyaan dienkripsi dengan kunci iCloud Anda. Mematikannya menghapusnya dari iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の Koncluí アプリのために、セッションを自分専用の iCloud に送ります。プロジェクト名、コマンド、質問は iCloud のキーで暗号化されます。オフにすると iCloud からデータが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí iPhone 앱을 위해 세션을 내 개인 iCloud로 보내요. 프로젝트 이름, 명령, 질문은 내 iCloud 키로 암호화돼요. 끄면 iCloud에서 데이터가 지워져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia suas sessões para seu iCloud privado para o app Koncluí no iPhone. Nomes de projetos, comandos e perguntas são criptografados com suas chaves do iCloud. Desativar remove-os do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет твои сессии в личный iCloud для приложения Koncluí на iPhone. Имена проектов, команды и вопросы шифруются твоими ключами iCloud. Отключение удаляет их из iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งเซสชันไปยัง iCloud ส่วนตัวของคุณสำหรับแอป Koncluí บน iPhone ชื่อโปรเจกต์ คำสั่ง และคำถามจะเข้ารหัสด้วยคีย์ iCloud ของคุณ เมื่อปิดใช้ ข้อมูลจะถูกลบจาก iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlarını iPhone'daki Koncluí uygulaması için özel iCloud hesabına gönderir. Proje adları, komutlar ve sorular iCloud anahtarlarınla şifrelenir. Kapatıldığında veriler iCloud'dan kaldırılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的会话发送到私有 iCloud，供 Koncluí iPhone 应用使用。项目名称、命令和问题使用你的 iCloud 密钥加密。关闭后将从 iCloud 中删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將工作階段傳送至你的私人 iCloud，供 iPhone 上的 Koncluí 使用。專案名稱、指令與問題會使用你的 iCloud 金鑰加密。停用後會移除 iCloud 中的資料。"
          }
        }
      }
    },
