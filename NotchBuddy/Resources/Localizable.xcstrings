            "value" : "عندما يسمع Koncluí الكلمات على اليسار، يكتب الكلمات على اليمين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাঁ দিকের শব্দ শুনলে Koncluí ডান দিকের শব্দ লেখে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Koncluí die Wörter links hört, schreibt es die Wörter rechts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Koncluí hears the words on the left, it writes the ones on the right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando Koncluí oye las palabras de la izquierda, escribe las de la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Koncluí entend les mots de gauche, il écrit ceux de droite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Koncluí बाईं ओर के शब्द सुनता है, तो दाईं ओर के शब्द लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Koncluí mendengar kata di kiri, ia menulis kata di kanan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左の言葉が聞こえたら、Koncluí は右の言葉を書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 왼쪽 단어를 들으면 오른쪽 단어로 바꿔 써요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o Koncluí ouve as palavras da esquerda, escreve as da direita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Услышав слова слева, Koncluí пишет слова справа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อ Koncluí ได้ยินคำทางซ้าย ระบบจะพิมพ์คำทางขวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí soldaki sözcükleri duyduğunda sağdakileri yazar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 听到左边的词时，会写成右边的词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 聽到左側詞彙時，會寫成右側文字。"
          }
        }
      }
    },
