    "notes.error.mic" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Koncluí استخدام الميكروفون. اسمح به من إعدادات النظام ‹ الخصوصية والأمن ‹ الميكروفون."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí মাইক্রোফোন ব্যবহার করতে পারছে না। সিস্টেম সেটিংস › গোপনীয়তা ও নিরাপত্তা › মাইক্রোফোন-এ অনুমতি দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí kann das Mikrofon nicht verwenden. Erlaube es unter Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí can't use the microphone. Allow it in System Settings › Privacy & Security › Microphone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí no puede usar el micrófono. Permítelo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ne peut pas utiliser le micro. Autorise-le dans Réglages Système › Confidentialité et sécurité › Micro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí माइक्रोफ़ोन इस्तेमाल नहीं कर पा रहा। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › माइक्रोफ़ोन में अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí tidak bisa memakai mikrofon. Izinkan di Pengaturan Sistem › Privasi & Keamanan › Mikrofon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí がマイクを使えません。システム設定 → プライバシーとセキュリティ → マイクで許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앗, Koncluí가 마이크를 쓸 수 없어요. 시스템 설정 → 개인정보 보호 및 보안 → 마이크에서 허용해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí não pode usar o microfone. Permita em Ajustes do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí не может использовать микрофон. Разрешите его в Системных настройках › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ใช้ไมโครโฟนไม่ได้ อนุญาตได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › ไมโครโฟน"
