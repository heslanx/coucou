    "konclui.reminders.size.small" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "صغير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ছোট" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Klein" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Small" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pequeño" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Petit" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "छोटा" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kecil" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "小" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "작게" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pequeno" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Малый" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เล็ก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Küçük" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "小" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "小" } } } },
    "konclui.reminders.size" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الحجم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আকার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Größe" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Size" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tamaño" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Taille" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आकार" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ukuran" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サイズ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "크기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tamanho" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Размер" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ขนาด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Boyut" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "大小" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "大小" } } } },
    "konclui.reminders.display.full-hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يغطي الشاشة حتى ترد. لما لا يجب تفويته." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি সাড়া না দেওয়া পর্যন্ত স্ক্রিন ঢেকে রাখে। যা কিছুতেই বাদ দেওয়া যাবে না তার জন্য।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedeckt den Bildschirm, bis du reagierst. Für das, was nicht verpasst werden darf." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Covers the screen until you answer. For what can’t be missed." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cubre la pantalla hasta que respondas. Para lo que no puede pasarse." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Couvre l’écran jusqu’à votre réponse. Pour ce qui ne doit pas être manqué." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जवाब देने तक स्क्रीन ढक देता है। उन बातों के लिए जो छूटनी नहीं चाहिए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menutupi layar sampai Anda merespons. Untuk hal yang tak boleh terlewat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "応答するまで画面全体に表示されます。見逃せない内容に向いています。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "응답할 때까지 화면 전체를 덮어요. 놓치면 안 되는 알림에 적합해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cobre a tela até você responder. Para o que não pode passar." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрывает экран, пока вы не ответите. Для того, что нельзя пропустить." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คลุมทั้งหน้าจอจนกว่าคุณจะตอบ สำหรับเรื่องที่พลาดไม่ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Siz yanıt verene kadar ekranı kaplar. Kaçırılmaması gerekenler için." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "覆盖整个屏幕，直到你回应。用于不能错过的事。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "覆蓋整個螢幕，直到你回應。用於不能錯過的事。" } } } },
    "konclui.reminders.display.card-hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تطفو فوق النوافذ دون أن تعيق ما تفعله." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "উইন্ডোর ওপরে ভাসে, আপনার কাজ আটকায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schwebt über deinen Fenstern, ohne dich zu blockieren." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Floats over your windows without blocking what you’re doing." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Flota sobre las ventanas sin bloquear lo que estás haciendo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Flotte au-dessus des fenêtres sans bloquer ce que vous faites." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "विंडो के ऊपर तैरता है, आपका काम नहीं रोकता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Melayang di atas jendela tanpa menghalangi pekerjaan Anda." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "作業を妨げず、ウインドウの上に表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "작업을 방해하지 않고 창 위에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Flutua sobre as janelas sem bloquear o que você está fazendo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Парит над окнами и не мешает работе." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลอยอยู่เหนือหน้าต่าง ไม่ขวางงานที่คุณทำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pencerelerin üstünde durur, yaptığınız işi engellemez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "浮在窗口上方，不会挡住你正在做的事。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "浮在視窗上方，不會擋住你正在做的事。" } } } },
