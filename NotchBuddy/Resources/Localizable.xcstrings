    "hub.history-empty %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر إملاءاتك هنا. اضغط مطولًا على %@ في أي تطبيق وتحدّث."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ডিক্টেশন এখানে দেখা যাবে। যেকোনো অ্যাপে %@ চেপে ধরে বলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Diktate erscheinen hier. Halte in einer beliebigen App %@ gedrückt und sprich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dictations will show here. Hold %@ in any app and speak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dictados aparecerán aquí. Mantén %@ en cualquier app y habla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes dictées s'afficheront ici. Maintiens %@ dans n'importe quelle app et parle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डिक्टेशन यहाँ दिखेंगे। किसी भी ऐप में %@ दबाए रखें और बोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktemu akan muncul di sini. Tahan %@ di aplikasi apa pun dan bicaralah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口述した内容がここに表示されます。どのアプリでも %@ を押したまま話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아쓴 내용이 여기에 쌓여요. 아무 앱에서나 %@ 키를 꾹 누르고 말해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus ditados aparecerão aqui. Segure %@ em qualquer app e fale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся ваши диктовки. Удерживайте %@ в любом приложении и говорите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความที่ป้อนจะแสดงที่นี่ กด %@ ค้างไว้ในแอปใดก็ได้แล้วพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktelerin burada görünür. Herhangi bir uygulamada %@ tuşunu basılı tut ve konuş."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的听写会显示在这里。在任何 App 中按住 %@ 说话即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽寫內容會顯示在這裡。在任何 App 中按住 %@ 並說話即可。"
          }
        }
      }
    },
    "hub.history-off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السجل متوقف. شغّله من إعدادات الإملاء ‹ الخصوصية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইতিহাস বন্ধ আছে। ডিক্টেশন সেটিংস › গোপনীয়তা-য় চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verlauf ist aus. Aktiviere ihn unter Diktat-Einstellungen › Datenschutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The history is off. Turn it on in Dictation settings › Privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial está desactivado. Actívalo en Ajustes del dictado › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'historique est désactivé. Active-le dans Réglages de la dictée › Confidentialité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास बंद है। इसे डिक्टेशन सेटिंग्स › गोपनीयता में चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat nonaktif. Aktifkan di Pengaturan dikte › Privasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴はオフです。設定 → プライバシーでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록이 꺼져 있어요. 설정 → 개인정보 보호에서 켤 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico está desligado. Ligue em Ajustes do ditado › Privacidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История выключена. Включите её в Настройки диктовки › Конфиденциальность."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดประวัติอยู่ เปิดได้ที่ การตั้งค่าการป้อนด้วยเสียง › ความเป็นส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş kapalı. Dikte ayarları › Gizlilik bölümünden aç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录已关闭。请在“听写设置”›“隐私”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歷史紀錄已關閉。請在「聽寫設定 › 隱私權」中開啟。"
