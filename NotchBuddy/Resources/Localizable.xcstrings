    "konclui.undo.app-style" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذف نمط التطبيق." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অ্যাপের স্টাইল মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "App-Stil gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "App style deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Estilo de la app borrado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Style de l'app supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ऐप की शैली हटा दी गई।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gaya aplikasi dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリのスタイルを削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 스타일을 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Estilo do app apagado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Стиль приложения удалён." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบรูปแบบของแอปแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulama üslubu silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除该 App 的风格。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除該 App 的風格。" } } } },
    "konclui.undo.snippet" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذف المقتطف." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "স্নিপেট মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Textbaustein gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snippet deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Fragmento borrado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Snippet supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "स्निपेट हटा दिया गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Cuplikan dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スニペットを削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "텍스트 조각을 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Trecho apagado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Шаблон удалён." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบข้อความสำเร็จรูปแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Metin kısayolu silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除该片段。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除該文字片段。" } } } },
    "konclui.undo.replacement" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذف الاستبدال." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রতিস্থাপন মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ersetzung gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Replacement deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Sustitución borrada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Remplacement supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बदलाव हटा दिया गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Penggantian dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "置換項目を削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "대체 항목을 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Substituição apagada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Замена удалена." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบคำแทนที่แล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değiştirme silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除该替换。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除該替換詞。" } } } },
    "konclui.undo.word" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذفت الكلمة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শব্দটি মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wort gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Word deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Palabra borrada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mot supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "शब्द हटा दिया गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kata dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "単語を削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단어를 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Palavra apagada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Слово удалено." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบคำแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sözcük silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除该词。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除該詞。" } } } },
    "konclui.claude.notes.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مع Claude يُرسل النص المكتوب (وليس الصوت أبدًا) عبر اشتراكك. أما Apple Intelligence فيكتبه على جهاز Mac (macOS 26)." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর সঙ্গে ট্রান্সক্রিপ্ট (কখনো অডিও নয়) আপনার সাবস্ক্রিপশন দিয়ে যায়। Apple Intelligence এটি আপনার Mac-এ লেখে (macOS 26)।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit Claude wird das Transkript über dein Abo gesendet, niemals das Audio. Apple Intelligence erstellt die Zusammenfassung auf deinem Mac (macOS 26)." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "With Claude, the transcript (never the audio) goes through your subscription. Apple Intelligence writes it on your Mac (macOS 26)." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Con Claude, la transcripción (nunca el audio) va con tu suscripción. Apple Intelligence lo escribe en tu Mac (macOS 26)." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Avec Claude, la transcription (jamais l'audio) passe par ton abonnement. Apple Intelligence l'écrit sur ton Mac (macOS 26)." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude के साथ ट्रांसक्रिप्ट (ऑडियो कभी नहीं) आपकी सदस्यता से होकर जाता है। Apple Intelligence इसे आपके Mac पर लिखता है (macOS 26)।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dengan Claude, transkrip (bukan audio) dikirim lewat langgananmu. Apple Intelligence menulisnya di Mac-mu (macOS 26)." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude を使うと、音声ではなく文字起こしがサブスクリプション経由で送信されます。Apple Intelligence は Mac 上でメモを作成します（macOS 26）。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude를 사용하면 오디오가 아닌 녹취록이 구독을 통해 전송돼요. Apple Intelligence는 Mac에서 메모를 작성해요(macOS 26)." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Com o Claude, a transcrição (nunca o áudio) vai pela sua assinatura. A Apple Intelligence escreve no seu Mac (macOS 26)." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "С Claude расшифровка (но не аудио) уходит по вашей подписке. Apple Intelligence пишет итог прямо на Mac (macOS 26)." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เมื่อใช้ Claude ระบบจะส่งข้อความถอดเสียง (ไม่ใช่เสียง) ผ่านการสมัครสมาชิกของคุณ ส่วน Apple Intelligence จะเขียนสรุปบน Mac (macOS 26)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude ile döküm, aboneliğin üzerinden gönderilir; ses asla gönderilmez. Apple Intelligence özeti Mac'inde yazar (macOS 26)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 Claude 时，转写文字（绝不是音频）会通过你的订阅发送。Apple 智能则在你的 Mac 上生成（macOS 26）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 Claude 時，會透過你的訂閱傳送逐字稿，不會傳送音訊。Apple Intelligence 則會在 Mac 上產生摘要（macOS 26）。" } } } },
    "konclui.claude.notes.engine.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude (اشتراكك)" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude (আপনার সাবস্ক্রিপশন)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude (dein Abo)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude (your subscription)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude (tu suscripción)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude (ton abonnement)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude (आपकी सदस्यता)" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude (langgananmu)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude（サブスクリプション）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude(구독)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Claude (sua assinatura)" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude (ваша подписка)" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude (การสมัครสมาชิกของคุณ)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude (aboneliğin)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude（你的订阅）" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude（你的訂閱）" } } } },
    "konclui.claude.connect.ai" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج وضع الموجّه والترجمة إلى Claude. صِل اشتراكك أو احفظ مفتاح Anthropic في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রম্পট মোড ও অনুবাদে Claude লাগে। চ্যাট পেজে আপনার সাবস্ক্রিপশন সংযুক্ত করুন বা একটি Anthropic কী সেভ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Prompt-Modus und Übersetzung brauchen Claude. Verbinde dein Abo oder speichere einen Anthropic-Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Prompt mode and translation need Claude. Connect your subscription or save an Anthropic key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El modo prompt y la traducción necesitan Claude. Conecta tu suscripción o guarda una clave de Anthropic en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le mode prompt et la traduction ont besoin de Claude. Connecte ton abonnement ou enregistre une clé Anthropic dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रॉम्प्ट मोड और अनुवाद के लिए Claude चाहिए। चैट पेज में अपनी सदस्यता जोड़ें या Anthropic कुंजी सहेजें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode prompt dan terjemahan butuh Claude. Sambungkan langgananmu atau simpan kunci Anthropic di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロンプトモードと翻訳には Claude が必要です。サブスクリプションを接続するか、チャットに Anthropic キーを保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "프롬프트 모드와 번역에는 Claude가 필요해요. 구독을 연결하거나 채팅에 Anthropic 키를 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O modo prompt e a tradução precisam do Claude. Conecte sua assinatura ou salve uma chave da Anthropic em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для режима промпта и перевода нужен Claude. Подключите подписку или сохраните ключ Anthropic на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "โหมดพรอมป์ต์และการแปลต้องใช้ Claude เชื่อมต่อการสมัครสมาชิกหรือบันทึกคีย์ Anthropic ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İstem modu ve çeviri için Claude gerekir. Aboneliğini bağla ya da Sohbet sayfasında bir Anthropic anahtarı kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提示词模式和翻译需要 Claude。请在“聊天”页面连接你的订阅或保存 Anthropic 密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提示詞模式與翻譯需要 Claude。請在「聊天」頁面連結你的訂閱或儲存 Anthropic 金鑰。" } } } },
    "konclui.claude.connect.cleanup" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج التنقيح إلى Claude أو Apple Intelligence. صِل اشتراكك أو احفظ مفتاح Anthropic في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরিষ্কার করতে Claude বা Apple Intelligence লাগে। চ্যাট পেজে আপনার সাবস্ক্রিপশন সংযুক্ত করুন বা একটি Anthropic কী সেভ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Überarbeitung braucht Claude oder Apple Intelligence. Verbinde dein Abo oder speichere einen Anthropic-Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Clean-up needs Claude or Apple Intelligence. Connect your subscription or save an Anthropic key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La limpieza necesita Claude o Apple Intelligence. Conecta tu suscripción o guarda una clave de Anthropic en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le nettoyage a besoin de Claude ou d'Apple Intelligence. Connecte ton abonnement ou enregistre une clé Anthropic dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सफ़ाई के लिए Claude या Apple Intelligence चाहिए। चैट पेज में अपनी सदस्यता जोड़ें या Anthropic कुंजी सहेजें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Perapian butuh Claude atau Apple Intelligence. Sambungkan langgananmu atau simpan kunci Anthropic di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "文章の整えには Claude または Apple Intelligence が必要です。サブスクリプションを接続するか、チャットに Anthropic キーを保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다듬기에는 Claude 또는 Apple Intelligence가 필요해요. 구독을 연결하거나 채팅에 Anthropic 키를 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A limpeza precisa do Claude ou da Apple Intelligence. Conecte sua assinatura ou salve uma chave da Anthropic em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для чистки нужен Claude или Apple Intelligence. Подключите подписку или сохраните ключ Anthropic на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การปรับข้อความต้องใช้ Claude หรือ Apple Intelligence เชื่อมต่อการสมัครสมาชิกหรือบันทึกคีย์ Anthropic ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düzenleme için Claude veya Apple Intelligence gerekir. Aboneliğini bağla ya da Sohbet sayfasında bir Anthropic anahtarı kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "整理需要 Claude 或 Apple 智能。请在“聊天”页面连接你的订阅或保存 Anthropic 密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "文字整理需要 Claude 或 Apple Intelligence。請在「聊天」頁面連結你的訂閱或儲存 Anthropic 金鑰。" } } } },
    "konclui.claude.privacy.apple" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ينقّح Apple Intelligence الكلمات على هذا الـ Mac ولا يغادره شيء. إذا تعذّر ذلك، تُلصق الكلمات كما سُمعت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence এই Mac-এই কথাগুলো পরিষ্কার করে। কিছুই এটি ছেড়ে যায় না। না পারলে কথাগুলো যেমন শোনা গেছে তেমনই পেস্ট হয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence überarbeitet die Worte auf diesem Mac. Nichts verlässt ihn. Wenn es nicht klappt, werden die Worte wie gehört eingefügt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence cleans up the words on this Mac. Nothing leaves it. If it can't, the words are pasted as heard." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence limpia las palabras en este Mac. Nada sale de él. Si no puede, las palabras se pegan tal cual." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence nettoie les mots sur ce Mac. Rien n'en sort. S'il n'y arrive pas, les mots sont collés tels qu'entendus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence इसी Mac पर शब्दों को साफ़ करता है। कुछ भी बाहर नहीं जाता। अगर वह न कर सके, तो शब्द जैसे सुने गए वैसे पेस्ट होते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence merapikan kata-kata di Mac ini. Tidak ada yang keluar darinya. Jika gagal, kata-kata ditempel apa adanya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence はこの Mac 上で文章を整えます。内容が Mac の外に送られることはありません。整えられない場合は、聞き取ったままペーストします。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence가 이 Mac에서 텍스트를 다듬어요. 내용은 Mac 밖으로 나가지 않아요. 다듬을 수 없으면 들은 그대로 붙여넣어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A Apple Intelligence limpa as palavras neste Mac. Nada sai dele. Se ela não conseguir, as palavras são coladas como foram ouvidas." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence чистит слова прямо на этом Mac, и ничего не уходит наружу. Если не получится, слова вставятся как услышаны." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence ปรับข้อความบน Mac เครื่องนี้ และไม่มีอะไรออกจากเครื่อง หากทำไม่ได้ ระบบจะพิมพ์ข้อความตามที่ได้ยิน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence sözleri bu Mac'te düzenler. Hiçbir şey dışarı çıkmaz. Başaramazsa sözlerin duyulduğu gibi yapıştırılır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 智能在这台 Mac 上整理文字，不会有任何内容离开它。如果整理不了，就按听到的原文粘贴。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence 會在這部 Mac 上整理文字，不會有任何內容離開它。若無法整理，會貼上辨識到的原始文字。" } } } },
    "konclui.claude.privacy.key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكلمات فقط، نصًّا، تُرسل إلى Claude بمفتاح Anthropic الخاص بك، أما صوتك فيبقى على جهاز Mac. إذا لم يرد Claude في الوقت المناسب، تُلصق الكلمات كما سُمعت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শুধু কথাগুলো, লেখা আকারে, আপনার Anthropic কী দিয়ে Claude-এর কাছে যায়। আপনার কণ্ঠ আপনার Mac-এই থাকে। Claude সময়মতো উত্তর না দিলে কথাগুলো যেমন শোনা গেছে তেমনই পেস্ট হয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur der Text geht mit deinem Anthropic-Schlüssel an Claude, niemals deine Stimme, die auf deinem Mac bleibt. Wenn Claude nicht rechtzeitig antwortet, werden deine Worte wie gehört eingefügt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Only the words, as text, go to Claude with your Anthropic key. Your voice stays on your Mac. If Claude doesn't answer in time, the words are pasted as heard." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo las palabras, como texto, van a Claude con tu clave de Anthropic; tu voz se queda en tu Mac. Si Claude no responde a tiempo, las palabras se pegan tal cual." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Seuls les mots, sous forme de texte, vont à Claude avec ta clé Anthropic ; ta voix reste sur ton Mac. Si Claude ne répond pas à temps, les mots sont collés tels qu'entendus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिर्फ़ शब्द, टेक्स्ट के रूप में, आपकी Anthropic कुंजी से Claude तक जाते हैं; आपकी आवाज़ आपके Mac पर रहती है। अगर Claude समय पर जवाब न दे, तो शब्द जैसे सुने गए वैसे पेस्ट होते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hanya kata-kata, dalam bentuk teks, yang dikirim ke Claude dengan kunci Anthropic-mu; suaramu tetap di Mac-mu. Jika Claude tidak menjawab tepat waktu, kata-kata ditempel apa adanya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テキストのみが Anthropic キーを使って Claude に送信されます。音声は Mac 内にとどまります。Claude が時間内に応答しない場合は、聞き取ったままペーストします。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "텍스트로 된 내용만 Anthropic 키를 사용해 Claude로 전송돼요. 음성은 Mac에 남아요. Claude가 제시간에 답하지 않으면 들은 그대로 붙여넣어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Só as palavras, em texto, vão para o Claude com a sua chave da Anthropic. Sua voz fica no seu Mac. Se o Claude não responder a tempo, as palavras são coladas como foram ouvidas." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "К Claude с вашим ключом Anthropic уходят только слова в виде текста, а голос остаётся на вашем Mac. Если Claude не ответит вовремя, слова вставятся как услышаны." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ระบบส่งเฉพาะข้อความไปยัง Claude ด้วยคีย์ Anthropic ของคุณ ส่วนเสียงยังคงอยู่บน Mac ของคุณ หาก Claude ไม่ตอบทันเวลา ระบบจะพิมพ์ข้อความตามที่ได้ยิน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'a Anthropic anahtarınla yalnızca metin gider; sesin Mac'inde kalır. Claude zamanında yanıt vermezse sözlerin duyulduğu gibi yapıştırılır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有文字会用你的 Anthropic 密钥发送给 Claude，声音始终留在你的 Mac 上。如果 Claude 没有及时回复，就按听到的原文粘贴。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只會將文字使用你的 Anthropic 金鑰傳送給 Claude，語音會留在 Mac 上。若 Claude 未及時回應，會貼上辨識到的原始文字。" } } } },
    "konclui.claude.privacy.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكلمات فقط، نصًّا، تُرسل إلى Claude عبر اشتراكك، أما صوتك فيبقى على جهاز Mac. إذا لم يرد Claude في الوقت المناسب، تُلصق الكلمات كما سُمعت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শুধু কথাগুলো, লেখা আকারে, আপনার সাবস্ক্রিপশন দিয়ে Claude-এর কাছে যায়। আপনার কণ্ঠ আপনার Mac-এই থাকে। Claude সময়মতো উত্তর না দিলে কথাগুলো যেমন শোনা গেছে তেমনই পেস্ট হয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur der Text geht über dein Abo an Claude, niemals deine Stimme, die auf deinem Mac bleibt. Wenn Claude nicht rechtzeitig antwortet, werden deine Worte wie gehört eingefügt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Only the words, as text, go to Claude through your subscription. Your voice stays on your Mac. If Claude doesn't answer in time, the words are pasted as heard." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo las palabras, como texto, van a Claude con tu suscripción; tu voz se queda en tu Mac. Si Claude no responde a tiempo, las palabras se pegan tal cual." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Seuls les mots, sous forme de texte, vont à Claude via ton abonnement ; ta voix reste sur ton Mac. Si Claude ne répond pas à temps, les mots sont collés tels qu'entendus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिर्फ़ शब्द, टेक्स्ट के रूप में, आपकी सदस्यता से होकर Claude तक जाते हैं; आपकी आवाज़ आपके Mac पर रहती है। अगर Claude समय पर जवाब न दे, तो शब्द जैसे सुने गए वैसे पेस्ट होते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hanya kata-kata, dalam bentuk teks, yang dikirim ke Claude lewat langgananmu; suaramu tetap di Mac-mu. Jika Claude tidak menjawab tepat waktu, kata-kata ditempel apa adanya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テキストのみがサブスクリプション経由で Claude に送信されます。音声は Mac 内にとどまります。Claude が時間内に応答しない場合は、聞き取ったままペーストします。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "텍스트로 된 내용만 구독을 통해 Claude로 전송돼요. 음성은 Mac에 남아요. Claude가 제시간에 답하지 않으면 들은 그대로 붙여넣어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Só as palavras, em texto, vão para o Claude pela sua assinatura. Sua voz fica no seu Mac. Se o Claude não responder a tempo, as palavras são coladas como foram ouvidas." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "К Claude по вашей подписке уходят только слова в виде текста, а голос остаётся на вашем Mac. Если Claude не ответит вовремя, слова вставятся как услышаны." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ระบบส่งเฉพาะข้อความไปยัง Claude ผ่านการสมัครสมาชิกของคุณ ส่วนเสียงยังคงอยู่บน Mac ของคุณ หาก Claude ไม่ตอบทันเวลา ระบบจะพิมพ์ข้อความตามที่ได้ยิน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'a aboneliğin üzerinden yalnızca metin gider; sesin Mac'inde kalır. Claude zamanında yanıt vermezse sözlerin duyulduğu gibi yapıştırılır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有文字会通过你的订阅发送给 Claude，声音始终留在你的 Mac 上。如果 Claude 没有及时回复，就按听到的原文粘贴。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只會將文字透過你的訂閱傳送給 Claude，語音會留在 Mac 上。若 Claude 未及時回應，會貼上辨識到的原始文字。" } } } },
    "konclui.claude.fail.apple" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتمكن Apple Intelligence من تنقيح هذا الإملاء، فلُصق كما سُمع. حاول مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence এই ডিক্টেশন পরিষ্কার করতে পারেনি, তাই এটি যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence konnte dieses Diktat nicht überarbeiten, deshalb wurde es wie gehört eingefügt. Versuche es erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence couldn't clean this up, so it was pasted as heard. Try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence no pudo limpiar este dictado, así que se pegó tal cual. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence n'a pas pu nettoyer cette dictée, elle a donc été collée telle qu'entendue. Réessaie." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence यह डिक्टेशन साफ़ नहीं कर सका, इसलिए यह जैसा सुना गया वैसा पेस्ट हुआ। फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence tidak bisa merapikan dikte ini, jadi ditempel apa adanya. Coba lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence が文章を整えられなかったため、聞き取ったままペーストしました。もう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence가 이 내용을 다듬지 못해 들은 그대로 붙여넣었어요. 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A Apple Intelligence não conseguiu limpar este ditado, então ele foi colado como foi ouvido. Tente de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence не смог почистить эту диктовку, поэтому она вставлена как услышана. Попробуйте ещё раз." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence ปรับข้อความที่บอกนี้ไม่ได้ จึงพิมพ์ตามที่ได้ยิน ลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence bu diktenin düzenini yapamadı, bu yüzden duyulduğu gibi yapıştırıldı. Tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 智能无法整理这次听写，所以按听到的原文粘贴了。请再试一次。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence 無法整理這次聽寫，所以貼上了辨識到的原始文字。請再試一次。" } } } },
    "konclui.claude.fail.reply" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر استخدام ردّ Claude، فلُصق هذا الإملاء كما سُمع. حاول مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর উত্তর ব্যবহার করা যায়নি, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Antwort von Claude war nicht brauchbar, deshalb wurde dieses Diktat wie gehört eingefügt. Versuche es erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude's answer couldn't be used, so this dictation was pasted as heard. Try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo usar la respuesta de Claude, así que este dictado se pegó tal cual. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La réponse de Claude était inutilisable, la dictée a donc été collée telle qu'entendue. Réessaie." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude का जवाब इस्तेमाल नहीं हो सका, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jawaban Claude tidak bisa dipakai, jadi dikte ini ditempel apa adanya. Coba lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の回答を使用できなかったため、この音声入力は聞き取ったままペーストしました。もう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude의 답변을 사용할 수 없어 이 받아쓰기는 들은 그대로 붙여넣었어요. 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A resposta do Claude não pôde ser usada, então este ditado foi colado como foi ouvido. Tente de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ответ Claude не удалось использовать, поэтому эта диктовка вставлена как услышана. Попробуйте ещё раз." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ใช้คำตอบของ Claude ไม่ได้ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน ลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'un yanıtı kullanılamadı, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用 Claude 的回复，所以这次听写按听到的原文粘贴了。请再试一次。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法使用 Claude 的回覆，所以這次聽寫貼上了辨識到的原始文字。請再試一次。" } } } },
    "konclui.claude.fail.slow" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأخر Claude كثيرًا، فلُصق هذا الإملاء كما سُمع. إن تكرر ذلك، تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude অনেক দেরি করেছে, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। বারবার হলে আপনার সংযোগ দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude hat zu lange gebraucht, deshalb wurde dieses Diktat wie gehört eingefügt. Wenn das öfter passiert, prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude took too long, so this dictation was pasted as heard. If it keeps happening, check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude tardó demasiado, así que este dictado se pegó tal cual. Si sigue pasando, revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude a mis trop de temps, la dictée a donc été collée telle qu'entendue. Si cela continue, vérifie ta connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude ने बहुत देर लगाई, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। बार-बार हो तो अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude terlalu lama, jadi dikte ini ditempel apa adanya. Kalau terus begini, periksa koneksimu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の応答に時間がかかりすぎたため、この音声入力は聞き取ったままペーストしました。繰り返す場合は接続を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude의 응답이 너무 늦어 이 받아쓰기는 들은 그대로 붙여넣었어요. 계속되면 연결을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude demorou demais, então este ditado foi colado como foi ouvido. Se continuar, confira sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude отвечал слишком долго, поэтому эта диктовка вставлена как услышана. Если это повторяется, проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ใช้เวลานานเกินไป จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน หากเกิดซ้ำ ให้ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude çok geç yanıt verdi, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Tekrar ederse bağlantını kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 响应太慢，所以这次听写按听到的原文粘贴了。如果经常这样，请检查你的网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 回應太慢，所以這次聽寫貼上了辨識到的原始文字。如果經常這樣，請檢查你的網路連線。" } } } },
    "konclui.claude.fail.offline" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر الوصول إلى Claude، فلُصق هذا الإملاء كما سُمع. تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর সঙ্গে যোগাযোগ করা যায়নি, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। আপনার সংযোগ দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude war nicht erreichbar, deshalb wurde dieses Diktat wie gehört eingefügt. Prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude couldn't be reached, so this dictation was pasted as heard. Check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo contactar con Claude, así que este dictado se pegó tal cual. Revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude est injoignable, la dictée a donc été collée telle qu'entendue. Vérifie ta connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude तक पहुँचा नहीं जा सका, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude tidak bisa dihubungi, jadi dikte ini ditempel apa adanya. Periksa koneksimu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude に接続できなかったため、この音声入力は聞き取ったままペーストしました。接続を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude에 연결할 수 없어 이 받아쓰기는 들은 그대로 붙여넣었어요. 연결을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível falar com o Claude, então este ditado foi colado como foi ouvido. Confira sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось связаться с Claude, поэтому эта диктовка вставлена как услышана. Проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อ Claude ไม่ได้ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'a ulaşılamadı, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Bağlantını kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接到 Claude，所以这次听写按听到的原文粘贴了。请检查你的网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法連線到 Claude，所以這次聽寫貼上了辨識到的原始文字。請檢查你的網路連線。" } } } },
    "konclui.claude.fail.busy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude مشغول، فلُصق هذا الإملاء كما سُمع. حاول مجددًا بعد قليل." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude এখন ব্যস্ত, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। একটু পরে আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude ist ausgelastet, deshalb wurde dieses Diktat wie gehört eingefügt. Versuche es gleich noch einmal." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude is busy, so this dictation was pasted as heard. Try again in a moment." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude está ocupado, así que este dictado se pegó tal cual. Inténtalo de nuevo en un momento." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude est occupé, la dictée a donc été collée telle qu'entendue. Réessaie dans un instant." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude अभी व्यस्त है, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। थोड़ी देर बाद फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude sedang sibuk, jadi dikte ini ditempel apa adanya. Coba lagi sebentar lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude がビジーのため、この音声入力は聞き取ったままペーストしました。しばらくしてからもう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude가 바빠 이 받아쓰기는 들은 그대로 붙여넣었어요. 잠시 후 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude está ocupado, então este ditado foi colado como foi ouvido. Tente de novo em instantes." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude сейчас занят, поэтому эта диктовка вставлена как услышана. Повторите чуть позже." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ไม่ว่างในขณะนี้ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน ลองอีกครั้งในอีกสักครู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude şu an meşgul, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Biraz sonra tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 现在比较忙，所以这次听写按听到的原文粘贴了。请稍后再试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 目前忙碌中，所以這次聽寫貼上了辨識到的原始文字。請稍後再試。" } } } },
    "konclui.claude.fail.limit" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم بلوغ حد Claude، فلُصق هذا الإملاء كما سُمع. حاول مجددًا بعد بضع دقائق." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর সীমা ছুঁয়ে গেছে, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। কয়েক মিনিট পরে আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Limit von Claude ist erreicht, deshalb wurde dieses Diktat wie gehört eingefügt. Versuche es in ein paar Minuten erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude's limit was reached, so this dictation was pasted as heard. Try again in a few minutes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se alcanzó el límite de Claude, así que este dictado se pegó tal cual. Inténtalo de nuevo en unos minutos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La limite de Claude est atteinte, la dictée a donc été collée telle qu'entendue. Réessaie dans quelques minutes." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude की सीमा पूरी हो गई, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। कुछ मिनट बाद फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batas Claude tercapai, jadi dikte ini ditempel apa adanya. Coba lagi beberapa menit lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の上限に達したため、この音声入力は聞き取ったままペーストしました。数分後にもう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude 사용 한도에 도달해 이 받아쓰기는 들은 그대로 붙여넣었어요. 몇 분 후 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O limite do Claude foi atingido, então este ditado foi colado como foi ouvido. Tente de novo em alguns minutos." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Лимит Claude исчерпан, поэтому эта диктовка вставлена как услышана. Повторите через несколько минут." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ถึงขีดจำกัดของ Claude แล้ว จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน ลองอีกครั้งในอีกไม่กี่นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude sınırına ulaşıldı, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Birkaç dakika sonra tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已达到 Claude 的用量上限，所以这次听写按听到的原文粘贴了。请几分钟后再试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已達到 Claude 的用量上限，所以這次聽寫貼上了辨識到的原始文字。請幾分鐘後再試。" } } } },
    "konclui.claude.fail.refused.key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض Claude مفتاحك، فلُصق هذا الإملاء كما سُمع. تحقق من المفتاح في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude আপনার কী গ্রহণ করেনি, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। চ্যাট পেজে কী-টি দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude hat deinen Schlüssel abgelehnt, deshalb wurde dieses Diktat wie gehört eingefügt. Prüfe den Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude refused your key, so this dictation was pasted as heard. Check the key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude rechazó tu clave, así que este dictado se pegó tal cual. Revisa la clave en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude a refusé ta clé, la dictée a donc été collée telle qu'entendue. Vérifie la clé dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude ने आपकी कुंजी अस्वीकार कर दी, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। चैट पेज में कुंजी जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude menolak kuncimu, jadi dikte ini ditempel apa adanya. Periksa kunci di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude がキーを拒否したため、この音声入力は聞き取ったままペーストしました。チャットでキーを確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude가 키를 거부해 이 받아쓰기는 들은 그대로 붙여넣었어요. 채팅에서 키를 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude recusou sua chave, então este ditado foi colado como foi ouvido. Confira a chave em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude отклонил ваш ключ, поэтому эта диктовка вставлена как услышана. Проверьте ключ на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ปฏิเสธคีย์ของคุณ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน ตรวจสอบคีย์ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude anahtarını reddetti, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Anahtarı Sohbet sayfasında kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 拒绝了你的密钥，所以这次听写按听到的原文粘贴了。请在“聊天”页面检查密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 拒絕了你的金鑰，所以這次聽寫貼上了辨識到的原始文字。請在「聊天」頁面檢查金鑰。" } } } },
    "konclui.claude.fail.refused.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رُفض اشتراكك، فلُصق هذا الإملاء كما سُمع. شغّل klaude doctor في Terminal." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার সাবস্ক্রিপশন গ্রহণ করা হয়নি, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। Terminal-এ klaude doctor চালান।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Abo wurde abgelehnt, deshalb wurde dieses Diktat wie gehört eingefügt. Führe klaude doctor im Terminal aus." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your subscription was refused, so this dictation was pasted as heard. Run klaude doctor in Terminal." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu suscripción fue rechazada, así que este dictado se pegó tal cual. Ejecuta klaude doctor en Terminal." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton abonnement a été refusé, la dictée a donc été collée telle qu'entendue. Lance klaude doctor dans le Terminal." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी सदस्यता अस्वीकार कर दी गई, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। Terminal में klaude doctor चलाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langgananmu ditolak, jadi dikte ini ditempel apa adanya. Jalankan klaude doctor di Terminal." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サブスクリプションが拒否されたため、この音声入力は聞き取ったままペーストしました。ターミナルで klaude doctor を実行してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "구독이 거부되어 이 받아쓰기는 들은 그대로 붙여넣었어요. 터미널에서 klaude doctor를 실행하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sua assinatura foi recusada, então este ditado foi colado como foi ouvido. Rode klaude doctor no Terminal." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подписка отклонена, поэтому эта диктовка вставлена как услышана. Выполните klaude doctor в Терминале." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การสมัครสมาชิกของคุณถูกปฏิเสธ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน รัน klaude doctor ใน Terminal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aboneliğin reddedildi, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Terminal'de klaude doctor çalıştır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的订阅被拒绝了，所以这次听写按听到的原文粘贴了。请在终端运行 klaude doctor。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的訂閱遭到拒絕，所以這次聽寫貼上了辨識到的原始文字。請在終端機執行 klaude doctor。" } } } },
    "konclui.claude.fail.none" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude غير متصل، فلُصق هذا الإملاء كما سُمع. صِل اشتراكك أو احفظ مفتاحًا في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude সংযুক্ত নেই, তাই এই ডিক্টেশন যেমন শোনা গেছে তেমনই পেস্ট হয়েছে। চ্যাট পেজে আপনার সাবস্ক্রিপশন সংযুক্ত করুন বা একটি কী সেভ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude ist nicht verbunden, deshalb wurde dieses Diktat wie gehört eingefügt. Verbinde dein Abo oder speichere einen Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude isn't connected, so this dictation was pasted as heard. Connect your subscription or save a key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude no está conectado, así que este dictado se pegó tal cual. Conecta tu suscripción o guarda una clave en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude n'est pas connecté, la dictée a donc été collée telle qu'entendue. Connecte ton abonnement ou enregistre une clé dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude कनेक्ट नहीं है, इसलिए यह डिक्टेशन जैसा सुना गया वैसा पेस्ट हुआ। चैट पेज में अपनी सदस्यता जोड़ें या कुंजी सहेजें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude belum tersambung, jadi dikte ini ditempel apa adanya. Sambungkan langgananmu atau simpan kunci di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude に接続されていないため、この音声入力は聞き取ったままペーストしました。サブスクリプションを接続するか、チャットにキーを保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude에 연결되어 있지 않아 이 받아쓰기는 들은 그대로 붙여넣었어요. 구독을 연결하거나 채팅에 키를 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude não está conectado, então este ditado foi colado como foi ouvido. Conecte sua assinatura ou salve uma chave em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude не подключён, поэтому эта диктовка вставлена как услышана. Подключите подписку или сохраните ключ на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ยังไม่ได้เชื่อมต่อ จึงพิมพ์ข้อความที่บอกตามที่ได้ยิน เชื่อมต่อการสมัครสมาชิกหรือบันทึกคีย์ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude bağlı değil, bu yüzden bu dikte duyulduğu gibi yapıştırıldı. Aboneliğini bağla ya da Sohbet sayfasında bir anahtar kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 未连接，所以这次听写按听到的原文粘贴了。请在“聊天”页面连接你的订阅或保存密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 尚未連線，所以這次聽寫貼上了辨識到的原始文字。請在「聊天」頁面連結你的訂閱或儲存金鑰。" } } } },
    "hub.notch.reminders" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تذكيرات محلية مع تنبيهات قابلة للتخصيص." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কাস্টমাইজ করা যায় এমন সতর্কবার্তাসহ স্থানীয় রিমাইন্ডার।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Lokale Erinnerungen mit anpassbaren Hinweisen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Local reminders with alerts you can customize." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios locales con avisos personalizables." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappels locaux avec des alertes personnalisables." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अनुकूलित की जा सकने वाली सूचनाओं के साथ स्थानीय रिमाइंडर।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat lokal dengan peringatan yang bisa disesuaikan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "通知をカスタマイズできるローカルリマインダー。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림 방식을 사용자화할 수 있는 로컬 미리 알림." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembretes locais com alertas personalizáveis." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Локальные напоминания с настраиваемыми оповещениями." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนความจำในเครื่องพร้อมการแจ้งเตือนที่ปรับแต่งได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Özelleştirilebilir uyarılarla yerel hatırlatıcılar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "带有可自定义提醒方式的本地提醒。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可自訂提醒方式的本機提醒。" } } } },
    "konclui.features.block.updates" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحديثات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপডেট" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktualisierungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Actualizaciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mises à jour" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपडेट" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pembaruan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデート" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "업데이트" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Atualizações" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обновления" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การอัปเดต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Güncellemeler" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更新" } } } },
    "konclui.remove.item.failed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تتم الإزالة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সরানো হয়নি" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht entfernt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Not removed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se quitó" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Non retiré" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाया नहीं गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak dihapus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除できませんでした" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "제거되지 않음" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não removido" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่ได้ลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaldırılamadı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未能移除" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未能移除" } } } },
    "konclui.remove.item.removed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تمت الإزالة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সরানো হয়েছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Entfernt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Removed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retiré" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटा दिया गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dihapus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除しました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "제거됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Removido" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaldırıldı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已移除" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已移除" } } } },
    "konclui.remove.item.nothing" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا شيء للإزالة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সরানোর কিছু নেই" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nichts zu entfernen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing to remove" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Nada que quitar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rien à retirer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाने को कुछ नहीं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada yang dihapus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除する項目はありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "제거할 항목 없음" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nada a remover" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нечего удалять" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่มีอะไรให้ลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaldırılacak bir şey yok" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可移除的内容" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有可移除的內容" } } } },
    "konclui.remove.close" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إغلاق" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schließen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cerrar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fermer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tutup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "閉じる" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "닫기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fechar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Закрыть" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapat" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉" } } } },
    "konclui.remove.done" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "انتهى. نتيجة كل ملف أعلاه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শেষ। প্রতিটি ফাইলের ফলাফল উপরে আছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Fertig. Das Ergebnis je Datei steht oben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Finished. The result for each file is above." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Terminado. El resultado de cada archivo está arriba." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Terminé. Le résultat de chaque fichier est ci-dessus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पूरा हुआ। हर फ़ाइल का नतीजा ऊपर है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selesai. Hasil tiap berkas ada di atas." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "完了しました。各ファイルの結果は上に表示されています。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료됐어요. 각 파일의 결과는 위에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Concluído. O resultado de cada arquivo está acima." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Готово. Результат по каждому файлу выше." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เสร็จสิ้น ผลของแต่ละไฟล์อยู่ด้านบน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bitti. Her dosyanın sonucu yukarıda." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已完成。每个文件的结果见上方。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已完成。每個檔案的結果見上方。" } } } },
    "konclui.remove.note" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يُكتب شيء قبل أن تضغط. تُزال إدخالات Koncluí فقط وتبقى إدخالاتك. يمكنك تثبيتها مجدداً من الوكلاء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি ক্লিক না করা পর্যন্ত কিছু লেখা হয় না। শুধু Koncluí-এর এন্ট্রি যাবে; আপনারগুলো থাকবে। এজেন্ট পেজ থেকে আবার ইনস্টল করা যাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Vor deinem Klick wird nichts geschrieben. Nur die Einträge von Koncluí verschwinden, deine bleiben. In Agenten kannst du sie wieder installieren." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing is written until you click. Only Koncluí's entries go; yours stay. You can install them again in Agents." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se escribe nada hasta que hagas clic. Solo salen las entradas de Koncluí; las tuyas se quedan. Puedes instalarlas de nuevo en Agentes." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rien n'est écrit avant ton clic. Seules les entrées de Koncluí partent, les tiennes restent. Tu peux les réinstaller dans Agents." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके क्लिक करने तक कुछ नहीं लिखा जाता। सिर्फ़ Koncluí की प्रविष्टियाँ हटेंगी, आपकी रहेंगी। एजेंट पेज से इन्हें फिर इंस्टॉल कर सकते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada yang ditulis sebelum kamu mengeklik. Hanya entri Koncluí yang dihapus; milikmu tetap. Kamu bisa memasangnya lagi di Agen." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クリックするまで何も書き込まれません。削除されるのは Koncluí の項目だけで、ユーザーの項目は残ります。エージェントから再インストールできます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "클릭하기 전에는 아무것도 기록되지 않아요. Koncluí 항목만 제거되고 사용자 항목은 그대로 남아요. 에이전트에서 다시 설치할 수 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nada é gravado antes do seu clique. Só saem as entradas do Koncluí; as suas ficam. Você pode instalar de novo em Agentes." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ничего не записывается до твоего клика. Уходят только записи Koncluí, твои остаются. Установить снова можно в разделе «Агенты»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จะไม่มีการเขียนอะไรจนกว่าคุณจะคลิก ระบบจะลบเฉพาะรายการของ Koncluí ส่วนของคุณยังอยู่ และติดตั้งใหม่ได้ที่หน้าเอเจนต์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tıklayana kadar hiçbir şey yazılmaz. Yalnızca Koncluí'nin girdileri gider, seninkiler kalır. Ajanlar sayfasından yeniden kurabilirsin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你点击之前不会写入任何内容。只移除 Koncluí 的条目，你自己的保持不变。之后可以在“代理”页面重新安装。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你點擊之前不會寫入任何內容。只移除 Koncluí 的項目，你自己的保持不變。之後可以在「代理程式」頁面重新安裝。" } } } },
    "konclui.remove.confirm" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إزالة التكاملات (%lld)" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ইন্টিগ্রেশন সরান (%lld)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Integrationen entfernen (%lld)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove integrations (%lld)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar integraciones (%lld)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer les intégrations (%lld)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इंटीग्रेशन हटाएँ (%lld)" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus integrasi (%lld)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "統合を削除（%lld）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "통합 제거(%lld개)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover integrações (%lld)" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить интеграции (%lld)" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบการเชื่อมต่อ (%lld)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Entegrasyonları kaldır (%lld)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除集成（%lld）" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移除整合（%lld）" } } } },
    "konclui.remove.heading" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إزالة تكاملات Koncluí" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí-এর ইন্টিগ্রেশন সরান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Integrationen von Koncluí entfernen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove Koncluí's integrations" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar las integraciones de Koncluí" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer les intégrations de Koncluí" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí के इंटीग्रेशन हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus integrasi Koncluí" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí の統合を削除" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 통합 제거" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover integrações do Koncluí" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить интеграции Koncluí" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบการเชื่อมต่อของ Koncluí" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí entegrasyonlarını kaldır" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除 Koncluí 的集成" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移除 Koncluí 的整合" } } } },
    "konclui.remove.open" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إزالة التكاملات…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ইন্টিগ্রেশন সরান…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Integrationen entfernen…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove integrations…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar integraciones…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer les intégrations…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इंटीग्रेशन हटाएँ…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus integrasi…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "統合を削除…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "통합 제거…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover integrações…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить интеграции…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบการเชื่อมต่อ…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Entegrasyonları kaldır…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除集成…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移除整合…" } } } },
    "konclui.remove.about" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كتب Koncluí الـ hooks والإضافات في %lld ملفات ليصل وكلاؤك إلى الـ notch. أزلها قبل حذف Koncluí وإلا سيستمر وكلاؤك في البحث عنه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার এজেন্ট notch-এ পৌঁছাতে Koncluí %lld টি ফাইলে hooks ও প্লাগইন লিখেছে। Koncluí মুছে ফেলার আগে এগুলো সরান, নইলে আপনার এজেন্ট ওকে খুঁজতেই থাকবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí hat Hooks und Plugins in %lld Dateien geschrieben, damit deine Agenten den Notch erreichen. Entferne sie, bevor du Koncluí löschst, sonst suchen deine Agenten weiter danach." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí wrote hooks and plugins in %lld files so your agents reach the notch. Remove them before you delete Koncluí, or your agents keep looking for it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí escribió hooks y plugins en %lld archivos para que tus agentes lleguen al notch. Quítalos antes de borrar Koncluí o tus agentes seguirán buscándolo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí a écrit des hooks et des plugins dans %lld fichiers pour que tes agents arrivent dans le notch. Retire-les avant de supprimer Koncluí, sinon tes agents continueront à le chercher." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके एजेंट notch तक पहुँचें, इसके लिए Koncluí ने %lld फ़ाइलों में hooks और प्लगइन लिखे हैं। Koncluí हटाने से पहले इन्हें हटा दें, वरना आपके एजेंट उसे खोजते रहेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí menulis hooks dan plugin di %lld berkas agar agen kamu sampai ke notch. Hapus sebelum menghapus Koncluí, atau agen kamu akan terus mencarinya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "エージェントをノッチに接続するため、Koncluí は %lld 個のファイルにフックとプラグインを書き込みました。Koncluí を削除する前にこれらを削除してください。削除しないと、エージェントは Koncluí を探し続けます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "에이전트가 노치에 연결되도록 Koncluí가 %lld개 파일에 훅과 플러그인을 작성했어요. Koncluí를 삭제하기 전에 제거하세요. 그렇지 않으면 에이전트가 계속 Koncluí를 찾아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí gravou hooks e plugins em %lld arquivos para os agentes chegarem ao notch. Remova antes de apagar o Koncluí, ou seus agentes continuam procurando por ele." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí записал хуки и плагины в %lld файлах, чтобы твои агенты доходили до notch. Убери их до удаления Koncluí, иначе агенты будут его искать." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí เขียน hooks และปลั๊กอินไว้ใน %lld ไฟล์เพื่อให้เอเจนต์ของคุณส่งมาถึง notch ควรลบออกก่อนลบ Koncluí ไม่เช่นนั้นเอเจนต์จะยังพยายามหามัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí, ajanların notch'a ulaşması için %lld dosyaya hook ve eklenti yazdı. Koncluí'yi silmeden önce bunları kaldır, yoksa ajanların onu aramaya devam eder." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为了让代理连接到 notch，Koncluí 在 %lld 个文件中写入了 hooks 和插件。删除 Koncluí 之前请先移除，否则你的代理会继续寻找它。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為了讓代理程式連接到 notch，Koncluí 在 %lld 個檔案中寫入了 hooks 和外掛。刪除 Koncluí 之前請先移除，否則你的代理程式會繼續尋找它。" } } } },
    "konclui.remove.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التكامل مع وكلائك" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার এজেন্টদের সাথে ইন্টিগ্রেশন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Integrationen mit deinen Agenten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Integrations with your agents" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Integraciones con tus agentes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Intégrations avec tes agents" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके एजेंट के साथ इंटीग्रेशन" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Integrasi dengan agen kamu" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "エージェントとの統合" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "에이전트 통합" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Integrações com os agentes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Интеграции с твоими агентами" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเชื่อมต่อกับเอเจนต์ของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ajanlarınla entegrasyonlar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与代理的集成" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "與代理程式的整合" } } } },
    "konclui.connect.action" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ربط الوكلاء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এজেন্ট সংযুক্ত করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Agenten verbinden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect agents" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectar agentes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecter les agents" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "एजेंट जोड़ें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hubungkan agen" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "エージェントを接続" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "에이전트 연결" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conectar agentes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключить агентов" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อเอเจนต์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ajanları bağla" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接代理" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連接代理程式" } } } },
    "konclui.connect.body" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم العثور عليها على هذا الـ Mac: %@. تصل إلى الـ notch بعد ربطها." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এ পাওয়া গেছে: %@। সংযুক্ত হলে এগুলো notch-এ পৌঁছাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf diesem Mac gefunden: %@. Sie erscheinen im Notch, sobald sie verbunden sind." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Found on this Mac: %@. They reach the notch once they are connected." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Encontrados en este Mac: %@. Llegan al notch cuando se conectan." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Trouvés sur ce Mac : %@. Ils arrivent dans le notch une fois connectés." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर मिले: %@। जुड़ते ही ये notch तक पहुँचेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ditemukan di Mac ini: %@. Mereka sampai ke notch setelah terhubung." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac で見つかりました：%@。接続するとノッチに表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 찾음: %@. 연결하면 노치에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Encontrados neste Mac: %@. Eles chegam ao notch depois de conectados." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Найдено на этом Mac: %@. Они появятся в notch после подключения." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พบใน Mac เครื่องนี้: %@ จะส่งมาถึง notch เมื่อเชื่อมต่อแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu Mac'te bulundu: %@. Bağlandıktan sonra notch'a ulaşırlar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这台 Mac 上找到：%@。连接后它们会出现在 notch 中。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在這台 Mac 上找到：%@。連接後它們會出現在 notch 中。" } } } },
    "konclui.connect.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اربط وكلاءك" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার এজেন্ট সংযুক্ত করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbinde deine Agenten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect your agents" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conecta tus agentes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecte tes agents" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने एजेंट जोड़ें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hubungkan agen kamu" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "エージェントを接続" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "에이전트 연결하기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conecte seus agentes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключи своих агентов" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อเอเจนต์ของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ajanlarını bağla" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接你的代理" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連接你的代理程式" } } } },
    "konclui.pills.turn-off.named" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ ausschalten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivar %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactiver %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ बंद करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Matikan %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@をオフにする" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 끄기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desligar %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключить %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิด %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ sekmesini kapat" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭 %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉 %@" } } } },
    "konclui.pills.turn-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausschalten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactiver" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Matikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにする" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끄기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desligar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapat" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉" } } } },
    "konclui.pills.limit.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعرض أي علامة تبويب يمكنك إيقافها" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কোন ট্যাব বন্ধ করা যায় তা দেখায়" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt, welchen Tab du ausschalten kannst" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows which tab you can turn off" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra qué pestaña puedes desactivar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Montre quel onglet tu peux désactiver" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "दिखाता है कि कौन-सा टैब बंद किया जा सकता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menampilkan tab yang bisa dimatikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにできるピルを表示します" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끌 수 있는 코루를 보여 줘요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra qual aba você pode desligar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показывает, какую вкладку можно выключить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงแท็บที่คุณปิดได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hangi sekmeyi kapatabileceğini gösterir" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示可以关闭的标签" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "顯示可以關閉的標籤" } } } },
    "konclui.pills.limit.about" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تستخدم 4 علامات تبويب بالفعل. أوقف إحداها لتشغيل %@." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি ইতিমধ্যে ৪টি ট্যাব ব্যবহার করছেন। %@ চালু করতে একটি বন্ধ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Du nutzt schon 4 Tabs. Schalte einen aus, um %@ einzuschalten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You already use 4 tabs. Turn one off to turn on %@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ya usas 4 pestañas. Desactiva una para activar %@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu utilises déjà 4 onglets. Désactive-en un pour activer %@." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप पहले से 4 टैब इस्तेमाल कर रहे हैं। %@ चालू करने के लिए एक बंद करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu sudah memakai 4 tab. Matikan satu untuk menyalakan %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "すでに 4 つのピルを使っています。%@をオンにするには、ピルを 1 つオフにしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 코루 4개를 사용 중이에요. %@을(를) 켜려면 코루 하나를 꺼 주세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você já usa 4 abas. Desligue uma para ligar %@." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ты уже используешь 4 вкладки. Выключи одну, чтобы включить %@." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คุณใช้ครบ 4 แท็บแล้ว ปิดหนึ่งแท็บเพื่อเปิด %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zaten 4 sekme kullanıyorsun. %@ sekmesini açmak için birini kapat." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你已经在使用 4 个标签。关闭一个才能开启 %@。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你已經在使用 4 個標籤。關閉一個才能開啟 %@。" } } } },
    "konclui.pills.limit" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الحد الأقصى 4 علامات تبويب" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সর্বোচ্চ ৪টি ট্যাব" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Limit von 4 Tabs" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Limit of 4 tabs" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Límite de 4 pestañas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Limite de 4 onglets" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अधिकतम 4 टैब" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batas 4 tab" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ピルは最大 4 つ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "코루는 최대 4개" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Limite de 4 abas" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Лимит: 4 вкладки" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จำกัด 4 แท็บ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "En fazla 4 sekme" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最多 4 个标签" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最多 4 個標籤" } } } },
    "konclui.orca.needs-hooks" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج إلى hooks الخاصة بـ Claude Code. ثبّتها من صف Claude Code." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code-এর hooks দরকার। Claude Code সারি থেকে ইনস্টল করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Braucht die Hooks von Claude Code. Installiere sie in der Zeile von Claude Code." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs the Claude Code hooks. Install them in the Claude Code row." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesita los hooks de Claude Code. Instálalos en la fila de Claude Code." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nécessite les hooks de Claude Code. Installe-les dans la ligne de Claude Code." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code के hooks चाहिए। उन्हें Claude Code की पंक्ति से इंस्टॉल करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Butuh hooks Claude Code. Pasang di baris Claude Code." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code のフックが必要です。Claude Code の行からインストールしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 훅이 필요해요. Claude Code 행에서 설치하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Precisa dos hooks do Claude Code. Instale na linha do Claude Code." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нужны хуки Claude Code. Установи их в строке Claude Code." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ต้องมี hooks ของ Claude Code ติดตั้งได้ที่แถว Claude Code" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code hook'ları gerekli. Bunları Claude Code satırından kur." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要 Claude Code 的 hooks。请在 Claude Code 一行中安装。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要 Claude Code 的 hooks。請在 Claude Code 這一列中安裝。" } } } },
    "konclui.orca.toggle" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرد على جلسات Orca من الـ notch" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "notch থেকে Orca সেশনে উত্তর দিন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Orca-Sitzungen im Notch beantworten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Answer Orca sessions from the notch" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Responder las sesiones de Orca desde el notch" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Répondre aux sessions d'Orca depuis le notch" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Orca के सेशन का जवाब notch से दें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jawab sesi Orca dari notch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノッチから Orca のセッションに回答" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "노치에서 Orca 세션에 답변" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Responder as sessões do Orca pelo notch" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отвечать на сессии Orca из notch" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตอบเซสชันของ Orca จาก notch" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orca oturumlarını notch'tan yanıtla" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 notch 中回复 Orca 的会话" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 notch 中回覆 Orca 的工作階段" } } } },
    "konclui.orca.about" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يشغّل Orca ‏Claude Code في طرفياته الخاصة. هنا تختار هل تنتظرك أسئلة هذه الجلسات وطلبات الإذن في الـ notch." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Orca তার নিজের টার্মিনালে Claude Code চালায়। এখানে ঠিক করুন ওই সেশনের প্রশ্ন ও অনুমতির অনুরোধ notch-এ আপনার জন্য অপেক্ষা করবে কি না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Orca führt Claude Code in eigenen Terminals aus. Hier legst du fest, ob deren Fragen und Berechtigungsanfragen im Notch auf dich warten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Orca runs Claude Code in its own terminals. Here you choose whether their questions and permission requests wait for you in the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Orca ejecuta Claude Code en sus propios terminales. Aquí eliges si sus preguntas y peticiones de permiso te esperan en el notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Orca lance Claude Code dans ses propres terminaux. Ici, tu choisis si leurs questions et demandes d'autorisation t'attendent dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Orca अपने टर्मिनल में Claude Code चलाता है। यहाँ चुनें कि उन सेशन के सवाल और अनुमति के अनुरोध notch में आपका इंतज़ार करें या नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Orca menjalankan Claude Code di terminalnya sendiri. Di sini kamu memilih apakah pertanyaan dan permintaan izin dari sesi itu menunggumu di notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Orca は専用のターミナルで Claude Code を実行します。セッションからの質問や許可リクエストをノッチで待機させるかどうかをここで選べます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Orca는 자체 터미널에서 Claude Code를 실행해요. 여기서 세션의 질문과 권한 요청을 노치에서 기다리게 할지 선택할 수 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Orca roda o Claude Code nos terminais dele. Aqui você escolhe se as perguntas e os pedidos de permissão dessas sessões esperam por você no notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Orca запускает Claude Code в собственных терминалах. Здесь ты выбираешь, будут ли их вопросы и запросы разрешений ждать тебя в notch." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Orca รัน Claude Code ในเทอร์มินัลของตัวเอง ที่นี่คุณเลือกได้ว่าจะให้คำถามและคำขออนุญาตจากเซสชันเหล่านั้นรอคุณใน notch หรือไม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orca, Claude Code'u kendi terminallerinde çalıştırır. Buradan bu oturumların sorularının ve izin isteklerinin notch'ta seni bekleyip beklemeyeceğini seçersin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Orca 在它自己的终端中运行 Claude Code。在这里选择这些会话的提问和权限请求是否在 notch 中等你处理。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Orca 在它自己的終端機中執行 Claude Code。在這裡選擇這些工作階段的提問和權限請求是否在 notch 中等你處理。" } } } },
    "konclui.terminals.about" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف: تظهر جلسات Warp وTerminal وiTerm وما شابهها في الـ notch، لكنها تطرح أسئلتها وطلبات الإذن في الطرفية نفسها. تشغيل: يسأل الـ notch أولاً وتنتظر الطرفية حتى دقيقتين." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ: Warp, Terminal, iTerm ও এ ধরনের অ্যাপের সেশন notch-এ দেখা যায়, কিন্তু প্রশ্ন ও অনুমতি তাদের নিজের টার্মিনালেই চাওয়া হয়। চালু: notch আগে জিজ্ঞেস করে, আর টার্মিনাল আপনার জন্য সর্বোচ্চ ২ মিনিট অপেক্ষা করে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus: Sitzungen in Warp, Terminal, iTerm und ähnlichen Apps erscheinen im Notch, stellen Fragen und Berechtigungen aber im eigenen Terminal. An: Der Notch fragt zuerst, und das Terminal wartet bis zu 2 Minuten auf dich." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Off: sessions in Warp, Terminal, iTerm and similar apps show in the notch, but ask their questions and permissions in their own terminal. On: the notch asks first, and the terminal waits up to 2 minutes for you." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivado: las sesiones de Warp, Terminal, iTerm y similares aparecen en el notch, pero preguntan y piden permiso en su propio terminal. Activado: el notch pregunta primero y el terminal espera hasta 2 minutos por ti." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé : les sessions de Warp, Terminal, iTerm et similaires apparaissent dans le notch, mais posent leurs questions et demandent les autorisations dans leur propre terminal. Activé : le notch demande d'abord, et le terminal t'attend jusqu'à 2 minutes." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद: Warp, Terminal, iTerm जैसे ऐप के सेशन notch में दिखते हैं, पर सवाल और अनुमति उनके अपने टर्मिनल में ही पूछी जाती है। चालू: notch पहले पूछता है और टर्मिनल आपके लिए 2 मिनट तक रुकता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mati: sesi di Warp, Terminal, iTerm, dan sejenisnya tampil di notch, tetapi pertanyaan dan izinnya diajukan di terminal masing-masing. Hidup: notch bertanya lebih dulu, dan terminal menunggu kamu hingga 2 menit." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフ：Warp、Terminal、iTerm などのアプリのセッションがノッチに表示されますが、質問や許可リクエストは各ターミナルで行われます。オン：ノッチで先に確認し、ターミナルは最大 2 分間待機します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끔: Warp, Terminal, iTerm 등의 앱에서 실행 중인 세션이 노치에 표시되지만, 질문과 권한 요청은 각 터미널에서 처리해요. 켬: 노치가 먼저 묻고, 터미널은 최대 2분 동안 기다려요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desligado: as sessões do Warp, Terminal, iTerm e similares aparecem no notch, mas fazem as perguntas e pedem permissão no próprio terminal. Ligado: o notch pergunta primeiro e o terminal espera até 2 minutos por você." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключено: сессии Warp, Terminal, iTerm и похожих приложений видны в notch, но вопросы и запросы разрешений приходят в их собственный терминал. Включено: сначала спрашивает notch, а терминал ждёт тебя до 2 минут." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิด: เซสชันใน Warp, Terminal, iTerm และแอปคล้ายกันจะแสดงใน notch แต่คำถามและคำขออนุญาตจะถามในเทอร์มินัลของมันเอง เปิด: notch ถามก่อน และเทอร์มินัลรอคุณได้นานสุด 2 นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalı: Warp, Terminal, iTerm ve benzeri uygulamalardaki oturumlar notch'ta görünür, ama soruları ve izin isteklerini kendi terminallerinde sorar. Açık: notch önce sorar, terminal seni 2 dakikaya kadar bekler." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭：Warp、Terminal、iTerm 等应用中的会话会显示在 notch 中，但提问和权限请求仍在它们自己的终端里进行。开启：先由 notch 询问，终端最多等你 2 分钟。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉：Warp、Terminal、iTerm 等 App 中的工作階段會顯示在 notch 中，但提問和權限請求仍在它們自己的終端機裡進行。開啟：先由 notch 詢問，終端機最多等你 2 分鐘。" } } } },
    "konclui.terminals.toggle" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "السؤال في الـ notch من الطرفيات الأخرى" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অন্য টার্মিনাল থেকে notch-এ প্রশ্ন করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Rückfragen anderer Terminals im Notch stellen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask in the notch from other terminals" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preguntar en el notch desde otros terminales" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Poser les questions des autres terminaux dans le notch" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "दूसरे टर्मिनल के सवाल notch में पूछें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tanya di notch dari terminal lain" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ほかのターミナルからの質問をノッチで確認" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다른 터미널의 요청을 노치에서 확인" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Perguntar no notch nos outros terminais" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Задавать вопросы других терминалов в notch" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ถามใน notch จากเทอร์มินัลอื่น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Diğer terminallerden notch'ta sor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 notch 中处理其他终端的提问" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 notch 中處理其他終端機的提問" } } } },
    "konclui.agents.checking" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التحقق…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "যাচাই করা হচ্ছে…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird geprüft…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérification…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जाँच हो रही है…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memeriksa…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verificando…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверяю…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังตรวจสอบ…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kontrol ediliyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查…" } } } },
    "konclui.hooks.copied" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم النسخ" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কপি হয়েছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Kopiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copié" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कॉपी हो गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tersalin" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コピーしました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировано" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kopyalandı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已拷贝" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已拷貝" } } } },
    "konclui.hooks.copy-path" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ المسار" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পাথ কপি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Pfad kopieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy path" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar ruta" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier le chemin" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पाथ कॉपी करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salin jalur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスをコピー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "경로 복사" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiar caminho" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать путь" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกพาธ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yolu kopyala" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拷贝路径" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "拷貝路徑" } } } },
    "konclui.hooks.reveal" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إظهار في Finder" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Finder-এ দেখান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Im Finder zeigen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Show in Finder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar en el Finder" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher dans le Finder" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Finder में दिखाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan di Finder" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Finder で表示" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Finder에서 보기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar no Finder" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать в Finder" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงใน Finder" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Finder'da göster" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Finder 中显示" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 Finder 中顯示" } } } },
    "konclui.hooks.details" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التفاصيل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বিবরণ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Details" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Details" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detalles" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Détails" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "विवरण" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Detail" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "詳細" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "세부 정보" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Detalhes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подробности" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รายละเอียด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayrıntılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "详情" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "詳情" } } } },
