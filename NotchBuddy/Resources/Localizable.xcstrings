    "Hovering the island opens it; it folds again shortly after the pointer leaves. Click inside to keep it open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح التمرير فوق النوتش ويُطوى بعد مغادرة المؤشر بقليل. انقر داخله لإبقائه مفتوحًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচের উপর পয়েন্টার রাখলে সেটি খোলে; পয়েন্টার সরালে একটু পরে আবার গুটিয়ে যায়। খোলা রাখতে ভিতরে ক্লিক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notch öffnet sich, wenn du den Mauszeiger darüber bewegst, und klappt kurz nach dem Verlassen wieder zu. Klicke hinein, damit sie geöffnet bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovering the notch opens it; it folds again shortly after the pointer leaves. Click inside to keep it open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar el cursor por el notch lo abre; se pliega poco después de que el cursor salga. Haz clic dentro para dejarlo abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survoler le notch l'ouvre ; il se replie peu après que le pointeur le quitte. Cliquez dedans pour le garder ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच पर पॉइंटर ले जाने से वह खुलता है; पॉइंटर हटने के कुछ देर बाद फिर सिमट जाता है। खुला रखने के लिए अंदर क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengarahkan kursor ke notch akan membukanya; notch menutup lagi sesaat setelah kursor pergi. Klik di dalamnya agar tetap terbuka."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイランドにポインタを重ねると開き、ポインタが離れると少しして畳まれます。中をクリックすると開いたままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아일랜드에 마우스를 올리면 열리고, 포인터가 떠나면 잠시 후 스르륵 접혀요. 계속 열어 두려면 안쪽을 클릭해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passar o cursor pelo notch o abre; ele se fecha logo depois que o cursor sai. Clique dentro para mantê-lo aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведение указателя открывает нотч; он сворачивается вскоре после того, как указатель уходит. Щёлкните внутри, чтобы он остался открытым."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ชี้เมาส์ที่ Notch เพื่อเปิด Notch จะพับหลังจากเลื่อนเมาส์ออก คลิกด้านในเพื่อเปิดค้างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretçiyi adanın üzerine getirdiğinde ada açılır; işaretçi ayrıldıktan kısa süre sonra tekrar kapanır. Açık tutmak için içine tıkla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将指针悬停在刘海上即可打开；指针离开后不久会再次收起。在其中点按可保持打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將游標移到瀏海上即可展開；移開後會稍候收合。點一下內部可讓它保持展開。"
          }
        }
      }
    },
