    },
    "whatsapp.mark-read.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف: تُعلَّم كمقروءة فقط عند الرد. لا تُعلَّم أبدًا لمجرد الوصول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধ: শুধু উত্তর দিলে পড়া হিসেবে চিহ্নিত। বার্তা এলেই কখনও নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Nur als gelesen markiert, wenn du antwortest. Nie, wenn eine Nachricht nur ankommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: marked read only when you reply. Never when a message just arrives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: se marca como leído solo al responder. Nunca solo por recibirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : marqué comme lu seulement quand tu réponds. Jamais à la simple réception."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद: सिर्फ़ जवाब देने पर पढ़ा हुआ। संदेश आने भर से कभी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mati: ditandai dibaca hanya saat kamu membalas. Tidak pernah hanya karena pesan masuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ：返信したときだけ既読になります。メッセージが届いただけでは既読になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끔: 답장할 때만 읽음으로 표시해요. 메시지가 도착했다고 읽음 처리하진 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: marcada como lida só quando você responde. Nunca só por chegar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено: прочитанным отмечается только при ответе. Никогда при простом получении."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด: ทำเครื่องหมายว่าอ่านแล้วเฉพาะตอนที่คุณตอบกลับ ไม่ทำเมื่อข้อความเพิ่งเข้ามา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalı: yalnızca yanıtladığında okundu işaretlenir. Mesaj sadece geldiği için asla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时：仅在你回复时标记为已读。收到消息时从不标记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時僅在回覆後標示為已讀，收到訊息時不會標示為已讀。"
          }
        }
      }
    },
