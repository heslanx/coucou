    "flow.translate-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث بأي لغة: تُلصق كلماتك باللغة التي تختارها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো ভাষায় বলুন: আপনার কথা আপনার বেছে নেওয়া ভাষায় পেস্ট হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich in einer beliebigen Sprache: Deine Worte werden in der gewählten Sprache eingefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak in any language: your words are pasted in the one you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla en cualquier idioma: tus palabras se pegan en el que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parle dans n'importe quelle langue : tes mots sont collés dans celle que tu choisis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी भाषा में बोलें: आपके शब्द आपकी चुनी भाषा में पेस्ट होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bicara dalam bahasa apa pun: kata-katamu ditempel dalam bahasa yang kamu pilih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの言語で話しても、選んだ言語で貼り付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 언어로 말해도 고른 언어로 붙여넣어져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale em qualquer idioma: suas palavras são coladas no que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
