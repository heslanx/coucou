    "whatsapp.no-slot" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفرغ مكانًا في الحبوب النشطة لعرض حبة واتساب (4 كحد أقصى)."
          }
        },
        "bn" : {
          "stringUnit" : {
