    "capture.flow-hint %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على %@ وتحدث: تذهب الصورة وكلماتك معًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ চেপে ধরে বলুন: ছবি আর আপনার কথা একসাথে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ gedrückt und sprich: Das Bild und deine Worte werden gemeinsam gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold %@ and talk: the image and your words go in together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén %@ y habla: la imagen y tus palabras van juntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens %@ et parle : l'image et tes mots partent ensemble."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ दबाकर बोलें: तस्वीर और आपके शब्द साथ जाएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan %@ dan bicara: gambar dan kata-katamu masuk bersama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を押したまま話してください。画像とあなたの言葉が一緒に送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키를 꾹 누른 채 말해 보세요. 이미지랑 말이 같이 들어가요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure %@ e fale: a imagem e suas palavras vão juntas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте %@ и говорите: снимок и слова уйдут вместе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด %@ ค้างไว้แล้วพูด ภาพและข้อความจะถูกส่งไปพร้อมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tuşunu basılı tut ve konuş: görüntü ve sözlerin birlikte gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 说话：图片和你的话会一起发出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 並說話：畫面和你的話會一起送出。"
          }
        }
      }
    },
