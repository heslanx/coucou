    "plan.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض استخدام خطة Claude (حدود 5 ساعات والحدود الأسبوعية) في ترويسة النوتش. يضيف Koncluí سطر حالة إلى Claude Code لقراءة الاستخدام، ويستمر سطر الحالة الخاص بك في العمل. للخطتين Pro وMax فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচ হেডারে আপনার Claude প্ল্যানের ব্যবহার (৫ ঘণ্টা ও সাপ্তাহিক সীমা) দেখায়। ব্যবহার পড়তে Koncluí Claude Code-এ একটি স্ট্যাটাস লাইন যোগ করে; আপনারটি আগের মতোই কাজ করে। শুধুমাত্র Pro এবং Max প্ল্যানের জন্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt deine Claude-Tarifnutzung (5-Stunden- und Wochenlimits) im Kopfbereich der Notch. Koncluí ergänzt in Claude Code eine Statuszeile, um die Nutzung zu lesen; deine eigene funktioniert weiter. Nur für Pro- und Max-Tarife."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your Claude plan usage (5-hour and weekly limits) in the notch header. Koncluí adds a status line to Claude Code to read the usage; yours keeps working. Pro and Max plans only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el uso de tu plan de Claude (límites de 5 horas y semanales) en el encabezado del notch. Koncluí añade una línea de estado a Claude Code para leer el uso; la tuya sigue funcionando. Solo planes Pro y Max."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l'utilisation de ton forfait Claude (limites de 5 heures et hebdomadaire) dans l'en-tête du notch. Koncluí ajoute une ligne de statut à Claude Code pour lire l'utilisation ; la tienne continue de fonctionner. Forfaits Pro et Max uniquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच हेडर में आपके Claude प्लान का उपयोग (5 घंटे और साप्ताहिक सीमाएं) दिखाता है। उपयोग पढ़ने के लिए Koncluí Claude Code में एक स्टेटस लाइन जोड़ता है; आपकी अपनी लाइन पहले की तरह काम करती रहती है। केवल Pro और Max प्लान के लिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan penggunaan paket Claude (batas 5 jam dan mingguan) di header notch. Koncluí menambahkan baris status ke Claude Code untuk membaca penggunaan; baris statusmu tetap berjalan. Hanya untuk paket Pro dan Max."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude プランの使用状況（5 時間と週の上限）をノッチのヘッダーに表示します。Koncluí は ~/.claude/settings.json にステータスラインのリレーを追加します。すでにステータスラインがある場合も、これまでどおり動作します。Pro と Max プランのみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치 상단에 Claude 요금제 사용량(5시간·주간 한도)을 보여 줘요. Koncluí가 ~/.claude/settings.json에 상태 표시줄 릴레이를 살짝 추가해요. 이미 상태 표시줄을 쓰고 있어도 걱정 마세요, 지금처럼 잘 돌아가요. Pro와 Max 요금제 전용이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o uso do seu plano Claude (limites de 5 horas e semanais) no cabeçalho do notch. O Koncluí acrescenta uma linha de status ao Claude Code para ler o uso; a sua continua funcionando. Apenas planos Pro e Max."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает использование плана Claude (лимиты на 5 часов и на неделю) в шапке нотча. Koncluí добавляет в Claude Code строку статуса, чтобы читать расход; ваша продолжит работать. Только для планов Pro и Max."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงปริมาณการใช้แพ็กเกจ Claude (ขีดจำกัด 5 ชั่วโมงและรายสัปดาห์) ที่ส่วนหัวของ Notch Koncluí เพิ่มบรรทัดสถานะให้ Claude Code เพื่ออ่านปริมาณการใช้ ส่วนบรรทัดสถานะของคุณยังทำงานเหมือนเดิม ใช้ได้กับแพ็กเกจ Pro และ Max เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude plan kullanımını (5 saatlik ve haftalık sınırlar) notch başlığında gösterir. Koncluí, kullanımı okumak için Claude Code'a bir durum satırı ekler; seninki çalışmaya devam eder. Yalnızca Pro ve Max planları için."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在刘海标头中显示你的 Claude 计划用量（5 小时及每周限额）。Koncluí 会给 Claude Code 添加一条状态栏来读取用量；你原有的状态栏照常运行。仅限 Pro 和 Max 计划。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在瀏海標頭顯示 Claude 方案用量（5 小時與每週額度）。Koncluí 會為 Claude Code 新增一條狀態列來讀取用量；你原有的狀態列仍會照常運作。僅適用於 Pro 與 Max 方案。"
          }
        }
      }
    },
