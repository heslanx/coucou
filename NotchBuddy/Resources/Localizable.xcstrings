          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GOWA 릴리스에 다운로드를 확인할 체크섬이 없어서, 아무것도 설치하지 않았어요. 안전 제일!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
