    "konclui.reminders.button.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسم الزر" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বোতামের নাম" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Name der Taste" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Button name" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Nombre del botón" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nom du bouton" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बटन का नाम" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Nama tombol" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ボタン名" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "버튼 이름" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nome do botão" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Название кнопки" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ชื่อปุ่ม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düğme adı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按钮名称" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "按鈕名稱" } } } },
    "konclui.reminders.snooze.locked" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يوجد زر يؤجل هذا التذكير بالفعل: أزله لإيقاف هذا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "একটি বোতাম ইতিমধ্যে এই রিমাইন্ডার স্থগিত করে: এটি বন্ধ করতে বোতামটি সরান।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine Taste verschiebt diese Erinnerung schon: Entferne sie, um dies auszuschalten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "A button already snoozes this reminder: remove it to turn this off." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un botón ya pospone este recordatorio: quítalo para desactivar esto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un bouton reporte déjà ce rappel : retirez-le pour désactiver ceci." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "एक बटन पहले से यह रिमाइंडर टालता है: इसे बंद करने के लिए वह बटन हटाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sebuah tombol sudah menunda pengingat ini: hapus tombol itu untuk mematikannya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このリマインダーにはすでにスヌーズボタンがあります。オフにするには、そのボタンを削除してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 미리 알림을 다시 알리는 버튼이 이미 있어요. 이 기능을 끄려면 해당 버튼을 제거하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um botão já adia este lembrete: remova-o para desligar isto." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эту функцию уже выполняет кнопка: удалите её, чтобы выключить." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "มีปุ่มที่เลื่อนการเตือนนี้อยู่แล้ว ลบปุ่มนั้นก่อนจึงจะปิดได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir düğme bu anımsatıcıyı zaten erteliyor: kapatmak için onu kaldırın." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已有按钮可推迟此提醒：移除该按钮才能关闭此项。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已有按鈕可延後此提醒：移除該按鈕才能關閉此項。" } } } },
    "konclui.reminders.snooze.minutes %lld" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%lld دقيقة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%lld মিনিট" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%lld Min." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%lld मिनट" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%lld menit" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld분" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "%lld мин" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "%lld นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%lld dk" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分钟" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分鐘" } } } },
