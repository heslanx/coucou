          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo dirección pública. Koncluí nunca toca tus claves privadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse publique uniquement. Koncluí ne touche jamais vos clés privées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल सार्वजनिक पता। Koncluí आपकी प्राइवेट कीज़ को कभी नहीं छूता।"
