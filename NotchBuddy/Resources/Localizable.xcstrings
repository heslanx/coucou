    "Choose the tools you use. Koncluí only shows what you declare here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل الأدوات التي تستخدمها: لا تظهر في النوتش إلا الحبات المفعّلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে টুলগুলো ব্যবহার করেন সেগুলো চালু করুন: শুধু চালু পিলগুলো নচে দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Werkzeuge ein, die du nutzt: Nur aktive Pills erscheinen in der Notch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on the tools you use: only pills that are on show in the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las herramientas que usas: solo las píldoras activas aparecen en el notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active les outils que tu utilises : seules les pills activées apparaissent dans le notch."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो टूल आप इस्तेमाल करते हैं उन्हें चालू करें: नॉच में सिर्फ़ चालू पिल दिखती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan alat yang kamu pakai: hanya pil yang aktif tampil di notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使っているツールを選んでください。Koncluí はここで選んだものだけを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰는 도구를 골라 주세요. Koncluí는 여기서 고른 것만 보여 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue as ferramentas que você usa: só as abas ligadas aparecem no notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите нужные инструменты: в нотче появляются только включённые пилюли."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดเครื่องมือที่คุณใช้: เฉพาะแถบที่เปิดอยู่เท่านั้นที่จะแสดงใน Notch"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullandığın araçları aç: notch'ta yalnızca açık olan araçlar görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开你使用的工具：只有已开启的胶囊会显示在刘海中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟你使用的工具：只有已開啟的標籤會顯示在瀏海中。"
          }
        }
      }
    },
