    "notes.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر مكالماتك هنا. انقر على تسجيل مكالمة عند بدئها."
