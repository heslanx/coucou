          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí вас не слышит: микрофон не разрешён или недоступен."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ไม่ได้ยินเสียงคุณ: ไมโครโฟนไม่ได้รับอนุญาตหรือไม่พร้อมใช้งาน"
