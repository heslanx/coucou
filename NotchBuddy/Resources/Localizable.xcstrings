    "Edit this reminder" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل هذا التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই রিমাইন্ডার সম্পাদনা করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Erinnerung bearbeiten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit this reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Editar este recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modifier ce rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह रिमाइंडर संपादित करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Edit pengingat ini" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Editar este lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Изменить это напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แก้ไขการเตือนความจำนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu hatırlatıcıyı düzenle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑此提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "編輯此提醒" } } } },
