    "Stop future occurrences" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف المرات القادمة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরবর্তী পুনরাবৃত্তি বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Künftige Wiederholungen stoppen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop future occurrences" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detener las próximas repeticiones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêter les prochaines occurrences" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आगे की पुनरावृत्तियाँ रोकें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hentikan kemunculan berikutnya" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar as próximas ocorrências" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановить будущие повторы" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หยุดการเตือนครั้งต่อไป" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonraki tekrarları durdur" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止后续提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停止後續提醒" } } } },
    "Delete" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "মুছুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Löschen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apagar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sil" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除" } } } },
    "Delete this reminder" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف هذا التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই রিমাইন্ডার মুছুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Erinnerung löschen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete this reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Eliminar este recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer ce rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह रिमाइंडर हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus pengingat ini" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apagar este lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить это напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบการเตือนความจำนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu hatırlatıcıyı sil" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除此提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除此提醒" } } } },
    "Delete reminder?" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف التذكير؟" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার মুছবেন?" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung löschen?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete reminder?" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Eliminar el recordatorio?" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer le rappel ?" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर हटाएँ?" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus pengingat?" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apagar o lembrete?" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить напоминание?" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบการเตือนความจำหรือไม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatıcı silinsin mi?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要删除此提醒吗？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "要刪除此提醒嗎？" } } } },
    "Connect a local MCP client" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ربط عميل MCP محلي" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "একটি লোকাল MCP ক্লায়েন্ট যুক্ত করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Lokalen MCP-Client verbinden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect a local MCP client" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Conectar un cliente MCP local" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connecter un client MCP local" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "लोकल MCP क्लाइंट जोड़ें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hubungkan klien MCP lokal" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Conectar um cliente MCP local" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подключить локальный клиент MCP" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อไคลเอนต์ MCP ในเครื่อง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yerel bir MCP istemcisi bağla" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接本地 MCP 客户端" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連接本機 MCP 用戶端" } } } },
    "Koncluí keeps reminders on this Mac. The MCP bridge uses a private local socket; it does not edit other apps’ settings or send calendar data." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتفظ Koncluí بالتذكيرات على هذا الـ Mac. يستخدم جسر MCP مقبسًا محليًا خاصًا؛ ولا يعدّل إعدادات التطبيقات الأخرى ولا يرسل بيانات التقويم." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí রিমাইন্ডার এই Mac-এই রাখে। MCP ব্রিজ একটি ব্যক্তিগত লোকাল সকেট ব্যবহার করে; এটি অন্য অ্যাপের সেটিংস বদলায় না বা ক্যালেন্ডারের তথ্য পাঠায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí speichert Erinnerungen auf diesem Mac. Die MCP-Brücke nutzt einen privaten lokalen Socket; sie ändert keine Einstellungen anderer Apps und sendet keine Kalenderdaten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí keeps reminders on this Mac. The MCP bridge uses a private local socket; it does not edit other apps’ settings or send calendar data." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí guarda los recordatorios en este Mac. El puente MCP usa un socket local privado; no modifica los ajustes de otras apps ni envía datos del calendario." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí garde les rappels sur ce Mac. Le pont MCP utilise un socket local privé ; il ne modifie pas les réglages d'autres apps et n'envoie aucune donnée de calendrier." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí रिमाइंडर इसी Mac पर रखता है। MCP ब्रिज एक निजी लोकल सॉकेट इस्तेमाल करता है; यह दूसरे ऐप की सेटिंग्स नहीं बदलता और कैलेंडर डेटा नहीं भेजता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí menyimpan pengingat di Mac ini. Jembatan MCP memakai soket lokal pribadi; ia tidak mengubah pengaturan app lain dan tidak mengirim data kalender." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí guarda os lembretes neste Mac. A ponte MCP usa um socket local privado; ela não altera os ajustes de outros apps nem envia dados de calendário." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí хранит напоминания на этом Mac. Мост MCP использует закрытый локальный сокет: он не меняет настройки других приложений и не отправляет данные календаря." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí เก็บการเตือนความจำไว้บน Mac เครื่องนี้ สะพาน MCP ใช้ซ็อกเก็ตในเครื่องแบบส่วนตัว ไม่แก้ไขการตั้งค่าของแอปอื่น และไม่ส่งข้อมูลปฏิทิน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí hatırlatıcıları bu Mac'te tutar. MCP köprüsü özel bir yerel soket kullanır; diğer uygulamaların ayarlarını değiştirmez ve takvim verisi göndermez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 会把提醒保存在这台 Mac 上。MCP 桥接使用私有的本地套接字，不会修改其他 App 的设置，也不会发送日历数据。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 會將提醒保存在此 Mac。本機 MCP 橋接程式使用私人本機通訊端，不會修改其他 App 的設定或傳送行事曆資料。" } } } },
    "Add this server to your MCP client configuration, then restart that client:" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أضف هذا الخادم إلى إعدادات عميل MCP لديك، ثم أعد تشغيل العميل:" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সার্ভারটি আপনার MCP ক্লায়েন্টের কনফিগারেশনে যোগ করুন, তারপর ক্লায়েন্টটি আবার চালু করুন:" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Füge diesen Server zur Konfiguration deines MCP-Clients hinzu und starte den Client neu:" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Add this server to your MCP client configuration, then restart that client:" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade este servidor a la configuración de tu cliente MCP y reinicia ese cliente:" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoute ce serveur à la configuration de ton client MCP, puis redémarre ce client :" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस सर्वर को अपने MCP क्लाइंट के कॉन्फ़िगरेशन में जोड़ें, फिर उस क्लाइंट को दोबारा शुरू करें:" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambahkan server ini ke konfigurasi klien MCP-mu, lalu mulai ulang klien itu:" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adicione este servidor à configuração do seu cliente MCP e reinicie o cliente:" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавьте этот сервер в настройки вашего клиента MCP и перезапустите клиент:" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เพิ่มเซิร์ฟเวอร์นี้ในการตั้งค่าไคลเอนต์ MCP ของคุณ แล้วเริ่มไคลเอนต์นั้นใหม่:" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu sunucuyu MCP istemcisinin yapılandırmasına ekle ve istemciyi yeniden başlat:" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把此服务器添加到你的 MCP 客户端配置中，然后重启该客户端：" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將此伺服器加入 MCP 用戶端設定，然後重新啟動該用戶端：" } } } },
