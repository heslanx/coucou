    "hub.mail.journal-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُفرز شيء بعد. ما يفعله Koncluí برسائلك يظهر هنا مع زر تراجع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কিছু সাজানো হয়নি। Koncluí আপনার মেলে যা করে তা এখানে দেখাবে, পূর্বাবস্থার বোতামসহ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts sortiert. Was Koncluí mit deinen E-Mails macht, erscheint hier, mit Rückgängig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing sorted yet. What Koncluí does to your messages shows up here, with an Undo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha ordenado nada. Lo que Koncluí hace con tus correos aparece aquí, con Deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de trié pour l’instant. Ce que Koncluí fait à tes mails s’affiche ici, avec un bouton Annuler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कुछ नहीं छाँटा गया। Koncluí आपके मेल के साथ जो करता है वह यहाँ दिखेगा, पूर्ववत के साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada yang dipilah. Apa yang dilakukan Koncluí pada emailmu muncul di sini, dengan tombol Urungkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も整理されていません。Koncluí がメールに行ったことはここに表示され、取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 정리된 메일이 없습니다. Koncluí가 메일에 한 일은 여기에 실행 취소와 함께 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada organizado ainda. O que o Koncluí faz com seus e-mails aparece aqui, com Desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не отсортировано. Всё, что Koncluí делает с письмами, появится здесь, с кнопкой «Отменить»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีการคัดแยก สิ่งที่ Koncluí ทำกับอีเมลของคุณจะแสดงที่นี่ พร้อมปุ่มเลิกทำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz bir şey düzenlenmedi. Koncluí’nun e-postalarına yaptıkları burada Geri Al ile birlikte görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有整理任何邮件。Koncluí 对邮件做的操作会显示在这里，并可撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有整理任何郵件。Koncluí 對郵件做的動作會顯示在這裡，並可還原。"
          }
        }
      }
    },
    "hub.mail.checked %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم فحص %lld رسالة جديدة اليوم. لم تطابق أيٌّ منها شخصًا مهمًا أو كلمة محظورة أو قاعدة، لذا تركها Koncluí كما هي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজ %lld টি নতুন বার্তা দেখা হয়েছে। কোনোটি VIP, নিষিদ্ধ শব্দ বা নিয়মের সাথে মেলেনি, তাই Koncluí সেগুলো যেমন ছিল তেমনই রেখেছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute %lld neue Nachrichten geprüft. Keine passte zu einem VIP, einem gesperrten Wort oder einer Regel, also hat Koncluí sie gelassen, wie sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld new messages checked today. None matched a VIP, a banned word or a rule, so Koncluí left them as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mensajes nuevos revisados hoy. Ninguno coincidía con un VIP, una palabra prohibida o una regla, así que Koncluí los dejó como estaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld nouveaux messages vérifiés aujourd’hui. Aucun ne correspondait à un VIP, un mot banni ou une règle : Koncluí les a laissés tels quels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज %lld नए संदेश जाँचे गए। कोई भी VIP, प्रतिबंधित शब्द या नियम से मेल नहीं खाया, इसलिए Koncluí ने उन्हें वैसे ही छोड़ दिया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld pesan baru diperiksa hari ini. Tidak ada yang cocok dengan VIP, kata terlarang, atau aturan, jadi Koncluí membiarkannya apa adanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は新着メッセージを %lld 件確認しました。VIP、禁止ワード、ルールのどれにも当てはまらなかったので、Koncluí はそのままにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 새 메시지 %lld개를 확인했어요. VIP, 금지어, 규칙 중 어느 것에도 해당하지 않아 Koncluí는 그대로 두었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mensagens novas verificadas hoje. Nenhuma correspondia a um VIP, uma palavra banida ou uma regra, então o Koncluí as deixou como estavam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня проверено новых писем: %lld. Ни одно не совпало с VIP, запрещённым словом или правилом, поэтому Koncluí оставил их как есть."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้ตรวจข้อความใหม่แล้ว %lld ฉบับ ไม่มีฉบับใดตรงกับ VIP คำต้องห้าม หรือกฎ Koncluí จึงปล่อยไว้ตามเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün %lld yeni ileti kontrol edildi. Hiçbiri bir VIP, yasaklı kelime veya kuralla eşleşmedi, bu yüzden Koncluí onları olduğu gibi bıraktı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天检查了 %lld 封新邮件。没有一封匹配 VIP、屏蔽词或规则，所以 Koncluí 保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天檢查了 %lld 封新郵件。沒有一封符合 VIP、封鎖字詞或規則，所以 Koncluí 保持原樣。"
          }
        }
      }
    },
    "hub.mail.mail-closed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail مغلق: لن يُفرز شيء حتى يُفتح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail বন্ধ: খোলা না হওয়া পর্যন্ত কিছুই সাজানো হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail ist geschlossen: Nichts wird sortiert, bis es geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail is closed: nothing is sorted until it is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail está cerrado: no se ordena nada hasta que se abra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail est fermé : rien n’est trié tant qu’il n’est pas ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail बंद है: खुलने तक कुछ भी नहीं छाँटा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail tertutup: tidak ada yang dipilah sampai dibuka."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail が閉じています。開くまで何も整理されません。"
          }
        },
        "ko" : {
