    "notes.edit-line-detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ الكلمات التي تصححها لمكالماتك القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে শব্দ ঠিক করেন, তা পরের কলগুলোর জন্য মনে রাখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter, die du korrigierst, werden für deine nächsten Gespräche gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The words you bring in are remembered for your next calls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras que corriges se recuerdan para tus próximas llamadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots que tu corriges sont retenus pour tes prochains appels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो शब्द सुधारते हैं, वे अगली कॉल के लिए याद रखे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata yang kamu perbaiki diingat untuk panggilan berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した単語は次回の通話でも覚えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고친 단어는 다음 통화 때도 기억해 둘게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As palavras que você corrige ficam guardadas para as próximas chamadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправленные слова запоминаются для следующих звонков."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำที่คุณแก้ไขจะถูกจดจำไว้สำหรับการบันทึกครั้งต่อไป"
