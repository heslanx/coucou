    "iphone.live-activity.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمر عبر ريلاي Koncluí إلى خدمة Apple للإشعارات. يُرسَل فقط اسم الوكيل وحالته: لا اسم مشروع ولا أمر ولا مسار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple-এর পুশ সার্ভিসে Koncluí রিলের মাধ্যমে যায়। শুধুমাত্র এজেন্টের নাম এবং অবস্থা পাঠানো হয়: কোনো প্রজেক্ট নাম, কমান্ড বা পাথ নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird über den Koncluí-Relay an Apples Push-Dienst gesendet. Nur Name und Status des Agenten werden übertragen: keine Projektnamen, Befehle oder Pfade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goes through the Koncluí relay to Apple's push service. Only the agent name and state are sent: no project name, command, or path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa por el relay de Koncluí al servicio push de Apple. Solo se envían el nombre y el estado del agente: sin nombre de proyecto, comando ni ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe par le relais Koncluí vers le service push d'Apple. Seuls le nom et l'état de l'agent sont envoyés : aucun nom de projet, commande ou chemin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí रिले के माध्यम से Apple के पुश सर्विस से जाता है। केवल एजेंट का नाम और स्थिति भेजी जाती है: कोई प्रोजेक्ट नाम, कमांड या पाथ नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melewati relay Koncluí ke layanan push Apple. Hanya nama dan status agen yang dikirim: tanpa nama proyek, perintah, atau jalur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí のリレー経由で Apple のプッシュサービスに送られます。送られるのはエージェント名と状態だけで、プロジェクト名、コマンド、パスは送られません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 릴레이를 거쳐 Apple 푸시 서비스로 가요. 에이전트 이름과 상태만 보내고, 프로젝트 이름·명령·경로는 안 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa pelo relay do Koncluí para o serviço push da Apple. Apenas o nome e o estado do agente são enviados: sem nome de projeto, comando ou caminho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проходит через ретранслятор Koncluí к сервису push Apple. Отправляются только имя и состояние агента: без имени проекта, команды или пути."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งผ่าน Koncluí relay ไปยังบริการ push ของ Apple โดยส่งเฉพาะชื่อเอเจนต์และสถานะ ไม่ส่งชื่อโปรเจกต์ คำสั่ง หรือพาธ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí aracısı üzerinden Apple'ın anlık bildirim servisine iletilir. Yalnızca ajan adı ve durumu gönderilir; proje adı, komut veya yol gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Koncluí 中继传至 Apple 推送服务。仅发送 Agent 的名称和状态：不含项目名称、命令或路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 Koncluí relay 傳送至 Apple 推播服務。只會傳送代理程式名稱與狀態，不包含專案名稱、指令或路徑。"
          }
        }
      }
    },
    "iphone.live-activity.toggle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
