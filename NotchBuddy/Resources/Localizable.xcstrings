    "konclui.reminders.title.placeholder" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مثال: شرب الماء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "যেমন: পানি পান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "z. B. Wasser trinken" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "E.g. Drink water" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ej.: Beber agua" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ex. : Boire de l’eau" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जैसे: पानी पिएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mis.: Minum air" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "例：水を飲む" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "예: 물 마시기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ex.: Beber água" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напр.: Выпить воды" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เช่น ดื่มน้ำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Örn.: Su iç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "例如：喝水" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "例如：喝水" } } } },
    "konclui.reminders.section.what" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒" } } } },
    "konclui.reminders.undo.deleted %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم حذف “%@”." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "“%@” মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "„%@“ gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "“%@” eliminado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "« %@ » supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "“%@” हटाया गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "“%@” dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」を削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’ 삭제됨." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "“%@” apagado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "«%@» удалено." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบ “%@” แล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "“%@” silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除“%@”。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除「%@」。" } } } },
    "konclui.reminders.undo.stopped" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم إيقاف التذكير: لن يظهر مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার বন্ধ হয়েছে: আর বাজবে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung gestoppt: Sie meldet sich nicht mehr." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminder stopped: it won’t ring again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorio detenido: no volverá a sonar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappel arrêté : il ne sonnera plus." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर रोका गया: अब यह नहीं बजेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat dihentikan: tidak akan berbunyi lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを停止しました。もう通知されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림이 중지됐어요. 다시 울리지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembrete parado: ele não toca mais." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминание остановлено: оно больше не сработает." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หยุดการเตือนแล้ว จะไม่เตือนอีก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı durduruldu: bir daha çalmayacak." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒已停止：不会再响。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒已停止：不會再響。" } } } },
    "konclui.reminders.undo.saved" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم حفظ التذكير." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার সংরক্ষিত হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung gesichert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminder saved." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorio guardado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappel enregistré." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर सहेजा गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat disimpan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを保存しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림을 저장했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembrete salvo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминание сохранено." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึกการเตือนแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı kaydedildi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒已保存。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒已儲存。" } } } },
    "konclui.reminders.undo.created %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم إنشاء التذكير: %@." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার তৈরি হয়েছে: %@।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung angelegt: %@." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminder created: %@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorio creado: %@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappel créé : %@." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर बना: %@।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat dibuat: %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを作成しました：%@。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림을 만들었어요: %@." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembrete criado: %@." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминание создано: %@." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สร้างการเตือนแล้ว: %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcı oluşturuldu: %@." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已创建提醒：%@。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已建立提醒：%@。" } } } },
    "konclui.reminders.mcp.how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصق الأمر في Terminal، أو الإعداد في ملف MCP الخاص بوكيلك، ثم أعد تشغيل الوكيل." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কমান্ডটি Terminal-এ, বা কনফিগারেশনটি আপনার এজেন্টের MCP ফাইলে পেস্ট করুন, তারপর এজেন্ট আবার চালু করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Füge den Befehl im Terminal oder die Konfiguration in die MCP-Datei deines Agenten ein und starte den Agenten neu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste the command in Terminal, or the configuration in your agent’s MCP file, then restart the agent." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pega el comando en Terminal, o la configuración en el archivo MCP de tu agente, y reinicia el agente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Collez la commande dans Terminal, ou la configuration dans le fichier MCP de votre agent, puis redémarrez l’agent." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कमांड को Terminal में, या कॉन्फ़िगरेशन को अपने एजेंट की MCP फ़ाइल में पेस्ट करें, फिर एजेंट दोबारा शुरू करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tempel perintah di Terminal, atau konfigurasi di file MCP agen Anda, lalu mulai ulang agen." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コマンドをターミナルに貼り付けるか、設定をエージェントの MCP ファイルに貼り付けてから、エージェントを再起動してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "명령어를 터미널에 붙여넣거나 설정을 에이전트의 MCP 파일에 붙여넣은 다음 에이전트를 다시 시작하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cole o comando no Terminal, ou a configuração no arquivo de MCP do seu agente, e reinicie o agente." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вставьте команду в Терминал или конфигурацию в MCP-файл агента и перезапустите агента." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "วางคำสั่งใน Terminal หรือวางการตั้งค่าในไฟล์ MCP ของเอเจนต์ แล้วเริ่มเอเจนต์ใหม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Komutu Terminal’e ya da yapılandırmayı ajanınızın MCP dosyasına yapıştırın, sonra ajanı yeniden başlatın." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将命令粘贴到“终端”，或将配置粘贴到智能体的 MCP 文件中，然后重启智能体。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將指令貼到「終端機」，或將設定貼到代理的 MCP 檔案中，然後重新啟動代理。" } } } },
    "konclui.reminders.mcp.copied" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم النسخ" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কপি হয়েছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Kopiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copié" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कॉपी हो गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Disalin" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "コピーしました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "복사됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировано" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kopyalandı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已複製" } } } },
    "konclui.reminders.mcp.copy-json" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ الإعداد (JSON)" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কনফিগারেশন কপি করুন (JSON)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Konfiguration kopieren (JSON)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy configuration (JSON)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar configuración (JSON)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier la configuration (JSON)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कॉन्फ़िगरेशन कॉपी करें (JSON)" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salin konfigurasi (JSON)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定をコピー（JSON）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정 복사(JSON)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiar configuração (JSON)" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать конфигурацию (JSON)" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกการตั้งค่า (JSON)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yapılandırmayı kopyala (JSON)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制配置（JSON）" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製設定（JSON）" } } } },
    "konclui.reminders.mcp.copy-command" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ أمر Claude Code" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code কমান্ড কপি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude-Code-Befehl kopieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Claude Code command" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copiar comando de Claude Code" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Copier la commande Claude Code" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code कमांड कॉपी करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Salin perintah Claude Code" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code のコマンドをコピー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 명령어 복사" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Copiar comando do Claude Code" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скопировать команду Claude Code" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คัดลอกคำสั่ง Claude Code" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code komutunu kopyala" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制 Claude Code 命令" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "複製 Claude Code 指令" } } } },
    "konclui.reminders.mcp.local" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كل شيء يبقى على هذا الـMac: يتواصل الوكيل مع Koncluí عبر قناة محلية، دون إنترنت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সবকিছু এই Mac-এই থাকে: এজেন্ট ইন্টারনেট ছাড়াই একটি লোকাল চ্যানেলে Koncluí-এর সঙ্গে কথা বলে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Alles bleibt auf diesem Mac: Der Agent spricht über einen lokalen Kanal mit Koncluí, ohne Internet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything stays on this Mac: the agent talks to Koncluí through a local channel, with no internet." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Todo se queda en este Mac: el agente habla con Koncluí por un canal local, sin internet." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tout reste sur ce Mac : l’agent parle à Koncluí par un canal local, sans internet." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सब कुछ इसी Mac पर रहता है: एजेंट बिना इंटरनेट, एक लोकल चैनल से Koncluí से बात करता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Semuanya tetap di Mac ini: agen berbicara dengan Koncluí lewat saluran lokal, tanpa internet." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべてこの Mac 内にとどまります。エージェントはインターネットを使わず、ローカル経由で Koncluí と通信します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 내용은 이 Mac에만 저장돼요. 에이전트는 인터넷 없이 로컬 채널로 Koncluí와 통신해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tudo fica neste Mac: o agente fala com o Koncluí por um canal local, sem internet." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё остаётся на этом Mac: агент общается с Koncluí по локальному каналу, без интернета." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ทุกอย่างอยู่บน Mac เครื่องนี้ เอเจนต์คุยกับ Koncluí ผ่านช่องทางภายในเครื่อง ไม่ใช้อินเทอร์เน็ต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her şey bu Mac’te kalır: ajan Koncluí ile internetsiz, yerel bir kanaldan konuşur." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一切都留在这台 Mac 上：智能体通过本地通道与 Koncluí 通信，无需联网。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "一切都留在這台 Mac 上：代理透過本機通道與 Koncluí 溝通，不需連網。" } } } },
    "konclui.reminders.mcp.body" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكن لـClaude Code أو Codex أو أي وكيل آخر يدعم MCP إنشاء التذكيرات هنا وعرضها وتأجيلها وإيقافها. مثال: “ذكّرني الساعة 5 مساءً بمراجعة الـPR”." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex বা MCP-সহ অন্য কোনো এজেন্ট এখানে রিমাইন্ডার তৈরি, তালিকা, স্থগিত ও বন্ধ করতে পারবে। যেমন: “বিকেল ৫টায় PR দেখার কথা মনে করিয়ে দিও”।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex oder ein anderer Agent mit MCP kann dann hier Erinnerungen anlegen, auflisten, verschieben und stoppen. Zum Beispiel: „Erinnere mich um 17 Uhr an das Review des PR“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex or any other agent with MCP can then create, list, snooze and stop reminders here. For example: “remind me at 5 pm to review the PR”." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex u otro agente con MCP podrá crear, listar, posponer y detener recordatorios aquí. Por ejemplo: “recuérdame a las 17:00 revisar el PR”." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex ou tout autre agent avec MCP peut alors créer, lister, reporter et arrêter des rappels ici. Par exemple : « rappelle-moi à 17 h de relire la PR »." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex या MCP वाला कोई और एजेंट यहाँ रिमाइंडर बना, देख, टाल और रोक सकेगा। उदाहरण: “शाम 5 बजे PR देखने की याद दिलाना”।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex, atau agen lain dengan MCP bisa membuat, menampilkan, menunda, dan menghentikan pengingat di sini. Contoh: “ingatkan saya jam 17.00 untuk meninjau PR”." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code、Codex など MCP 対応エージェントを使って、ここでリマインダーの作成、一覧表示、スヌーズ、停止ができます。例：「午後 5 時に PR のレビューをリマインドして」。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "MCP를 지원하는 Claude Code, Codex 또는 다른 에이전트가 여기서 미리 알림을 만들고, 목록을 보고, 다시 알림을 설정하거나 중지할 수 있어요. 예: “오후 5시에 PR 검토 알림”." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude Code, o Codex ou outro agente com MCP passa a criar, listar, adiar e parar lembretes aqui. Por exemplo: “me lembre às 17h de revisar o PR”." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex или другой агент с MCP сможет создавать, показывать, откладывать и останавливать напоминания здесь. Например: «напомни мне в 17:00 проверить PR»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex หรือเอเจนต์อื่นที่รองรับ MCP จะสร้าง ดูรายการ เลื่อน และหยุดการเตือนที่นี่ได้ เช่น “เตือนฉันตอน 17:00 ให้รีวิว PR”" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code, Codex ya da MCP destekli başka bir ajan burada anımsatıcı oluşturabilir, listeleyebilir, erteleyebilir ve durdurabilir. Örneğin: “Saat 17’de PR’ı incelemeyi hatırlat”." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这样 Claude Code、Codex 或其他支持 MCP 的智能体就能在这里创建、列出、推迟和停止提醒。例如：“下午 5 点提醒我审阅 PR”。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這樣 Claude Code、Codex 或其他支援 MCP 的代理就能在這裡建立、列出、延後和停止提醒。例如：「下午 5 點提醒我審閱 PR」。" } } } },
    "konclui.reminders.mcp.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اطلب التذكيرات من وكيل (MCP)" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এজেন্টকে দিয়ে রিমাইন্ডার (MCP)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen von einem Agenten anlegen lassen (MCP)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask an agent for reminders (MCP)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pide recordatorios a un agente (MCP)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Demandez des rappels à un agent (MCP)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "एजेंट से रिमाइंडर बनवाएँ (MCP)" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Minta pengingat ke agen (MCP)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "エージェントにリマインダーを頼む（MCP）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "에이전트에게 미리 알림 요청(MCP)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Peça lembretes a um agente (MCP)" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминания через агента (MCP)" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ให้เอเจนต์สร้างการเตือน (MCP)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir ajandan anımsatıcı isteyin (MCP)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让智能体创建提醒（MCP）" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "讓代理建立提醒（MCP）" } } } },
    "konclui.reminders.notifications.open" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح الإشعارات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নোটিফিকেশন খুলুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Mitteilungen öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Notifications" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Notificaciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Notifications" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सूचनाएँ खोलें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka Notifikasi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "通知を開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Notificações" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть Уведомления" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการแจ้งเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bildirimler’i aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开“通知”" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "打開「通知」" } } } },
    "konclui.reminders.notifications.off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إشعارات macOS متوقفة لـKoncluí: عندما يكون التطبيق مغلقًا لا تظهر التذكيرات." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí-এর জন্য macOS নোটিফিকেশন বন্ধ: অ্যাপ বন্ধ থাকলে রিমাইন্ডার দেখা যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "macOS-Mitteilungen sind für Koncluí aus: Ist die App geschlossen, erscheinen keine Erinnerungen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS notifications are off for Koncluí: with the app closed, reminders don’t show up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Las notificaciones de macOS están desactivadas para Koncluí: con la app cerrada, los recordatorios no aparecen." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notifications macOS sont désactivées pour Koncluí : app fermée, les rappels n’apparaissent pas." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí के लिए macOS सूचनाएँ बंद हैं: ऐप बंद होने पर रिमाइंडर नहीं दिखते।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Notifikasi macOS untuk Koncluí nonaktif: saat app ditutup, pengingat tidak muncul." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí の macOS 通知がオフです。アプリを終了すると、リマインダーは表示されません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí의 macOS 알림이 꺼져 있어요. 앱이 닫혀 있으면 미리 알림이 표시되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As notificações do macOS estão desligadas para o Koncluí: com o app fechado, os lembretes não aparecem." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Уведомления macOS для Koncluí выключены: когда приложение закрыто, напоминания не появляются." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การแจ้งเตือนของ macOS สำหรับ Koncluí ปิดอยู่ เมื่อปิดแอป การเตือนจะไม่แสดง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí için macOS bildirimleri kapalı: uygulama kapalıyken anımsatıcılar görünmez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 的 macOS 通知已关闭：应用关闭时不会显示提醒。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 的 macOS 通知已關閉：App 關閉時不會顯示提醒。" } } } },
    "konclui.reminders.row.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح التذكير لتعديله أو تجربته." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সম্পাদনা বা পরীক্ষা করতে রিমাইন্ডারটি খোলে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die Erinnerung zum Bearbeiten oder Testen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens the reminder to edit or test it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre el recordatorio para editarlo o probarlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre le rappel pour le modifier ou le tester." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "संपादित करने या आज़माने के लिए रिमाइंडर खोलता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka pengingat untuk diedit atau diuji." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを開いて編集またはテストします。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림을 열어 편집하거나 테스트해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre o lembrete para editar ou testar." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает напоминание для изменения или проверки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการเตือนเพื่อแก้ไขหรือทดสอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcıyı düzenlemek ya da denemek için açar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开提醒以编辑或测试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟提醒以編輯或測試。" } } } },
    "konclui.reminders.status.stopped" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوقف" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gestoppt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detenido" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Arrêté" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रुका हुआ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dihentikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановлено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หยุดแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Durduruldu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已停止" } } } },
    "konclui.reminders.status.snoozed %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مؤجل حتى %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ পর্যন্ত স্থগিত" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verschoben bis %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Snoozed until %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pospuesto hasta las %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Reporté jusqu’à %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ तक टाला गया" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ditunda sampai %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@までスヌーズ中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@까지 다시 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adiado até %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отложено до %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลื่อนไปถึง %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ saatine ertelendi" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已推迟到 %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已延後到 %@" } } } },
    "konclui.reminders.status.active" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نشط" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চালু" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Active" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Actif" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सक्रिय" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktif" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "有効" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "활성" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ativo" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Активно" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Etkin" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已启用" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已啟用" } } } },
    "konclui.reminders.list" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التذكيرات على هذا الـMac" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এর রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen auf diesem Mac" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders on this Mac" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios en este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappels sur ce Mac" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat di Mac ini" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac のリマインダー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac의 미리 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembretes neste Mac" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминания на этом Mac" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนบน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu Mac’teki anımsatıcılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 上的提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這台 Mac 上的提醒" } } } },
    "konclui.reminders.empty.body" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشئ واحدًا هنا أو اطلبه من وكيل. يظهر في الوقت المحدد، كبطاقة أو بملء الشاشة، حتى ترد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখানে একটি তৈরি করুন বা কোনো এজেন্টকে বলুন। নির্ধারিত সময়ে এটি কার্ড বা পূর্ণ স্ক্রিনে দেখা যাবে, যতক্ষণ না আপনি সাড়া দেন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erstelle hier eine oder bitte einen Agenten darum. Sie erscheint zur festgelegten Zeit als Karte oder im Vollbild, bis du reagierst." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Create one here or ask an agent. It shows up at the set time, as a card or full screen, until you answer." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crea uno aquí o pídeselo a un agente. Aparece a la hora fijada, como tarjeta o a pantalla completa, hasta que respondas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Créez-en un ici ou demandez-le à un agent. Il apparaît à l’heure prévue, en carte ou en plein écran, jusqu’à ce que vous répondiez." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यहाँ एक बनाएँ या किसी एजेंट से कहें। यह तय समय पर कार्ड या फ़ुल स्क्रीन में दिखेगा, जब तक आप जवाब न दें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buat di sini atau minta ke agen. Pengingat muncul pada waktu yang ditetapkan, sebagai kartu atau layar penuh, sampai Anda merespons." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ここで作成するか、エージェントに頼んでください。指定した時刻にカードまたはフルスクリーンで表示され、応答するまで残ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "여기서 만들거나 에이전트에게 요청하세요. 지정한 시간에 카드 또는 전체 화면으로 표시되며, 응답할 때까지 계속 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Crie um aqui ou peça a um agente. Ele aparece na hora marcada, em um cartão ou na tela inteira, até você responder." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создайте здесь или попросите агента. Оно появится в назначенное время, карточкой или на весь экран, пока вы не ответите." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สร้างที่นี่หรือขอให้เอเจนต์สร้างให้ การเตือนจะแสดงตามเวลาที่กำหนด เป็นการ์ดหรือเต็มหน้าจอ จนกว่าคุณจะตอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Buradan oluşturun ya da bir ajandan isteyin. Belirlenen saatte, kart olarak ya da tam ekranda, siz yanıt verene kadar görünür." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这里创建，或让智能体帮你创建。到点时它会以卡片或全屏显示，直到你回应。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在這裡建立，或請代理幫你建立。時間到時會以卡片或全螢幕顯示，直到你回應。" } } } },
    "konclui.reminders.empty.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد تذكيرات بعد" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখনও কোনো রিমাইন্ডার নেই" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch keine Erinnerungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No reminders yet" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no hay recordatorios" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun rappel pour l’instant" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी कोई रिमाइंडर नहीं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum ada pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーはまだありません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 미리 알림이 없어요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum lembrete ainda" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминаний пока нет" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่มีการเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Henüz anımsatıcı yok" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "還沒有提醒" } } } },
    "konclui.reminders.edit" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل التذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার সম্পাদনা" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung bearbeiten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Editar recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Modifier le rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर संपादित करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Edit pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダーを編集" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림 편집" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Editar lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Изменить напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แก้ไขการเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcıyı düzenle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "編輯提醒" } } } },
    "konclui.reminders.new" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تذكير جديد" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নতুন রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Neue Erinnerung" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "New reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Nuevo recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nouveau rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "नया रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat baru" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新規リマインダー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 미리 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Novo lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Новое напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนใหม่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeni anımsatıcı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新提醒" } } } },
    "konclui.claude.fail.notes.reply" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر استخدام ردّ Claude، فبقيت ملاحظات هذه المكالمة كما كانت. حاول مجددًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর উত্তর ব্যবহার করা যায়নি, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Antwort von Claude war nicht brauchbar, deshalb blieben die Notizen dieses Gesprächs unverändert. Versuche es erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude's answer couldn't be used, so the notes of this call were left as they were. Try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo usar la respuesta de Claude, así que las notas de esta llamada se quedaron como estaban. Inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La réponse de Claude était inutilisable, les notes de ce call sont donc restées telles quelles. Réessaie." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude का जवाब इस्तेमाल नहीं हो सका, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jawaban Claude tidak bisa dipakai, jadi catatan panggilan ini dibiarkan apa adanya. Coba lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の回答を使用できなかったため、この通話のメモは変更されていません。もう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude의 답변을 사용할 수 없어 이 통화의 메모는 그대로 두었어요. 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A resposta do Claude não pôde ser usada, então as notas desta chamada ficaram como estavam. Tente de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ответ Claude не удалось использовать, поэтому заметки этого звонка остались как были. Попробуйте ещё раз." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ใช้คำตอบของ Claude ไม่ได้ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม ลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'un yanıtı kullanılamadı, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用 Claude 的回复，所以这次通话的笔记保持原样。请再试一次。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法使用 Claude 的回覆，所以這次通話的筆記維持原樣。請再試一次。" } } } },
    "konclui.claude.fail.notes.slow" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأخر Claude كثيرًا، فبقيت ملاحظات هذه المكالمة كما كانت. إن تكرر ذلك، تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude অনেক দেরি করেছে, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। বারবার হলে আপনার সংযোগ দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude hat zu lange gebraucht, deshalb blieben die Notizen dieses Gesprächs unverändert. Wenn das öfter passiert, prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude took too long, so the notes of this call were left as they were. If it keeps happening, check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude tardó demasiado, así que las notas de esta llamada se quedaron como estaban. Si sigue pasando, revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude a mis trop de temps, les notes de ce call sont donc restées telles quelles. Si cela continue, vérifie ta connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude ने बहुत देर लगाई, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। बार-बार हो तो अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude terlalu lama, jadi catatan panggilan ini dibiarkan apa adanya. Kalau terus begini, periksa koneksimu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の応答に時間がかかりすぎたため、この通話のメモは変更されていません。繰り返す場合は接続を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude의 응답이 너무 늦어 이 통화의 메모는 그대로 두었어요. 계속되면 연결을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude demorou demais, então as notas desta chamada ficaram como estavam. Se continuar, confira sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude отвечал слишком долго, поэтому заметки этого звонка остались как были. Если это повторяется, проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ใช้เวลานานเกินไป จึงคงบันทึกของการโทรนี้ไว้ตามเดิม หากเกิดซ้ำ ให้ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude çok geç yanıt verdi, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Tekrar ederse bağlantını kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 响应太慢，所以这次通话的笔记保持原样。如果经常这样，请检查你的网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 回應太慢，所以這次通話的筆記維持原樣。如果經常這樣，請檢查你的網路連線。" } } } },
    "konclui.claude.fail.notes.offline" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر الوصول إلى Claude، فبقيت ملاحظات هذه المكالمة كما كانت. تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর সঙ্গে যোগাযোগ করা যায়নি, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। আপনার সংযোগ দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude war nicht erreichbar, deshalb blieben die Notizen dieses Gesprächs unverändert. Prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude couldn't be reached, so the notes of this call were left as they were. Check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo contactar con Claude, así que las notas de esta llamada se quedaron como estaban. Revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude est injoignable, les notes de ce call sont donc restées telles quelles. Vérifie ta connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude तक पहुँचा नहीं जा सका, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude tidak bisa dihubungi, jadi catatan panggilan ini dibiarkan apa adanya. Periksa koneksimu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude に接続できなかったため、この通話のメモは変更されていません。接続を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude에 연결할 수 없어 이 통화의 메모는 그대로 두었어요. 연결을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível falar com o Claude, então as notas desta chamada ficaram como estavam. Confira sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось связаться с Claude, поэтому заметки этого звонка остались как были. Проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เชื่อมต่อ Claude ไม่ได้ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'a ulaşılamadı, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Bağlantını kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接到 Claude，所以这次通话的笔记保持原样。请检查你的网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法連線到 Claude，所以這次通話的筆記維持原樣。請檢查你的網路連線。" } } } },
    "konclui.claude.fail.notes.busy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude مشغول، فبقيت ملاحظات هذه المكالمة كما كانت. حاول مجددًا بعد قليل." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude এখন ব্যস্ত, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। একটু পরে আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude ist ausgelastet, deshalb blieben die Notizen dieses Gesprächs unverändert. Versuche es gleich noch einmal." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude is busy, so the notes of this call were left as they were. Try again in a moment." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude está ocupado, así que las notas de esta llamada se quedaron como estaban. Inténtalo de nuevo en un momento." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude est occupé, les notes de ce call sont donc restées telles quelles. Réessaie dans un instant." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude अभी व्यस्त है, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। थोड़ी देर बाद फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude sedang sibuk, jadi catatan panggilan ini dibiarkan apa adanya. Coba lagi sebentar lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude がビジーのため、この通話のメモは変更されていません。しばらくしてからもう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude가 바빠 이 통화의 메모는 그대로 두었어요. 잠시 후 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude está ocupado, então as notas desta chamada ficaram como estavam. Tente de novo em instantes." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude сейчас занят, поэтому заметки этого звонка остались как были. Повторите чуть позже." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ไม่ว่างในขณะนี้ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม ลองอีกครั้งในอีกสักครู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude şu an meşgul, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Biraz sonra tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 现在比较忙，所以这次通话的笔记保持原样。请稍后再试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 目前忙碌中，所以這次通話的筆記維持原樣。請稍後再試。" } } } },
    "konclui.claude.fail.notes.limit" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم بلوغ حد Claude، فبقيت ملاحظات هذه المكالمة كما كانت. حاول مجددًا بعد بضع دقائق." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর সীমা ছুঁয়ে গেছে, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। কয়েক মিনিট পরে আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Limit von Claude ist erreicht, deshalb blieben die Notizen dieses Gesprächs unverändert. Versuche es in ein paar Minuten erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude's limit was reached, so the notes of this call were left as they were. Try again in a few minutes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se alcanzó el límite de Claude, así que las notas de esta llamada se quedaron como estaban. Inténtalo de nuevo en unos minutos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La limite de Claude est atteinte, les notes de ce call sont donc restées telles quelles. Réessaie dans quelques minutes." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude की सीमा पूरी हो गई, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। कुछ मिनट बाद फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Batas Claude tercapai, jadi catatan panggilan ini dibiarkan apa adanya. Coba lagi beberapa menit lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude の上限に達したため、この通話のメモは変更されていません。数分後にもう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude 사용 한도에 도달해 이 통화의 메모는 그대로 두었어요. 몇 분 후 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O limite do Claude foi atingido, então as notas desta chamada ficaram como estavam. Tente de novo em alguns minutos." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Лимит Claude исчерпан, поэтому заметки этого звонка остались как были. Повторите через несколько минут." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ถึงขีดจำกัดของ Claude แล้ว จึงคงบันทึกของการโทรนี้ไว้ตามเดิม ลองอีกครั้งในอีกไม่กี่นาที" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude sınırına ulaşıldı, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Birkaç dakika sonra tekrar dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已达到 Claude 的用量上限，所以这次通话的笔记保持原样。请几分钟后再试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已達到 Claude 的用量上限，所以這次通話的筆記維持原樣。請幾分鐘後再試。" } } } },
    "konclui.claude.fail.notes.refused.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رُفض اشتراكك، فبقيت ملاحظات هذه المكالمة كما كانت. شغّل klaude doctor في Terminal." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার সাবস্ক্রিপশন গ্রহণ করা হয়নি, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। Terminal-এ klaude doctor চালান।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dein Abo wurde abgelehnt, deshalb blieben die Notizen dieses Gesprächs unverändert. Führe klaude doctor im Terminal aus." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your subscription was refused, so the notes of this call were left as they were. Run klaude doctor in Terminal." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu suscripción fue rechazada, así que las notas de esta llamada se quedaron como estaban. Ejecuta klaude doctor en Terminal." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ton abonnement a été refusé, les notes de ce call sont donc restées telles quelles. Lance klaude doctor dans le Terminal." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपकी सदस्यता अस्वीकार कर दी गई, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। Terminal में klaude doctor चलाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langgananmu ditolak, jadi catatan panggilan ini dibiarkan apa adanya. Jalankan klaude doctor di Terminal." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サブスクリプションが拒否されたため、この通話のメモは変更されていません。ターミナルで klaude doctor を実行してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "구독이 거부되어 이 통화의 메모는 그대로 두었어요. 터미널에서 klaude doctor를 실행하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sua assinatura foi recusada, então as notas desta chamada ficaram como estavam. Rode klaude doctor no Terminal." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подписка отклонена, поэтому заметки этого звонка остались как были. Выполните klaude doctor в Терминале." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การสมัครสมาชิกของคุณถูกปฏิเสธ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม รัน klaude doctor ใน Terminal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aboneliğin reddedildi, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Terminal'de klaude doctor çalıştır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的订阅被拒绝了，所以这次通话的笔记保持原样。请在终端运行 klaude doctor。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的訂閱遭到拒絕，所以這次通話的筆記維持原樣。請在終端機執行 klaude doctor。" } } } },
    "konclui.claude.fail.notes.refused.key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض Claude مفتاحك، فبقيت ملاحظات هذه المكالمة كما كانت. تحقق من المفتاح في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude আপনার কী গ্রহণ করেনি, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। চ্যাট পেজে কী-টি দেখে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude hat deinen Schlüssel abgelehnt, deshalb blieben die Notizen dieses Gesprächs unverändert. Prüfe den Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude refused your key, so the notes of this call were left as they were. Check the key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude rechazó tu clave, así que las notas de esta llamada se quedaron como estaban. Revisa la clave en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude a refusé ta clé, les notes de ce call sont donc restées telles quelles. Vérifie la clé dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude ने आपकी कुंजी अस्वीकार कर दी, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। चैट पेज में कुंजी जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude menolak kuncimu, jadi catatan panggilan ini dibiarkan apa adanya. Periksa kunci di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude がキーを拒否したため、この通話のメモは変更されていません。チャットでキーを確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude가 키를 거부해 이 통화의 메모는 그대로 두었어요. 채팅에서 키를 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude recusou sua chave, então as notas desta chamada ficaram como estavam. Confira a chave em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude отклонил ваш ключ, поэтому заметки этого звонка остались как были. Проверьте ключ на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ปฏิเสธคีย์ของคุณ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม ตรวจสอบคีย์ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude anahtarını reddetti, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Anahtarı Sohbet sayfasında kontrol et." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 拒绝了你的密钥，所以这次通话的笔记保持原样。请在“聊天”页面检查密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 拒絕了你的金鑰，所以這次通話的筆記維持原樣。請在「聊天」頁面檢查金鑰。" } } } },
    "konclui.claude.fail.notes.none" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude غير متصل، فبقيت ملاحظات هذه المكالمة كما كانت. صِل اشتراكك أو احفظ مفتاحًا في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude সংযুক্ত নেই, তাই এই কলের নোট আগের মতোই রাখা হয়েছে। চ্যাট পেজে আপনার সাবস্ক্রিপশন সংযুক্ত করুন বা একটি কী সেভ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude ist nicht verbunden, deshalb blieben die Notizen dieses Gesprächs unverändert. Verbinde dein Abo oder speichere einen Schlüssel unter Chat." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude isn't connected, so the notes of this call were left as they were. Connect your subscription or save a key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude no está conectado, así que las notas de esta llamada se quedaron como estaban. Conecta tu suscripción o guarda una clave en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude n'est pas connecté, les notes de ce call sont donc restées telles quelles. Connecte ton abonnement ou enregistre une clé dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude कनेक्ट नहीं है, इसलिए इस कॉल के नोट्स जैसे थे वैसे ही रहे। चैट पेज में अपनी सदस्यता जोड़ें या कुंजी सहेजें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude belum tersambung, jadi catatan panggilan ini dibiarkan apa adanya. Sambungkan langgananmu atau simpan kunci di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude に接続されていないため、この通話のメモは変更されていません。サブスクリプションを接続するか、チャットにキーを保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude에 연결되어 있지 않아 이 통화의 메모는 그대로 두었어요. 구독을 연결하거나 채팅에 키를 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude não está conectado, então as notas desta chamada ficaram como estavam. Conecte sua assinatura ou salve uma chave em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude не подключён, поэтому заметки этого звонка остались как были. Подключите подписку или сохраните ключ на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ยังไม่ได้เชื่อมต่อ จึงคงบันทึกของการโทรนี้ไว้ตามเดิม เชื่อมต่อการสมัครสมาชิกหรือบันทึกคีย์ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude bağlı değil, bu yüzden bu görüşmenin notları olduğu gibi bırakıldı. Aboneliğini bağla ya da Sohbet sayfasında bir anahtar kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 未连接，所以这次通话的笔记保持原样。请在“聊天”页面连接你的订阅或保存密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 尚未連線，所以這次通話的筆記維持原樣。請在「聊天」頁面連結你的訂閱或儲存金鑰。" } } } },
    "konclui.voice.proxy-slow" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استغرق Koncluí Proxy وقتًا طويلًا في الرد. تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy উত্তর দিতে অনেক সময় নিয়েছে। আপনার সংযোগ পরীক্ষা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Koncluí Proxy hat zu lange für die Antwort gebraucht. Prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The Koncluí Proxy took too long to answer. Check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El Koncluí Proxy tardó demasiado en responder. Revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Koncluí Proxy a mis trop de temps à répondre. Vérifiez votre connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy ने जवाब देने में बहुत देर कर दी। अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy terlalu lama menjawab. Periksa koneksi Anda." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy の応答に時間がかかりすぎています。接続を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy의 응답이 너무 늦어요. 연결을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí Proxy demorou demais para responder. Confira sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy слишком долго не отвечал. Проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy ตอบกลับช้าเกินไป ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy yanıt vermekte çok gecikti. Bağlantınızı kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy 响应时间过长。请检查网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy 回應時間過長。請檢查網路連線。" } } } },
    "konclui.keychain.save-failed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر حفظ المفتاح في Keychain. يعمل حتى تُغلق Koncluí. افتح قفل Keychain واحفظه من جديد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কীটি Keychain-এ সেভ করা যায়নি। Koncluí বন্ধ না করা পর্যন্ত এটি কাজ করবে। Keychain আনলক করে আবার সেভ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Schlüssel konnte nicht im Schlüsselbund gespeichert werden. Er gilt nur, bis du Koncluí beendest. Entsperre den Schlüsselbund und speichere ihn erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't save the key in the Keychain. It works until you quit Koncluí. Unlock the Keychain and save it again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo guardar la clave en el Keychain. Vale hasta que cierres Koncluí. Desbloquea el Keychain y guárdala de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La clé n'a pas pu être enregistrée dans le Trousseau. Elle ne vaut que jusqu'à ce que tu quittes Koncluí. Déverrouille le Trousseau et enregistre-la de nouveau." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कुंजी Keychain में सहेजी नहीं जा सकी। यह Koncluí बंद करने तक काम करेगी। Keychain अनलॉक करके फिर से सहेजें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kunci tidak bisa disimpan di Keychain. Kunci berlaku sampai kamu menutup Koncluí. Buka kunci Keychain lalu simpan lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "キーをキーチェーンに保存できませんでした。Koncluí を終了するまでのみ使用できます。キーチェーンのロックを解除して、もう一度保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "키를 키체인에 저장할 수 없어요. Koncluí를 종료할 때까지만 사용할 수 있어요. 키체인을 잠금 해제하고 다시 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível salvar a chave no Keychain. Ela vale só até você sair do Koncluí. Desbloqueie o Keychain e salve de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось сохранить ключ в Keychain. Он действует, пока вы не закроете Koncluí. Разблокируйте Keychain и сохраните ключ снова." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึกคีย์ลง Keychain ไม่ได้ คีย์ใช้งานได้จนกว่าคุณจะปิด Koncluí ปลดล็อก Keychain แล้วบันทึกอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anahtar, Anahtar Zinciri'ne kaydedilemedi. Koncluí'yi kapatana kadar geçerli olur. Anahtar Zincirinin kilidini aç ve yeniden kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法把密钥保存到 Keychain。它在你退出 Koncluí 之前有效。请解锁 Keychain 后重新保存。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法將金鑰儲存到「鑰匙圈」。它在你結束 Koncluí 之前有效。請解鎖「鑰匙圈」後重新儲存。" } } } },
    "konclui.voice.source" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مصدر الصوت" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ভয়েসের উৎস" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Stimmquelle" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Voice source" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Fuente de la voz" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Source de la voix" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आवाज़ का स्रोत" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sumber suara" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声ソース" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "음성 입력" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fonte da voz" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Источник голоса" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แหล่งเสียง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses kaynağı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音来源" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "語音來源" } } } },
    "konclui.undo.note-line" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذف السطر." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "লাইনটি মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeile gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Line deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Línea eliminada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ligne supprimée." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पंक्ति हटा दी गई।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Baris dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "行を削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "줄을 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Linha apagada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Строка удалена." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบบรรทัดแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Satır silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已删除这一行。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已刪除此行。" } } } },
    "konclui.undo" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تراجع" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পূর্বাবস্থায় ফিরুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Rückgängig" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Undo" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Deshacer" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Annuler" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पूर्ववत करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Urungkan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り消す" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실행 취소" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desfazer" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отменить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เลิกทำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geri al" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤销" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "復原" } } } },
    "konclui.undo.recap" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم مسح سجل الملخص الأسبوعي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সাপ্তাহিক সারসংক্ষেপের ইতিহাস মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlauf des Wochenrückblicks gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Weekly recap history cleared." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Historial del resumen semanal borrado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Historique du récap de la semaine effacé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "साप्ताहिक सारांश का इतिहास साफ़ कर दिया गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Riwayat rekap mingguan dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "週間まとめの履歴を消去しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "주간 요약 기록을 지웠어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Histórico da recapitulação semanal limpo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "История итогов недели очищена." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ล้างประวัติสรุปรายสัปดาห์แล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Haftalık özet geçmişi temizlendi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已清除每周回顾的历史记录。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已清除每週回顧的歷史紀錄。" } } } },
    "konclui.settings.all-shortcuts" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض كل الاختصارات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সব শর্টকাট দেখুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Alle Tastenkombinationen ansehen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "See all shortcuts" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ver todos los atajos" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Voir tous les raccourcis" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सभी शॉर्टकट देखें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lihat semua pintasan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべてのショートカットを表示" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 단축키 보기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ver todos os atalhos" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать все горячие клавиши" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ดูปุ่มลัดทั้งหมด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm kısayolları gör" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看全部快捷键" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "查看全部快捷鍵" } } } },
    "konclui.flow.accessibility-stale" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هل هو مفعّل بالفعل؟ احذف Koncluí من القائمة (زر الناقص) ثم أضفه من جديد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আগে থেকেই চালু? তালিকা থেকে Koncluí সরিয়ে (মাইনাস বোতাম) আবার যোগ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schon aktiviert? Entferne Koncluí aus der Liste (Minus-Taste) und füge es erneut hinzu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Already on? Remove Koncluí from the list (the minus button) and add it again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Ya estaba activado? Quita Koncluí de la lista (botón menos) y vuelve a añadirlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Déjà activée ? Retire Koncluí de la liste (bouton moins) puis ajoute-le de nouveau." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले से चालू है? सूची से Koncluí को हटाएँ (माइनस बटन) और फिर जोड़ें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sudah aktif? Hapus Koncluí dari daftar (tombol minus) lalu tambahkan lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "すでにオンですか？リストから Koncluí を削除（マイナスボタン）して、もう一度追加してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 켜져 있나요? 목록에서 Koncluí를 제거(빼기 버튼)한 다음 다시 추가하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Já estava ativado? Remova o Koncluí da lista (botão menos) e adicione de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Уже включено? Удалите Koncluí из списка (кнопка «минус») и добавьте снова." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดอยู่แล้ว? ลบ Koncluí ออกจากรายการ (ปุ่มลบ) แล้วเพิ่มอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zaten açıksa Koncluí'yu listeden çıkar (eksi düğmesi) ve yeniden ekle." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已经打开了？请把 Koncluí 从列表中移除（减号按钮），再重新添加。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已經開啟了？請將 Koncluí 從列表中移除（減號按鈕），再重新加入。" } } } },
    "konclui.flow.accessibility" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج Koncluí إلى إذن تسهيلات الاستخدام للصق ما تُمليه والتقاط مفتاح Esc. فعّله من إعدادات النظام ‹ الخصوصية والأمن ‹ تسهيلات الاستخدام." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি যা ডিক্টেট করেন তা পেস্ট করতে এবং Esc শুনতে Koncluí-র অ্যাক্সেসিবিলিটি অনুমতি দরকার। সিস্টেম সেটিংস › গোপনীয়তা ও নিরাপত্তা › অ্যাক্সেসিবিলিটিতে চালু করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí braucht die Berechtigung für Bedienungshilfen, um Diktiertes einzufügen und Esc zu erkennen. Aktiviere sie unter Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí needs the Accessibility permission to paste what you dictate and to hear Esc. Turn it on in System Settings › Privacy & Security › Accessibility." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí necesita el permiso de Accesibilidad para pegar lo que dictas y detectar Esc. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Accesibilidad." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí a besoin de l'autorisation Accessibilité pour coller ce que tu dictes et détecter Échap. Active-la dans Réglages Système › Confidentialité et sécurité › Accessibilité." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप जो डिक्टेट करते हैं उसे पेस्ट करने और Esc सुनने के लिए Koncluí को एक्सेसिबिलिटी अनुमति चाहिए। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › एक्सेसिबिलिटी में इसे चालू करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí membutuhkan izin Aksesibilitas untuk menempelkan hasil dikte dan mendeteksi Esc. Aktifkan di Pengaturan Sistem › Privasi & Keamanan › Aksesibilitas." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí が音声入力した内容をペーストし、Esc キーを検知するにはアクセシビリティの許可が必要です。システム設定 › プライバシーとセキュリティ › アクセシビリティでオンにしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 받아쓴 내용을 붙여넣고 Esc 키를 감지하려면 손쉬운 사용 권한이 필요해요. 시스템 설정 › 개인정보 보호 및 보안 › 손쉬운 사용에서 켜세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí precisa da permissão de Acessibilidade para colar o que você dita e ouvir o Esc. Ative em Ajustes do Sistema › Privacidade e Segurança › Acessibilidade." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí нужно разрешение «Универсальный доступ», чтобы вставлять продиктованное и видеть Esc. Включите его в Системных настройках › Конфиденциальность и безопасность › Универсальный доступ." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ต้องได้รับอนุญาตด้านการช่วยการเข้าถึงเพื่อวางข้อความที่คุณป้อนด้วยเสียงและรับรู้ปุ่ม Esc เปิดได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › การช่วยการเข้าถึง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí'nun dikte ettiğin metni yapıştırması ve Esc tuşunu algılaması için Erişilebilirlik izni gerekir. Sistem Ayarları › Gizlilik ve Güvenlik › Erişilebilirlik bölümünden aç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 需要“辅助功能”权限才能粘贴你听写的内容并识别 Esc。请在“系统设置”›“隐私与安全性”›“辅助功能”中打开。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 需要「輔助使用」權限才能貼上你聽寫的內容並偵測 Esc。請在「系統設定 › 隱私權與安全性 › 輔助使用」中開啟。" } } } },
    "konclui.hub.styles-turn-on" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تشغيل التنقيح" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরিষ্কার করা চালু করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Überarbeiten einschalten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on the clean-up" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activar la limpieza" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Activer le nettoyage" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सफ़ाई चालू करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan perapian" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "文章の整えをオンにする" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "텍스트 다듬기 켜기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ligar a limpeza" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включить чистку" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการปรับข้อความ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düzenlemeyi aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启整理" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟整理" } } } },
    "konclui.hub.styles-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُطبَّق الأنماط عندما يكون التنقيح باستخدام Claude مفعّلًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude দিয়ে পরিষ্কার করা চালু থাকলেই স্টাইলগুলো কাজ করে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Stile gelten, wenn das Überarbeiten mit Claude eingeschaltet ist." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Styles apply when the Claude clean-up is on." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Los estilos valen cuando la limpieza con Claude está activada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les styles s'appliquent quand le nettoyage avec Claude est activé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "शैलियाँ तभी लागू होती हैं जब Claude से सफ़ाई चालू हो।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gaya berlaku saat perapian dengan Claude aktif." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude による文章の整えがオンのときにスタイルが適用されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude로 다듬기를 켜면 스타일이 적용돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os estilos valem quando a limpeza com o Claude está ligada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Стили действуют, когда включена чистка текста с Claude." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รูปแบบจะมีผลเมื่อเปิดการปรับข้อความด้วย Claude" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Üsluplar, Claude ile düzenleme açıkken geçerlidir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启“用 Claude 整理”后，风格才会生效。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟「使用 Claude 整理文字」後，風格才會生效。" } } } },
    "konclui.stat.next-on %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اضغط مطولًا على %@ في أي تطبيق وتحدّث." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "যেকোনো অ্যাপে %@ চেপে ধরে বলুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Halte %@ in einer beliebigen App gedrückt und sprich." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold %@ in any app and speak." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mantén %@ en cualquier app y habla." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Maintiens %@ dans n'importe quelle app et parle." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "किसी भी ऐप में %@ दबाए रखें और बोलें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tahan %@ di app mana pun lalu bicara." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのアプリでも %@ を押したまま話します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "어떤 앱에서든 %@을(를) 누른 채 말하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Segure %@ em qualquer app e fale." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удерживайте %@ в любом приложении и говорите." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กด %@ ค้างไว้ในแอปใดก็ได้แล้วพูด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Herhangi bir uygulamada %@ tuşunu basılı tutup konuş." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在任何 App 中按住 %@ 并说话。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在任何 App 中按住 %@ 並說話。" } } } },
    "konclui.stat.col-speaking" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحدث" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বলা" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Sprechzeit" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Speaking" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hablando" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Parole" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बोलना" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bicara" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "話した時間" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "말한 시간" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Falando" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Речь" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เวลาพูด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Konuşma" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说话" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "說話" } } } },
    "konclui.stat.col-words" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكلمات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শব্দ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wörter" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Words" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Palabras" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mots" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "शब्द" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kata" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "単語数" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단어 수" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Palavras" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Слов" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sözcük" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "字数" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "字數" } } } },
    "konclui.stat.col-day" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اليوم" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "দিন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Tag" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Day" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Día" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Jour" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "दिन" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hari" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "日" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "날짜" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Dia" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "День" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "วัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gün" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日期" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "日期" } } } },
    "konclui.stat.total" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإجمالي" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "মোট" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gesamt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Total" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Total" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Total" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कुल" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Total" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "合計" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "합계" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Total" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Итого" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รวม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Toplam" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "合计" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "總計" } } } },
    "konclui.stat.speed-none" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يظهر بعد أول إملاء، عندما يتوفر وقت تحدث يمكن قياسه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রথম ডিক্টেশনের পর দেখা যাবে, যখন মাপার মতো কথা বলার সময় থাকবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erscheint nach dem ersten Diktat, sobald es Sprechzeit zum Messen gibt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows after the first dictation, once there is speaking time to measure." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aparece después del primer dictado, cuando hay tiempo de habla que medir." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apparaît après la première dictée, quand il y a un temps de parole à mesurer." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले डिक्टेशन के बाद दिखेगा, जब मापने लायक बोलने का समय होगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Muncul setelah dikte pertama, saat ada waktu bicara yang bisa diukur." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初の音声入力後、話した時間を測定できるようになると表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 받아쓰기 후 측정할 말하기 시간이 생기면 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aparece depois do primeiro ditado, quando há tempo de fala para medir." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Появится после первой диктовки, когда будет время речи для измерения." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จะแสดงหลังการป้อนตามคำบอกครั้งแรก เมื่อมีเวลาพูดให้วัดได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İlk diktenden sonra görünür, ölçülecek konuşma süresi olduğunda." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第一次听写之后才会显示，那时才有可测量的说话时间。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "第一次聽寫之後才會顯示，那時才有可測量的說話時間。" } } } },
    "konclui.stat.streak-none" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا إملاء اليوم ولا أمس. تبدأ السلسلة من جديد مع الإملاء التالي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আজ বা গতকাল কোনো ডিক্টেশন হয়নি। পরের ডিক্টেশন থেকে ধারা আবার শুরু হবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Weder heute noch gestern ein Diktat. Die Serie beginnt mit dem nächsten Diktat neu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No dictation today or yesterday. The streak starts again with the next one." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ningún dictado hoy ni ayer. La racha empieza de nuevo con el siguiente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune dictée aujourd'hui ni hier. La série repart avec la prochaine." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आज और कल कोई डिक्टेशन नहीं हुआ। अगले डिक्टेशन से सिलसिला फिर शुरू होगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada dikte hari ini maupun kemarin. Rentetan dimulai lagi dengan dikte berikutnya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "今日も昨日も音声入力がありません。次の音声入力から連続記録が再開します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘이나 어제 받아쓰기가 없어요. 다음 받아쓰기부터 연속 기록이 다시 시작돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum ditado hoje nem ontem. A sequência recomeça no próximo ditado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ни сегодня, ни вчера диктовок не было. Серия начнётся заново со следующей." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่มีการป้อนตามคำบอกทั้งวันนี้และเมื่อวาน ช่วงต่อเนื่องจะเริ่มใหม่เมื่อป้อนครั้งถัดไป" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bugün de dün de dikte yok. Seri bir sonraki dikteyle yeniden başlar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天和昨天都没有听写。下一次听写会重新开始连续计数。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "今天和昨天都沒有聽寫。下一次聽寫會重新開始連續計算。" } } } },
    "konclui.stat.none" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا إملاء في هذه الفترة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সময়ে কোনো ডিক্টেশন হয়নি।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Diktat in diesem Zeitraum." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No dictation in this period." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ningún dictado en este periodo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune dictée sur cette période." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस अवधि में कोई डिक्टेशन नहीं हुआ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada dikte pada periode ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この期間に音声入力はありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 기간에는 받아쓰기가 없어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum ditado neste período." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "В этом периоде диктовок нет." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่มีการป้อนตามคำบอกในช่วงเวลานี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu dönemde dikte yok." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这段时间没有听写。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這段期間沒有聽寫。" } } } },
    "konclui.stat.streak-how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أيام متتالية فيها إملاء واحد على الأقل، تُحتسب حتى اليوم (أو حتى أمس إن لم يكن لليوم أي إملاء بعد)." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "টানা যত দিন অন্তত একটি ডিক্টেশন হয়েছে, আজ পর্যন্ত গোনা (আজ এখনও কোনো ডিক্টেশন না হলে গতকাল পর্যন্ত)।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Tage in Folge mit mindestens einem Diktat, gezählt bis heute (oder bis gestern, falls heute noch keins war)." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Days in a row with at least one dictation, counted up to today (or yesterday, if today has none yet)." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Días seguidos con al menos un dictado, contados hasta hoy (o hasta ayer, si hoy aún no hay ninguno)." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Jours d'affilée avec au moins une dictée, comptés jusqu'à aujourd'hui (ou hier, s'il n'y en a pas encore aujourd'hui)." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "लगातार वे दिन जिनमें कम से कम एक डिक्टेशन हुआ, आज तक गिने गए (या कल तक, अगर आज अभी तक कोई नहीं हुआ)।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hari berturut-turut dengan setidaknya satu dikte, dihitung sampai hari ini (atau kemarin, jika hari ini belum ada)." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "1 日に 1 回以上音声入力した連続日数です。今日までを数え、今日まだ入力していない場合は昨日までを数えます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "하루에 한 번 이상 받아쓴 연속 일수예요. 오늘까지 계산하며, 오늘 아직 없다면 어제까지 계산해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Dias seguidos com pelo menos um ditado, contados até hoje (ou até ontem, se hoje ainda não teve nenhum)." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Дни подряд хотя бы с одной диктовкой, считаются до сегодняшнего дня (или до вчерашнего, если сегодня диктовок ещё не было)." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จำนวนวันติดต่อกันที่มีการป้อนตามคำบอกอย่างน้อยหนึ่งครั้ง นับถึงวันนี้ (หรือถึงเมื่อวาน หากวันนี้ยังไม่มี)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "En az bir dikte yapılan ardışık günler, bugüne kadar sayılır (bugün henüz yoksa düne kadar)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "至少有一次听写的连续天数，统计到今天（如果今天还没有听写，则统计到昨天）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "至少有一次聽寫的連續天數，統計到今天（如果今天還沒有聽寫，則統計到昨天）。" } } } },
    "konclui.stat.saved-how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوقت الذي كانت ستستغرقه كتابة الكلمات (الكلمات ÷ 45 في الدقيقة) ناقص الوقت الذي قضيته في التحدث." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শব্দগুলো টাইপ করতে যত সময় লাগত (শব্দ ÷ মিনিটে ৪৫) তা থেকে কথা বলতে যে সময় গেছে তা বাদ দিলে যা থাকে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Zeit, die Tippen der Wörter gedauert hätte (Wörter ÷ 45 pro Minute), minus die Zeit, die du mit Sprechen verbracht hast." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The time typing the words would take (words ÷ 45 per minute) minus the time you spent speaking." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El tiempo que habría llevado teclear las palabras (palabras ÷ 45 por minuto) menos el tiempo que pasaste hablando." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le temps qu'il aurait fallu pour taper les mots (mots ÷ 45 par minute) moins le temps passé à parler." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "शब्द टाइप करने में लगने वाला समय (शब्द ÷ 45 प्रति मिनट) घटा बोलने में लगा समय।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Waktu yang dibutuhkan untuk mengetik kata-kata itu (kata ÷ 45 per menit) dikurangi waktu yang kamu habiskan untuk berbicara." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "単語を入力するのにかかる時間（1 分あたり 45 語）から、話した時間を差し引いた値です。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단어를 입력하는 데 걸리는 시간(분당 45단어 기준)에서 말한 시간을 뺀 값이에요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O tempo que digitar as palavras levaria (palavras ÷ 45 por minuto) menos o tempo que você passou falando." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Время, которое ушло бы на набор слов (слова ÷ 45 в минуту), минус время, потраченное на речь." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เวลาที่ต้องใช้พิมพ์คำเหล่านี้ (จำนวนคำ ÷ 45 ต่อนาที) ลบด้วยเวลาที่คุณใช้พูด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sözcükleri yazmanın süreceği zaman (sözcük ÷ dakikada 45) eksi konuşarak geçirdiğin zaman." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打出这些字所需的时间（字数 ÷ 每分钟 45 个）减去你说话所花的时间。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "輸入這些字所需的時間（字數 ÷ 每分鐘 45 字）減去你說話所花的時間。" } } } },
    "konclui.stat.speed-how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكلمات المُملاة ÷ دقائق التحدث خلال الفترة. الوقت بين الإملاءات لا يُحتسب." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সময়ে ডিক্টেট করা শব্দ ÷ কথা বলার মিনিট। দুই ডিক্টেশনের মাঝের সময় গোনা হয় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diktierte Wörter ÷ Minuten Sprechzeit im Zeitraum. Die Zeit zwischen den Diktaten zählt nicht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Words dictated ÷ minutes speaking, over the period. The time between dictations does not count." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Palabras dictadas ÷ minutos hablando, en el periodo. El tiempo entre dictados no cuenta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mots dictés ÷ minutes de parole sur la période. Le temps entre deux dictées ne compte pas." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस अवधि में डिक्टेट किए शब्द ÷ बोलने के मिनट। दो डिक्टेशन के बीच का समय नहीं गिना जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kata didiktekan ÷ menit berbicara pada periode ini. Jeda di antara dikte tidak dihitung." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "期間中に音声入力した単語数を、話した時間（分）で割った値です。音声入力の間の時間は含まれません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "해당 기간에 받아쓴 단어 수를 말한 시간(분)으로 나눈 값이에요. 받아쓰기 사이의 대기 시간은 포함되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Palavras ditadas ÷ minutos falando, no período. O tempo parado entre os ditados não conta." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Продиктованные слова ÷ минуты речи за период. Время между диктовками не учитывается." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จำนวนคำที่ป้อน ÷ จำนวนนาทีที่พูดในช่วงเวลานี้ ช่วงเวลาระหว่างการป้อนแต่ละครั้งไม่นับ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dönemde dikte edilen sözcükler ÷ konuşma dakikaları. Diktelerin arasındaki süre sayılmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该时段内的听写字数 ÷ 说话分钟数。两次听写之间的时间不计入。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "該時段內的聽寫字數 ÷ 說話分鐘數。兩次聽寫之間的時間不計入。" } } } },
    "konclui.stat.dictations-how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عدد مرات الإملاء في هذه الفترة: كل نص يُلصق يُحتسب مرة واحدة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সময়ে কতবার ডিক্টেট করেছেন: প্রতিটি পেস্ট করা লেখা একবার গোনা হয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wie oft du im Zeitraum diktiert hast: Jeder eingefügte Text zählt einmal." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "How many times you dictated in the period: each pasted text counts as one." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cuántos dictados hiciste en el periodo: cada texto pegado cuenta como uno." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Combien de dictées tu as faites sur la période : chaque texte collé compte pour une." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस अवधि में आपने कितनी बार डिक्टेट किया: चिपकाया गया हर टेक्स्ट एक गिना जाता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Berapa kali kamu berdikte pada periode ini: setiap teks yang ditempel dihitung satu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "期間中に音声入力した回数です。ペーストしたテキスト 1 件を 1 回として数えます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 기간의 받아쓰기 횟수예요. 붙여 넣은 텍스트 하나도 한 번으로 계산해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Quantos ditados você fez no período: cada texto colado conta um." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сколько раз вы диктовали за период: каждый вставленный текст считается за одну диктовку." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จำนวนครั้งที่คุณป้อนตามคำบอกในช่วงเวลานี้ ข้อความที่วางแต่ละครั้งนับเป็นหนึ่ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dönemde kaç kez dikte ettiğin: yapıştırılan her metin bir sayılır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该时段内你听写的次数：每段粘贴的文字算一次。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "該時段內你聽寫的次數：每段貼上的文字算一次。" } } } },
    "konclui.stat.words-how" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مجموع كلمات كل إملاء في هذه الفترة، محسوبة على هذا الـ Mac." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সময়ের সব ডিক্টেশনের শব্দের যোগফল, এই Mac-এ গোনা।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Summe der Wörter aller Diktate im Zeitraum, auf diesem Mac gezählt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The sum of the words of every dictation in the period, counted on this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Suma de las palabras de todos los dictados del periodo, contadas en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Somme des mots de toutes les dictées de la période, comptés sur ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस अवधि के सभी डिक्टेशन के शब्दों का जोड़, जो इसी Mac पर गिना गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Jumlah kata dari semua dikte pada periode ini, dihitung di Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "期間中に音声入力したすべての単語数の合計です。この Mac 上で集計されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "해당 기간에 받아쓴 모든 단어의 합계이며, 이 Mac에서 계산해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Soma das palavras de todos os ditados do período, contadas neste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сумма слов всех диктовок за период, подсчитанная на этом Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ผลรวมจำนวนคำของทุกการป้อนตามคำบอกในช่วงเวลานี้ นับบน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dönemdeki tüm diktelerin sözcük toplamı, bu Mac'te sayılır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该时段内每次听写的字数之和，在这台 Mac 上统计。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "該時段內每次聽寫的字數總和，在這台 Mac 上統計。" } } } },
    "konclui.stat.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعرض مصدر هذا الرقم والأيام التي يتكوّن منها." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সংখ্যাটি কোথা থেকে এসেছে এবং কোন কোন দিনের হিসাব, তা দেখায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt, woher diese Zahl kommt und welche Tage dahinterstehen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows where this number comes from and the days behind it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra de dónde sale este número y los días que lo forman." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Montre d'où vient ce chiffre et les jours qui le composent." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "दिखाता है कि यह संख्या कहाँ से आती है और किन दिनों से बनी है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menampilkan asal angka ini dan hari-hari yang membentuknya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この数値の内訳と対象の日付を表示します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 숫자의 계산 방식과 해당 날짜를 표시해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostra de onde vem este número e os dias por trás dele." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показывает, откуда это число и из каких дней оно складывается." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงที่มาของตัวเลขนี้และวันที่นำมารวมกัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu sayının nereden geldiğini ve hangi günlerden oluştuğunu gösterir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示这个数字的来源和组成它的每一天。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "顯示這個數字的來源，以及組成它的每一天。" } } } },
    "konclui.stat.unavailable" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "غير متاح" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অনুপলব্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "nicht verfügbar" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "unavailable" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "no disponible" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "indisponible" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "उपलब्ध नहीं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "tidak tersedia" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用不可" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용할 수 없음" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "indisponível" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "недоступно" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่พร้อมใช้งาน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kullanılamıyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不可用" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法使用" } } } },
    "konclui.home.local-only" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى هذه الأرقام على هذا الـ Mac فقط." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সংখ্যাগুলো শুধু এই Mac-এই থাকে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Zahlen bleiben nur auf diesem Mac." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "These numbers stay on this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Estas cifras se quedan solo en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces chiffres restent uniquement sur ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ये आँकड़े सिर्फ़ इसी Mac पर रहते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Angka-angka ini hanya tersimpan di Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらの数値はこの Mac 内にのみ保存されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 통계는 이 Mac에만 저장돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Estes números ficam só neste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эти цифры хранятся только на этом Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตัวเลขเหล่านี้เก็บไว้ใน Mac เครื่องนี้เท่านั้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu sayılar yalnızca bu Mac'te kalır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些数字只保存在这台 Mac 上。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這些數字只保存在這台 Mac 上。" } } } },
    "konclui.home.empty-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تظهر إملاءاتك هنا بعد أن تفعّل الإملاء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিক্টেশন চালু করার পর আপনার ডিক্টেশন এখানে দেখা যাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Diktate erscheinen hier, sobald du das Diktieren aktivierst." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your dictations will show here once you turn on dictation." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus dictados aparecerán aquí cuando actives el dictado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes dictées s'afficheront ici une fois la dictée activée." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिक्टेशन चालू करने के बाद आपके डिक्टेशन यहाँ दिखेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Diktemu akan muncul di sini setelah kamu mengaktifkan dikte." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力をオンにすると、ここに入力内容が表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기를 켜면 여기에 받아쓴 내용이 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seus ditados aparecem aqui depois que você ativar o ditado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ваши диктовки появятся здесь после включения диктовки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ข้อความที่ป้อนจะแสดงที่นี่หลังจากคุณเปิดการป้อนตามคำบอก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikteyi açtıktan sonra diktelerin burada görünür." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启听写后，你的听写内容会显示在这里。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟聽寫後，聽寫內容會顯示在這裡。" } } } },
    "konclui.home.hint-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فعّل الإملاء لتكتب بصوتك في أي تطبيق." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "যেকোনো অ্যাপে কথা বলে লিখতে ডিক্টেশন চালু করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere das Diktieren, um in jeder App per Sprache zu schreiben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on dictation to write by speaking in any app." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activa el dictado para escribir hablando en cualquier app." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Active la dictée pour écrire en parlant dans n'importe quelle app." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "किसी भी ऐप में बोलकर लिखने के लिए डिक्टेशन चालू करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan dikte untuk menulis dengan bicara di app mana pun." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力をオンにすると、どのアプリでも話して入力できます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기를 켜면 어떤 앱에서든 말로 입력할 수 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ative o ditado para escrever falando em qualquer app." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включите диктовку, чтобы писать голосом в любом приложении." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการป้อนตามคำบอกเพื่อพิมพ์ด้วยเสียงในแอปใดก็ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Herhangi bir uygulamada konuşarak yazmak için dikteyi aç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启听写，即可在任何 App 中用说话代替打字。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟聽寫，即可在任何 App 中用說話代替打字。" } } } },
    "konclui.undo.shortcuts" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أُعيد ضبط الاختصارات." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শর্টকাট রিসেট করা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Tastenkombinationen zurückgesetzt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Shortcuts reset." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Atajos restablecidos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Raccourcis réinitialisés." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "शॉर्टकट रीसेट कर दिए गए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pintasan direset." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ショートカットをリセットしました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "단축키를 재설정했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Atalhos redefinidos." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Горячие клавиши сброшены." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รีเซ็ตปุ่มลัดแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kısayollar sıfırlandı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已重置快捷键。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已重設快捷鍵。" } } } },
    "konclui.undo.everything" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حُذف السجل والإحصاءات." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ইতিহাস ও পরিসংখ্যান মুছে ফেলা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verlauf und Statistiken gelöscht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "History and statistics deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Historial y estadísticas borrados." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Historique et statistiques effacés." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इतिहास और आँकड़े मिटा दिए गए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Riwayat dan statistik dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "履歴と統計を削除しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록과 통계를 삭제했어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Histórico e estatísticas apagados." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "История и статистика стёрты." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลบประวัติและสถิติแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Geçmiş ve istatistikler silindi." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已清除历史记录和统计数据。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已清除歷史紀錄和統計資料。" } } } },
