    "konclui.hint.snippet-text" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب النص الذي يلصقه Koncluí." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí যে লেখা পেস্ট করবে তা লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibe den Text, den Koncluí einfügt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type the text Koncluí pastes." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe el texto que pega Koncluí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écris le texte que Koncluí colle." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "वह टेक्स्ट लिखें जो Koncluí चिपकाएगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tulis teks yang ditempel Koncluí." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí がペーストするテキストを入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 붙여넣을 텍스트를 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escreva o texto que o Koncluí cola." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Введите текст, который вставит Koncluí." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์ข้อความที่ Koncluí จะวาง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí'nun yapıştıracağı metni yaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入 Koncluí 要粘贴的文字。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請輸入 Koncluí 要貼上的文字。" } } } },
    "konclui.hint.trigger" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب أولًا ما تقوله." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আগে আপনি যা বলেন তা লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibe zuerst, was du sagst." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type what you say first." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe primero lo que dices." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écris d'abord ce que tu dis." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले लिखें कि आप क्या बोलते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tulis dulu yang kamu ucapkan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初に話す言葉を入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "먼저 말할 내용을 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escreva primeiro o que você diz." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сначала введите, что вы говорите." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์สิ่งที่คุณพูดก่อน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce söylediğini yaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先输入你说的话。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先輸入你說的話。" } } } },
    "konclui.hint.written" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب كيف يجب أن يُكتب." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কীভাবে লেখা হবে তা লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibe, wie es geschrieben werden soll." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type how it should be written." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe cómo debe quedar escrito." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écris comment cela doit s'écrire." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "लिखें कि यह कैसे लिखा जाए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tulis bagaimana seharusnya ditulis." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのように表記するか入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "어떻게 적을지 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escreva como deve ficar escrito." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Введите, как это нужно писать." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์ว่าควรเขียนอย่างไร" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Nasıl yazılacağını yaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入应写成的内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請輸入應寫成的內容。" } } } },
    "konclui.hint.heard" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب أولًا ما تم سماعه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আগে যা শোনা গেছে তা লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibe zuerst, was gehört wurde." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type what was heard first." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe primero lo que se oyó." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écris d'abord ce qui a été entendu." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले लिखें कि क्या सुना गया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tulis dulu apa yang terdengar." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初に聞き取った内容を入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "먼저 들은 내용을 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escreva primeiro o que foi ouvido." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сначала введите услышанное." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์คำที่ได้ยินก่อน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce duyulanı yaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先输入听到的内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先輸入辨識到的文字。" } } } },
    "konclui.hint.word" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اكتب الكلمة أولًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আগে শব্দটি লিখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibe zuerst das Wort." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Type the word first." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escribe primero la palabra." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écris d'abord le mot." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहले शब्द लिखें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tulis kata dulu." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初に単語を入力してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "먼저 단어를 입력하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escreva a palavra primeiro." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сначала введите слово." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "พิมพ์คำก่อน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce sözcüğü yaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先输入词语。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請先輸入詞彙。" } } } },
    "konclui.home.empty" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ستظهر إملاءاتك هنا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনার ডিক্টেশন এখানে দেখা যাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Diktate erscheinen hier." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your dictations will show here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus dictados aparecerán aquí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes dictées s'afficheront ici." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आपके डिक्टेशन यहाँ दिखेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Diktemu akan muncul di sini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力した内容がここに表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓴 내용이 여기에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seus ditados aparecerão aqui." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Здесь появятся ваши диктовки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ข้อความที่ป้อนจะแสดงที่นี่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Diktelerin burada görünür." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的听写会显示在这里。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "聽寫內容會顯示在這裡。" } } } },
    "konclui.settings.sub" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفتاح الإملاء والتعرّف على الصوت وما يتم حفظه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিক্টেশনের কি, ভয়েস রিকগনিশন এবং কী সংরক্ষিত থাকে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Diktiertaste, die Spracherkennung und was gespeichert bleibt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The dictation key, speech recognition and what is kept." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La tecla del dictado, el reconocimiento de voz y lo que se guarda." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La touche de dictée, la reconnaissance vocale et ce qui est conservé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिक्टेशन की, आवाज़ की पहचान और क्या सहेजा जाता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tombol dikte, pengenalan suara, dan apa yang disimpan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力キー、音声認識、保存される内容。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기 키, 음성 인식 및 보관되는 내용." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A tecla do ditado, o reconhecimento de voz e o que fica guardado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Клавиша диктовки, распознавание речи и то, что сохраняется." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปุ่มป้อนตามคำบอก การรู้จำเสียง และสิ่งที่เก็บไว้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikte tuşu, ses tanıma ve nelerin saklandığı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写按键、语音识别，以及保留的内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "聽寫按鍵、語音辨識，以及保留的內容。" } } } },
    "konclui.status.turn-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف الإملاء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিক্টেশন বন্ধ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diktieren deaktivieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off dictation" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivar el dictado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactiver la dictée" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिक्टेशन बंद करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Nonaktifkan dikte" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力をオフにする" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기 끄기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desativar o ditado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключить диктовку" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดการป้อนตามคำบอก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikteyi kapat" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭听写" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉聽寫" } } } },
    "konclui.status.open-settings" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح إعدادات الإملاء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিক্টেশনের সেটিংস খুলুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diktiereinstellungen öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open dictation settings" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir los ajustes del dictado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir les réglages de la dictée" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिक्टेशन की सेटिंग्स खोलें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka pengaturan dikte" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力の設定を開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기 설정 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir os ajustes do ditado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть настройки диктовки" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการตั้งค่าการป้อนตามคำบอก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikte ayarlarını aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开听写设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟聽寫設定" } } } },
    "konclui.status.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح خيارات الإملاء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিক্টেশনের বিকল্প খোলে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die Optionen fürs Diktieren." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens the dictation options." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre las opciones del dictado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre les options de la dictée." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिक्टेशन के विकल्प खोलता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka opsi dikte." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力のオプションを開きます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "받아쓰기 옵션을 열어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre as opções do ditado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает параметры диктовки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดตัวเลือกการป้อนตามคำบอก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dikte seçeneklerini açar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开听写选项。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟聽寫選項。" } } } },
    "konclui.agents.door.hint %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح تثبيت %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@-এর ইনস্টল খোলে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die Installation für %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens the install for %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre la instalación para %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre l'installation pour %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ के लिए इंस्टॉल खोलता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka instalasi untuk %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ のインストール画面を開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 설치 화면 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre a instalação para %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает установку для %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการติดตั้งสำหรับ %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ için kurulumu açar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 %@ 的安装" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟 %@ 的安裝" } } } },
    "konclui.agents.door.plugin %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يرى Koncluí جلسات %@ إلا بعد تثبيت المكوّن الإضافي. لا يُكتب أي شيء قبل أن تؤكد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্লাগইন ইনস্টল না হওয়া পর্যন্ত Koncluí %@-এর সেশন দেখতে পায় না। আপনি নিশ্চিত করার আগে কিছু লেখা হয় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí sieht die Sitzungen von %@ erst, wenn das Plugin installiert ist. Vor deiner Bestätigung wird nichts geschrieben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí only sees %@ sessions once the plugin is installed. Nothing is written until you confirm." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí solo ve las sesiones de %@ cuando el plugin está instalado. No se escribe nada hasta que confirmes." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ne voit les sessions de %@ qu'une fois le plugin installé. Rien n'est écrit avant ta confirmation." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्लगइन इंस्टॉल होने के बाद ही Koncluí को %@ के सेशन दिखते हैं। आपके पुष्टि करने तक कुछ नहीं लिखा जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí baru melihat sesi %@ setelah plugin terpasang. Tidak ada yang ditulis sebelum kamu mengonfirmasi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プラグインをインストールすると、Koncluí が %@ のセッションを認識できるようになります。確認するまで何も書き込まれません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "플러그인을 설치해야 Koncluí가 %@ 세션을 볼 수 있어요. 확인하기 전에는 아무것도 기록되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí só vê as sessões do %@ depois que o plugin for instalado. Nada é gravado antes de você confirmar." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí видит сессии %@ только после установки плагина. Ничего не записывается, пока ты не подтвердишь." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí จะเห็นเซสชันของ %@ ก็ต่อเมื่อติดตั้งปลั๊กอินแล้ว และจะไม่มีการเขียนอะไรจนกว่าคุณจะยืนยัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí, eklenti kurulmadan %@ oturumlarını göremez. Sen onaylamadan hiçbir şey yazılmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装插件后，Koncluí 才能看到 %@ 的会话。你确认之前不会写入任何内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝外掛後，Koncluí 才能看到 %@ 的工作階段。你確認之前不會寫入任何內容。" } } } },
    "konclui.agents.door.hooks %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يرى Koncluí جلسات %@ إلا بعد تثبيت الـ hooks. لا يُكتب أي شيء قبل أن تؤكد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "hooks ইনস্টল না হওয়া পর্যন্ত Koncluí %@-এর সেশন দেখতে পায় না। আপনি নিশ্চিত করার আগে কিছু লেখা হয় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí sieht die Sitzungen von %@ erst, wenn die Hooks installiert sind. Vor deiner Bestätigung wird nichts geschrieben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí only sees %@ sessions once the hooks are installed. Nothing is written until you confirm." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí solo ve las sesiones de %@ cuando los hooks están instalados. No se escribe nada hasta que confirmes." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ne voit les sessions de %@ qu'une fois les hooks installés. Rien n'est écrit avant ta confirmation." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "hooks इंस्टॉल होने के बाद ही Koncluí को %@ के सेशन दिखते हैं। आपके पुष्टि करने तक कुछ नहीं लिखा जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí baru melihat sesi %@ setelah hooks terpasang. Tidak ada yang ditulis sebelum kamu mengonfirmasi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "フックをインストールすると、Koncluí が %@ のセッションを認識できるようになります。確認するまで何も書き込まれません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "훅을 설치해야 Koncluí가 %@ 세션을 볼 수 있어요. 확인하기 전에는 아무것도 기록되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí só vê as sessões do %@ depois que os hooks forem instalados. Nada é gravado antes de você confirmar." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí видит сессии %@ только после установки хуков. Ничего не записывается, пока ты не подтвердишь." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí จะเห็นเซสชันของ %@ ก็ต่อเมื่อติดตั้ง hooks แล้ว และจะไม่มีการเขียนอะไรจนกว่าคุณจะยืนยัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí, hook'lar kurulmadan %@ oturumlarını göremez. Sen onaylamadan hiçbir şey yazılmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装 hooks 后，Koncluí 才能看到 %@ 的会话。你确认之前不会写入任何内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝 hooks 後，Koncluí 才能看到 %@ 的工作階段。你確認之前不會寫入任何內容。" } } } },
    "konclui.agents.row.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح خيارات هذا الوكيل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই এজেন্টের অপশন খোলে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die Optionen dieses Agenten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens this agent's options" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre las opciones de este agente" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre les options de cet agent" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस एजेंट के विकल्प खोलता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka opsi agen ini" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このエージェントのオプションを開きます" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 에이전트의 옵션을 열어요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre as opções deste agente" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает параметры этого агента" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดตัวเลือกของเอเจนต์นี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu ajanın seçeneklerini açar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开此代理的选项" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟此代理程式的選項" } } } },
    "konclui.agents.needs-permission" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج إلى إذن" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অনুমতি দরকার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Braucht eine Erlaubnis" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs permission" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Necesita permiso" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisation requise" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अनुमति चाहिए" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Perlu izin" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "許可が必要" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "권한 필요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Precisa de permissão" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нужно разрешение" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ต้องการสิทธิ์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İzin gerekiyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要权限" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "需要權限" } } } },
    "konclui.agents.off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "غير مفعّل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeschaltet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turned off" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dimatikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "꺼짐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desativado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已关闭" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已關閉" } } } },
    "konclui.agents.on" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفعّل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চালু" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eingeschaltet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turned on" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Activé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चालू है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktif" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オン" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "켜짐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ativado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açık" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已开启" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已開啟" } } } },
    "konclui.agents.plugin.installed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المكوّن الإضافي مثبَّت" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্লাগইন ইনস্টল করা আছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Plugin installiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Plugin installed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Plugin instalado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plugin installé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्लगइन इंस्टॉल है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Plugin terpasang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "プラグインをインストール済み" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "플러그인 설치됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Plugin instalado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Плагин установлен" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้งปลั๊กอินแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eklenti kurulu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插件已安装" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "外掛已安裝" } } } },
    "konclui.agents.hooks.outdated" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Hooks قديمة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Hooks পুরোনো" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Hooks veraltet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hooks outdated" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hooks desactualizados" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hooks obsolètes" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Hooks पुराने हैं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hooks sudah usang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "フックが古い" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "훅이 오래됨" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Hooks desatualizados" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хуки устарели" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Hooks ล้าสมัย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hook'lar eski" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hooks 已过期" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Hooks 已過期" } } } },
    "konclui.agents.hooks.installed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Hooks مثبتة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Hooks ইনস্টল করা আছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installiert" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hooks instalados" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installés" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Hooks स्थापित हैं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hooks terpasang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "フックをインストール済み" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "훅 설치 완료" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Hooks instalados" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хуки установлены" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้ง Hooks แล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hook'lar kurulu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hooks 已安装" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Hooks 已安裝" } } } },
    "konclui.whatsapp.preview.held" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ينتظر بهدوء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চুপচাপ অপেক্ষা করছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "wartet leise" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "waits quietly" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "espera en silencio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "attend en silence" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चुपचाप इंतज़ार" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "menunggu tenang" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "静かに待機" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "조용히 기다려요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "espera em silêncio" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "ждёт тихо" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รออยู่เงียบๆ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sessizce bekliyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "静静等待" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "靜靜等待" } } } },
    "konclui.whatsapp.preview.note.unread %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفتح الدردشة مع %@. تبقى غير مقروءة حتى ترد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি %@ এর সঙ্গে চ্যাট খোলেন। উত্তর না দেওয়া পর্যন্ত এটি অপঠিত থাকে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Du öffnest den Chat mit %@. Er bleibt ungelesen, bis du antwortest." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You open the chat with %@. It stays unread until you reply." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abres el chat con %@. Sigue sin leer hasta que respondes." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu ouvres la discussion avec %@. Elle reste non lue jusqu’à ta réponse." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप %@ के साथ चैट खोलते हैं। जवाब देने तक वह अपठित रहती है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu membuka obrolan dengan %@. Obrolan tetap belum dibaca sampai kamu membalas." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@とのチャットを開きます。返信するまで未読のままです。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@와의 채팅을 열어요. 답장할 때까지 읽지 않음으로 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você abre a conversa com %@. Ela continua não lida até você responder." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы открываете чат с %@. Он остаётся непрочитанным, пока вы не ответите." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คุณเปิดแชตกับ %@ แชตนั้นจะยังไม่ถูกอ่านจนกว่าคุณจะตอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ ile sohbeti açarsın. Yanıtlayana kadar okunmamış kalır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你打开与 %@ 的聊天。回复之前它仍保持未读。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你打開與 %@ 的聊天。回覆之前它仍保持未讀。" } } } },
    "konclui.whatsapp.preview.note.read %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفتح الدردشة مع %@. تُعلَّم كمقروءة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি %@ এর সঙ্গে চ্যাট খোলেন। এটি পড়া হিসেবে চিহ্নিত হয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Du öffnest den Chat mit %@. Er wird als gelesen markiert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You open the chat with %@. It is marked as read." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abres el chat con %@. Se marca como leído." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu ouvres la discussion avec %@. Elle est marquée comme lue." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप %@ के साथ चैट खोलते हैं। वह पढ़ी हुई के रूप में चिह्नित हो जाती है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu membuka obrolan dengan %@. Obrolan ditandai sudah dibaca." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@とのチャットを開きます。既読になります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@와의 채팅을 열어요. 읽음으로 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você abre a conversa com %@. Ela é marcada como lida." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы открываете чат с %@. Он отмечается как прочитанный." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คุณเปิดแชตกับ %@ แชตนั้นถูกทำเครื่องหมายว่าอ่านแล้ว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ ile sohbeti açarsın. Okundu olarak işaretlenir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你打开与 %@ 的聊天。它被标记为已读。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你打開與 %@ 的聊天。它會標記為已讀。" } } } },
    "konclui.whatsapp.preview.note.held %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التركيز قيد التشغيل. %@ ينتظر بهدوء، بلا صوت ولا تفاعل." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ফোকাস চালু। %@ চুপচাপ অপেক্ষা করে, শব্দ ছাড়া, প্রতিক্রিয়া ছাড়া।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Fokus an. %@ wartet leise, ohne Ton und ohne Reaktion." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus on. %@ waits quietly, with no sound and no reaction." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Concentración activa. %@ espera en silencio, sin sonido ni reacción." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Concentration active. %@ attend en silence, sans son ni réaction." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फ़ोकस चालू। %@ चुपचाप इंतज़ार करता है, न आवाज़, न प्रतिक्रिया।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Fokus aktif. %@ menunggu dengan tenang, tanpa suara dan tanpa reaksi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "集中モード中です。%@は音も反応もなく、静かに待機します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "집중 모드가 켜져 있어요. %@은(는) 소리나 반응 없이 조용히 기다려요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Foco ligado. %@ espera em silêncio, sem som e sem reação." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Фокусирование включено. %@ ждёт тихо, без звука и реакции." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "โฟกัสเปิดอยู่ %@ รออยู่เงียบๆ ไม่มีเสียงและไม่มีปฏิกิริยา" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Odak açık. %@ sessizce bekler, ses yok, tepki yok." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注模式已开启。%@ 静静等待，无声音，无反应。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "專注模式已開啟。%@ 靜靜等待，無聲音，無反應。" } } } },
    "konclui.whatsapp.preview.note.opened" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفتح النوتش. الرسالة الجديدة في الأعلى." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আপনি নচ খোলেন। নতুন বার্তা সবার উপরে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Du öffnest die Notch. Die neue Nachricht steht oben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "You open the notch. The new message is at the top." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abres el notch. El mensaje nuevo aparece arriba." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tu ouvres le notch. Le nouveau message est en haut." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "आप नॉच खोलते हैं। नया संदेश सबसे ऊपर है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kamu membuka notch. Pesan baru ada di atas." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノッチを開くと、新しいメッセージが一番上に表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "노치를 열어요. 새 메시지가 맨 위에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Você abre o notch. A mensagem nova aparece no topo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вы открываете чёлку. Новое сообщение сверху." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คุณเปิดรอยบาก ข้อความใหม่อยู่ด้านบนสุด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çentiği açarsın. Yeni mesaj en üstte." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你打开刘海。新消息显示在最上面。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你打開瀏海。新訊息顯示在最上面。" } } } },
    "konclui.whatsapp.preview.note.arrives.group %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رسالة جديدة في %@. Koru تقفز وواتساب يضيء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@: নতুন বার্তা এসেছে। Koru লাফ দেয় আর WhatsApp জ্বলে ওঠে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ hat eine neue Nachricht. Koru hüpft und WhatsApp leuchtet auf." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ has a new message. Koru hops and WhatsApp lights up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ tiene un mensaje nuevo. Koru da un salto y WhatsApp se ilumina." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ a un nouveau message. Koru saute et WhatsApp s’allume." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ में नया संदेश आया है। Koru उछलती है और WhatsApp जल उठता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ punya pesan baru. Koru melompat dan WhatsApp menyala." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@から新しいメッセージが届きました。Koru が跳ねて WhatsApp が光ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@에게 새 메시지가 왔어요. 코루가 뛰어오르고 WhatsApp이 켜져요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ tem uma mensagem nova. A Koru dá um pulinho e o WhatsApp acende." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "В %@ новое сообщение. Koru подпрыгивает, и WhatsApp загорается." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "%@ มีข้อความใหม่ Koru กระโดด และ WhatsApp สว่างขึ้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ içinde yeni bir mesaj var. Koru zıplıyor ve WhatsApp yanıyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 有一条新消息。Koru 跳了一下，WhatsApp 亮起。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 有一則新訊息。Koru 跳了一下，WhatsApp 亮起。" } } } },
    "konclui.whatsapp.preview.note.arrives.mention %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@ يشير إليك. Koru تقفز وواتساب يضيء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ আপনাকে উল্লেখ করেছে। Koru লাফ দেয় আর WhatsApp জ্বলে ওঠে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ erwähnt dich. Koru hüpft und WhatsApp leuchtet auf." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ mentions you. Koru hops and WhatsApp lights up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ te menciona. Koru da un salto y WhatsApp se ilumina." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ te mentionne. Koru saute et WhatsApp s’allume." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ में आपका उल्लेख है। Koru उछलती है और WhatsApp जल उठता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ menyebut kamu. Koru melompat dan WhatsApp menyala." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@があなたにメンションしました。Koru が跳ねて WhatsApp が光ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@이(가) 회원님을 언급했어요. 코루가 뛰어오르고 WhatsApp이 켜져요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ menciona você. A Koru dá um pulinho e o WhatsApp acende." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ упоминает вас. Koru подпрыгивает, и WhatsApp загорается." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "%@ กล่าวถึงคุณ Koru กระโดด และ WhatsApp สว่างขึ้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ senden bahsediyor. Koru zıplıyor ve WhatsApp yanıyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 提到了你。Koru 跳了一下，WhatsApp 亮起。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 提到了你。Koru 跳了一下，WhatsApp 亮起。" } } } },
    "konclui.whatsapp.preview.note.arrives.direct %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@ يكتب لك. Koru تقفز وواتساب يضيء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "%@ আপনাকে লিখছে। Koru লাফ দেয় আর WhatsApp জ্বলে ওঠে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ schreibt dir. Koru hüpft und WhatsApp leuchtet auf." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ writes to you. Koru hops and WhatsApp lights up." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ te escribe. Koru da un salto y WhatsApp se ilumina." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ t’écrit. Koru saute et WhatsApp s’allume." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "%@ आपको लिख रहा है। Koru उछलती है और WhatsApp जल उठता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "%@ menulis kepadamu. Koru melompat dan WhatsApp menyala." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@からメッセージが届きました。Koru が跳ねて WhatsApp が光ります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@이(가) 메시지를 보냈어요. 코루가 뛰어오르고 WhatsApp이 켜져요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "%@ escreve para você. A Koru dá um pulinho e o WhatsApp acende." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ пишет вам. Koru подпрыгивает, и WhatsApp загорается." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "%@ ส่งข้อความถึงคุณ Koru กระโดด และ WhatsApp สว่างขึ้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ sana yazıyor. Koru zıplıyor ve WhatsApp yanıyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 给你发来消息。Koru 跳了一下，WhatsApp 亮起。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "%@ 傳來訊息。Koru 跳了一下，WhatsApp 亮起。" } } } },
    "konclui.whatsapp.preview.note.waiting" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "النوتش ينتظر رسالة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নচ একটি বার্তার অপেক্ষায় আছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Notch wartet auf eine Nachricht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The notch waits for a message." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El notch espera un mensaje." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le notch attend un message." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "नॉच किसी संदेश का इंतज़ार कर रहा है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Notch menunggu pesan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノッチでメッセージを待機します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "노치가 메시지를 기다려요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O notch espera uma mensagem." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чёлка ждёт сообщения." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รอยบากกำลังรอข้อความ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çentik bir mesaj bekliyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刘海正在等待消息。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "瀏海正在等待訊息。" } } } },
    "konclui.notes.speech.upgrade-label" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختياري: Parakeet" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ঐচ্ছিক: Parakeet" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Optional: Parakeet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional: Parakeet" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Opcional: Parakeet" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Facultatif : Parakeet" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "वैकल्पिक: Parakeet" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Opsional: Parakeet" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オプション：Parakeet" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택 사항: Parakeet" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Opcional: Parakeet" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "По желанию: Parakeet" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตัวเลือกเสริม: Parakeet" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İsteğe bağlı: Parakeet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选：Parakeet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選用：Parakeet" } } } },
    "konclui.notes.speech.upgrade-detail" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدق، ويميّز كل شخص في المكالمة. تنزيل واحد بحجم نحو 650 ميغابايت، ثم يعمل بلا إنترنت." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আরও নির্ভুল, এবং কলের প্রত্যেক ব্যক্তিকে আলাদা করে। একবার প্রায় ৬৫০ MB ডাউনলোড, তারপর অফলাইনে চলে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Genauer und unterscheidet jede Person im Gespräch. Ein einmaliger Download von etwa 650 MB, danach läuft es offline." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "More accurate, and tells each person on the call apart. One download of about 650 MB, then it works offline." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Más preciso y separa a cada persona de la llamada. Una descarga de unos 650 MB y luego funciona sin conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Plus précis, et sépare chaque personne de l'appel. Un téléchargement d'environ 650 Mo, puis ça marche hors ligne." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ज़्यादा सटीक, और कॉल में हर व्यक्ति को अलग करता है। लगभग 650 MB का एक डाउनलोड, फिर ऑफ़लाइन चलता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Lebih akurat, dan memisahkan setiap orang dalam panggilan. Satu kali unduh sekitar 650 MB, lalu bekerja luring." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "精度が上がり、通話中の人を個別に識別します。約 650 MB を一度ダウンロードすれば、オフラインでも使えます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "더 정확하고 통화 중인 사람을 각각 구분해요. 약 650MB를 한 번 다운로드하면 오프라인에서도 작동해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mais preciso e separa cada pessoa da chamada. Um download de cerca de 650 MB, depois funciona offline." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Точнее и разделяет всех участников звонка. Одна загрузка около 650 МБ, дальше работает без сети." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แม่นยำกว่า และแยกผู้พูดแต่ละคนในสายได้ ดาวน์โหลดครั้งเดียวประมาณ 650 MB จากนั้นใช้งานออฟไลน์ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Daha doğru ve görüşmedeki her kişiyi ayırır. Yaklaşık 650 MB'lık tek seferlik indirme, sonra çevrimdışı çalışır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更准确，并能区分通话中的每个人。只需下载一次（约 650 MB），之后离线运行。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "更準確，並能區分通話中的每個人。僅需下載一次（約 650 MB），之後離線運作。" } } } },
    "konclui.notes.speech.unsupported" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يدعم نسخ Mac الصوتي لغتك هنا. نزّل Parakeet لتسجيل المكالمات." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Mac-এর ট্রান্সক্রিপশন এখানে আপনার ভাষা সমর্থন করে না। কল রেকর্ড করতে Parakeet ডাউনলোড করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Transkription deines Macs unterstützt deine Sprache hier nicht. Lade Parakeet herunter, um Gespräche aufzunehmen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Mac's transcription does not support your language here. Download Parakeet to record calls." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La transcripción del Mac no admite tu idioma aquí. Descarga Parakeet para grabar llamadas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La transcription du Mac ne gère pas ta langue ici. Télécharge Parakeet pour enregistrer des appels." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Mac का ट्रांसक्रिप्शन यहाँ आपकी भाषा का समर्थन नहीं करता। कॉल रिकॉर्ड करने के लिए Parakeet डाउनलोड करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Transkripsi Mac tidak mendukung bahasamu di sini. Unduh Parakeet untuk merekam panggilan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac の音声入力はここではお使いの言語に対応していません。通話を録音するには Parakeet をダウンロードしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac의 음성 인식은 여기서 이 언어를 지원하지 않아요. 통화 내용을 기록하려면 Parakeet을 다운로드하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A transcrição do Mac não oferece o seu idioma aqui. Baixe o Parakeet para gravar chamadas." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Расшифровка на Mac не поддерживает ваш язык. Скачайте Parakeet, чтобы записывать звонки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การถอดเสียงของ Mac ไม่รองรับภาษาของคุณที่นี่ ดาวน์โหลด Parakeet เพื่อบันทึกสาย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mac'in yazıya dökmesi burada dilini desteklemiyor. Aramaları kaydetmek için Parakeet'i indir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 自带的转写在此处不支持你的语言。请下载 Parakeet 来录制通话。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Mac 內建的轉錄在此處不支援你的語言。請下載 Parakeet 來錄製通話。" } } } },
    "konclui.notes.speech.unreadable" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّرت قراءة الصوت للنسخ الصوتي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ট্রান্সক্রিপশনের জন্য অডিও পড়া যায়নি।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Audio konnte für die Transkription nicht gelesen werden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The audio could not be read for the transcription." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo leer el audio para la transcripción." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de lire l'audio pour la transcription." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ट्रांसक्रिप्शन के लिए ऑडियो पढ़ा नहीं जा सका।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Audio tidak dapat dibaca untuk transkripsi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力用のオーディオを読み取れませんでした。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "전사할 오디오를 읽을 수 없어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível ler o áudio para a transcrição." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось прочитать звук для расшифровки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อ่านเสียงเพื่อถอดเสียงไม่ได้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses, yazıya dökmek için okunamadı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取音频以进行转写。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法讀取音訊以進行轉錄。" } } } },
    "konclui.notes.speech.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسخ Mac الصوتي، على هذا الجهاز" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Mac-এর ট্রান্সক্রিপশন, এই ডিভাইসেই" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Transkription deines Macs, auf diesem Gerät" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Mac's transcription, on this device" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Transcripción del Mac, en este equipo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Transcription du Mac, sur cet appareil" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Mac का ट्रांसक्रिप्शन, इसी डिवाइस पर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Transkripsi Mac, di perangkat ini" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このデバイス上で使う Mac の音声入力" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac의 음성 인식" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Transcrição do Mac, neste aparelho" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Расшифровка на Mac, прямо на этом устройстве" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การถอดเสียงของ Mac บนอุปกรณ์เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mac'in yazıya dökmesi, bu cihazda" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Mac 自带的转写，在此设备上运行" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Mac 內建的轉錄，在此裝置上執行" } } } },
    "konclui.notes.speech.row-hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح خيارات النسخ الصوتي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ট্রান্সক্রিপশনের বিকল্প খোলে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die Transkriptionsoptionen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens the transcription options." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre las opciones de transcripción." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre les options de transcription." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ट्रांसक्रिप्शन के विकल्प खोलता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka opsi transkripsi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声入力のオプションを開きます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "통화 전사 옵션을 열어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre as opções de transcrição." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает параметры расшифровки." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดตัวเลือกการถอดเสียง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yazıya dökme seçeneklerini açar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开转写选项。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟轉錄選項。" } } } },
    "konclui.notes.speech.retry" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إعادة المحاولة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "আবার চেষ্টা করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erneut versuchen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Try again" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Reintentar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réessayer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फिर कोशिश करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Coba lagi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "再試行" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 시도" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tentar de novo" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Повторить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden dene" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重試" } } } },
    "konclui.notes.speech.one-voice" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "من دون Parakeet يظهر جميع الآخرين في المكالمة كشخص واحد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet ছাড়া কলের বাকি সবাই একজন ব্যক্তি হিসেবে দেখা যায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ohne Parakeet erscheinen alle anderen im Gespräch als eine Person." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Without Parakeet, everyone else on the call appears as one person." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin Parakeet, todas las demás personas de la llamada aparecen como una sola." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sans Parakeet, tous les autres participants de l'appel apparaissent comme une seule personne." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet के बिना कॉल के बाकी सभी लोग एक ही व्यक्ति के रूप में दिखते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tanpa Parakeet, semua orang lain dalam panggilan tampil sebagai satu orang." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet がない場合、通話中のほかの人は 1 人として表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet이 없으면 통화 중인 다른 사람은 한 사람으로 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sem o Parakeet, todas as outras pessoas da chamada aparecem como uma só." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Без Parakeet все остальные участники звонка отображаются как один человек." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หากไม่มี Parakeet ผู้พูดคนอื่นทั้งหมดในสายจะแสดงเป็นคนเดียว" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet olmadan görüşmedeki diğer herkes tek bir kişi olarak görünür." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有 Parakeet 时，通话中的其他人都会显示为同一个人。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有 Parakeet 時，通話中的其他人都會顯示為同一個人。" } } } },
    "konclui.notes.speech.installing" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تجهيز لغتك على هذا الـ Mac." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এ আপনার ভাষা প্রস্তুত করা হচ্ছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Sprache wird auf diesem Mac vorbereitet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing your language on this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preparando tu idioma en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préparation de ta langue sur ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर आपकी भाषा तैयार की जा रही है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menyiapkan bahasamu di Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac で使う言語を準備しています。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 사용할 언어를 준비하고 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Preparando o idioma neste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Готовим ваш язык на этом Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังเตรียมภาษาของคุณบน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dilin bu Mac'te hazırlanıyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在这台 Mac 上准备你的语言。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在這台 Mac 上準備你的語言。" } } } },
    "konclui.notes.speech.install-failed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر تجهيز لغتك على هذا الـ Mac. التسجيل محفوظ. اتصل بالإنترنت وحاول مرة أخرى." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এ আপনার ভাষা প্রস্তুত করা যায়নি। রেকর্ডিং রেখে দেওয়া হয়েছে। ইন্টারনেটে সংযুক্ত হয়ে আবার চেষ্টা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Sprache konnte auf diesem Mac nicht vorbereitet werden. Die Aufnahme bleibt erhalten. Verbinde dich mit dem Internet und versuche es erneut." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not prepare your language on this Mac. The recording is kept. Connect to the internet and try again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo preparar tu idioma en este Mac. La grabación se conserva. Conéctate a internet e inténtalo de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de préparer ta langue sur ce Mac. L'enregistrement est conservé. Connecte-toi à internet et réessaie." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर आपकी भाषा तैयार नहीं हो सकी। रिकॉर्डिंग सुरक्षित है। इंटरनेट से जुड़ें और फिर कोशिश करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak dapat menyiapkan bahasamu di Mac ini. Rekaman tetap disimpan. Sambungkan ke internet lalu coba lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac で使う言語を準備できませんでした。録音は保持されています。インターネットに接続して、もう一度お試しください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서 사용할 언어를 준비하지 못했어요. 녹음은 보존돼요. 인터넷에 연결한 후 다시 시도하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível preparar o idioma neste Mac. A gravação foi mantida. Conecte-se à internet e tente de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось подготовить ваш язык на этом Mac. Запись сохранена. Подключитесь к интернету и повторите." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เตรียมภาษาของคุณบน Mac เครื่องนี้ไม่สำเร็จ เก็บการบันทึกไว้แล้ว เชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dilin bu Mac'te hazırlanamadı. Kayıt korundu. İnternete bağlanıp yeniden dene." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法在这台 Mac 上准备你的语言。录音已保留。请连接互联网后重试。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法在這台 Mac 上準備你的語言。錄音已保留。請連線至網際網路後再試一次。" } } } },
    "konclui.notes.speech.first-time" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يجهّز أول تسجيل لغتك على هذا الـ Mac." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রথম রেকর্ডিংয়ে এই Mac-এ আপনার ভাষা প্রস্তুত করা হবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die erste Aufnahme bereitet deine Sprache auf diesem Mac vor." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The first recording prepares your language on this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La primera grabación prepara tu idioma en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le premier enregistrement prépare ta langue sur ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पहली रिकॉर्डिंग इस Mac पर आपकी भाषा तैयार करेगी।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rekaman pertama menyiapkan bahasamu di Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "初回の録音時に、この Mac で使う言語を準備します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "첫 녹음 시 이 Mac에서 사용할 언어를 준비해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A primeira gravação prepara o idioma neste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Первая запись подготовит ваш язык на этом Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การบันทึกครั้งแรกจะเตรียมภาษาของคุณบน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İlk kayıt, dilini bu Mac'te hazırlar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "首次录制时会在这台 Mac 上准备你的语言。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "首次錄製時會在這台 Mac 上準備你的語言。" } } } },
    "konclui.notes.speech.download-progress" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ تنزيل Parakeet" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet ডাউনলোড হচ্ছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet wird heruntergeladen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading Parakeet" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Descargando Parakeet" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Téléchargement de Parakeet" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet डाउनलोड हो रहा है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mengunduh Parakeet" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet をダウンロード中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet 다운로드 중" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Baixando o Parakeet" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка Parakeet" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังดาวน์โหลด Parakeet" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet indiriliyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载 Parakeet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在下載 Parakeet" } } } },
    "konclui.notes.speech.download" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تنزيل Parakeet" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet ডাউনলোড করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet herunterladen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Parakeet" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Descargar Parakeet" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Télécharger Parakeet" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet डाउनलोड करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Unduh Parakeet" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet をダウンロード" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet 다운로드" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Baixar o Parakeet" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скачать Parakeet" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ดาวน์โหลด Parakeet" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Parakeet'i indir" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载 Parakeet" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "下載 Parakeet" } } } },
    "konclui.notes.speech.detail" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سجّل دون تنزيل أي شيء. كل شيء يبقى على هذا الـ Mac." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কিছু ডাউনলোড না করেই রেকর্ড করুন। সবকিছু এই Mac-এই থাকে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nimm auf, ohne etwas herunterzuladen. Alles bleibt auf diesem Mac." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Record without downloading anything. Everything stays on this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Graba sin descargar nada. Todo se queda en este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistre sans rien télécharger. Tout reste sur ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कुछ भी डाउनलोड किए बिना रिकॉर्ड करें। सब कुछ इसी Mac पर रहता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Rekam tanpa mengunduh apa pun. Semuanya tetap di Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "何もダウンロードせずに録音できます。すべてこの Mac 内にとどまります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아무것도 다운로드하지 않고 녹음하세요. 모든 내용은 이 Mac에만 저장돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Grave sem baixar nada. Tudo fica neste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Записывайте без загрузок. Всё остаётся на этом Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึกได้โดยไม่ต้องดาวน์โหลดอะไร ทุกอย่างอยู่บน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hiçbir şey indirmeden kaydet. Her şey bu Mac'te kalır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无需下载任何内容即可录制。一切都留在这台 Mac 上。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無需下載任何內容即可錄製。一切都留在這台 Mac 上。" } } } },
    "konclui.voice.permission.open-settings" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح إعدادات النظام" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সিস্টেম সেটিংস খোলো" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Systemeinstellungen öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Ajustes del Sistema" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Réglages Système" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिस्टम सेटिंग्स खोलो" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka Pengaturan Sistem" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "システム設定を開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 설정 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Ajustes do Sistema" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть Системные настройки" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดการตั้งค่าระบบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sistem Ayarları'nı aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开系统设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟系統設定" } } } },
    "konclui.voice.permission.denied" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الميكروفون أو التعرف على الكلام محظور. اسمح به من إعدادات النظام ‹ الخصوصية والأمن." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "মাইক্রোফোন বা বক্তৃতা স্বীকৃতি ব্লক করা আছে। সিস্টেম সেটিংস › গোপনীয়তা ও নিরাপত্তায় অনুমতি দাও।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Mikrofon oder Spracherkennung ist gesperrt. Erlaube sie unter Systemeinstellungen › Datenschutz & Sicherheit." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The microphone or speech recognition is blocked. Allow it in System Settings, under Privacy and Security." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El micrófono o el reconocimiento de voz está bloqueado. Permítelo en Ajustes del Sistema › Privacidad y seguridad." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le micro ou la reconnaissance vocale est bloqué. Autorise-le dans Réglages Système › Confidentialité et sécurité." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "माइक्रोफ़ोन या वाक् पहचान ब्लॉक है। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा में अनुमति दो।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mikrofon atau pengenalan ucapan diblokir. Izinkan di Pengaturan Sistem › Privasi & Keamanan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マイクまたは音声認識がブロックされています。システム設定 › プライバシーとセキュリティで許可してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마이크 또는 음성 인식이 차단됐어요. 시스템 설정 › 개인정보 보호 및 보안에서 허용하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O microfone ou o reconhecimento de fala está bloqueado. Libere em Ajustes do Sistema › Privacidade e Segurança." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Микрофон или распознавание речи заблокированы. Разреши доступ в Системных настройках › Конфиденциальность и безопасность." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไมโครโฟนหรือการรู้จำเสียงพูดถูกบล็อกอยู่ อนุญาตได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mikrofon veya konuşma tanıma engellenmiş. Sistem Ayarları › Gizlilik ve Güvenlik bölümünden izin ver." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风或语音识别已被阻止。请在“系统设置 › 隐私与安全性”中允许。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "麥克風或語音辨識已被封鎖。請在「系統設定 › 隱私權與安全性」中允許。" } } } },
    "konclui.voice.permission.reason" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح بالوصول إلى الميكروفون والتعرف على الكلام لتفعيل هذا الخيار." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এটি চালু করতে মাইক্রোফোন ও বক্তৃতা স্বীকৃতির অনুমতি দাও।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlaube Mikrofon und Spracherkennung, um dies zu aktivieren." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow the microphone and speech recognition to turn this on." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Permite el micrófono y el reconocimiento de voz para activarlo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorise le micro et la reconnaissance vocale pour l'activer." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इसे चालू करने के लिए माइक्रोफ़ोन और वाक् पहचान की अनुमति दो।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Izinkan mikrofon dan pengenalan ucapan untuk mengaktifkannya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この機能をオンにするには、マイクと音声認識を許可してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 기능을 켜려면 마이크와 음성 인식을 허용하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Permita o microfone e o reconhecimento de fala para ativar." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разреши доступ к микрофону и распознаванию речи, чтобы включить." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "อนุญาตให้ใช้ไมโครโฟนและการรู้จำเสียงพูดเพื่อเปิดใช้งาน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Etkinleştirmek için mikrofona ve konuşma tanımaya izin ver." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请允许使用麦克风和语音识别，才能打开。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請允許使用麥克風和語音辨識，才能開啟。" } } } },
    "konclui.voice.checking" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التحقق من اتصالاتك" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "তোমার সংযোগগুলো যাচাই করা হচ্ছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verbindungen werden geprüft" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking your connections" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando tus conexiones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérification de tes connexions" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "तुम्हारे कनेक्शन जाँचे जा रहे हैं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memeriksa koneksimu" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "接続を確認中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "연결 확인 중" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verificando suas conexões" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверяем подключения" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlantıların denetleniyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查你的连接" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在檢查你的連線" } } } },
    "konclui.voice.claude.failed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر الوصول إلى Claude في المحاولة الأخيرة. تستمر أوامر العبارات في العمل." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শেষবার Claude-এর কাছে পৌঁছানো যায়নি। বাক্যের কমান্ড কাজ করতে থাকবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude war beim letzten Versuch nicht erreichbar. Satzbefehle funktionieren weiter." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't reach Claude on the last try. Phrase commands keep working." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo contactar con Claude en el último intento. Los comandos de frase siguen funcionando." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude n'a pas pu être joint à la dernière tentative. Les commandes par phrases continuent de fonctionner." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पिछली बार Claude तक नहीं पहुँच पाए। वाक्य कमांड काम करते रहेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude tidak terjangkau pada percobaan terakhir. Perintah frasa tetap berfungsi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "前回 Claude に接続できませんでした。フレーズコマンドは引き続き使えます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막 시도에서 Claude에 연결하지 못했어요. 구문 명령은 계속 사용할 수 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível falar com o Claude na última tentativa. Os comandos de frase continuam funcionando." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "В прошлый раз связаться с Claude не удалось. Команды-фразы продолжают работать." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดต่อ Claude ไม่ได้ในครั้งล่าสุด คำสั่งแบบวลียังใช้งานได้ตามปกติ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude'a son denemede ulaşılamadı. Cümle komutları çalışmaya devam eder." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上次尝试未能连接到 Claude。短语命令仍然可用。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "上次嘗試未能連線到 Claude。片語指令仍可使用。" } } } },
    "konclui.voice.claude.open-chat" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح الدردشة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চ্যাট খুলুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Chat öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Chat" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Chat" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Chat" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चैट खोलें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka Chat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "チャットを開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "채팅 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Chat" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть Чат" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sohbeti aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开聊天" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟聊天" } } } },
    "konclui.voice.claude.missing" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج Claude إلى اتصال. أعدّ klaude (Koncluí Proxy) أو احفظ مفتاح Anthropic API في صفحة الدردشة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude-এর জন্য একটি সংযোগ লাগে। klaude (Koncluí Proxy) সেট আপ করো, অথবা চ্যাট পেজে একটি Anthropic API কী সংরক্ষণ করো।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude braucht eine Verbindung. Richte klaude (Koncluí Proxy) ein oder speichere unter Chat einen Anthropic-API-Schlüssel." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude needs a connection. Set up klaude (Koncluí Proxy) or save an Anthropic API key in Chat." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude necesita una conexión. Configura klaude (Koncluí Proxy) o guarda una clave de API de Anthropic en Chat." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude a besoin d'une connexion. Configure klaude (Koncluí Proxy) ou enregistre une clé API Anthropic dans Chat." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude को एक कनेक्शन चाहिए। klaude (Koncluí Proxy) सेट करो, या चैट पेज में Anthropic API कुंजी सहेजो।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude butuh koneksi. Siapkan klaude (Koncluí Proxy) atau simpan kunci API Anthropic di Chat." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude への接続が必要です。klaude（Koncluí Proxy）を設定するか、チャットに Anthropic API キーを保存してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude에 연결해야 해요. klaude(Koncluí Proxy)를 설정하거나 채팅에 Anthropic API 키를 저장하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Claude precisa de uma conexão. Configure o klaude (Koncluí Proxy) ou salve uma chave de API da Anthropic em Chat." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude нужно подключение. Настрой klaude (Koncluí Proxy) или сохрани ключ Anthropic API на странице Чат." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ต้องมีการเชื่อมต่อ ตั้งค่า klaude (Koncluí Proxy) หรือบันทึกคีย์ Anthropic API ได้ที่หน้าแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude için bir bağlantı gerekir. klaude'u (Koncluí Proxy) kur ya da Sohbet sayfasına bir Anthropic API anahtarı kaydet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 需要一个连接。请设置 klaude（Koncluí Proxy），或在“聊天”页面中保存 Anthropic API 密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 需要連線。請設定 klaude（Koncluí Proxy），或在「聊天」頁面中儲存 Anthropic API 金鑰。" } } } },
    "konclui.voice.claude.consent-key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عند التشغيل، تُرسل كلماتك نصًّا إلى Claude بمفتاح Anthropic API الخاص بك. أما الصوت فلا يغادر هذا الـ Mac أبدًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চালু করলে তোমার কথা লেখা আকারে তোমার Anthropic API কী দিয়ে Claude-এর কাছে যাবে। অডিও কখনো এই Mac ছেড়ে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn aktiv, gehen deine Worte als Text mit deinem Anthropic-API-Schlüssel an Claude. Das Audio verlässt diesen Mac nie." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, your words, as text, go to Claude with your Anthropic API key. The audio never leaves this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Al activarlo, tus palabras, como texto, van a Claude con tu clave de API de Anthropic. El audio nunca sale de este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une fois activé, tes mots, sous forme de texte, vont à Claude avec ta clé API Anthropic. L'audio ne quitte jamais ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चालू करने पर तुम्हारे शब्द, टेक्स्ट के रूप में, तुम्हारी Anthropic API कुंजी से Claude तक जाएँगे। ऑडियो कभी इस Mac से बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saat aktif, kata-katamu, dalam bentuk teks, dikirim ke Claude dengan kunci API Anthropic-mu. Audionya tidak pernah keluar dari Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オンにすると、話した内容がテキストとして Anthropic API キーを使って Claude に送信されます。音声がこの Mac の外に送信されることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "켜면 사용자의 말이 텍스트로 변환되어 Anthropic API 키를 사용해 Claude로 전송돼요. 오디오는 이 Mac 밖으로 나가지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ao ligar, suas palavras, em texto, vão para o Claude com a sua chave de API da Anthropic. O áudio nunca sai deste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "После включения твои слова в виде текста будут уходить к Claude с твоим ключом Anthropic API. Звук никогда не покидает этот Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เมื่อเปิด คำพูดของคุณจะถูกส่งเป็นข้อความไปยัง Claude ด้วยคีย์ Anthropic API ของคุณ ส่วนเสียงจะไม่ออกจาก Mac เครื่องนี้เลย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açıldığında sözlerin metin olarak Anthropic API anahtarınla Claude'a gider. Ses hiçbir zaman bu Mac'ten çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开后，你说的话会以文字形式，用你的 Anthropic API 密钥发送给 Claude。音频永远不会离开这台 Mac。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟後，你說的話會以文字形式，用你的 Anthropic API 金鑰傳送給 Claude。音訊永遠不會離開這部 Mac。" } } } },
    "konclui.voice.claude.consent-proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عند التشغيل، تُرسل كلماتك نصًّا إلى Claude عبر اشتراكك (Koncluí Proxy). أما الصوت فلا يغادر هذا الـ Mac أبدًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চালু করলে তোমার কথা লেখা আকারে তোমার সাবস্ক্রিপশন (Koncluí Proxy) দিয়ে Claude-এর কাছে যাবে। অডিও কখনো এই Mac ছেড়ে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn aktiv, gehen deine Worte als Text über dein Abo (Koncluí Proxy) an Claude. Das Audio verlässt diesen Mac nie." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, your words, as text, go to Claude through your subscription (Koncluí Proxy). The audio never leaves this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Al activarlo, tus palabras, como texto, van a Claude con tu suscripción (Koncluí Proxy). El audio nunca sale de este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une fois activé, tes mots, sous forme de texte, vont à Claude via ton abonnement (Koncluí Proxy). L'audio ne quitte jamais ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चालू करने पर तुम्हारे शब्द, टेक्स्ट के रूप में, तुम्हारी सदस्यता (Koncluí Proxy) से Claude तक जाएँगे। ऑडियो कभी इस Mac से बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Saat aktif, kata-katamu, dalam bentuk teks, dikirim ke Claude lewat langgananmu (Koncluí Proxy). Audionya tidak pernah keluar dari Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オンにすると、話した内容がテキストとしてサブスクリプション（Koncluí Proxy）経由で Claude に送信されます。音声がこの Mac の外に送信されることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "켜면 사용자의 말이 텍스트로 변환되어 구독(Koncluí Proxy)을 통해 Claude로 전송돼요. 오디오는 이 Mac 밖으로 나가지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ao ligar, suas palavras, em texto, vão para o Claude pela sua assinatura (Koncluí Proxy). O áudio nunca sai deste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "После включения твои слова в виде текста будут уходить к Claude по твоей подписке (Koncluí Proxy). Звук никогда не покидает этот Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เมื่อเปิด คำพูดของคุณจะถูกส่งเป็นข้อความไปยัง Claude ผ่านการสมัครสมาชิกของคุณ (Koncluí Proxy) ส่วนเสียงจะไม่ออกจาก Mac เครื่องนี้เลย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açıldığında sözlerin metin olarak aboneliğin (Koncluí Proxy) üzerinden Claude'a gider. Ses hiçbir zaman bu Mac'ten çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开后，你说的话会以文字形式，通过你的订阅（Koncluí Proxy）发送给 Claude。音频永远不会离开这台 Mac。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟後，你說的話會以文字形式，透過你的訂閱（Koncluí Proxy）傳送給 Claude。音訊永遠不會離開這部 Mac。" } } } },
    "konclui.voice.claude.toggle" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude يجيب عن الأسئلة المفتوحة ويبحث في الويب" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude খোলা প্রশ্নের উত্তর দেয় এবং ওয়েবে খোঁজে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude beantwortet offene Fragen und durchsucht das Web" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude answers open questions and searches the web" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude responde preguntas abiertas y busca en la web" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude répond aux questions ouvertes et cherche sur le web" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude खुले सवालों के जवाब देता है और वेब पर खोजता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude menjawab pertanyaan terbuka dan mencari di web" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude が自由な質問に回答し、ウェブを検索します" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude가 자유로운 질문에 답하고 웹을 검색해요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Claude responde perguntas abertas e pesquisa na web" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude отвечает на открытые вопросы и ищет в интернете" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ตอบคำถามปลายเปิดและค้นหาบนเว็บ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude açık uçlu soruları yanıtlar ve web'de arama yapar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude 回答开放式问题并搜索网络" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude 回答開放式問題並搜尋網路" } } } },
    "konclui.voice.hint.ai-unsupported" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحدث بكلماتك الخاصة يتطلب Apple Intelligence (macOS 26 وجهاز Mac متوافق) أو Claude." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নিজের মতো করে বলতে Apple Intelligence (macOS 26 ও সামঞ্জস্যপূর্ণ Mac) অথবা Claude লাগে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Um in eigenen Worten zu sprechen, brauchst du Apple Intelligence (macOS 26 und einen kompatiblen Mac) oder Claude." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Speaking in your own words needs Apple Intelligence (macOS 26 and a compatible Mac) or Claude." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hablar con tus propias palabras requiere Apple Intelligence (macOS 26 y un Mac compatible) o Claude." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Parler avec tes propres mots demande Apple Intelligence (macOS 26 et un Mac compatible) ou Claude." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने शब्दों में बोलने के लिए Apple Intelligence (macOS 26 और संगत Mac) या Claude चाहिए।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bicara dengan kata-katamu sendiri membutuhkan Apple Intelligence (macOS 26 dan Mac yang kompatibel) atau Claude." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自由に話すには Apple Intelligence（macOS 26 と対応する Mac）または Claude が必要です。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자유롭게 말하려면 Apple Intelligence(macOS 26 및 호환되는 Mac) 또는 Claude가 필요해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Falar com suas próprias palavras exige Apple Intelligence (macOS 26 e um Mac compatível) ou o Claude." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чтобы говорить своими словами, нужен Apple Intelligence (macOS 26 и совместимый Mac) или Claude." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การพูดด้วยคำพูดของคุณเองต้องใช้ Apple Intelligence (macOS 26 และ Mac ที่รองรับ) หรือ Claude" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kendi sözlerinle konuşmak için Apple Intelligence (macOS 26 ve uyumlu bir Mac) ya da Claude gerekir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要用自己的话来说，需要 Apple Intelligence（macOS 26 和兼容的 Mac）或 Claude。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "要用自己的話來說，需要 Apple Intelligence（macOS 26 和相容的 Mac）或 Claude。" } } } },
    "konclui.voice.hint.ai-off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فعّل Apple Intelligence في إعدادات النظام لتتحدث بكلماتك الخاصة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নিজের মতো করে বলতে সিস্টেম সেটিংসে Apple Intelligence চালু করো।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere Apple Intelligence in den Systemeinstellungen, um in eigenen Worten zu sprechen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Apple Intelligence in System Settings to speak in your own words." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activa Apple Intelligence en Ajustes del Sistema para hablar con tus propias palabras." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Active Apple Intelligence dans Réglages Système pour parler avec tes propres mots." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अपने शब्दों में बोलने के लिए सिस्टम सेटिंग्स में Apple Intelligence चालू करो।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan Apple Intelligence di Pengaturan Sistem agar bisa bicara dengan kata-katamu sendiri." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自由に話すには、システム設定で Apple Intelligence をオンにしてください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자유롭게 말하려면 시스템 설정에서 Apple Intelligence를 켜세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ative Apple Intelligence em Ajustes do Sistema para falar com suas próprias palavras." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включи Apple Intelligence в Системных настройках, чтобы говорить своими словами." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิด Apple Intelligence ในการตั้งค่าระบบ เพื่อพูดด้วยคำพูดของคุณเอง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kendi sözlerinle konuşmak için Sistem Ayarları'ndan Apple Intelligence'ı aç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在“系统设置”中打开 Apple Intelligence，就能用自己的话来说。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在「系統設定」中開啟 Apple Intelligence，就能用自己的話來說。" } } } },
    "konclui.voice.privacy.phrases" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعمل فقط العبارات التي يعرفها Koncluí مسبقًا. لا شيء يغادر هذا الـ Mac." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শুধু Koncluí-এর আগে থেকে জানা বাক্যগুলোই কাজ করে। কিছুই এই Mac ছেড়ে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Es funktionieren nur Sätze, die Koncluí schon kennt. Nichts verlässt diesen Mac." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Only the phrases Koncluí already knows work. Nothing leaves this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo funcionan las frases que Koncluí ya conoce. Nada sale de este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Seules les phrases que Koncluí connaît déjà fonctionnent. Rien ne quitte ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिर्फ़ वही वाक्य काम करते हैं जिन्हें Koncluí पहले से जानता है। कुछ भी इस Mac से बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hanya frasa yang sudah dikenal Koncluí yang berfungsi. Tidak ada yang keluar dari Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí がすでに認識しているフレーズのみ使えます。この Mac の外に送信されるものはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 이미 알고 있는 구문만 사용할 수 있어요. 이 Mac 밖으로 전송되는 내용은 없어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Só funcionam as frases que o Koncluí já conhece. Nada sai deste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Работают только фразы, которые Koncluí уже знает. Ничего не уходит с этого Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ใช้ได้เฉพาะวลีที่ Koncluí รู้จักอยู่แล้ว และไม่มีอะไรออกจาก Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnızca Koncluí'nin zaten bildiği cümleler çalışır. Hiçbir şey bu Mac'ten çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有 Koncluí 已经认识的短语才有效。不会有任何内容离开这台 Mac。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只有 Koncluí 已經認得的片語才有效。不會有任何內容離開這部 Mac。" } } } },
    "konclui.voice.privacy.key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كلماتك، نصًّا، تُرسل إلى Claude بمفتاح Anthropic API الخاص بك. أما الصوت فلا يغادر هذا الـ Mac أبدًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "তোমার কথা, লেখা আকারে, তোমার Anthropic API কী দিয়ে Claude-এর কাছে যায়। অডিও কখনো এই Mac ছেড়ে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Worte gehen als Text mit deinem Anthropic-API-Schlüssel an Claude. Das Audio verlässt diesen Mac nie." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your words, as text, go to Claude with your Anthropic API key. The audio never leaves this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus palabras, como texto, van a Claude con tu clave de API de Anthropic. El audio nunca sale de este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes mots, sous forme de texte, vont à Claude avec ta clé API Anthropic. L'audio ne quitte jamais ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "तुम्हारे शब्द, टेक्स्ट के रूप में, तुम्हारी Anthropic API कुंजी से Claude तक जाते हैं। ऑडियो कभी इस Mac से बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kata-katamu, dalam bentuk teks, dikirim ke Claude dengan kunci API Anthropic-mu. Audionya tidak pernah keluar dari Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "話した内容がテキストとして Anthropic API キーを使って Claude に送信されます。音声がこの Mac の外に送信されることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용자의 말이 텍스트로 변환되어 Anthropic API 키를 사용해 Claude로 전송돼요. 오디오는 이 Mac 밖으로 나가지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Suas palavras, em texto, vão para o Claude com a sua chave de API da Anthropic. O áudio nunca sai deste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Твои слова в виде текста уходят к Claude с твоим ключом Anthropic API. Звук никогда не покидает этот Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คำพูดของคุณจะถูกส่งเป็นข้อความไปยัง Claude ด้วยคีย์ Anthropic API ของคุณ ส่วนเสียงจะไม่ออกจาก Mac เครื่องนี้เลย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sözlerin metin olarak Anthropic API anahtarınla Claude'a gider. Ses hiçbir zaman bu Mac'ten çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你说的话会以文字形式，用你的 Anthropic API 密钥发送给 Claude。音频永远不会离开这台 Mac。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你說的話會以文字形式，用你的 Anthropic API 金鑰傳送給 Claude。音訊永遠不會離開這部 Mac。" } } } },
    "konclui.voice.privacy.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كلماتك، نصًّا، تُرسل إلى Claude عبر اشتراكك. أما الصوت فلا يغادر هذا الـ Mac أبدًا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "তোমার কথা, লেখা আকারে, তোমার সাবস্ক্রিপশন দিয়ে Claude-এর কাছে যায়। অডিও কখনো এই Mac ছেড়ে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Worte gehen als Text über dein Abo an Claude. Das Audio verlässt diesen Mac nie." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Your words, as text, go to Claude through your subscription. The audio never leaves this Mac." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tus palabras, como texto, van a Claude con tu suscripción. El audio nunca sale de este Mac." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tes mots, sous forme de texte, vont à Claude via ton abonnement. L'audio ne quitte jamais ce Mac." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "तुम्हारे शब्द, टेक्स्ट के रूप में, तुम्हारी सदस्यता से होकर Claude तक जाते हैं। ऑडियो कभी इस Mac से बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Kata-katamu, dalam bentuk teks, dikirim ke Claude lewat langgananmu. Audionya tidak pernah keluar dari Mac ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "話した内容がテキストとしてサブスクリプション経由で Claude に送信されます。音声がこの Mac の外に送信されることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용자의 말이 텍스트로 변환되어 구독을 통해 Claude로 전송돼요. 오디오는 이 Mac 밖으로 나가지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Suas palavras, em texto, vão para o Claude pela sua assinatura. O áudio nunca sai deste Mac." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Твои слова в виде текста уходят к Claude по твоей подписке. Звук никогда не покидает этот Mac." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คำพูดของคุณจะถูกส่งเป็นข้อความไปยัง Claude ผ่านการสมัครสมาชิกของคุณ ส่วนเสียงจะไม่ออกจาก Mac เครื่องนี้เลย" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sözlerin metin olarak aboneliğin üzerinden Claude'a gider. Ses hiçbir zaman bu Mac'ten çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你说的话会以文字形式通过你的订阅 发送给 Claude。音频永远不会离开这台 Mac。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你說的話會以文字形式透過你的訂閱 傳送給 Claude。音訊永遠不會離開這部 Mac。" } } } },
    "konclui.voice.privacy.local" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "ما تقوله يُفهَم على هذا الـ Mac. لا شيء يغادره." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "তুমি যা বলো তা এই Mac-এই বোঝা হয়। কিছুই এর বাইরে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Was du sagst, wird auf diesem Mac verstanden. Nichts verlässt ihn." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "What you say is understood on this Mac. Nothing leaves it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Lo que dices se entiende en este Mac. Nada sale de él." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce que tu dis est compris sur ce Mac. Rien n'en sort." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "तुम जो कहते हो वह इसी Mac पर समझा जाता है। कुछ भी बाहर नहीं जाता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ucapanmu dipahami di Mac ini. Tidak ada yang keluar darinya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "話した内容はこの Mac 上で認識されます。Mac の外に送信されることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "말한 내용은 이 Mac에서 인식돼요. Mac 밖으로 전송되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O que você diz é entendido neste Mac. Nada sai dele." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё, что ты говоришь, понимается на этом Mac. Ничего не уходит наружу." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สิ่งที่คุณพูดจะถูกทำความเข้าใจบน Mac เครื่องนี้ และไม่มีอะไรออกจากเครื่อง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Söylediklerin bu Mac'te anlaşılır. Hiçbir şey dışarı çıkmaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你说的话在这台 Mac 上理解，不会离开它。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你說的話在這部 Mac 上理解，不會離開它。" } } } },
    "konclui.voice.brain.phrases" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أوامر العبارات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বাক্যের কমান্ড" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Satzbefehle" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Phrase commands" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Comandos de frase" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Commandes par phrases" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "वाक्य कमांड" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Perintah frasa" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "フレーズコマンド" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "구문 명령" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Comandos de frase" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Команды-фразы" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คำสั่งแบบวลี" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Cümle komutları" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "短语命令" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "片語指令" } } } },
    "konclui.voice.brain.key" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude، عبر مفتاح API الخاص بك" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude, তোমার API কী দিয়ে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude, über deinen API-Schlüssel" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude, through your API key" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude, con tu clave de API" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude, via ta clé API" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude, तुम्हारी API कुंजी से" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude, lewat kunci API-mu" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude（API キー経由）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude(API 키 사용)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Claude, pela chave de API" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude, по твоему ключу API" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ผ่านคีย์ API ของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude, API anahtarın üzerinden" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude，通过你的 API 密钥" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude，透過你的 API 金鑰" } } } },
    "konclui.voice.brain.proxy" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Claude، عبر اشتراكك (Koncluí Proxy)" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Claude, তোমার সাবস্ক্রিপশন দিয়ে (Koncluí Proxy)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Claude, über dein Abo (Koncluí Proxy)" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude, through your subscription (Koncluí Proxy)" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Claude, con tu suscripción (Koncluí Proxy)" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Claude, via ton abonnement (Koncluí Proxy)" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Claude, तुम्हारी सदस्यता से (Koncluí Proxy)" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Claude, lewat langgananmu (Koncluí Proxy)" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Claude（サブスクリプション経由、Koncluí Proxy）" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Claude(구독, Koncluí Proxy)" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Claude, pela sua assinatura (Koncluí Proxy)" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Claude, по твоей подписке (Koncluí Proxy)" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Claude ผ่านการสมัครสมาชิกของคุณ (Koncluí Proxy)" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Claude, aboneliğin üzerinden (Koncluí Proxy)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude，通过你的订阅（Koncluí Proxy）" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Claude，透過你的訂閱（Koncluí Proxy）" } } } },
    "konclui.voice.brain.apple" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence، على هذا الـ Mac" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এ Apple Intelligence" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, auf diesem Mac" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, on this Mac" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, en este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, sur ce Mac" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर Apple Intelligence" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, di Mac ini" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac 上の Apple Intelligence" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac의 Apple Intelligence" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, neste Mac" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, на этом Mac" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence บน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence, bu Mac'te" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence，在这台 Mac 上" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence，在這部 Mac 上" } } } },
    "konclui.disclosure.collapsed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مطوي" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eingeklappt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Collapsed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cerrado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Replié" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tertutup" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "折りたたみ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "접힘" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Fechado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Свёрнуто" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已折叠" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已收合" } } } },
    "konclui.disclosure.expanded" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفتوح" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "খোলা" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Geöffnet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Expanded" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abierto" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvert" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "खुला" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Terbuka" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "展開" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "펼침" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aberto" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Развёрнуто" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Açık" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已展开" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已展開" } } } },
    "konclui.features.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الميزات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ফিচার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Funktionen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Features" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Funciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Fonctionnalités" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सुविधाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Fitur" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "機能" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기능" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Recursos" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Функции" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ฟีเจอร์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Özellikler" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "功能" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "功能" } } } },
    "konclui.features.subtitle" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فعّل كل ميزة أو عطّلها. الميزة المعطّلة تختفي من النوتش والصفحات والإعدادات، ولا يُحذف شيء." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "প্রতিটি ফিচার চালু বা বন্ধ করুন। বন্ধ ফিচার নচ, পেজ আর সেটিংস থেকে সরে যায়; কিছুই মুছে যায় না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schalte jede Funktion ein oder aus. Eine ausgeschaltete Funktion verschwindet aus der Notch, den Seiten und den Einstellungen; gelöscht wird nichts." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn each feature on or off. A feature that is off leaves the notch, the pages and Settings; nothing is deleted." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Activa o desactiva cada función. Una función desactivada desaparece del notch, de las páginas y de los ajustes; no se borra nada." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Active ou désactive chaque fonctionnalité. Une fonctionnalité désactivée disparaît du notch, des pages et des réglages ; rien n’est supprimé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हर सुविधा को चालू या बंद करें। बंद सुविधा नॉच, पेजों और सेटिंग्स से हट जाती है; कुछ भी मिटता नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan atau matikan tiap fitur. Fitur yang mati hilang dari notch, halaman, dan Pengaturan; tidak ada yang dihapus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "機能ごとにオン／オフを切り替えます。オフにした機能はノッチ、ページ、設定から非表示になりますが、削除はされません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기능을 각각 켜거나 끄세요. 끈 기능은 노치, 페이지, 설정에서 숨겨지며 삭제되지는 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ligue ou desligue cada recurso. Um recurso desligado some do notch, das páginas e dos Ajustes; nada é apagado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включайте и выключайте каждую функцию. Выключенная функция пропадает из чёлки, страниц и настроек; ничего не удаляется." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดหรือปิดแต่ละฟีเจอร์ ฟีเจอร์ที่ปิดจะหายไปจากรอยบาก หน้าต่าง ๆ และการตั้งค่า โดยไม่มีอะไรถูกลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her özelliği açın veya kapatın. Kapalı bir özellik çentikten, sayfalardan ve Ayarlar’dan kalkar; hiçbir şey silinmez." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "逐项开启或关闭功能。关闭的功能会从刘海、页面和设置中消失，不会删除任何内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "逐項開啟或關閉功能。關閉的功能會從瀏海、頁面與設定中消失，不會刪除任何內容。" } } } },
    "konclui.features.group.pills" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التبويبات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ট্যাব" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Pills" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pills" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pestañas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Onglets" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "टैब" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tab" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクティブなピル" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "활성화된 코루들" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abas" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Вкладки" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แถบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Araçlar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标签页" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "標籤" } } } },
    "konclui.features.group.pages" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصفحات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পেজ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Seiten" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Pages" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Páginas" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pages" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "पेज" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Halaman" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ページ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "페이지" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Páginas" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Страницы" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หน้า" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sayfalar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "页面" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "頁面" } } } },
    "konclui.features.group.blocks" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أقسام الإعدادات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সেটিংসের ব্লক" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungsblöcke" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings blocks" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Bloques de ajustes" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Blocs de réglages" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सेटिंग्स ब्लॉक" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Blok Pengaturan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定ブロック" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정 블록" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Blocos de ajustes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Блоки настроек" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บล็อกการตั้งค่า" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayar blokları" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置区块" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "設定區塊" } } } },
    "konclui.features.note.pills" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التبويب المعطّل لا يظهر في التبويبات النشطة ولا في النوتش ولا بالصوت، ويخرج من التبويبات النشطة. إعادة تفعيله لا تعيد شيئًا تلقائيًا: أضفه من جديد." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ করা ট্যাব সক্রিয় ট্যাব, নচ বা ভয়েসে পাওয়া যায় না, আর সক্রিয় ট্যাব থেকেও সরে যায়। আবার চালু করলে কিছুই ফিরে আসে না: নিজে আবার যোগ করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine ausgeschaltete Pill wird weder in „Aktive Pills“ noch in der Notch noch per Sprache angeboten und verlässt die aktiven Pills. Wieder einschalten bringt nichts zurück: füge sie neu hinzu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "A pill that is off is not offered in Active pills, in the notch or by voice, and leaves the active pills. Turning it on again brings nothing back: add it again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Una pestaña desactivada no se ofrece en Pestañas activas, en el notch ni por voz, y sale de las pestañas activas. Volver a activarla no devuelve nada: añádela de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un onglet désactivé n’est proposé ni dans Onglets actifs, ni dans le notch, ni à la voix, et quitte les onglets actifs. Le réactiver ne ramène rien : ajoute-le de nouveau." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद किया गया टैब सक्रिय टैब, नॉच या आवाज़ में नहीं दिखता और सक्रिय टैब से हट जाता है। उसे फिर चालू करने पर कुछ वापस नहीं आता: उसे दोबारा जोड़ें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tab yang dimatikan tidak ditawarkan di Tab aktif, di notch, maupun lewat suara, dan keluar dari tab aktif. Menyalakannya lagi tidak mengembalikan apa-apa: tambahkan lagi." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにしたピルは、アクティブなピル、ノッチ、音声コマンドに表示されず、アクティブなピルの一覧からも削除されます。再びオンにしても戻らないため、もう一度追加してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "꺼진 코루는 활성화된 코루들, 노치 또는 음성 명령에 표시되지 않으며 활성화된 코루들 목록에서도 빠져요. 다시 켜도 복원되지 않으니 다시 추가해 주세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma aba desligada não é oferecida em Abas ativas, no notch nem por voz, e sai das abas ativas. Ligá-la de novo não traz nada de volta: adicione-a outra vez." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключенная вкладка не предлагается ни в «Активных вкладках», ни в чёлке, ни голосом и уходит из активных вкладок. Повторное включение ничего не возвращает: добавьте её снова." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แถบที่ปิดจะไม่ปรากฏใน แถบที่ใช้งาน บนรอยบาก หรือทางเสียง และจะหลุดจากแถบที่ใช้งาน การเปิดใหม่จะไม่นำกลับมาให้เอง: เพิ่มเองอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapatılan bir araç Etkin araçlar’da, çentikte ya da sesle sunulmaz ve etkin araçlardan çıkar. Yeniden açmak hiçbir şeyi geri getirmez: yeniden ekleyin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭的标签页不会出现在“活跃标签页”、刘海或语音中，并会从活跃标签页中移除。重新开启不会自动恢复：请再次添加。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉的標籤不會出現在「啟用的標籤」、瀏海或語音中，並會從啟用的標籤中移除。重新開啟不會自動恢復：請再次加入。" } } } },
    "konclui.features.note.pages" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصفحة المعطّلة تختفي من الشريط الجانبي للنافذة. وإن كانت النافذة عليها، تنتقل إلى أول صفحة مفعّلة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ পেজ উইন্ডোর সাইডবার থেকে সরে যায়। উইন্ডো সেটিতে থাকলে প্রথম চালু পেজে চলে যায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine ausgeschaltete Seite verschwindet aus der Seitenleiste des Fensters. Ist das Fenster gerade darauf, wechselt es zur ersten eingeschalteten Seite." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "A page that is off leaves the window’s sidebar. If the window is on it, it falls back to the first page that is on." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Una página desactivada sale de la barra lateral de la ventana. Si la ventana estaba en ella, pasa a la primera página activa." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Une page désactivée quitte la barre latérale de la fenêtre. Si la fenêtre y est, elle passe à la première page activée." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद पेज विंडो के साइडबार से हट जाता है। विंडो उसी पर हो तो वह पहले चालू पेज पर चली जाती है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Halaman yang dimatikan hilang dari bilah sisi jendela. Jika jendela sedang di halaman itu, jendela pindah ke halaman pertama yang aktif." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにしたページはウインドウのサイドバーから非表示になります。そのページを表示中の場合は、オンになっている最初のページに切り替わります。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끈 페이지는 윈도우 사이드바에서 제거돼요. 해당 페이지가 열려 있으면 켜져 있는 첫 페이지로 이동해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Uma página desligada sai da barra lateral da janela. Se a janela estiver nela, passa para a primeira página ligada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключенная страница пропадает из боковой панели окна. Если окно было на ней, оно переходит на первую включённую страницу." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "หน้าที่ปิดจะหายไปจากแถบด้านข้างของหน้าต่าง หากหน้าต่างอยู่ที่หน้านั้น จะย้ายไปหน้าแรกที่เปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapatılan bir sayfa pencerenin kenar çubuğundan kalkar. Pencere o sayfadaysa, açık olan ilk sayfaya geçer." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭的页面会从窗口侧边栏中消失。若窗口正停留在该页面，会切换到第一个开启的页面。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉的頁面會從視窗側邊欄中消失。若視窗正停留在該頁面，會切換到第一個開啟的頁面。" } } } },
    "konclui.features.note.blocks" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "القسم المعطّل يختفي من صفحة إعداداته. وخدمات التكامل تتبع تبويبها: مفتاح التبويب يُظهر قسمها أو يخفيه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ ব্লক তার সেটিংস পেজ থেকে সরে যায়। ইন্টিগ্রেশন সার্ভিস নিজের ট্যাবের সঙ্গে চলে: ট্যাবের সুইচই তার ব্লক দেখায় বা লুকায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein ausgeschalteter Block verschwindet von seiner Einstellungsseite. Die Integrationsdienste folgen ihrer Pill: Der Schalter der Pill zeigt oder verbirgt ihren Block." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "A block that is off leaves its Settings page. The services of Integrations follow their pill: the pill’s switch shows or hides its block." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Un bloque desactivado sale de su página de ajustes. Los servicios de Integraciones siguen a su pestaña: el interruptor de la pestaña muestra u oculta su bloque." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un bloc désactivé quitte sa page de réglages. Les services d’Intégrations suivent leur onglet : l’interrupteur de l’onglet affiche ou masque son bloc." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद ब्लॉक अपने सेटिंग्स पेज से हट जाता है। इंटीग्रेशन सेवाएँ अपने टैब के साथ चलती हैं: टैब का स्विच उसका ब्लॉक दिखाता या छिपाता है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Blok yang dimatikan hilang dari halaman Pengaturannya. Layanan Integrasi mengikuti tab-nya: sakelar tab menampilkan atau menyembunyikan bloknya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフにしたブロックは設定ページから非表示になります。統合サービスは対応するピルに連動し、ピルのスイッチでブロックを表示または非表示にします。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "꺼진 블록은 해당 설정 페이지에서 사라져요. 통합 서비스는 연결된 코루를 따르며, 코루 스위치로 블록을 표시하거나 숨겨요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Um bloco desligado sai da sua página de ajustes. Os serviços de Integrações seguem a sua aba: o interruptor da aba mostra ou esconde o bloco." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключенный блок пропадает со своей страницы настроек. Сервисы интеграций следуют за своей вкладкой: переключатель вкладки показывает или скрывает её блок." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บล็อกที่ปิดจะหายไปจากหน้าการตั้งค่าของมัน บริการในการเชื่อมต่อจะตามแถบของตัวเอง: สวิตช์ของแถบจะแสดงหรือซ่อนบล็อกนั้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapatılan bir blok Ayarlar sayfasından kalkar. Entegrasyon servisleri kendi aracını izler: aracın anahtarı bloğunu gösterir veya gizler." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭的区块会从其设置页面中消失。集成服务跟随其标签页：标签页的开关决定其区块的显示或隐藏。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "關閉的區塊會從其設定頁面中消失。整合服務跟隨其標籤：標籤的開關決定其區塊的顯示或隱藏。" } } } },
    "konclui.features.block.reminders" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التذكيرات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappels" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リマインダー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "미리 알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembretes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминания" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนความจำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Anımsatıcılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒事项" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒事項" } } } },
    "konclui.features.required" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفعّل دائمًا" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সবসময় চালু" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Immer an" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Always on" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Siempre activado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Toujours activé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हमेशा चालू" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selalu aktif" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "常にオン" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "항상 켜짐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sempre ligado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всегда включено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดเสมอ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her zaman açık" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "始终开启" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "一律開啟" } } } },
    "konclui.features.off-by-default" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "معطّل افتراضيًا" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিফল্টভাবে বন্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Standardmäßig aus" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Off by default" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivado por defecto" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé par défaut" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिफ़ॉल्ट रूप से बंद" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mati secara bawaan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "デフォルトでオフ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기본적으로 꺼짐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desligado por padrão" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "По умолчанию выключено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดตามค่าเริ่มต้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Varsayılan olarak kapalı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认关闭" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預設關閉" } } } },
    "konclui.features.restore" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استعادة الإعدادات الافتراضية" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডিফল্ট ফিরিয়ে আনুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Standardwerte wiederherstellen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore defaults" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Restaurar valores predeterminados" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rétablir les valeurs par défaut" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डिफ़ॉल्ट बहाल करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pulihkan bawaan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "デフォルトに戻す" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "기본값 복원" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Restaurar padrões" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Восстановить по умолчанию" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "คืนค่าเริ่มต้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Varsayılanları geri yükle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复默认值" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "還原預設值" } } } },
    "konclui.add" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "যোগ করুন…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Hinzufügen…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Add…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añadir…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajouter…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जोड़ें…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambah…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "追加…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "추가…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adicionar…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавить…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เพิ่ม…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekle…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "加入…" } } } },
    "konclui.add.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يعرض Koncluí ما تعرّف عليه في هذا الـ Mac. زر «إضافة…» يُظهر الباقي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí এই Mac-এ যা চিনতে পেরেছে সেটুকুই দেখায়। বাকিগুলো দেখতে “যোগ করুন…” চাপুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí listet, was es auf diesem Mac erkannt hat. „Hinzufügen…“ zeigt den Rest." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí lists what it recognized on this Mac. Add… shows the rest." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí muestra lo que reconoció en este Mac. «Añadir…» muestra el resto." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí liste ce qu’il a reconnu sur ce Mac. « Ajouter… » affiche le reste." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí वही दिखाता है जो उसने इस Mac पर पहचाना। बाकी देखने के लिए “जोड़ें…” दबाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí hanya menampilkan yang dikenalinya di Mac ini. “Tambah…” menampilkan sisanya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí がこの Mac で認識した項目を表示します。「追加…」を選ぶと、ほかの項目が表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 이 Mac에서 인식한 항목을 표시해요. ‘추가…’를 누르면 나머지 항목을 볼 수 있어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí lista o que reconheceu neste Mac. “Adicionar…” mostra o resto." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí показывает то, что распознал на этом Mac. Кнопка «Добавить…» покажет остальное." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí แสดงเฉพาะสิ่งที่รู้จักบน Mac เครื่องนี้ ปุ่ม “เพิ่ม…” จะแสดงที่เหลือ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí bu Mac’te tanıdıklarını listeler. “Ekle…” kalanları gösterir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 只列出它在这台 Mac 上识别到的内容。点“添加…”可显示其余项目。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 只列出它在這台 Mac 上辨識到的項目。按「加入…」可顯示其餘項目。" } } } },
    "konclui.whatsapp.options" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخيارات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অপশন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Optionen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Options" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Opciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Options" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "विकल्प" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Opsi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オプション" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "옵션" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Opções" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Параметры" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ตัวเลือก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçenekler" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选项" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選項" } } } },
    "konclui.whatsapp.options.hint" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يفتح الخيارات اليومية والدردشات المتجاهَلة والبوابة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "দৈনন্দিন অপশন, উপেক্ষিত চ্যাট ও গেটওয়ে খোলে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet die täglichen Optionen, ignorierte Chats und das Gateway" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Opens the daily options, ignored chats and the gateway" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre las opciones del día a día, los chats ignorados y la pasarela" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre les options du quotidien, les chats ignorés et la passerelle" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रोज़ के विकल्प, अनदेखी चैट और गेटवे खोलता है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Membuka opsi harian, chat yang diabaikan, dan gateway" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "日常のオプション、無視したチャット、ゲートウェイを開きます" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "일반 옵션, 무시한 채팅 및 게이트웨이를 열어요" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abre as opções do dia a dia, as conversas ignoradas e o gateway" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открывает ежедневные параметры, игнорируемые чаты и шлюз" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดตัวเลือกที่ใช้ทุกวัน แชตที่ละเว้น และเกตเวย์" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Günlük seçenekleri, yok sayılan sohbetleri ve ağ geçidini açar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开日常选项、已忽略的聊天和网关" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟日常選項、已忽略的對話與閘道" } } } },
    "konclui.whatsapp.notifications" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإشعارات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নোটিফিকেশন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Benachrichtigungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Notificaciones" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सूचनाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Notifikasi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "通知" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Notificações" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Уведомления" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การแจ้งเตือน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bildirimler" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通知" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "通知" } } } },
    "konclui.whatsapp.experimental" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تجريبي" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরীক্ষামূলক" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Experimentell" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Experimental" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Experimental" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Expérimental" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "प्रायोगिक" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Eksperimental" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実験的" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실험적" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Experimental" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экспериментально" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ทดลอง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneysel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实验性" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "實驗性" } } } },
    "konclui.whatsapp.state.off" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "متوقف" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বন্ধ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeschaltet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turned off" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Desactivado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Désactivé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बंद है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Dimatikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "オフ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "꺼짐" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Desativado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выключено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดอยู่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已关闭" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已關閉" } } } },
    "konclui.whatsapp.state.no-room" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يظهر في النوتش بعد" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখনও নচে দেখা যাচ্ছে না" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch nicht in der Notch zu sehen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Not showing in the notch yet" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no aparece en el notch" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pas encore affiché dans le notch" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी नॉच में नहीं दिख रहा" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum tampil di notch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "まだノッチに表示されていません" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 노치에 표시되지 않음" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ainda não aparece no notch" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока не показывается в чёлке" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่แสดงในรอยบาก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Henüz çentikte görünmüyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未显示在刘海中" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未顯示在瀏海中" } } } },
    "konclui.whatsapp.state.not-set-up" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "غير مُعدّ" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সেট আপ করা হয়নি" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht eingerichtet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Not set up" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin configurar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Non configuré" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सेट अप नहीं है" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum disiapkan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "未設定" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설정되지 않음" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não configurado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не настроено" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่ได้ตั้งค่า" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kurulmadı" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未設定" } } } },
    "konclui.whatsapp.state.installing" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التثبيت…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ইনস্টল হচ্ছে…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird installiert…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Installing…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Instalando…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Installation…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इंस्टॉल हो रहा है…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Memasang…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "インストール中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Instalando…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установка…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังติดตั้ง…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yükleniyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在安装…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在安裝…" } } } },
    "konclui.whatsapp.state.install-failed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فشل التثبيت" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ইনস্টল ব্যর্থ হয়েছে" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Installation fehlgeschlagen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Install failed" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Falló la instalación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec de l’installation" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इंस्टॉल नहीं हो सका" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pemasangan gagal" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "インストールに失敗しました" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치 실패" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Falha ao instalar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось установить" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้งไม่สำเร็จ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yükleme başarısız" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装失败" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝失敗" } } } },
    "konclui.whatsapp.state.waiting-qr" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بانتظار مسح رمز QR" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "QR কোড স্ক্যানের অপেক্ষায়" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wartet auf den QR-Code" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for the QR code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando el código QR" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "En attente du QR code" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "QR कोड का इंतज़ार" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menunggu kode QR" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "QR コードを待機中" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "QR 코드 대기 중" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando o QR code" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ждём QR-код" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รอสแกนคิวอาร์โค้ด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "QR kodu bekleniyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待扫描二维码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待掃描 QR 碼" } } } },
    "konclui.whatsapp.open-advanced" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "فتح الإعدادات المتقدمة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "অ্যাডভান্সড খুলুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erweitert öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Advanced" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Avanzado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrir Avancé" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "एडवांस्ड खोलें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buka Lanjutan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "詳細設定を開く" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "고급 설정 열기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Abrir Avançado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Открыть «Дополнительно»" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เปิดขั้นสูง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gelişmişi aç" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开高级设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟進階設定" } } } },
    "konclui.whatsapp.install.downloading" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "جارٍ التنزيل…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ডাউনলোড হচ্ছে…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird heruntergeladen…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Descargando…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Téléchargement…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "डाउनलोड हो रहा है…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mengunduh…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダウンロード中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다운로드 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Baixando…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Загрузка…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กำลังดาวน์โหลด…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "İndiriliyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在下載…" } } } },
    "konclui.whatsapp.install.step %lld" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخطوة %lld من 4. يستمر التثبيت حتى لو غادرت هذه الصفحة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ধাপ %lld / ৪। এই পেজ ছেড়ে গেলেও ইনস্টল চলতে থাকবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schritt %lld von 4. Die Installation läuft weiter, auch wenn du diese Seite verlässt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Step %lld of 4. The install keeps going if you leave this page." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Paso %lld de 4. La instalación continúa aunque salgas de esta página." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Étape %lld sur 4. L’installation continue même si tu quittes cette page." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चरण %lld / 4। इस पेज से बाहर जाने पर भी इंस्टॉल चलता रहेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Langkah %lld dari 4. Pemasangan tetap berjalan meski kamu meninggalkan halaman ini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "全 4 ステップの %lld ステップ目。このページを離れてもインストールは続きます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "4단계 중 %lld단계. 이 페이지를 나가도 설치는 계속돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Passo %lld de 4. A instalação continua mesmo se você sair desta página." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Шаг %lld из 4. Установка продолжится, даже если вы покинете эту страницу." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ขั้นตอนที่ %lld จาก 4 การติดตั้งจะดำเนินต่อแม้คุณออกจากหน้านี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Adım %lld / 4. Bu sayfadan çıksanız bile yükleme sürer." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 步，共 4 步。离开此页面后，安装仍会继续。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 步，共 4 步。離開此頁面後，安裝仍會繼續。" } } } },
    "konclui.whatsapp.qr.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "امسح رمز QR" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "QR কোড স্ক্যান করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "QR-Code scannen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan the QR code" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Escanea el código QR" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Scanne le QR code" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "QR कोड स्कैन करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pindai kode QR" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "QR コードをスキャン" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "QR 코드 스캔" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escaneie o QR code" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отсканируйте QR-код" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สแกนคิวอาร์โค้ด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "QR kodunu tarayın" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描二维码" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "掃描 QR 碼" } } } },
    "konclui.whatsapp.qr.waiting" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "بانتظار المسح…" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "স্ক্যানের অপেক্ষায়…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Warte auf den Scan …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for the scan…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esperando el escaneo…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "En attente du scan…" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "स्कैन का इंतज़ार…" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Menunggu pemindaian…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "スキャンを待機中…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "스캔 대기 중…" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aguardando o escaneamento…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ожидаем сканирование…" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รอการสแกน…" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tarama bekleniyor…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待扫描…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "等待掃描…" } } } },
    "konclui.whatsapp.problem.stopped.auto" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لن تصل أي رسالة جديدة إلى النوتش طالما البوابة متوقفة. يحاول Koncluí تشغيلها من جديد تلقائيًا، مرة في الدقيقة على الأكثر. إن استمر الفشل، فتحقق من العنوان في الإعدادات المتقدمة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ে বন্ধ থাকলে নচে নতুন কোনো বার্তা পৌঁছায় না। Koncluí নিজে থেকেই আবার চালু করার চেষ্টা করে, মিনিটে একবারের বেশি নয়। বারবার ব্যর্থ হলে অ্যাডভান্সডে ঠিকানাটি দেখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Solange das Gateway gestoppt ist, kommt keine neue Nachricht in der Notch an. Koncluí versucht von selbst, es neu zu starten, höchstens einmal pro Minute. Klappt das nicht, prüfe die Adresse unter „Erweitert“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No new message reaches the notch while it is stopped. Koncluí tries to start it again on its own, once a minute at most. If it keeps failing, check the address under Advanced." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mientras está detenida, ningún mensaje nuevo llega al notch. Koncluí intenta iniciarla de nuevo por su cuenta, una vez por minuto como máximo. Si sigue fallando, revisa la dirección en Avanzado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tant qu’elle est arrêtée, aucun nouveau message n’arrive dans le notch. Koncluí essaie de la relancer automatiquement, une fois par minute au plus. Si ça échoue encore, vérifie l’adresse dans Avancé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे बंद रहने पर नॉच में कोई नया संदेश नहीं पहुँचता। Koncluí उसे अपने आप दोबारा चालू करने की कोशिश करता है, मिनट में एक बार से ज़्यादा नहीं। फिर भी न चले तो एडवांस्ड में पता जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selama gateway berhenti, tidak ada pesan baru yang sampai ke notch. Koncluí mencoba menjalankannya lagi secara otomatis, paling sering sekali per menit. Jika terus gagal, periksa alamatnya di Lanjutan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止中は新しいメッセージがノッチに届きません。Koncluí は自動で再起動を試みます（最大 1 分に 1 回）。失敗が続く場合は、詳細設定でアドレスを確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지 중에는 새 메시지가 노치에 도착하지 않아요. Koncluí가 분당 최대 한 번 자동으로 다시 시작해요. 계속 실패하면 고급 설정에서 주소를 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Enquanto estiver parado, nenhuma mensagem nova chega ao notch. O Koncluí tenta iniciá-lo de novo sozinho, no máximo uma vez por minuto. Se continuar, confira o endereço em Avançado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока шлюз остановлен, новые сообщения в чёлку не приходят. Koncluí сам пробует запустить его снова, не чаще раза в минуту. Если не получается, проверьте адрес в разделе «Дополнительно»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ขณะที่เกตเวย์หยุดทำงาน จะไม่มีข้อความใหม่ไปถึงรอยบาก Koncluí จะพยายามเริ่มใหม่เองอัตโนมัติ อย่างมากนาทีละครั้ง หากยังไม่ได้ ให้ตรวจสอบที่อยู่ในส่วนขั้นสูง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidi durduğu sürece çentiğe yeni mesaj ulaşmaz. Koncluí onu kendiliğinden yeniden başlatmayı dener, en fazla dakikada bir kez. Sürekli başarısız olursa Gelişmiş bölümünde adresi kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关停止期间，刘海不会收到新消息。Koncluí 会自动尝试重新启动它，每分钟最多一次。如果仍然失败，请在“高级”中检查地址。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閘道停止期間，瀏海不會收到新訊息。Koncluí 會自動嘗試重新啟動，每分鐘最多一次。若仍失敗，請在「進階」中檢查位址。" } } } },
    "konclui.whatsapp.problem.stopped.manual" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لن تصل أي رسالة جديدة إلى النوتش طالما البوابة متوقفة. شغّل بوابتك أو تحقق من عنوانها في الإعدادات المتقدمة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "গেটওয়ে বন্ধ থাকলে নচে নতুন কোনো বার্তা পৌঁছায় না। নিজের গেটওয়ে চালু করুন, অথবা অ্যাডভান্সডে তার ঠিকানা দেখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Solange das Gateway gestoppt ist, kommt keine neue Nachricht in der Notch an. Starte dein Gateway oder prüfe seine Adresse unter „Erweitert“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No new message reaches the notch while it is stopped. Start your gateway, or check its address under Advanced." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mientras está detenida, ningún mensaje nuevo llega al notch. Inicia tu pasarela o revisa su dirección en Avanzado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tant qu’elle est arrêtée, aucun nouveau message n’arrive dans le notch. Lance ta passerelle ou vérifie son adresse dans Avancé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "गेटवे बंद रहने पर नॉच में कोई नया संदेश नहीं पहुँचता। अपना गेटवे चालू करें, या एडवांस्ड में उसका पता जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Selama gateway berhenti, tidak ada pesan baru yang sampai ke notch. Jalankan gateway-mu, atau periksa alamatnya di Lanjutan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止中は新しいメッセージがノッチに届きません。ゲートウェイを起動するか、詳細設定でアドレスを確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "중지 중에는 새 메시지가 노치에 도착하지 않아요. 게이트웨이를 시작하거나 고급 설정에서 주소를 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Enquanto estiver parado, nenhuma mensagem nova chega ao notch. Inicie o seu gateway ou confira o endereço dele em Avançado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока шлюз остановлен, новые сообщения в чёлку не приходят. Запустите свой шлюз или проверьте его адрес в разделе «Дополнительно»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ขณะที่เกตเวย์หยุดทำงาน จะไม่มีข้อความใหม่ไปถึงรอยบาก เริ่มเกตเวย์ของคุณ หรือตรวจสอบที่อยู่ในส่วนขั้นสูง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ağ geçidi durduğu sürece çentiğe yeni mesaj ulaşmaz. Ağ geçidinizi başlatın ya da adresini Gelişmiş bölümünde kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网关停止期间，刘海不会收到新消息。请启动你的网关，或在“高级”中检查它的地址。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "閘道停止期間，瀏海不會收到新訊息。請啟動你的閘道，或在「進階」中檢查其位址。" } } } },
    "konclui.whatsapp.problem.unauthorized.detail" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لن تصل أي رسالة جديدة إلى النوتش حتى تطابق بيانات الاعتماد ما تتوقعه البوابة. تحقق منها في الإعدادات المتقدمة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরিচয়পত্র গেটওয়ের প্রত্যাশার সঙ্গে না মিললে নচে নতুন কোনো বার্তা পৌঁছায় না। অ্যাডভান্সডে সেগুলো দেখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Solange die Zugangsdaten nicht zu dem passen, was das Gateway erwartet, kommt keine neue Nachricht in der Notch an. Prüfe sie unter „Erweitert“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No new message reaches the notch until the credentials match what the gateway expects. Check them under Advanced." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ningún mensaje nuevo llega al notch hasta que las credenciales coincidan con lo que espera la pasarela. Revísalas en Avanzado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun nouveau message n’arrive dans le notch tant que les identifiants ne correspondent pas à ce qu’attend la passerelle. Vérifie-les dans Avancé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "जब तक क्रेडेंशियल गेटवे की अपेक्षा से मेल नहीं खाते, नॉच में कोई नया संदेश नहीं पहुँचता। एडवांस्ड में उन्हें जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada pesan baru yang sampai ke notch sampai kredensial cocok dengan yang diminta gateway. Periksa di Lanjutan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "認証情報がゲートウェイの設定と一致するまで、新しいメッセージはノッチに届きません。詳細設定で確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자격 증명이 게이트웨이의 설정과 일치할 때까지 새 메시지가 노치에 도착하지 않아요. 고급 설정에서 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhuma mensagem nova chega ao notch até as credenciais combinarem com o que o gateway espera. Confira em Avançado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Новые сообщения в чёлку не приходят, пока учётные данные не совпадут с теми, что ждёт шлюз. Проверьте их в разделе «Дополнительно»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จะไม่มีข้อความใหม่ไปถึงรอยบาก จนกว่าข้อมูลรับรองจะตรงกับที่เกตเวย์ต้องการ ตรวจสอบได้ในส่วนขั้นสูง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kimlik bilgileri ağ geçidinin beklediğiyle eşleşmedikçe çentiğe yeni mesaj ulaşmaz. Gelişmiş bölümünde kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在凭据与网关要求的一致之前，刘海不会收到新消息。请在“高级”中检查。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在憑證與閘道要求的相符之前，瀏海不會收到新訊息。請在「進階」中檢查。" } } } },
    "konclui.whatsapp.problem.other.detail" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لن تصل أي رسالة جديدة إلى النوتش قبل إصلاح هذا. تحقق من عنوان البوابة وإعداداتها في الإعدادات المتقدمة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এটি ঠিক না হওয়া পর্যন্ত নচে নতুন কোনো বার্তা পৌঁছায় না। অ্যাডভান্সডে গেটওয়ের ঠিকানা ও সেটিংস দেখুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bis das behoben ist, kommt keine neue Nachricht in der Notch an. Prüfe Adresse und Einstellungen des Gateways unter „Erweitert“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No new message reaches the notch until this is fixed. Check the gateway’s address and settings under Advanced." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ningún mensaje nuevo llega al notch hasta que esto se resuelva. Revisa la dirección y los ajustes de la pasarela en Avanzado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun nouveau message n’arrive dans le notch tant que ce n’est pas réglé. Vérifie l’adresse et les réglages de la passerelle dans Avancé." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह ठीक होने तक नॉच में कोई नया संदेश नहीं पहुँचता। एडवांस्ड में गेटवे का पता और सेटिंग्स जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada pesan baru yang sampai ke notch sampai ini diperbaiki. Periksa alamat dan setelan gateway di Lanjutan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "問題を解決するまで、新しいメッセージはノッチに届きません。詳細設定でゲートウェイのアドレスと設定を確認してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "문제를 해결할 때까지 새 메시지가 노치에 도착하지 않아요. 고급 설정에서 게이트웨이 주소와 설정을 확인하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhuma mensagem nova chega ao notch até isso ser resolvido. Confira o endereço e os ajustes do gateway em Avançado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Пока это не исправлено, новые сообщения в чёлку не приходят. Проверьте адрес и настройки шлюза в разделе «Дополнительно»." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "จะไม่มีข้อความใหม่ไปถึงรอยบากจนกว่าจะแก้ไขเรื่องนี้ ตรวจสอบที่อยู่และการตั้งค่าของเกตเวย์ในส่วนขั้นสูง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu düzelene kadar çentiğe yeni mesaj ulaşmaz. Ağ geçidinin adresini ve ayarlarını Gelişmiş bölümünde kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "问题解决之前，刘海不会收到新消息。请在“高级”中检查网关的地址和设置。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "問題解決之前，瀏海不會收到新訊息。請在「進階」中檢查閘道的位址與設定。" } } } },
    "konclui.whatsapp.privacy.short" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "على هذا الـ Mac فقط. تبقى الرسائل في الذاكرة ولا تُحفظ أبدًا. بلا صور أو وسائط." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "শুধু এই Mac-এ। বার্তা মেমরিতে থাকে, কখনও সংরক্ষিত হয় না। কোনো ছবি বা মিডিয়া নয়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur auf diesem Mac. Nachrichten bleiben im Speicher und werden nie gesichert. Keine Fotos oder Medien." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Only on this Mac. Messages stay in memory and are never saved. No photos or media." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo en este Mac. Los mensajes quedan en memoria y nunca se guardan. Sin fotos ni archivos." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Uniquement sur ce Mac. Les messages restent en mémoire et ne sont jamais enregistrés. Ni photos ni médias." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सिर्फ़ इसी Mac पर। संदेश मेमोरी में रहते हैं और कभी सेव नहीं होते। कोई फ़ोटो या मीडिया नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hanya di Mac ini. Pesan tetap di memori dan tidak pernah disimpan. Tanpa foto atau media." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この Mac 内でのみ動作します。メッセージはメモリ上に保持され、保存されません。写真やメディアは扱いません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 Mac에서만 작동해요. 메시지는 메모리에만 보관되며 저장되지 않아요. 사진이나 미디어는 포함되지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Só neste Mac. As mensagens ficam na memória e nunca são salvas. Sem fotos ou mídia." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Только на этом Mac. Сообщения хранятся в памяти и нигде не сохраняются. Без фото и медиа." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เฉพาะบน Mac เครื่องนี้ ข้อความอยู่ในหน่วยความจำและไม่เคยถูกบันทึก ไม่มีรูปภาพหรือสื่อ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnızca bu Mac’te. Mesajlar bellekte kalır, hiç kaydedilmez. Fotoğraf veya medya yok." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在这台 Mac 上。消息只留在内存中，从不保存。不含照片或媒体。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅在這部 Mac 上。訊息只留在記憶體中，從不儲存。不含照片或媒體。" } } } },
    "konclui.whatsapp.details" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التفاصيل" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বিস্তারিত" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Details" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Details" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Detalles" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Détails" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ब्योरा" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Detail" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "詳細" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "세부 정보" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Detalhes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Подробнее" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "รายละเอียด" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ayrıntılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "详情" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "詳細資訊" } } } },
    "konclui.whatsapp.hide" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إخفاء" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "লুকান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausblenden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hide" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Ocultar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Masquer" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "छिपाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Sembunyikan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "非表示" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "숨기기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Ocultar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скрыть" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ซ่อน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gizle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐藏" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "隱藏" } } } },
    "konclui.whatsapp.ignored.empty" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد دردشات متجاهَلة." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "কোনো উপেক্ষিত চ্যাট নেই।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine ignorierten Chats." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No ignored chats." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay chats ignorados." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun chat ignoré." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "कोई अनदेखी चैट नहीं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada chat yang diabaikan." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "無視したチャットはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "무시한 채팅이 없어요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhuma conversa ignorada." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет игнорируемых чатов." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่มีแชตที่ละเว้น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yok sayılan sohbet yok." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有已忽略的聊天。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有已忽略的對話。" } } } },
    "konclui.whatsapp.preview.label" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كيف تصل رسائل واتساب إلى النوتش" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp বার্তা কীভাবে নচে পৌঁছায়" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "So kommen WhatsApp-Nachrichten in der Notch an" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "How WhatsApp messages reach the notch" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Cómo llegan los mensajes de WhatsApp al notch" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Comment les messages WhatsApp arrivent dans le notch" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp संदेश नॉच तक कैसे पहुँचते हैं" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Bagaimana pesan WhatsApp sampai ke notch" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp メッセージがノッチに届く仕組み" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 메시지가 노치에 도착하는 방식" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Como as mensagens do WhatsApp chegam ao notch" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Как сообщения WhatsApp попадают в чёлку" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ข้อความ WhatsApp ไปถึงรอยบากอย่างไร" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp mesajları çentiğe nasıl ulaşır" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 消息如何到达刘海" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "WhatsApp 訊息如何傳到瀏海" } } } },
    "konclui.whatsapp.preview.caption" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه رسائل نموذجية وليست رسائلك. تُظهر كيف تغيّر خياراتك ما يصل إلى النوتش." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এগুলো নমুনা বার্তা, আপনার নয়। আপনার অপশন নচে কী পৌঁছায় তা কীভাবে বদলায়, সেটাই দেখায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das sind Beispielnachrichten, nicht deine. Sie zeigen, wie deine Optionen verändern, was in der Notch ankommt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "These are sample messages, not yours. They show how your options change what reaches the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Son mensajes de ejemplo, no tuyos. Muestran cómo tus opciones cambian lo que llega al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce sont des messages d’exemple, pas les tiens. Ils montrent comment tes options changent ce qui arrive dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ये नमूना संदेश हैं, आपके नहीं। ये दिखाते हैं कि आपके विकल्प नॉच तक पहुँचने वाली चीज़ें कैसे बदलते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Ini pesan contoh, bukan pesanmu. Menunjukkan bagaimana opsimu mengubah apa yang sampai ke notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "実際のメッセージではなくサンプルです。オプションによってノッチに届く内容がどう変わるかを示します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "실제 메시지가 아닌 예시 메시지예요. 옵션에 따라 노치에 표시되는 내용이 어떻게 달라지는지 보여 줘요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "São mensagens de exemplo, não as suas. Mostram como suas opções mudam o que chega ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Это примеры сообщений, не ваши. Они показывают, как ваши параметры меняют то, что приходит в чёлку." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "นี่คือข้อความตัวอย่าง ไม่ใช่ของคุณ แสดงว่าตัวเลือกของคุณเปลี่ยนสิ่งที่ไปถึงรอยบากอย่างไร" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bunlar örnek mesajlardır, sizin değil. Seçeneklerinizin çentiğe ulaşanları nasıl değiştirdiğini gösterir." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些是示例消息，不是你的。它们展示你的选项如何改变到达刘海的内容。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這些是範例訊息，不是你的。展示你的選項如何改變傳到瀏海的內容。" } } } },
    "konclui.whatsapp.preview.focus-chip" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "معاينة مع التركيز" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ফোকাসসহ প্রিভিউ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Vorschau mit Fokus" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview a Focus" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Vista previa con Concentración" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aperçu avec Concentration" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फ़ोकस के साथ पूर्वावलोकन" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pratinjau dengan Fokus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "集中モードをプレビュー" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "집중 모드 미리 보기" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Prévia com Foco" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать с фокусированием" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ดูตัวอย่างเมื่อเปิดโฟกัส" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Odak açıkken önizle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预览专注状态" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預覽專注模式" } } } },
    "konclui.whatsapp.preview.focus-note" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التركيز قيد التشغيل. لا صوت ولا تفاعل. الرسائل تنتظر هنا." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "ফোকাস চালু। শব্দ নেই, প্রতিক্রিয়া নেই। বার্তা এখানে অপেক্ষা করে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Fokus an. Kein Ton, keine Reaktion. Nachrichten warten hier." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus on. No sound and no reaction. Messages wait here." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Concentración activa. Sin sonido ni reacción. Los mensajes esperan aquí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Concentration active. Ni son ni réaction. Les messages attendent ici." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "फ़ोकस चालू। न आवाज़, न प्रतिक्रिया। संदेश यहाँ इंतज़ार करते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Fokus aktif. Tanpa suara, tanpa reaksi. Pesan menunggu di sini." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "集中モード中です。音も反応もなく、メッセージはここで待機します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "집중 모드가 켜져 있어요. 소리나 반응 없이 메시지가 여기에 대기해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Foco ligado. Sem som, sem reação. As mensagens esperam aqui." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Фокусирование включено. Без звука и реакции. Сообщения ждут здесь." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "โฟกัสเปิดอยู่ ไม่มีเสียง ไม่มีปฏิกิริยา ข้อความรออยู่ที่นี่" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Odak açık. Ses yok, tepki yok. Mesajlar burada bekler." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注模式已开启。无声音，无反应，消息会留在这里。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "專注模式已開啟。無聲音，無反應，訊息會留在這裡。" } } } },
    "konclui.whatsapp.preview.muted" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مكتومة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "নিঃশব্দ" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "stumm" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "muted" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "silenciado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "muet" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "म्यूट" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "dibisukan" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ミュート" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "알림 끔" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "silenciado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "без звука" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ปิดเสียง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "sessiz" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已静音" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已靜音" } } } },
