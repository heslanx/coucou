        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ইনস্টল করা নেই। সেটিংস → চ্যাট থেকে এটি ইনস্টল করুন, টার্মিনালে একবার সাইন ইন করুন, তারপর আবার জিজ্ঞেস করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
