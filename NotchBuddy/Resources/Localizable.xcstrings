            "value" : "พูดภาษาใดก็ได้ แล้วระบบจะพิมพ์เป็นภาษาที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin dilde konuş: sözlerin seçtiğin dilde yapıştırılır."
          }
