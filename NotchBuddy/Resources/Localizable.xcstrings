    "hub.mail.banned-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا كلمات محظورة. أضف كلمة، أو انقر «تجاهل هذا المرسل دائمًا» على رسالة في النوتش."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো নিষিদ্ধ শব্দ নেই। একটি শব্দ যোগ করুন, অথবা নচে কোনো মেলে “এই প্রেরককে সবসময় উপেক্ষা করুন” ক্লিক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine verbotenen Wörter. Füge ein Wort hinzu oder klicke bei einer E-Mail in der Notch auf „Diesen Absender immer ignorieren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No banned words. Add a word, or click “Always ignore this sender” on a message in the notch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay palabras prohibidas. Añade una o haz clic en «Ignorar siempre a este remitente» en un correo del notch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun mot banni. Ajoute un mot, ou clique sur « Toujours ignorer cet expéditeur » sur un mail dans l’encoche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई प्रतिबंधित शब्द नहीं। कोई शब्द जोड़ें, या नॉच में किसी मेल पर “इस प्रेषक को हमेशा अनदेखा करें” क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada kata terlarang. Tambahkan kata, atau klik “Selalu abaikan pengirim ini” pada email di notch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁止ワードはありません。語句を追加するか、ノッチのメールで「この差出人を常に無視」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금지어가 없습니다. 단어를 추가하거나 노치의 메일에서 ‘이 보낸 사람 항상 무시’를 누르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma palavra proibida. Adicione uma, ou clique em “Sempre ignorar este remetente” num e-mail no notch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрещённых слов нет. Добавьте слово или нажмите «Всегда игнорировать этого отправителя» у письма в вырезе."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีคำต้องห้าม เพิ่มคำ หรือคลิก “ละเว้นผู้ส่งนี้เสมอ” ที่อีเมลในรอยบาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yasaklı kelime yok. Bir kelime ekle ya da çentikteki bir e-postada “Bu göndereni her zaman yok say”a tıkla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有屏蔽词。添加一个词，或在刘海里的邮件上点击“始终忽略此发件人”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有封鎖字詞。加入一個字詞，或在瀏海中的郵件上按「一律忽略此寄件者」。"
          }
        }
      }
    },
