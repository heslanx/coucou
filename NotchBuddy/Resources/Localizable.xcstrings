    "A reminder title must contain 1–120 characters." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder title must contain 1–120 characters."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O título do lembrete deve ter de 1 a 120 caracteres."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒標題必須包含 1 至 120 個字元。"}}}},
    "A reminder message must contain at most 2,000 characters." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder message must contain at most 2,000 characters."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem do lembrete deve ter no máximo 2.000 caracteres."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒訊息不得超過 2,000 個字元。"}}}},
    "The reminder size or position is outside the supported range." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder size or position is outside the supported range."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O tamanho ou a posição do lembrete está fora do intervalo permitido."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒的大小或位置超出支援範圍。"}}}},
    "Snooze must be between 1 and 1,440 minutes." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Snooze must be between 1 and 1,440 minutes."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O adiamento deve ser de 1 a 1.440 minutos."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"稍後提醒時間必須介於 1 至 1,440 分鐘。"}}}},
    "A reminder can have at most three buttons." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder can have at most three buttons."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um lembrete pode ter no máximo três botões."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒最多可有三個按鈕。"}}}},
    "A reminder button has an invalid title or action." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder button has an invalid title or action."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um botão do lembrete tem um título ou uma ação inválida."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒按鈕的標題或動作無效。"}}}},
    "The reminder image must be a PNG or JPEG image." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder image must be a PNG or JPEG image."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A imagem do lembrete deve estar no formato PNG ou JPEG."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒圖片必須是 PNG 或 JPEG 格式。"}}}},
    "The reminder image exceeds the 2 MB limit." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder image exceeds the 2 MB limit."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A imagem do lembrete excede o limite de 2 MB."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒圖片超過 2 MB 限制。"}}}},
    "MCP reminder images must be 700 KB or smaller." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"MCP reminder images must be 700 KB or smaller."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As imagens de lembretes via MCP devem ter no máximo 700 KB."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"MCP 提醒圖片必須小於或等於 700 KB。"}}}},
    "Reminder created." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder created."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete criado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已建立提醒。"}}}},
    "Reminder updated." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder updated."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete atualizado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已更新提醒。"}}}},
    "Reminder snoozed for %lld minutes." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder snoozed for %lld minutes."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete adiado por %lld minutos."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒已延後 %lld 分鐘。"}}}},
    "Reminder stopped." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder stopped."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete parado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已停止提醒。"}}}},
    "Reminder deleted." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder deleted."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete excluído."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已刪除提醒。"}}}},
    "Reminder dismissed. The next one is scheduled." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder dismissed. The next one is scheduled."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete dispensado. O próximo foi agendado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已關閉提醒，並排定下一次提醒。"}}}},
    "Reminder completed." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder completed."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete concluído."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成提醒。"}}}},
    "Reminder dismissed." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder dismissed."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete dispensado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已關閉提醒。"}}}},
    "Saved reminders could not be read from %@: %@. Changes are disabled to protect the existing file." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved reminders could not be read from %@: %@. Changes are disabled to protect the existing file."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível ler os lembretes salvos em %@: %@. As alterações foram desativadas para proteger o arquivo existente."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法從 %@ 讀取已儲存的提醒：%@。為保護現有檔案，已停用變更。"}}}},
    "Reminder could not be saved: %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder could not be saved: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar o lembrete: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法儲存提醒：%@"}}}},
    "System notification permission failed: %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"System notification permission failed: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Falha na permissão de notificações do sistema: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"系統通知權限失敗：%@"}}}},
    "macOS notifications are off. Reminders will appear only while Koncluí is open." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"macOS notifications are off. Reminders will appear only while Koncluí is open."}},"pt-BR":{"stringUnit":{"state":"translated","value":"As notificações do macOS estão desativadas. Os lembretes só aparecerão enquanto o Koncluí estiver aberto."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"macOS 通知已關閉。只有 Koncluí 開啟時才會顯示提醒。"}}}},
    "System reminder could not be scheduled: %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"System reminder could not be scheduled: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível agendar o lembrete do sistema: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法排程系統提醒：%@"}}}},
    "Reminder was not found." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder was not found."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lembrete não encontrado."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"找不到提醒。"}}}},
    "Reminder ID is invalid." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder ID is invalid."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ID do lembrete é inválido."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒 ID 無效。"}}}},
    "Reminder action is not supported." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Reminder action is not supported."}},"pt-BR":{"stringUnit":{"state":"translated","value":"A ação do lembrete não é compatível."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不支援此提醒動作。"}}}},
    "The reminder contains an unsupported display, repeat, button, or image value." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder contains an unsupported display, repeat, button, or image value."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O lembrete contém um valor não compatível de exibição, repetição, botão ou imagem."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒包含不支援的顯示、重複、按鈕或圖片設定。"}}}},
    "A reminder needs a title and an ISO 8601 due date." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A reminder needs a title and an ISO 8601 due date."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O lembrete precisa de um título e de uma data ISO 8601."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"提醒需要標題和 ISO 8601 到期日期。"}}}},
    "Snooze is disabled for this reminder." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Snooze is disabled for this reminder."}},"pt-BR":{"stringUnit":{"state":"translated","value":"O adiamento está desativado para este lembrete."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此提醒已停用稍後提醒。"}}}},
    "Once" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Once"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uma vez"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一次"}}}},
    "Stopped" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Stopped"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Parado"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已停止"}}}},
    "Full screen" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Full screen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tela cheia"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全螢幕"}}}},
    "%@ · %@ · %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ · %@ · %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ · %@ · %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ · %@ · %@"}}}},
    "Choose an image smaller than 2 MB." : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose an image smaller than 2 MB."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha uma imagem menor que 2 MB."}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請選擇小於 2 MB 的圖片。"}}}},
    "Image could not be opened: %@" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Image could not be opened: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível abrir a imagem: %@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法開啟圖片：%@"}}}},
