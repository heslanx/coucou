    "crypto.hint" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسعار عامة من المنصة: بلا حساب ولا مفتاح. تُقرأ كل دقيقة، فقط حين تكون الحبة مفعّلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক্সচেঞ্জের পাবলিক দাম: কোনো অ্যাকাউন্ট বা কী লাগে না। পিলটি চালু থাকলেই শুধু প্রতি মিনিটে পড়া হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffentliche Börsenkurse: ohne Konto und Schlüssel. Werden jede Minute abgerufen, nur solange die Kapsel aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public prices from the exchange: no account, no key. Read every minute, only while the pill is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precios públicos de la plataforma: sin cuenta ni clave. Se leen cada minuto, solo con la píldora activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cours publics de la plateforme : ni compte ni clé. Lus chaque minute, seulement quand la pilule est active."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सचेंज की सार्वजनिक कीमतें: न खाता, न कुंजी। पिल चालू होने पर ही हर मिनट पढ़ी जाती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga publik dari bursa: tanpa akun, tanpa kunci. Dibaca tiap menit, hanya saat pil aktif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引所の公開価格：アカウントもキーも不要。ピルがオンの間だけ 1 分ごとに読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래소의 공개 시세라서 계정도 키도 필요 없어요. 코루가 켜져 있을 때만 1분마다 읽어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preços públicos da corretora: sem conta nem chave. Lidos a cada minuto, só com a aba ativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публичные цены биржи: без аккаунта и ключа. Обновляются раз в минуту, только когда пилюля включена."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคาเปิดเผยจากตลาดซื้อขาย ไม่ต้องมีบัญชีหรือคีย์ อ่านทุกนาทีเฉพาะตอนแสดงแถบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borsanın herkese açık fiyatları: hesap ve anahtar gerekmez. Yalnızca araç açıkken dakikada bir okunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自交易所的公开行情：无需账户和密钥。仅在启用该胶囊时每分钟读取一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用交易所的公開價格，不需要帳號或金鑰。只有啟用此項目時，才會每分鐘讀取一次。"
          }
        }
      }
    },
