    "hub.mail.vip-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرسائل من هذه العناوين أو النطاقات تُوسم دائمًا كمهمة، ولا تنقلها أي قاعدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ঠিকানা বা ডোমেইন থেকে আসা মেল সবসময় গুরুত্বপূর্ণ চিহ্নিত হয়, আর কোনো নিয়ম সেগুলো সরায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-Mails von diesen Adressen oder Domains sind immer als wichtig markiert, und keine Regel verschiebt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages from these addresses or domains are always flagged important, and no rule ever moves them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los correos de estas direcciones o dominios siempre se marcan como importantes y ninguna regla los mueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mails de ces adresses ou domaines sont toujours marqués importants, et aucune règle ne les déplace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन पतों या डोमेन से आए मेल हमेशा महत्वपूर्ण चिह्नित होते हैं, और कोई नियम उन्हें नहीं हटाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email dari alamat atau domain ini selalu ditandai penting, dan tidak ada aturan yang memindahkannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアドレスやドメインからのメールは常に重要に設定され、ルールで移動されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소나 도메인에서 온 메일은 항상 중요로 표시되며, 어떤 규칙도 옮기지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails destes endereços ou domínios são sempre marcados como importantes, e nenhuma regra os move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Письма с этих адресов или доменов всегда отмечаются важными, и никакое правило их не перемещает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีเมลจากที่อยู่หรือโดเมนเหล่านี้จะถูกทำเครื่องหมายสำคัญเสมอ และไม่มีกฎใดย้ายออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adreslerden veya alan adlarından gelen e-postalar her zaman önemli olarak işaretlenir ve hiçbir kural onları taşımaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自这些地址或域名的邮件始终标为重要，任何规则都不会移动它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自這些地址或網域的郵件一律標為重要，任何規則都不會移動它們。"
          }
        }
      }
    },
