          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっと待ってね — 3 秒で仕事に戻るよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠깐만요 — 3초만 쉬고 다시 일할게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
