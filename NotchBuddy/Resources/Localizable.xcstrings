    "island.position.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الزاوية، يطفو Koncluí فوق سطح المكتب ويُفتح من هناك. يمكنك أيضًا سحب Koru قرب زاوية من الشاشة، أو إعادته إلى أعلى الوسط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোণে থাকলে Koncluí আপনার ডেস্কটপের উপর ভাসে এবং সেখান থেকেই খোলে। Koru-কে স্ক্রিনের কোনো কোণের কাছে টেনে আনতে পারেন, অথবা আবার উপরের মাঝখানে নিতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Ecke schwebt Koncluí über deinem Schreibtisch und öffnet sich von dort. Du kannst Koru auch in die Nähe einer Bildschirmecke ziehen oder zurück nach oben in die Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a corner, Koncluí floats over your desktop and opens from there. You can also drag Koru near a corner of the screen, or back to the top centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una esquina, Koncluí flota sobre tu escritorio y se abre desde ahí. También puedes arrastrar a Koru cerca de una esquina de la pantalla, o devolverlo arriba en el centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un coin, Koncluí flotte sur ton bureau et s’ouvre depuis ce coin. Tu peux aussi glisser Koru près d’un coin de l’écran, ou le ramener en haut au centre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोने में Koncluí आपके डेस्कटॉप पर तैरता है और वहीं से खुलता है। आप Koru को स्क्रीन के किसी कोने के पास खींच सकते हैं, या वापस ऊपर बीच में ला सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di sudut, Koncluí melayang di atas desktop dan terbuka dari sana. Kamu juga bisa menyeret Koru ke dekat sudut layar, atau kembali ke atas tengah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隅に置くと、Koncluí はデスクトップの上に浮かび、そこから開きます。Koru を画面の隅の近くへドラッグしたり、上部中央へ戻したりすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모서리에 두면 Koncluí가 데스크톱 위에 떠 있고 그 자리에서 열려요. Koru를 화면 모서리 근처로 끌어다 놓거나 상단 가운데로 다시 옮길 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num canto, o Koncluí flutua sobre a sua área de trabalho e abre a partir dali. Você também pode arrastar a Koru para perto de um canto da tela, ou de volta ao centro, no alto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В углу Koncluí парит над рабочим столом и открывается оттуда. Можно также перетащить Koru к углу экрана или обратно наверх по центру."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่ออยู่ที่มุม Koncluí จะลอยอยู่เหนือเดสก์ท็อปและเปิดจากตรงนั้น คุณยังลาก Koru ไปใกล้มุมจอ หรือกลับไปด้านบนตรงกลางได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir köşedeyken Koncluí masaüstünün üzerinde süzülür ve oradan açılır. Koru’yi ekranın bir köşesine yakın sürükleyebilir ya da üst ortaya geri getirebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放在角落时，Koncluí 会浮在桌面上并从那里展开。你也可以把 Koru 拖到屏幕角落附近，或拖回顶部中间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放在角落時，Koncluí 會浮在桌面上並從那裡展開。你也可以把 Koru 拖到螢幕角落附近，或拖回頂部中間。"
          }
        }
      }
    },
