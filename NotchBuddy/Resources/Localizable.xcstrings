    "whatsapp.focus-unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح macOS بعد لهذا الإصدار من Koncluí بقراءة حالة التركيز: تستمر الرسائل في الوصول ويستمر Koru في التفاعل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS এখনও Koncluí-র এই বিল্ডকে ফোকাসের অবস্থা পড়তে দেয় না: বার্তা আসতে থাকবে, Koru সাড়া দিতে থাকবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lässt diese Version von Koncluí den Fokus-Status noch nicht lesen: Nachrichten kommen trotzdem an, Koru reagiert weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS doesn’t let this build of Koncluí read the Focus state yet: messages still arrive, Koru keeps reacting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS aún no deja a esta versión de Koncluí leer el estado de Concentración: los mensajes siguen llegando y Koru sigue reaccionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne laisse pas encore cette version de Koncluí lire l’état Concentration : les messages arrivent quand même, Koru continue de réagir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS अभी Koncluí के इस बिल्ड को फ़ोकस की स्थिति पढ़ने नहीं देता: संदेश आते रहेंगे, Koru प्रतिक्रिया देता रहेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS belum mengizinkan build Koncluí ini membaca status Fokus: pesan tetap masuk, Koru tetap bereaksi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドの Koncluí は macOS の制限でまだ集中モードの状態を読み取れません。メッセージは届き、Koru も反応し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버전의 Koncluí는 아직 macOS 집중 모드 상태를 읽을 수 없어요. 그래도 메시지는 잘 오고, 코루도 계속 반응해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS ainda não deixa esta versão do Koncluí ler o estado do Foco: as mensagens continuam chegando e a Koru continua reagindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS пока не даёт этой сборке Koncluí читать состояние фокусирования: сообщения приходят, Koru реагирует."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ยังไม่อนุญาตให้ Koncluí รุ่นนี้อ่านสถานะโฟกัส ข้อความยังเข้ามาตามปกติ และ Koru ยังคงตอบสนอง"
          }
        },
