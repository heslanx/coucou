    "iphone.instruction.description" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعليمات المُرسَلة من iPhone تستخدم النموذج المفتوح حاليًا في الدردشة. يُطبَّق موجه النظام وتاريخ المحادثة. التعليمات المُرسَلة أثناء توقف Koncluí تُضاف إلى قائمة الانتظار وتُنفَّذ عند التشغيل التالي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone থেকে পাঠানো নির্দেশনা চ্যাটে বর্তমানে খোলা মডেল ব্যবহার করে। সিস্টেম প্রম্পট এবং কথোপকথনের ইতিহাস প্রযোজ্য। Koncluí চলছে না থাকলে পাঠানো নির্দেশনাগুলো কিউতে রাখা হয় এবং পরবর্তী চালুতে চালানো হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vom iPhone gesendete Anweisung verwendet das im Chat geöffnete Modell. System-Prompt und Gesprächsverlauf gelten auch hier. Wird eine Anweisung gesendet, während Koncluí nicht läuft, wird sie beim nächsten Start ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An instruction sent from the iPhone uses the model open in chat. The system prompt and conversation history apply. Instructions sent when Koncluí is not running are queued and executed on next launch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una instrucción enviada desde el iPhone usa el modelo abierto actualmente en el chat. Se aplican el prompt de sistema y el historial de conversación. Las instrucciones enviadas mientras Koncluí no está en ejecución se ponen en cola y se ejecutan en el siguiente inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une instruction envoyée depuis l'iPhone utilise le modèle ouvert dans le chat. Le prompt système et l'historique de conversation s'appliquent. Les instructions envoyées quand Koncluí ne tourne pas sont mises en file d'attente et exécutées au prochain démarrage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone से भेजा गया निर्देश चैट में वर्तमान में खुले मॉडल का उपयोग करता है। सिस्टम प्रॉम्प्ट और बातचीत का इतिहास लागू होता है। Koncluí चल नहीं रहे होने पर भेजे गए निर्देश कतार में रखे जाते हैं और अगली बार चालू होने पर चलाए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instruksi yang dikirim dari iPhone menggunakan model yang sedang terbuka di chat. Prompt sistem dan riwayat percakapan berlaku. Instruksi yang dikirim saat Koncluí tidak berjalan dimasukkan ke antrean dan dijalankan saat peluncuran berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone から送った指示には、チャットで開いているモデルが使われます。システムプロンプトと会話履歴が適用されます。Koncluí が起動していないときに送った指示はキューに入り、次回の起動時に実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 보낸 지시는 채팅에 열려 있는 모델이 처리해요. 시스템 프롬프트와 대화 기록도 그대로 적용돼요. Koncluí가 꺼져 있을 때 보낸 지시는 줄 서 있다가 다음 실행 때 처리돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma instrução enviada pelo iPhone usa o modelo aberto no momento no chat. O prompt de sistema e o histórico de conversa se aplicam. Instruções enviadas enquanto o Koncluí não está em execução ficam na fila e são executadas no próximo início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструкция, отправленная с iPhone, использует модель, открытую в чате. Системный промпт и история разговора применяются. Инструкции, отправленные пока Koncluí не запущен, ставятся в очередь и выполняются при следующем запуске."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำสั่งที่ส่งจาก iPhone จะใช้โมเดลที่เปิดอยู่ในแชต พร้อม system prompt และประวัติการสนทนา หาก Koncluí ไม่ได้ทำงาน คำสั่งจะเข้าคิวและทำงานเมื่อเปิดแอปครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'dan gönderilen talimat, sohbette açık olan modeli kullanır. Sistem istemi ve sohbet geçmişi geçerlidir. Koncluí çalışmıyorken gönderilen talimatlar sıraya alınır ve bir sonraki açılışta yürütülür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 iPhone 发送的指令使用聊天中当前打开的模型。系统提示和对话历史适用。Koncluí 未运行时发送的指令将排队，并在下次启动时执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 傳送的指令會使用聊天中選取的模型，並套用系統提示與對話紀錄。Koncluí 未執行時收到的指令會排入佇列，於下次啟動時執行。"
          }
        }
      }
    },
    "iphone.instruction.toggle" : {
