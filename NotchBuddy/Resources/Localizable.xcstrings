{
  "sourceLanguage" : "en",
  "strings" : {
    "konclui.chat.proxy.detail" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تحدّث عبر Koncluí Proxy الخاص بـ klaude، بمفتاح klaude نفسه. لا يحتفظ Koncluí بأي مفتاح API له." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "klaude-এর Koncluí Proxy দিয়ে চ্যাট করুন, klaude-এর নিজের কী দিয়ে। Koncluí এর জন্য কোনো API কী রাখে না।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Chatte über den Koncluí Proxy von klaude, mit klaudes eigenem Schlüssel. Koncluí speichert dafür keinen API-Schlüssel." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Chat through the Koncluí Proxy behind klaude, with klaude's own key. Koncluí keeps no API key for it." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Chatea a través del Koncluí Proxy de klaude, con la clave del propio klaude. Koncluí no guarda ninguna clave de API para él." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Discutez via le Koncluí Proxy de klaude, avec la clé de klaude. Koncluí ne garde aucune clé d'API pour lui." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "klaude के Koncluí Proxy से चैट करें, klaude की अपनी कुंजी के साथ। Koncluí इसके लिए कोई API कुंजी नहीं रखता।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Mengobrol lewat Koncluí Proxy milik klaude, dengan kunci klaude sendiri. Koncluí tidak menyimpan kunci API untuknya." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "klaude 自身のキーを使い、klaude 経由で Koncluí Proxy とチャットします。Koncluí が API キーを保存することはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "klaude의 Koncluí Proxy를 통해 채팅하며, klaude 자체 키를 사용해요. Koncluí는 이 키를 저장하지 않아요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Converse pelo Koncluí Proxy do klaude, com a chave do próprio klaude. O Koncluí não guarda chave de API para ele." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Общайтесь через Koncluí Proxy из klaude, с собственным ключом klaude. Koncluí не хранит для него ключ API." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แชตผ่าน Koncluí Proxy ของ klaude ด้วยคีย์ของ klaude เอง Koncluí ไม่เก็บคีย์ API สำหรับมัน" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "klaude'un Koncluí Proxy'si üzerinden, klaude'un kendi anahtarıyla sohbet et. Koncluí bunun için API anahtarı saklamaz." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通过 klaude 的 Koncluí Proxy 聊天，使用 klaude 自己的密钥。Koncluí 不为它保存任何 API 密钥。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "透過 klaude 的 Koncluí Proxy 聊天，使用 klaude 自己的金鑰。Koncluí 不為它保存任何 API 金鑰。" } } } },
    "konclui.mail.needs-offline %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تتضمن هذه المحادثة رسائل بريد، ولا يستطيع %@ الرد من دون الويب. ابدأ محادثة جديدة أو اختر ذكاءً اصطناعيًا آخر." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই কথোপকথনে ইমেইল আছে, আর %@ ওয়েব ছাড়া উত্তর দিতে পারে না। নতুন কথোপকথন শুরু করুন বা অন্য একটি AI বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Unterhaltung enthält E-Mails, und %@ kann nicht ohne das Web antworten. Beginne eine neue Unterhaltung oder wähle eine andere KI." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This conversation includes email, and %@ can't answer without the web. Start a new conversation or pick another AI." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta conversación incluye correos, y %@ no puede responder sin la web. Empieza una conversación nueva o elige otra IA." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette conversation contient des e-mails, et %@ ne peut pas répondre sans le web. Commencez une nouvelle conversation ou choisissez une autre IA." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस बातचीत में ईमेल हैं, और %@ वेब के बिना जवाब नहीं दे सकता। नई बातचीत शुरू करें या कोई दूसरा AI चुनें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Percakapan ini berisi email, dan %@ tidak bisa menjawab tanpa web. Mulai percakapan baru atau pilih AI lain." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この会話にはメールが含まれているため、%@ はウェブに接続できないと回答できません。新しい会話を始めるか、別の AI を選んでください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 대화에는 이메일이 포함되어 있어 %@은(는) 웹 연결 없이는 답변할 수 없어요. 새 대화를 시작하거나 다른 AI를 선택하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta conversa inclui e-mails, e o %@ não responde sem a web. Comece uma conversa nova ou escolha outra IA." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "В этом разговоре есть письма, а %@ не может отвечать без интернета. Начните новый разговор или выберите другой ИИ." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บทสนทนานี้มีอีเมลอยู่ และ %@ ตอบไม่ได้หากไม่มีเว็บ เริ่มบทสนทนาใหม่หรือเลือก AI อื่น" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu konuşmada e-postalar var ve %@ web olmadan yanıt veremiyor. Yeni bir konuşma başlat ya da başka bir yapay zekâ seç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这段对话包含邮件，而 %@ 离开网络就无法回答。请开始新对话或选择其他 AI。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這段對話包含郵件，而 %@ 離開網路就無法回答。請開始新對話或選擇其他 AI。" } } } },
    "konclui.reminders.alert.trial" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تجربة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরীক্ষা" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Test" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Test" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Prueba" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Test" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "टेस्ट" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Uji" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "テスト" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "테스트" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Teste" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверка" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ทดสอบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Deneme" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "测试" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "測試" } } } },
