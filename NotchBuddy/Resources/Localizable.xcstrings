    "hub.notes-promo" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكالماتك مكتوبة شخصًا بشخص، مع ملخص والمهام. بدون روبوت في الاجتماع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার কল প্রতিজনের আলাদা ট্রান্সক্রিপ্টসহ, সারাংশ আর করণীয় তালিকা নিয়ে। মিটিংয়ে কোনো বট নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gespräche nach Personen transkribiert, mit Zusammenfassung und Aufgaben. Kein Bot im Meeting."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your calls transcribed person by person, with a summary and the to-dos. No bot in the meeting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus llamadas transcritas persona por persona, con un resumen y las tareas. Sin bot en la reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes calls transcrits personne par personne, avec un résumé et les choses à faire. Sans bot dans la réunion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी कॉल हर व्यक्ति के हिसाब से लिखी हुई, सारांश और करने वाले कामों के साथ। मीटिंग में कोई बॉट नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilanmu ditranskrip per orang, dengan ringkasan dan daftar tugas. Tanpa bot di rapat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話を話者ごとに文字起こしし、要約と ToDo も。会議にボットは入りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화를 사람별로 받아 적고, 요약과 할 일까지 정리해 줘요. 회의에 봇이 끼어들 일도 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas chamadas transcritas pessoa por pessoa, com um resumo e as tarefas. Sem bot na reunião."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши звонки расшифрованы по участникам, с кратким итогом и задачами. Без бота во встрече."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถอดเสียงการโทรแยกตามผู้พูด พร้อมสรุปและรายการสิ่งที่ต้องทำ โดยไม่มีบอตเข้าร่วมประชุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüşmelerinin kişilere göre ayrılmış dökümü, özeti ve yapılacakları. Toplantıya bot katılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话按人逐句转写，附带摘要和待办。会议里没有机器人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依發言者轉錄通話，並產生摘要與待辦事項。無須機器人加入會議。"
          }
        }
      }
    },
