    "konclui.hooks.diff.updates" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيحدّث Koncluí إدخالاته (%1$lld) في %2$@." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí %2$@-এ তার এন্ট্রি (%1$lld) আপডেট করবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí aktualisiert seine Einträge (%1$lld) in %2$@." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí will update its entries (%1$lld) in %2$@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí actualizará sus entradas (%1$lld) en %2$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí mettra à jour ses entrées (%1$lld) dans %2$@." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí %2$@ में अपनी प्रविष्टियाँ (%1$lld) अपडेट करेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí akan memperbarui entrinya (%1$lld) di %2$@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí が %2$@ 内の項目を %1$lld 件更新します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 %2$@에서 항목 %1$lld개를 업데이트해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí vai atualizar as entradas dele (%1$lld) em %2$@." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí обновит свои записи (%1$lld) в %2$@." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí จะอัปเดตรายการของตัวเอง (%1$lld) ใน %2$@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí kendi girdilerini (%1$lld) %2$@ dosyasında güncelleyecek." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 将更新 %2$@ 中它的条目（%1$lld）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 將更新 %2$@ 中它的項目（%1$lld）。" } } } },
    "konclui.hooks.diff.removes" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيزيل Koncluí إدخالاته (%1$lld) من %2$@." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí %2$@ থেকে তার এন্ট্রি (%1$lld) সরিয়ে দেবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí entfernt seine Einträge (%1$lld) aus %2$@." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí will remove its entries (%1$lld) from %2$@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí quitará sus entradas (%1$lld) de %2$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí retirera ses entrées (%1$lld) de %2$@." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí अपनी प्रविष्टियाँ (%1$lld) %2$@ से हटाएगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí akan menghapus entrinya (%1$lld) dari %2$@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí が %2$@ から項目を %1$lld 件削除します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 %2$@에서 항목 %1$lld개를 제거해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí vai remover as entradas dele (%1$lld) de %2$@." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí удалит свои записи (%1$lld) из %2$@." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí จะลบรายการของตัวเอง (%1$lld) ออกจาก %2$@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí kendi girdilerini (%1$lld) %2$@ dosyasından kaldıracak." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 将从 %2$@ 移除它的条目（%1$lld）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 將從 %2$@ 移除它的項目（%1$lld）。" } } } },
    "konclui.hooks.diff.adds" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيضيف Koncluí إدخالاته (%1$lld) إلى %2$@." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí %2$@-এ তার এন্ট্রি (%1$lld) যোগ করবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí fügt seine Einträge (%1$lld) zu %2$@ hinzu." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí will add its entries (%1$lld) to %2$@." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí añadirá sus entradas (%1$lld) a %2$@." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí ajoutera ses entrées (%1$lld) dans %2$@." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí अपनी प्रविष्टियाँ (%1$lld) %2$@ में जोड़ेगा।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí akan menambahkan entrinya (%1$lld) ke %2$@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí が %2$@ に項目を %1$lld 件追加します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí가 %2$@에 항목 %1$lld개를 추가해요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí vai adicionar as entradas dele (%1$lld) em %2$@." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí добавит свои записи (%1$lld) в %2$@." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí จะเพิ่มรายการของตัวเอง (%1$lld) ลงใน %2$@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí kendi girdilerini (%1$lld) %2$@ dosyasına ekleyecek." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 将向 %2$@ 添加它的条目（%1$lld）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí 將向 %2$@ 加入它的項目（%1$lld）。" } } } },
    "konclui.hooks.outdated" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه الـ hooks أقدم مما يحتاجه Koncluí الآن. حدّثها لتواصل الرد من الـ notch." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই hooks Koncluí-এর এখনকার প্রয়োজনের চেয়ে পুরোনো। notch থেকে উত্তর দিতে আপডেট করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Hooks sind älter als das, was Koncluí jetzt braucht. Aktualisiere sie, um weiter über den Notch zu antworten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "These hooks are older than what Koncluí needs now. Update them to keep answering from the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Estos hooks son más antiguos de lo que Koncluí necesita ahora. Actualízalos para seguir respondiendo desde el notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces hooks sont plus anciens que ce dont Koncluí a besoin maintenant. Mets-les à jour pour continuer à répondre depuis le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "ये hooks अब Koncluí की ज़रूरत से पुराने हैं। notch से जवाब देना जारी रखने के लिए इन्हें अपडेट करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hooks ini lebih lama dari yang kini dibutuhkan Koncluí. Perbarui agar kamu tetap bisa menjawab dari notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このフックは現在 Koncluí が必要とするものより古いバージョンです。ノッチから引き続き回答できるよう更新してください。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 훅은 현재 Koncluí에 필요한 버전보다 오래됐어요. 노치에서 계속 답변하려면 업데이트하세요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Estes hooks são mais antigos do que o Koncluí precisa agora. Atualize para continuar respondendo pelo notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Эти хуки старее, чем нужно Koncluí сейчас. Обнови их, чтобы и дальше отвечать из notch." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "hooks เหล่านี้เก่ากว่าที่ Koncluí ต้องใช้ตอนนี้ อัปเดตเพื่อให้ตอบจาก notch ได้ต่อไป" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu hook'lar Koncluí'nin şimdi ihtiyaç duyduğundan eski. notch'tan yanıt vermeye devam etmek için güncelle." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些 hooks 比 Koncluí 现在需要的版本旧。更新后才能继续在 notch 中回复。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這些 hooks 比 Koncluí 現在需要的版本舊。更新後才能繼續在 notch 中回覆。" } } } },
    "konclui.hooks.ok" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "كل شيء جاهز. جلسات %@ تصل إلى الـ notch." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সব ঠিক আছে। %@-এর সেশন notch-এ পৌঁছায়।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Alles bereit. Die Sitzungen von %@ erscheinen im Notch." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything is in place. %@ sessions reach the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Todo en orden. Las sesiones de %@ llegan al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tout est en place. Les sessions de %@ arrivent dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सब ठीक है। %@ के सेशन notch तक पहुँचते हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Semua sudah siap. Sesi %@ sampai ke notch." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "準備が整いました。%@ のセッションがノッチに表示されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 설정이 완료됐어요. %@ 세션이 노치에 표시돼요." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Tudo certo. As sessões do %@ chegam ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё готово. Сессии %@ доходят до notch." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ทุกอย่างพร้อมแล้ว เซสชันของ %@ ส่งมาถึง notch" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her şey yerinde. %@ oturumları notch'a ulaşıyor." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一切就绪。%@ 的会话会出现在 notch 中。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "一切就緒。%@ 的工作階段會出現在 notch 中。" } } } },
    "konclui.codex.until %@" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : " · حتى %@" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : " · %@ পর্যন্ত" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : " · bis %@" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : " · until %@" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : " · hasta %@" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : " · jusqu'au %@" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : " · %@ तक" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : " · hingga %@" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : " · %@まで" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : " · %@까지" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : " · até %@" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : " · до %@" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : " · ถึง %@" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : " · %@ tarihine kadar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : " · 截至 %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : " · 至 %@" } } } },
    "konclui.codex.available %lld" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "المتاح: %lld" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "উপলব্ধ: %lld" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "verfügbar: %lld" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld available" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "disponibles: %lld" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "disponibles : %lld" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "उपलब्ध: %lld" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "tersedia: %lld" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 件利用可能" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld개 사용 가능" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "disponíveis: %lld" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "доступно: %lld" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ใช้ได้ %lld" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "kullanılabilir: %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可用：%lld" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可用：%lld" } } } },
