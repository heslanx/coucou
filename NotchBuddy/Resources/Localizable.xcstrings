    "whatsapp.install.no-checksum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي إصدار البوابة على بصمة للتحقق من التنزيل: لم يُثبَّت شيء. أعد المحاولة لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গেটওয়ে রিলিজে ডাউনলোড যাচাইয়ের চেকসাম নেই: কিছু ইনস্টল হয়নি। পরে আবার চেষ্টা করুন।"
          }
