      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Koncluí في إعدادات النظام ‹ الخصوصية والأمن ‹ تسجيل الشاشة، ثم التقط مرة أخرى."
