            "value" : "Nur öffentliche Adresse. Koncluí berührt nie deine privaten Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public address only. Koncluí never touches your private keys."
          }
        },
