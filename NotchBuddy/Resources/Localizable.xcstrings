    "flow.accessibility" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Koncluí إلى إذن تسهيلات الاستخدام للصق ما تُمليه والتقاط مفتاح Esc. فعّله من إعدادات النظام ‹ الخصوصية والأمن ‹ تسهيلات الاستخدام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যা ডিক্টেট করেন তা পেস্ট করতে এবং Esc শুনতে Koncluí-র অ্যাক্সেসিবিলিটি অনুমতি দরকার। সিস্টেম সেটিংস › গোপনীয়তা ও নিরাপত্তা › অ্যাক্সেসিবিলিটিতে চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí braucht die Berechtigung für Bedienungshilfen, um Diktiertes einzufügen und Esc zu erkennen. Aktiviere sie unter Systemeinstellungen › Datenschutz & Sicherheit › Bedienungshilfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí needs the Accessibility permission to paste what you dictate and to hear Esc. Turn it on in System Settings › Privacy & Security › Accessibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí necesita el permiso de Accesibilidad para pegar lo que dictas y detectar Esc. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí a besoin de l'autorisation Accessibilité pour coller ce que tu dictes et détecter Échap. Active-la dans Réglages Système › Confidentialité et sécurité › Accessibilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो डिक्टेट करते हैं उसे पेस्ट करने और Esc सुनने के लिए Koncluí को एक्सेसिबिलिटी अनुमति चाहिए। सिस्टम सेटिंग्स › गोपनीयता और सुरक्षा › एक्सेसिबिलिटी में इसे चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí membutuhkan izin Aksesibilitas untuk menempelkan hasil dikte dan mendeteksi Esc. Aktifkan di Pengaturan Sistem › Privasi & Keamanan › Aksesibilitas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí はまだペーストしたり Esc を検知したりできません。アクセシビリティの権限が必要です。システム設定 → プライバシーとセキュリティ → アクセシビリティで Koncluí をオンにしてください。すでにオンの場合は − で削除してから追加し直してください。Koncluí の新しいビルドでは再度必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 아직 붙여넣지도, Esc를 알아채지도 못해요. 손쉬운 사용 권한이 필요해요! 시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 Koncluí를 켜 주세요. 이미 켜져 있다면 −로 뺐다가 다시 추가해 주세요. Koncluí를 새로 빌드하면 다시 허용해야 하거든요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí precisa da permissão de Acessibilidade para colar o que você dita e ouvir o Esc. Ative em Ajustes do Sistema › Privacidade e Segurança › Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí нужно разрешение «Универсальный доступ», чтобы вставлять продиктованное и видеть Esc. Включите его в Системных настройках › Конфиденциальность и безопасность › Универсальный доступ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ต้องได้รับอนุญาตด้านการช่วยการเข้าถึงเพื่อวางข้อความที่คุณป้อนด้วยเสียงและรับรู้ปุ่ม Esc เปิดได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › การช่วยการเข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí'nun dikte ettiğin metni yapıştırması ve Esc tuşunu algılaması için Erişilebilirlik izni gerekir. Sistem Ayarları › Gizlilik ve Güvenlik › Erişilebilirlik bölümünden aç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 需要“辅助功能”权限才能粘贴你听写的内容并识别 Esc。请在“系统设置”›“隐私与安全性”›“辅助功能”中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 需要「輔助使用」權限才能貼上你聽寫的內容並偵測 Esc。請在「系統設定 › 隱私權與安全性 › 輔助使用」中開啟。"
          }
        }
      }
    },
    "flow.access-ok" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم السماح بتسهيلات الاستخدام: يلصق Koncluí حيث تكتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাক্সেসিবিলিটি অনুমোদিত: আপনি যেখানে লেখেন Koncluí সেখানে পেস্ট করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen erlaubt: Koncluí fügt dort ein, wo du schreibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibility allowed: Koncluí pastes where you type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad permitida: Koncluí pega donde escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilité autorisée : Koncluí colle là où tu écris."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्सेसिबिलिटी की अनुमति है: Koncluí वहीं चिपकाता है जहाँ आप टाइप करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksesibilitas diizinkan: Koncluí menempel di tempat kamu mengetik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティを許可しました：Koncluí は入力中の場所にペーストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 허용 완료! 이제 입력하던 곳에 바로 붙여넣어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acessibilidade permitida: o Koncluí cola onde você digita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ разрешён: Koncluí вставляет текст туда, где вы печатаете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการช่วยการเข้าถึงแล้ว Koncluí วางข้อความตรงตำแหน่งที่คุณพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik izni verildi: Koncluí yazdığın yere yapıştırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许辅助功能：Koncluí 会粘贴到你输入的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允許輔助使用：Koncluí 會將文字貼到你輸入的位置。"
          }
        }
      }
