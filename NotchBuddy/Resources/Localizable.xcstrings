        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí आपको सुन नहीं पा रहा: माइक्रोफ़ोन की अनुमति नहीं है या वह उपलब्ध नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí tidak bisa mendengarmu: mikrofon tidak diizinkan atau tidak tersedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí にあなたの声が聞こえません。マイクが許可されていないか、利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
