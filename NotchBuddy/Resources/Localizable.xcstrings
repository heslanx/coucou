    "No Koncluí hooks to remove." : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد خطافات Koncluí لإزالتها." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সরানোর মতো কোনো Koncluí হুক নেই।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Koncluí-Hooks zum Entfernen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No Koncluí hooks to remove." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay hooks de Koncluí que eliminar." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun hook Koncluí à supprimer." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हटाने के लिए कोई Koncluí हुक नहीं है।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tidak ada hooks Koncluí untuk dihapus." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não há hooks do Koncluí para remover." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нет хуков Koncluí для удаления." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ไม่มี Hooks ของ Koncluí ให้ลบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaldırılacak Koncluí hook'u yok." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可移除的 Koncluí Hooks。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有可移除的 Koncluí hooks。" } } } },
    "Press Escape to close this alert." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اضغط على Esc لإغلاق هذا التنبيه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই সতর্কতা বন্ধ করতে Esc চাপুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Drücke Esc, um diesen Hinweis zu schließen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Press Escape to close this alert." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Pulsa Esc para cerrar esta alerta." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appuie sur Échap pour fermer cette alerte." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस अलर्ट को बंद करने के लिए Esc दबाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tekan Esc untuk menutup peringatan ini." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pressione Esc para fechar este alerta." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нажмите Esc, чтобы закрыть это уведомление." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "กด Esc เพื่อปิดการแจ้งเตือนนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu uyarıyı kapatmak için Esc'ye bas." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按 Esc 关闭此提醒。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "按下 Escape 關閉此提醒。" } } } },
    "Reminders" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التذكيرات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappels" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembretes" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминания" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนความจำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatıcılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒事项" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒事項" } } } },
    "Create a reminder and choose how Koncluí should interrupt you." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنشئ تذكيرًا واختر كيف يقاطعك Koncluí." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "একটি রিমাইন্ডার তৈরি করুন এবং Koncluí কীভাবে আপনাকে থামাবে তা বেছে নিন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erstelle eine Erinnerung und wähle, wie Koncluí dich unterbrechen soll." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a reminder and choose how Koncluí should interrupt you." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crea un recordatorio y elige cómo debe interrumpirte Koncluí." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Crée un rappel et choisis comment Koncluí doit t'interrompre." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "एक रिमाइंडर बनाएँ और चुनें कि Koncluí आपको कैसे टोके।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buat pengingat dan pilih cara Koncluí menyela kamu." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Crie um lembrete e escolha como o Koncluí deve interromper você." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создайте напоминание и выберите, как Koncluí должен вас прерывать." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สร้างการเตือนความจำและเลือกวิธีที่ Koncluí จะขัดจังหวะคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir hatırlatıcı oluştur ve Koncluí'nun seni nasıl böleceğini seç." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建提醒，并选择 Koncluí 以何种方式打断你。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立提醒，並選擇 Koncluí 提醒你的方式。" } } } },
