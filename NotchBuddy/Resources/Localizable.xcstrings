    "plugin.hermes.approvals.enabled" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر طلبات الموافقة في الشريط. إذا لم تكن Koncluí تعمل، يعود Hermes إلى طرفيته الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নচে অনুমোদন অনুরোধ দেখানো হয়। Koncluí না চললে Hermes তার নিজের প্রম্পটে ফলব্যাক করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungsanfragen erscheinen in der Notch. Wenn Koncluí nicht läuft, verwendet Hermes seine eigene Abfrage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approval requests appear in the notch. If Koncluí is not running, Hermes falls back to its own prompt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes de aprobación aparecen en el notch. Si Koncluí no está en ejecución, Hermes usa su propio prompt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les demandes d'approbation s'affichent dans le notch. Si Koncluí ne tourne pas, Hermes utilise son propre prompt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नॉच में अनुमोदन अनुरोध दिखाए जाते हैं। यदि Koncluí नहीं चल रहा तो Hermes अपने प्रॉम्प्ट पर वापस जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan persetujuan muncul di notch. Jika Koncluí tidak berjalan, Hermes menggunakan promptnya sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認リクエストはノッチに表示されます。Koncluí が起動していない場合、Hermes は自身のプロンプトに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 요청이 노치에 떠요. Koncluí가 꺼져 있으면 Hermes가 직접 물어볼 거예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitações de aprovação aparecem no notch. Se Koncluí não estiver em execução, Hermes usa seu próprio prompt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросы подтверждения отображаются в notch. Если Koncluí не запущен, Hermes использует собственный prompt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขออนุมัติจะแสดงในแถบ หาก Koncluí ไม่ทำงาน Hermes จะกลับไปใช้พรอมป์ต์ของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onay istekleri adada görünür. Koncluí çalışmıyorsa Hermes kendi onay istemini kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审批请求显示在刘海中。若 Koncluí 未运行，Hermes 将回退到其自己的提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核准請求會顯示在瀏海中。若 Koncluí 未執行，Hermes 會使用自己的提示。"
          }
        }
      }
    },
