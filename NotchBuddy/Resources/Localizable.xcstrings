    "whatsapp.install.no-build" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على إصدار للبوابة لهذا الـ Mac على GitHub. أعد المحاولة لاحقًا أو اضبط بوابتك في «متقدم»."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub-এ এই Mac-এর জন্য গেটওয়ে পাওয়া যায়নি। পরে আবার চেষ্টা করুন, বা অ্যাডভান্সডে নিজের গেটওয়ে সেট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
