          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac 用の GOWA ビルドが GitHub に見つかりませんでした。あとでもう一度試すか、詳細設定で自分のゲートウェイを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 맞는 GOWA 빌드를 GitHub에서 못 찾았어요. 나중에 다시 해 보거나, 고급에서 내 게이트웨이를 설정해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há versão do gateway para este Mac no GitHub. Tente mais tarde ou configure seu próprio gateway em Avançado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На GitHub нет сборки шлюза для этого Mac. Попробуйте позже или укажите свой шлюз в разделе «Дополнительно»."
          }
