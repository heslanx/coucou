          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail закрыта: пока она не открыта, ничего не сортируется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mail ปิดอยู่: จะไม่มีการคัดแยกจนกว่าจะเปิด"
          }
        },
        "tr" : {
