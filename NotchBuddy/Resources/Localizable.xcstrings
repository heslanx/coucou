    "chat.subscriptions.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث باستخدام الخطة التي تدفع ثمنها بالفعل. يستعين Koncluí بأداة الطرفية الرسمية للذكاء الاصطناعي الخاص بك، المسجّلة بحسابك أنت: لا يرى أبدًا كلمة مرورك أو مفتاحك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যে প্ল্যানের জন্য আপনি আগেই টাকা দেন, সেটি দিয়েই চ্যাট করুন। Koncluí আপনার AI-এর অফিশিয়াল টার্মিনাল টুলকে জিজ্ঞেস করে, যা আপনার নিজের অ্যাকাউন্টে সাইন ইন করা: এটি কখনো আপনার পাসওয়ার্ড বা কী দেখে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatte mit dem Abo, das du schon bezahlst. Koncluí fragt das offizielle Terminal-Tool deiner KI, angemeldet mit deinem eigenen Konto: Es sieht nie dein Passwort oder deinen Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat on the plan you already pay for. Koncluí asks your AI's official terminal tool, signed in with your own account: it never sees your password or your key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatea con el plan que ya pagas. Koncluí usa la herramienta oficial de terminal de tu IA, con tu propia cuenta: nunca ve tu contraseña ni tu clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discute avec l'abonnement que tu paies déjà. Koncluí passe par l'outil terminal officiel de ton IA, connecté à ton propre compte : il ne voit jamais ton mot de passe ni ta clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस प्लान से चैट करें जिसका आप पहले से भुगतान करते हैं। Koncluí आपकी AI के आधिकारिक टर्मिनल टूल से पूछता है, जो आपके अपने खाते से साइन इन है: वह आपका पासवर्ड या कुंजी कभी नहीं देखता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat dengan paket yang sudah kamu bayar. Koncluí memakai alat terminal resmi AI-mu, masuk dengan akunmu sendiri: Koncluí tidak pernah melihat kata sandi atau kuncimu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに支払っているプランでチャットできます。Koncluí は、あなた自身のアカウントでサインインしたAIの公式ターミナルツールに問い合わせます。パスワードやキーを見ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 결제 중인 요금제로 채팅하세요. Koncluí는 내 계정으로 로그인된 AI의 공식 터미널 도구에 물어봅니다. 비밀번호나 키는 절대 보지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converse usando o plano que você já paga. O Koncluí usa a ferramenta oficial de terminal da sua IA, conectada à sua própria conta: ele nunca vê sua senha nem sua chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общайтесь в рамках подписки, за которую вы уже платите. Koncluí обращается к официальному терминальному инструменту вашего ИИ, вошедшему в вашу учётную запись: он никогда не видит ваш пароль или ключ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชตด้วยแพ็กเกจที่คุณจ่ายอยู่แล้ว Koncluí จะถามเครื่องมือเทอร์มินัลทางการของ AI ของคุณ ซึ่งลงชื่อเข้าใช้ด้วยบัญชีของคุณเอง: Koncluí ไม่เคยเห็นรหัสผ่านหรือคีย์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaten ödediğiniz planla sohbet edin. Koncluí, yapay zekânızın kendi hesabınızla oturum açmış resmi terminal aracına sorar: şifrenizi veya anahtarınızı asla görmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你已经付费的套餐聊天。Koncluí 会调用你的 AI 的官方终端工具，并使用你自己的账户登录：它永远看不到你的密码或密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你已經付費的方案聊天。Koncluí 會呼叫你的 AI 的官方終端工具，並使用你自己的帳號登入：它永遠看不到你的密碼或金鑰。"
          }
        }
      }
    },
