    "konclui.reminders.button.remove" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إزالة الزر" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বোতাম সরান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Taste entfernen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove button" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Quitar botón" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retirer le bouton" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बटन हटाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hapus tombol" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ボタンを削除" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "버튼 제거" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Remover botão" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Удалить кнопку" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เอาปุ่มออก" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düğmeyi kaldır" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除按钮" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "移除按鈕" } } } },
