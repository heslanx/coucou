        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รุ่นของเกตเวย์ไม่มีค่าตรวจสอบสำหรับยืนยันไฟล์ที่ดาวน์โหลด จึงไม่ได้ติดตั้งอะไร ลองอีกครั้งภายหลัง"
