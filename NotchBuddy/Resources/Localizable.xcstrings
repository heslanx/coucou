    "update.manual" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ليس في مجلد التطبيقات، لذا لا يمكنه استبدال نفسه: احصل على الإصدار الجديد من GitHub."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí আপনার Applications ফোল্ডারে নেই, তাই নিজেকে বদলাতে পারে না: নতুন সংস্করণ GitHub থেকে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí liegt nicht in deinem Programme-Ordner und kann sich daher nicht selbst ersetzen: Hol dir die neue Version auf GitHub."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí isn’t in your Applications folder, so it can’t replace itself: get the new version on GitHub."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí no está en tu carpeta Aplicaciones, así que no puede reemplazarse: descarga la nueva versión en GitHub."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí n’est pas dans ton dossier Applications, il ne peut donc pas se remplacer : récupère la nouvelle version sur GitHub."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí आपके Applications फ़ोल्डर में नहीं है, इसलिए खुद को बदल नहीं सकता: नया वर्ज़न GitHub से लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí tidak ada di folder Aplikasi, jadi tidak bisa mengganti dirinya: ambil versi baru di GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí がアプリケーションフォルダにないため、自分自身を置き換えられません。GitHub から新しいバージョンを入手してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí가 응용 프로그램 폴더에 없어서 스스로 바꿔 끼울 수 없어요. GitHub에서 새 버전을 받아 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Koncluí não está na sua pasta Aplicativos, então não pode se substituir: baixe a nova versão no GitHub."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí не в папке «Программы», поэтому не может заменить себя: скачайте новую версию на GitHub."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí ไม่ได้อยู่ในโฟลเดอร์แอปพลิเคชัน จึงแทนที่ตัวเองไม่ได้ ดาวน์โหลดเวอร์ชันใหม่จาก GitHub แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí Uygulamalar klasöründe değil, bu yüzden kendini değiştiremiyor: yeni sürümü GitHub'dan al."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 不在“应用程序”文件夹中，无法自行替换：请在 GitHub 上获取新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koncluí 不在「應用程式」檔案夾中，無法自行取代：請前往 GitHub 取得新版本。"
          }
        }
      }
    },
