    "What do you want to do with it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا تريد أن تفعل به؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এটা দিয়ে কী করতে চান?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was möchtest du damit machen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What do you want to do with it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué quieres hacer con él?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que veux-tu faire avec ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसके साथ क्या करना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang ingin Anda lakukan dengannya?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これをどうしますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이걸로 뭘 해 볼까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você quer fazer com ele?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что вы хотите с ним сделать?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องการทำอะไรกับสิ่งนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bununla ne yapmak istiyorsun?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您想对它做什么？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你想如何處理這個項目？"
          }
        }
      }
    },
    "When enabled, Koncluí listens for the wake word « OK Koru ». Speech recognition runs entirely on-device — no audio or transcript leaves your Mac." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، يستمع Koncluí لكلمة التنشيط «OK Koru». يعمل التعرف على الكلام بالكامل على هذا الـ Mac: لا يغادره أي صوت أو نص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সক্ষম হলে, Koncluí ওয়েক ওয়ার্ড “OK Koru” শোনে। ভাষণ স্বীকৃতি পুরোপুরি এই Mac-এই চলে: কোনো অডিও বা ট্রান্সক্রিপ্ট এটি ছেড়ে যায় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wartet Koncluí auf das Aktivierungswort „OK Koru“. Die Spracherkennung läuft vollständig auf diesem Mac: Weder Audio noch Transkripte verlassen ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Koncluí listens for the wake word “OK Koru”. Speech recognition runs entirely on this Mac: no audio or transcript leaves it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, Koncluí escucha la palabra de activación «OK Koru». El reconocimiento de voz se ejecuta por completo en este Mac: ningún audio ni transcripción sale de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand cette option est activée, Koncluí écoute le mot d’activation « OK Koru ». La reconnaissance vocale se fait entièrement sur ce Mac : aucun audio ni transcription n’en sort."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम होने पर, Koncluí वेक वर्ड “OK Koru” सुनता है। वाक् पहचान पूरी तरह इसी Mac पर चलती है: कोई ऑडियो या ट्रांसक्रिप्ट इससे बाहर नहीं जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat diaktifkan, Koncluí mendengarkan kata pemicu “OK Koru”. Pengenalan ucapan berjalan sepenuhnya di Mac ini: tidak ada audio atau transkrip yang keluar darinya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、Koncluí はウェイクワード「OK Koru」を聞き取ります。音声認識はすべてデバイス上で動作し、音声も文字起こしも Mac の外に出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜 두면 Koncluí가 호출어 « OK Koru »에 귀 기울여요. 음성 인식은 전부 기기 안에서 처리돼서, 오디오도 받아쓴 글도 Mac 밖으로 안 나가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o Koncluí escuta a palavra de ativação “OK Koru”. O reconhecimento de fala acontece inteiramente neste Mac: nenhum áudio ou transcrição sai dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено, Koncluí слушает слово активации «OK Koru». Распознавание речи работает полностью на этом Mac: ни аудио, ни транскрипции его не покидают."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้งาน Koncluí จะฟังคำปลุก “OK Koru” การรู้จำเสียงพูดทำงานบน Mac เครื่องนี้ทั้งหมด ไม่มีเสียงหรือข้อความถอดเสียงออกจากเครื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde Koncluí, “OK Koru” uyandırma sözcüğünü dinler. Konuşma tanıma tamamen bu Mac'te çalışır; ses veya döküm Mac'ten dışarı çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，Koncluí 会监听唤醒词“OK Koru”。语音识别完全在这台 Mac 上运行：任何音频或文字记录都不会离开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，Koncluí 會聆聽喚醒詞「OK Koru」。語音辨識完全在這台 Mac 上執行，音訊和逐字稿都不會離開它。"
          }
        }
      }
    },
    "While listening, macOS shows the orange microphone dot in the top-right of the menu bar. This is normal system behaviour." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء الاستماع، يعرض macOS نقطة الميكروفون البرتقالية في أعلى يمين شريط القوائم. هذا هو السلوك الطبيعي للنظام."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শোনার সময়, macOS মেনু বারের উপরের-ডানে কমলা মাইক্রোফোন বিন্দু দেখায়। এটি স্বাভাবিক সিস্টেম আচরণ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Zuhörens zeigt macOS oben rechts in der Menüleiste den orangefarbenen Mikrofonpunkt. Das ist normales Systemverhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While listening, macOS shows the orange microphone dot in the top-right of the menu bar. This is normal system behaviour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la escucha, macOS muestra el punto naranja del micrófono en la parte superior derecha de la barra de menús. Este es el comportamiento normal del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant l’écoute, macOS affiche le point orange du microphone en haut à droite de la barre de menus. C’est le comportement normal du système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनते समय, macOS मेनू बार के ऊपर-दाईं ओर नारंगी माइक्रोफ़ोन बिंदु दिखाता है। यह सामान्य सिस्टम व्यवहार है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat mendengarkan, macOS menampilkan titik mikrofon oranye di kanan atas bilah menu. Ini adalah perilaku sistem yang normal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞き取り中は、macOS がメニューバーの右上にオレンジ色のマイクの点を表示します。これはシステムの通常の動作です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣는 동안 메뉴 막대 오른쪽 위에 주황색 마이크 점이 떠요. macOS가 원래 그러니까 놀라지 마세요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a escuta, o macOS exibe o ponto laranja do microfone no canto superior direito da barra de menus. Este é o comportamento normal do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время прослушивания macOS отображает оранжевую точку микрофона в правом верхнем углу строки меню. Это нормальное поведение системы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขณะฟัง macOS จะแสดงจุดไมโครโฟนสีส้มที่มุมขวาบนของแถบเมนู นี่เป็นการทำงานปกติของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlerken macOS, menü çubuğunun sağ üstünde turuncu mikrofon noktasını gösterir. Bu normal bir sistem davranışıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收听时，macOS 会在菜单栏右上角显示橙色麦克风指示灯。这是正常的系统行为。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聆聽時，macOS 會在選單列右上角顯示橘色麥克風指示點。這是系統的正常行為。"
          }
        }
      }
    },
