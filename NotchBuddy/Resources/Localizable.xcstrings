    "hub.mail.rules-empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا قواعد بعد. مثال: إذا احتوى المرسل على «newsletter»، انقلها إلى غير المرغوب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কোনো নিয়ম নেই। উদাহরণ: প্রেরকে “newsletter” থাকলে জাঙ্কে সরান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Regeln. Beispiel: Wenn der Absender „Newsletter“ enthält, in Werbung verschieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rules yet. Example: if the sender contains “newsletter”, move to Junk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay reglas. Ejemplo: si el remitente contiene «newsletter», mover a no deseado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de règle. Exemple : si l’expéditeur contient « newsletter », mettre en indésirables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई नियम नहीं। उदाहरण: अगर प्रेषक में “newsletter” हो, तो जंक में भेजें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada aturan. Contoh: jika pengirim berisi “newsletter”, pindahkan ke Sampah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールはまだありません。例：差出人に「newsletter」を含む場合、迷惑メールへ移動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 규칙이 없습니다. 예: 보낸 사람에 ‘newsletter’가 있으면 정크로 이동."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma regra ainda. Exemplo: se o remetente contém “newsletter”, mover para o lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правил пока нет. Пример: если отправитель содержит «newsletter», переместить в спам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีกฎ ตัวอย่าง: ถ้าผู้ส่งมีคำว่า “newsletter” ให้ย้ายไปที่ขยะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz kural yok. Örnek: gönderen “newsletter” içeriyorsa gereksize taşı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有规则。例如：发件人包含“newsletter”时，移到垃圾邮件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還沒有規則。例如：寄件者包含「newsletter」時，移到垃圾郵件。"
          }
        }
      }
    },
    "hub.mail.rules-sub" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا طابقت رسالة، ينفذ Koncluí الإجراء. تفوز أول قاعدة مطابقة؛ وتأتي كبار الشخصيات والكلمات المحظورة قبلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো মেল মিললে Koncluí কাজটি করে। প্রথম মেলা নিয়মটিই প্রযোজ্য; VIP আর নিষিদ্ধ শব্দ তার আগে আসে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt eine E-Mail, führt Koncluí die Aktion aus. Die erste passende Regel gewinnt; VIPs und verbotene Wörter kommen vorher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a message matches, Koncluí does the action. The first rule that matches wins; VIPs and banned words come before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un correo coincide, Koncluí hace la acción. Gana la primera regla que coincida; los VIP y las palabras prohibidas van antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un mail correspond, Koncluí fait l’action. La première règle qui correspond l’emporte ; les VIP et les mots bannis passent avant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई मेल मेल खाता है, तो Koncluí कार्रवाई करता है। पहला मिलने वाला नियम लागू होता है; VIP और प्रतिबंधित शब्द उससे पहले आते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika email cocok, Koncluí menjalankan tindakannya. Aturan pertama yang cocok yang berlaku; VIP dan kata terlarang didahulukan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件に合うメールに Koncluí が操作を行います。最初に一致したルールが優先され、VIP と禁止ワードはそれより先に処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일이 조건에 맞으면 Koncluí가 동작을 실행합니다. 처음 맞는 규칙이 적용되며, VIP와 금지어가 먼저 처리됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se um e-mail corresponder, o Koncluí faz a ação. A primeira regra que corresponder vence; VIPs e palavras proibidas vêm antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если письмо подходит, Koncluí выполняет действие. Срабатывает первое подходящее правило; VIP и запрещённые слова проверяются раньше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าอีเมลตรงเงื่อนไข Koncluí จะทำตามการกระทำ กฎแรกที่ตรงจะถูกใช้ และ VIP กับคำต้องห้ามจะมาก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir e-posta eşleşirse Koncluí işlemi yapar. İlk eşleşen kural geçerlidir; VIP’ler ve yasaklı kelimeler önce gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邮件符合条件时，Koncluí 会执行操作。第一条匹配的规则生效；VIP 和屏蔽词优先。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "郵件符合條件時，Koncluí 會執行動作。第一條符合的規則生效；VIP 和封鎖字詞優先。"
          }
        }
      }
    },
