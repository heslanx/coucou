    "The Koncluí Proxy is unreachable. Check your connection." : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر الوصول إلى Koncluí Proxy. تحقق من اتصالك." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy-তে পৌঁছানো যাচ্ছে না। আপনার সংযোগ পরীক্ষা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Koncluí Proxy ist nicht erreichbar. Prüfe deine Verbindung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The Koncluí Proxy is unreachable. Check your connection." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se puede acceder al Koncluí Proxy. Revisa tu conexión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Koncluí Proxy est injoignable. Vérifiez votre connexion." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy तक पहुँच नहीं हो पा रही। अपना कनेक्शन जाँचें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy tidak dapat dijangkau. Periksa koneksi Anda." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível alcançar o Koncluí Proxy. Verifique sua conexão." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy недоступен. Проверьте подключение." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เข้าถึง Koncluí Proxy ไม่ได้ ตรวจสอบการเชื่อมต่อของคุณ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy'ye ulaşılamıyor. Bağlantınızı kontrol edin." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法连接 Koncluí Proxy。请检查网络连接。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法連線至 Koncluí Proxy。請檢查網路連線。" } } } },
    "The Koncluí Proxy refused the key. Run klaude doctor in Terminal." : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "رفض Koncluí Proxy المفتاح. شغّل klaude doctor في Terminal." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy কী গ্রহণ করেনি। Terminal-এ klaude doctor চালান।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Koncluí Proxy hat den Schlüssel abgelehnt. Führe klaude doctor im Terminal aus." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The Koncluí Proxy refused the key. Run klaude doctor in Terminal." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El Koncluí Proxy rechazó la clave. Ejecuta klaude doctor en Terminal." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Koncluí Proxy a refusé la clé. Lancez klaude doctor dans le Terminal." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy ने कुंजी अस्वीकार कर दी। Terminal में klaude doctor चलाएँ।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy menolak kunci. Jalankan klaude doctor di Terminal." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Koncluí Proxy recusou a chave. Rode klaude doctor no Terminal." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy отклонил ключ. Выполните klaude doctor в Терминале." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy ปฏิเสธคีย์ รัน klaude doctor ใน Terminal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy anahtarı reddetti. Terminal'de klaude doctor çalıştırın." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy 拒绝了该密钥。请在终端运行 klaude doctor。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Koncluí Proxy 拒絕了該金鑰。請在終端機執行 klaude doctor。" } } } },
    "The chat took too long. Ask again." : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استغرقت الدردشة وقتًا طويلًا. اسأل مرة أخرى." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চ্যাটে অনেক সময় লেগেছে। আবার জিজ্ঞাসা করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Chat hat zu lange gebraucht. Frage noch einmal." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The chat took too long. Ask again." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "El chat tardó demasiado. Pregunta de nuevo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le chat a pris trop de temps. Posez à nouveau votre question." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चैट में बहुत समय लगा। फिर से पूछें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Chat terlalu lama. Tanyakan lagi." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O chat demorou demais. Pergunte de novo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Чат отвечал слишком долго. Спросите ещё раз." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แชตใช้เวลานานเกินไป ลองถามอีกครั้ง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sohbet çok uzun sürdü. Yeniden sorun." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "聊天用时过长。请再问一次。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "聊天耗時過長。請再問一次。" } } } },
    "Use for chat" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استخدمه في الدردشة" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "চ্যাটের জন্য ব্যবহার করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Für den Chat verwenden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Use for chat" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Usar para el chat" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utiliser pour le chat" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "चैट के लिए उपयोग करें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Gunakan untuk chat" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Usar no chat" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Использовать для чата" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ใช้สำหรับแชต" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sohbet için kullan" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于聊天" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "用於聊天" } } } },
    "klaude has no key: run klaude doctor in Terminal" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يملك klaude مفتاحًا: شغّل klaude doctor في Terminal" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "klaude-এর কোনো কী নেই: Terminal-এ klaude doctor চালান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "klaude hat keinen Schlüssel: Führe klaude doctor im Terminal aus" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "klaude has no key: run klaude doctor in Terminal" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "klaude no tiene clave: ejecuta klaude doctor en Terminal" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "klaude n'a pas de clé : lancez klaude doctor dans le Terminal" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "klaude के पास कुंजी नहीं है: Terminal में klaude doctor चलाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "klaude tidak punya kunci: jalankan klaude doctor di Terminal" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O klaude não tem chave: rode klaude doctor no Terminal" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "У klaude нет ключа: выполните klaude doctor в Терминале" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "klaude ไม่มีคีย์: รัน klaude doctor ใน Terminal" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "klaude'un anahtarı yok: Terminal'de klaude doctor çalıştırın" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "klaude 没有密钥：请在终端运行 klaude doctor" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "klaude 沒有金鑰：請在終端機執行 klaude doctor" } } } },
    "klaude is not installed. Install it to use the Koncluí Proxy." : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "klaude غير مثبّت. ثبّته لاستخدام Koncluí Proxy." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "klaude ইনস্টল করা নেই। Koncluí Proxy ব্যবহার করতে এটি ইনস্টল করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "klaude ist nicht installiert. Installiere es, um den Koncluí Proxy zu nutzen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "klaude is not installed. Install it to use the Koncluí Proxy." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "klaude no está instalado. Instálalo para usar el Koncluí Proxy." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "klaude n'est pas installé. Installez-le pour utiliser le Koncluí Proxy." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "klaude इंस्टॉल नहीं है। Koncluí Proxy का उपयोग करने के लिए इसे इंस्टॉल करें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "klaude belum terpasang. Pasang untuk memakai Koncluí Proxy." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O klaude não está instalado. Instale-o para usar o Koncluí Proxy." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "klaude не установлен. Установите его, чтобы использовать Koncluí Proxy." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่ได้ติดตั้ง klaude ติดตั้งเพื่อใช้ Koncluí Proxy" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "klaude kurulu değil. Koncluí Proxy'yi kullanmak için kurun." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未安装 klaude。安装后即可使用 Koncluí Proxy。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "尚未安裝 klaude。安裝後即可使用 Koncluí Proxy。" } } } },
    "hooks.klaude.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "خطافات klaude" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "klaude হুক" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "klaude-Hooks" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "klaude hooks" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hooks de klaude" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hooks klaude" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "klaude हुक" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hooks klaude" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Hooks do klaude" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хуки klaude" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "klaude Hooks" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "klaude hook'ları" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "klaude 钩子" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "klaude hooks" } } } },
    "hooks.klaude.installed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخطافات مثبَّتة. جلسات klaude الجديدة تظهر في الشريط العلوي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "হুক ইনস্টল হয়েছে। klaude-এর নতুন সেশন নচে পৌঁছাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installiert. Neue klaude-Sitzungen erscheinen in der Notch." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installed. New klaude sessions reach the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Hooks instalados. Las nuevas sesiones de klaude llegan al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Hooks installés. Les nouvelles sessions klaude arrivent dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "हुक इंस्टॉल हो गए। klaude के नए सेशन नॉच तक पहुँचेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Hooks terpasang. Sesi klaude baru muncul di notch." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Hooks instalados. As novas sessões do klaude chegam ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Хуки установлены. Новые сессии klaude появятся в нотче." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ติดตั้ง Hooks แล้ว เซสชัน klaude ใหม่จะแสดงในแถบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hook'lar kuruldu. Yeni klaude oturumları adaya ulaşır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hooks 已安装。新的 klaude 会话会显示在刘海中。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "hooks 已安裝。新的 klaude 工作階段會顯示在瀏海中。" } } } },
    "status.klaude-hooks-installed" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "✓ تم تثبيت خطافات klaude. جلسات klaude الجديدة تظهر في الشريط العلوي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude হুক ইনস্টল হয়েছে। klaude-এর নতুন সেশন নচে পৌঁছাবে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude-Hooks installiert. Neue klaude-Sitzungen erscheinen in der Notch." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude hooks installed. New klaude sessions reach the notch." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "✓ Hooks de klaude instalados. Las nuevas sesiones de klaude llegan al notch." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "✓ Hooks klaude installés. Les nouvelles sessions klaude arrivent dans le notch." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude हुक इंस्टॉल हो गए। klaude के नए सेशन नॉच तक पहुँचेंगे।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "✓ Hooks klaude terpasang. Sesi klaude baru muncul di notch." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "✓ Hooks do klaude instalados. As novas sessões do klaude chegam ao notch." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "✓ Хуки klaude установлены. Новые сессии klaude появятся в нотче." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "✓ ติดตั้ง klaude Hooks แล้ว เซสชัน klaude ใหม่จะแสดงในแถบ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude hook'ları kuruldu. Yeni klaude oturumları adaya ulaşır." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude Hooks 已安装。新的 klaude 会话会显示在刘海中。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "✓ klaude hooks 已安裝。新的 klaude 工作階段會顯示在瀏海中。" } } } },
