    "voice.mac-voices-help" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لصوت أكثر طبيعية، نزّل صوتًا Premium: إعدادات النظام ‹ تسهيلات الاستخدام ‹ المحتوى المنطوق ‹ صوت النظام ‹ إدارة الأصوات. بالإنجليزية: Ava لامرأة، Jamie لرجل (بريطاني)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আরও স্বাভাবিক কণ্ঠের জন্য একটি Premium কণ্ঠ ডাউনলোড করো: System Settings › Accessibility › Spoken Content › System Voice › Manage Voices। ইংরেজিতে: নারী হলে Ava, পুরুষ হলে Jamie (ব্রিটিশ)।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine natürlichere Stimme lade eine Premium-Stimme herunter: Systemeinstellungen › Bedienungshilfen › Gesprochene Inhalte › Systemstimme › Stimmen verwalten. Auf Englisch: Ava für eine weibliche, Jamie für eine männliche Stimme (britisch)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a more natural voice, download a Premium voice: System Settings › Accessibility › Spoken Content › System Voice › Manage Voices. In English: Ava for a woman, Jamie for a man (British)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una voz más natural, descarga una voz Premium: Ajustes del Sistema › Accesibilidad › Contenido leído › Voz del sistema › Gestionar voces. En inglés: Ava para mujer, Jamie para hombre (británico)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une voix plus naturelle, télécharge une voix Premium : Réglages Système › Accessibilité › Contenu énoncé › Voix du système › Gérer les voix. En anglais : Ava pour une femme, Jamie pour un homme (britannique)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा स्वाभाविक आवाज़ के लिए Premium आवाज़ डाउनलोड करें: System Settings › Accessibility › Spoken Content › System Voice › Manage Voices। अंग्रेज़ी में: महिला के लिए Ava, पुरुष के लिए Jamie (ब्रिटिश)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk suara yang lebih alami, unduh suara Premium: Pengaturan Sistem › Aksesibilitas › Konten Lisan › Suara Sistem › Kelola Suara. Bahasa Inggris: Ava untuk wanita, Jamie untuk pria (Inggris)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より自然な声にするには、プレミアムの声をダウンロードしてください：システム設定 → アクセシビリティ → 読み上げコンテンツ → システムの声 → 声を管理。英語なら、女性は Ava、男性は Jamie（イギリス英語）がおすすめです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 자연스러운 목소리를 원하면 프리미엄 음성을 받아 보세요: 시스템 설정 → 손쉬운 사용 → 말하기 콘텐츠 → 시스템 음성 → 음성 관리. 영어라면 여성은 Ava, 남성은 Jamie(영국식)를 추천해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para uma voz mais natural, baixe uma voz Premium: Ajustes do Sistema › Acessibilidade › Conteúdo Falado › Voz do Sistema › Gerenciar Vozes. Em inglês: Ava para mulher, Jamie para homem (britânico)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для более естественного голоса скачай голос Premium: Системные настройки › Универсальный доступ › Устная речь › Системный голос › Управлять голосами. По-английски: Ava: женский, Jamie: мужской (британский)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการเสียงที่เป็นธรรมชาติมากขึ้น ให้ดาวน์โหลดเสียงพรีเมียมที่ การตั้งค่าระบบ › การช่วยการเข้าถึง › เนื้อหาที่พูด › เสียงระบบ › จัดการเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha doğal bir ses için Premium ses indir: Sistem Ayarları › Erişilebilirlik › Seslendirilen İçerik › Sistem Sesi › Sesleri Yönet. İngilizcede: kadın sesi için Ava, erkek sesi için Jamie (Britanya)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想要更自然的声音，请下载 Premium 语音：系统设置 › 辅助功能 › 朗读内容 › 系统语音 › 管理语音。英语：女声选 Ava，男声选 Jamie（英式）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若想要更自然的語音，請下載優質語音：「系統設定 › 輔助使用 › 朗讀內容 › 系統聲音 › 管理聲音」。英文女聲可選 Ava，男聲可選 Jamie（英式）。"
          }
        }
      }
    },
