          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No gateway build for this Mac was found on GitHub. Try again later, or set your own gateway under Advanced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna versión de la pasarela para este Mac en GitHub. Inténtalo más tarde o configura tu propia pasarela en Avanzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune version de la passerelle pour ce Mac sur GitHub. Réessaie plus tard, ou configure ta propre passerelle dans Avancé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub पर इस Mac के लिए गेटवे नहीं मिला। बाद में फिर कोशिश करें, या एडवांस्ड में अपना गेटवे सेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
