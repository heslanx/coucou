    "Add button" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة زر" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "বোতাম যোগ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Taste hinzufügen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Add button" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Añadir botón" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajouter un bouton" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बटन जोड़ें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tambah tombol" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adicionar botão" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Добавить кнопку" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "เพิ่มปุ่ม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düğme ekle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加按钮" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增按鈕" } } } },
    "Create reminder" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إنشاء تذكير" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "রিমাইন্ডার তৈরি করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerung erstellen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Create reminder" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Crear recordatorio" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Créer le rappel" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "रिमाइंडर बनाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Buat pengingat" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Criar lembrete" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Создать напоминание" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "สร้างการเตือนความจำ" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hatırlatıcı oluştur" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建立提醒" } } } },
    "Save changes" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "حفظ التغييرات" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "পরিবর্তন সংরক্ষণ করুন" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Änderungen sichern" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Save changes" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Guardar cambios" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistrer les modifications" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "बदलाव सहेजें" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Simpan perubahan" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Salvar alterações" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохранить изменения" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "บันทึกการเปลี่ยนแปลง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Değişiklikleri kaydet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存更改" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "儲存變更" } } } },
    "Reminders on this Mac" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "التذكيرات على هذا الـ Mac" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই Mac-এর রিমাইন্ডার" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnerungen auf diesem Mac" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders on this Mac" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Recordatorios en este Mac" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rappels sur ce Mac" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "इस Mac पर रिमाइंडर" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat di Mac ini" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Lembretes neste Mac" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминания на этом Mac" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "การเตือนความจำบน Mac เครื่องนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu Mac'teki hatırlatıcılar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此 Mac 上的提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "此 Mac 上的提醒" } } } },
    "No reminders yet. Create one above or connect a local MCP client below." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد تذكيرات بعد. أنشئ واحدًا أعلاه أو اربط عميل MCP محليًا أدناه." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখনও কোনো রিমাইন্ডার নেই। উপরে একটি তৈরি করুন বা নিচে একটি লোকাল MCP ক্লায়েন্ট যুক্ত করুন।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch keine Erinnerungen. Erstelle oben eine oder verbinde unten einen lokalen MCP-Client." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No reminders yet. Create one above or connect a local MCP client below." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aún no hay recordatorios. Crea uno arriba o conecta un cliente MCP local abajo." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun rappel pour l'instant. Crée-en un ci-dessus ou connecte un client MCP local ci-dessous." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी कोई रिमाइंडर नहीं है। ऊपर एक बनाएँ या नीचे एक लोकल MCP क्लाइंट जोड़ें।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Belum ada pengingat. Buat di atas atau hubungkan klien MCP lokal di bawah." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Nenhum lembrete ainda. Crie um acima ou conecte um cliente MCP local abaixo." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Напоминаний пока нет. Создайте его выше или подключите локальный клиент MCP ниже." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "ยังไม่มีการเตือนความจำ สร้างด้านบน หรือเชื่อมต่อไคลเอนต์ MCP ในเครื่องด้านล่าง" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Henüz hatırlatıcı yok. Yukarıdan bir tane oluştur ya da aşağıdan yerel bir MCP istemcisi bağla." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有提醒。请在上方创建，或在下方连接本地 MCP 客户端。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "目前沒有提醒。請在上方建立，或在下方連接本機 MCP 用戶端。" } } } },
    "Saved reminders could not be loaded. Changes are disabled to protect the existing file." : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعذّر تحميل التذكيرات المحفوظة. عُطّلت التغييرات لحماية الملف الحالي." } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "সংরক্ষিত রিমাইন্ডার লোড করা যায়নি। বিদ্যমান ফাইল রক্ষা করতে পরিবর্তন বন্ধ রাখা হয়েছে।" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die gesicherten Erinnerungen konnten nicht geladen werden. Änderungen sind deaktiviert, um die vorhandene Datei zu schützen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved reminders could not be loaded. Changes are disabled to protect the existing file." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudieron cargar los recordatorios guardados. Los cambios están desactivados para proteger el archivo existente." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de charger les rappels enregistrés. Les modifications sont désactivées pour protéger le fichier existant." } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "सहेजे गए रिमाइंडर लोड नहीं हो सके। मौजूदा फ़ाइल की सुरक्षा के लिए बदलाव बंद हैं।" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat tersimpan tidak dapat dimuat. Perubahan dinonaktifkan untuk melindungi berkas yang ada." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível carregar os lembretes salvos. As alterações ficam desativadas para proteger o arquivo existente." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось загрузить сохранённые напоминания. Изменения отключены, чтобы защитить существующий файл." } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "โหลดการเตือนความจำที่บันทึกไว้ไม่ได้ ระบบปิดการแก้ไขเพื่อปกป้องไฟล์เดิม" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kayıtlı hatırlatıcılar yüklenemedi. Mevcut dosyayı korumak için değişiklikler kapatıldı." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法载入已保存的提醒。为保护现有文件，已停用更改功能。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法載入已儲存的提醒。為保護原有檔案，已停用變更功能。" } } } },
    "Show now" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض الآن" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এখনই দেখান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Jetzt anzeigen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Show now" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar ahora" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher maintenant" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "अभी दिखाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan sekarang" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar agora" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать сейчас" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงตอนนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şimdi göster" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即显示" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "立即顯示" } } } },
    "Show this reminder now" : { "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض هذا التذكير الآن" } }, "bn" : { "stringUnit" : { "state" : "translated", "value" : "এই রিমাইন্ডার এখনই দেখান" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Erinnerung jetzt anzeigen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Show this reminder now" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar este recordatorio ahora" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher ce rappel maintenant" } }, "hi" : { "stringUnit" : { "state" : "translated", "value" : "यह रिमाइंडर अभी दिखाएँ" } }, "id" : { "stringUnit" : { "state" : "translated", "value" : "Tampilkan pengingat ini sekarang" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mostrar este lembrete agora" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Показать это напоминание сейчас" } }, "th" : { "stringUnit" : { "state" : "translated", "value" : "แสดงการเตือนความจำนี้ตอนนี้" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu hatırlatıcıyı şimdi göster" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "立即显示此提醒" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "立即顯示此提醒" } } } },
